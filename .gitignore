node_modules/
.env
.DS_Store
*.log
npm-debug.log*

# Incoming source files (the served copies live in public/pdfs)
/pdfs/

# Local Claude session state, but the shared skills folder IS version-controlled
# (it carries /goodnight, see WORKING-METHOD.md)
.claude/*
!.claude/skills/

# Workspace snapshot: only the encrypted file is committed. Any plaintext
# extract of the controlled Drive records stays outside the repository.
data/*.json
