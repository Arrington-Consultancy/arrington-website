<%
  var _tone = { new: 'soon', in_progress: 'warn', waiting: 'neutral', done: 'ok' }[c.status] || 'neutral';
  var _overdue = c.escalated_at && !c.approved_at && (c.status === 'new' || c.status === 'in_progress');
  var _kindName = { unread: 'Not read yet', bookings: 'Bookings', customer: 'Customer emails', complaints: 'Complaints', licensing: 'Council', other: 'Not for the office' }[c.kind] || c.kind;
  var _iconId = { bookings: 'bookings', customer: 'customer', complaints: 'complaints', licensing: 'licensing' }[c.kind];
%>
<li><a class="to-case-row<%= _overdue ? ' is-overdue' : '' %><%= c.seriousness === 'safety' && c.status !== 'done' ? ' is-safety' : '' %>" href="/case/<%= c.id %>">
  <span><span class="to-case-subject"><%= c.subject || '(no subject)' %></span><br><span class="to-small"><%= c.from_address %></span></span>
  <span class="to-case-side">
    <% if (_overdue) { %><span class="to-pill to-pill-bad">Overdue</span><% } %>
    <% if (c.passed_up_at && !c.approved_at && c.status !== 'done') { %><span class="to-pill to-pill-warn">For a manager</span><% } %>
    <% if (c.dispatch_ref) { %><span class="to-pill to-pill-ok">In dispatch <%= c.dispatch_ref %></span><% } %>
    <% if (c.seriousness && c.seriousness !== 'none') { %><span class="to-pill <%= c.seriousness === 'minor' ? 'to-pill-neutral' : 'to-pill-bad' %>"><%= c.seriousness %></span><% } %>
    <% if (c.kind === 'licensing' && c.council && c.council.deadline && c.status !== 'done') { %><span class="to-pill to-pill-warn">Due <%= new Date(c.council.deadline + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) %></span><% } %>
    <% if (c.approved_at) { %><span class="to-pill to-pill-ok">Approved</span><% } %>
    <span class="to-pill to-pill-<%= _tone %>"><%= label(c.status) %></span>
  </span>
  <span class="to-case-meta">
    <span class="to-chip"><% if (_iconId) { %><%- include('worker-icon', { id: _iconId }) %><% } %><%= _kindName %></span>
    <% if (/^<logged-/.test(String(c.message_id || '')) && channels[c.channel]) { %><span class="to-tag"><%= channels[c.channel].label %></span><% } %>
    <% if (manyBrands && !portal) { %><% if (brandLogo(c.brand)) { %><span class="to-tag to-tag-logo"><img src="<%= brandLogo(c.brand) %>" alt="<%= brandName(c.brand) %>" height="18"></span><% } else { %><span class="to-tag"><%= brandName(c.brand) %></span><% } %><% } %>
    <span>Received <%= new Date(c.received_at).toLocaleString('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
    <span><%= c.owner_display || c.owner_username ? 'With ' + (c.owner_display || c.owner_username) : 'Nobody has it' %></span>
    <% if (c.reading && c.reading.summary) { %><span><%= c.reading.summary %></span><% } %>
  </span>
</a></li>
