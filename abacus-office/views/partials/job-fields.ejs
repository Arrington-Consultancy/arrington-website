<%# The job's details, for booking it or changing it in dispatch. `j` holds
    the values to show; `p` keeps the ids apart when two forms are on one
    page. With `copy` each line has a Copy button, for keying the job into
    the dispatch system by hand (Tom, 27 November 2026): Copy puts that one
    line on the clipboard as it stands now, corrections included. %>
<% var _vehicles = ['Car (up to 4)', 'Estate (up to 4, more luggage)', '6 seater', '8 seater', 'Wheelchair accessible']; %>
<% var _copy = typeof copy !== 'undefined' && copy; %>
<%# `needs` is what the job cannot be booked without (the day, the time and
    the two addresses; a live dispatch system also a name and a phone). The
    other lines may be left empty and are asked for in the reply (Tom,
    28 November 2026). With no `needs` given every line is required. %>
<% var _needs = typeof needs !== 'undefined' && Array.isArray(needs) ? needs : ['date', 'time', 'pickup', 'destination', 'name', 'phone', 'passengers']; %>
<% function _req(k) { return _needs.indexOf(k) === -1 ? '' : ' required'; } %>
<% function _later(k) { return _needs.indexOf(k) === -1 ? ' (ask if not given)' : ''; } %>
<% function _btn(id, what, as) { return _copy ? '<button type="button" class="to-copy" data-copy-from="' + p + '-' + id + '"' + (as ? ' data-copy-as="' + as + '"' : '') + ' aria-label="Copy the ' + what + '">Copy</button>' : ''; } %>
<div class="to-field-row is-two<%= _copy ? " has-copy" : "" %>">
  <div class="to-field"><label for="<%= p %>-date">Date</label><div class="to-copyable"><input id="<%= p %>-date" name="date" type="date" value="<%= j.date || '' %>" required><%- _btn('date', 'date', 'ukdate') %></div></div>
  <div class="to-field"><label for="<%= p %>-time">Pickup time</label><div class="to-copyable"><input id="<%= p %>-time" name="time" type="time" value="<%= j.time || '' %>" required><%- _btn('time', 'pickup time') %></div></div>
</div>
<div class="to-field-row is-two<%= _copy ? " has-copy" : "" %>">
  <div class="to-field"><label for="<%= p %>-pickup">Pickup</label><div class="to-copyable"><input id="<%= p %>-pickup" name="pickup" value="<%= j.pickup || '' %>" maxlength="160" required><%- _btn('pickup', 'pickup address') %></div></div>
  <div class="to-field"><label for="<%= p %>-destination">Destination</label><div class="to-copyable"><input id="<%= p %>-destination" name="destination" value="<%= j.destination || '' %>" maxlength="160" required><%- _btn('destination', 'destination') %></div></div>
</div>
<div class="to-field-row<%= _copy ? " has-copy" : "" %>">
  <div class="to-field"><label for="<%= p %>-name">Passenger<%= _later('name') %></label><div class="to-copyable"><input id="<%= p %>-name" name="name" value="<%= j.name || '' %>" maxlength="80"<%- _req('name') %>><%- _btn('name', 'passenger\'s name') %></div></div>
  <div class="to-field"><label for="<%= p %>-phone">Phone<%= _later('phone') %></label><div class="to-copyable"><input id="<%= p %>-phone" name="phone" type="tel" value="<%= j.phone || '' %>" maxlength="30"<%- _req('phone') %>><%- _btn('phone', 'phone number') %></div></div>
  <div class="to-field"><label for="<%= p %>-passengers">Passengers<%= _later('passengers') %></label><div class="to-copyable"><input id="<%= p %>-passengers" name="passengers" inputmode="numeric" value="<%= j.passengers || '' %>" maxlength="2"<%- _req('passengers') %> placeholder="How many"><%- _btn('passengers', 'number of passengers') %></div></div>
</div>
<div class="to-field-row is-two<%= _copy ? " has-copy" : "" %>">
  <div class="to-field"><label for="<%= p %>-vehicle">Vehicle</label><div class="to-copyable"><select id="<%= p %>-vehicle" name="vehicle"><% _vehicles.forEach(function (v) { %><option<% if ((j.vehicle || 'Car (up to 4)') === v) { %> selected<% } %>><%= v %></option><% }) %></select><%- _btn('vehicle', 'vehicle') %></div></div>
  <div class="to-field"><label for="<%= p %>-notes">Note for the driver (optional)</label><div class="to-copyable"><input id="<%= p %>-notes" name="notes" value="<%= j.notes || '' %>" maxlength="300" placeholder="One suitcase, ring on arrival"><%- _btn('notes', 'note for the driver') %></div></div>
</div>
<div class="to-field-row is-two<%= _copy ? " has-copy" : "" %>">
  <div class="to-field"><label for="<%= p %>-flight">Flight number (airport pickups)</label><div class="to-copyable"><input id="<%= p %>-flight" name="flight" value="<%= j.flight || '' %>" maxlength="12" placeholder="e.g. FR 1234"><%- _btn('flight', 'flight number') %></div></div>
</div>
