<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found | Arrington Consultancy</title>
    <meta name="robots" content="noindex, follow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--black);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2rem 1.5rem;
        }
        .nf-logo { margin-bottom: 2.5rem; }
        .nf-logo img { height: 36px; width: auto; }
        .nf-eyebrow {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-weight: 500;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }
        h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2rem, 5vw, 2.75rem);
            color: var(--text-bright);
            font-weight: 400;
            margin-bottom: 1rem;
        }
        .nf-body {
            max-width: 32rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 2.5rem;
        }
        .nf-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            max-width: 40rem;
            margin-bottom: 1rem;
        }
        .nf-links a {
            padding: 0.65rem 1.25rem;
            border: 1px solid var(--border);
            border-radius: 2px;
            color: var(--text);
            text-decoration: none;
            font-size: 0.9rem;
            transition: border-color 0.15s ease, color 0.15s ease;
        }
        .nf-links a:hover, .nf-links a:focus-visible {
            border-color: var(--accent);
            color: var(--text-bright);
        }
        .nf-home {
            margin-top: 1.5rem;
            color: var(--accent);
            font-weight: 500;
            text-decoration: none;
        }
        .nf-home:hover, .nf-home:focus-visible { color: var(--accent-hover); }
    </style>
</head>
<body>
    <a href="/" class="nf-logo">
        <img src="/img/logo" alt="Arrington Business Consultancy">
    </a>
    <p class="nf-eyebrow">404</p>
    <h1>Page Not Found</h1>
    <p class="nf-body">The page you're looking for doesn't exist or may have moved. Here's where you can go instead:</p>
    <nav class="nf-links">
        <% pages.forEach(function(p) { %>
        <a href="<%= p.slug === 'main' ? '/' : '/' + p.slug %>"><%= p.nav_label || p.title %></a>
        <% }); %>
    </nav>
    <a href="/" class="nf-home">&larr; Back to homepage</a>
</body>
</html>
