<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Commercial Gaps Review | Arrington Consultancy</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
        body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--black); color: var(--text); line-height: 1.6; }
        <%- include('partials/site-chrome-styles') %>
        main { max-width: 680px; margin: 0 auto; padding: calc(88px + 2.5rem) 1.5rem 6rem; }
        @media (max-width: 900px) {
            main { padding-top: calc(64px + 2.5rem); }
        }
        .cgr-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--accent); margin-bottom: 0.9rem; }
        h1, h2, h3 { font-family: 'DM Serif Display', serif; font-weight: 400; color: var(--text-bright); line-height: 1.25; margin: 0 0 1rem; text-wrap: balance; }
        h1 { font-size: clamp(1.7rem, 4.5vw, 2.2rem); }
        h2 { font-size: 1.25rem; }
        p { color: var(--text); margin: 0 0 1.2rem; }

        .cgr-card { border: 1px solid var(--border); border-radius: 6px; padding: 1.75rem; margin-bottom: 1.5rem; }
        .cgr-card-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--text-muted); margin-bottom: 0.75rem; }
        .cgr-primary { border-color: var(--accent); }

        .cgr-resource { display: flex; flex-direction: column; gap: 0.5rem; }
        .cgr-resource a { color: var(--accent); text-decoration: none; font-weight: 600; }
        .cgr-resource a:hover, .cgr-resource a:focus-visible { text-decoration: underline; }

        .btn { display: inline-block; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; padding: 0.85rem 1.75rem; border-radius: 3px; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
        .btn-primary { background: var(--accent); color: var(--black); border-color: var(--accent); }
        .btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }

        .cgr-next { text-align: center; border-top: 1px solid var(--border); padding: 3rem 0 1rem; margin-top: 2.5rem; }
        .cgr-next p { max-width: 480px; margin: 0 auto 1.75rem; }

        .cgr-caveat { font-size: 0.85rem; color: var(--text-muted); }
        .cgr-card .cgr-label { margin-bottom: 0.5rem; }
        .cgr-card p:last-child { margin-bottom: 0; }

        /* ---- waiting state ---- */
        .cgr-waiting { text-align: center; padding: 4rem 0 2rem; }
        .cgr-spinner { width: 40px; height: 40px; margin: 0 auto 2rem; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: cgr-spin 0.9s linear infinite; }
        @keyframes cgr-spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { .cgr-spinner { animation: none; border-top-color: var(--border); } }
        .cgr-waiting-text { font-size: 1.1rem; color: var(--text-bright); min-height: 1.6em; transition: opacity 0.4s ease; }
        .cgr-waiting-meta { font-size: 0.85rem; color: var(--text-muted); margin-top: 1.5rem; }

        /* ---- failed state ---- */
        .cgr-error-box { padding: 1.5rem 1.6rem; border: 1px solid var(--odr-red, #c0524a); background: rgba(192,82,74,0.08); border-radius: 6px; margin-bottom: 1.5rem; }
        .cgr-error-box p { color: var(--text-bright); margin: 0; }
        .cgr-reference { display: inline-block; margin-top: 1rem; padding: 0.4rem 0.8rem; border-radius: 3px; background: rgba(255,255,255,0.06); font-family: 'DM Sans', monospace; font-weight: 600; color: var(--accent); letter-spacing: 0.03em; }
    </style>
</head>
<body>
    <%- include('partials/site-header', { currentPage: { slug: 'owner-check' }, navPages, canEdit: false, content, pageContact }) %>

    <main>
        <% if (state === 'waiting') { %>
        <p class="cgr-label">YOUR COMMERCIAL GAPS REVIEW</p>
        <div class="cgr-waiting">
            <div class="cgr-spinner" aria-hidden="true"></div>
            <p class="cgr-waiting-text" id="cgr-waiting-text" role="status">Reading through what you've told us&hellip;</p>
            <p class="cgr-waiting-meta">This page will update on its own &mdash; no need to refresh it yourself.</p>
        </div>
        <script nonce="<%= nonce %>">
            (function () {
                var messages = [
                    "Reading through what you've told us…",
                    'Weighing up where the pressure in the business really sits…',
                    'Comparing this against real Arrington experience…',
                    'Nearly there…',
                    "This is taking a little longer than usual, but we're still working on it…"
                ];
                var textEl = document.getElementById('cgr-waiting-text');
                var step = 0;
                function advanceMessage() {
                    if (step >= messages.length - 1) return; // hold on the last message rather than looping
                    step += 1;
                    textEl.style.opacity = '0';
                    window.setTimeout(function () {
                        textEl.textContent = messages[step];
                        textEl.style.opacity = '1';
                    }, 300);
                }
                var messageTimer = window.setInterval(advanceMessage, 6000);

                function poll() {
                    fetch('/api/commercial-gaps-review/status/<%= token %>')
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.status === 'completed' || data.status === 'failed') {
                                window.clearInterval(messageTimer);
                                window.location.reload();
                            }
                        })
                        .catch(function () { /* try again on the next tick */ });
                }
                window.setInterval(poll, 3000);
            })();
        </script>

        <% } else if (state === 'failed') { %>
        <p class="cgr-label">YOUR COMMERCIAL GAPS REVIEW</p>
        <div class="cgr-error-box">
            <p>We couldn't display your review this time. Your answers have been received. Contact Tom at tom@arringtonconsultancy.com and we can recover or complete it for you.</p>
            <span class="cgr-reference">Reference: <%= shortReference %></span>
        </div>

        <% } else { %>
        <p class="cgr-label">YOUR COMMERCIAL GAPS REVIEW</p>
        <h1><%= headline %></h1>
        <p><%= visitorSummary %></p>

        <div class="cgr-card">
            <p class="cgr-label">AI-generated, not personally reviewed</p>
            <p>What follows was generated by Arrington Consultancy's AI commercial review system, based only on what you wrote. Tom Arrington has not personally read or checked this specific result.</p>
        </div>

        <div class="cgr-card cgr-primary">
            <p class="cgr-card-label">Primary issue</p>
            <p><%= primaryIssue %></p>
        </div>

        <div class="cgr-card">
            <p class="cgr-card-label">Also worth watching</p>
            <p><%= secondaryIssue %></p>
        </div>

        <div class="cgr-card">
            <p class="cgr-card-label">One useful observation</p>
            <p><%= usefulObservation %></p>
        </div>

        <div class="cgr-card cgr-resource">
            <p class="cgr-card-label">Worth reading</p>
            <a href="<%= recommendedResource.url %>"><%= recommendedResource.title %></a>
            <p><%= recommendedResource.reason %></p>
        </div>

        <p class="cgr-caveat">This review is a starting point, not a finished answer. It has looked at what you told us and pointed at where the pressure seems to be, it has not solved it for you.</p>
        <% } %>

        <div class="cgr-next">
            <h2>If this sounds familiar</h2>
            <p>A straightforward conversation is usually enough to work out whether a commercial review would help.</p>
            <a href="/book-a-30-minute-conversation" class="btn btn-primary">Book a 30 minute conversation</a>
        </div>
    </main>

    <%- include('partials/site-footer', { canEdit: false, pageContact, content }) %>
    <script nonce="<%= nonce %>">
        <%- include('partials/site-chrome-script') %>
    </script>
</body>
</html>
