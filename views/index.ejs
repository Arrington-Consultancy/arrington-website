<% const _k = _iid; %>
<!-- HONEST QUESTIONS -->
<section class="assessment<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" id="questions" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <div class="assessment-inner">
            <p class="section-label"><%- content[_k + '.label'] %></p>
            <h2 class="section-heading"><%- content[_k + '.heading'] %></h2>
            <p><%- content[_k + '.intro'] %></p>
            <div class="assessment-questions">
                <div class="aq"><%- content[_k + '.q_1'] %></div>
                <div class="aq"><%- content[_k + '.q_2'] %></div>
                <div class="aq"><%- content[_k + '.q_3'] %></div>
                <div class="aq"><%- content[_k + '.q_4'] %></div>
                <div class="aq"><%- content[_k + '.q_5'] %></div>
                <div class="aq"><%- content[_k + '.q_6'] %></div>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'filter') { %>
<% const _k = _iid; %>
<!-- FILTER -->
<section class="filter<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <div class="filter-inner">
            <p class="section-label"><%- content[_k + '.label'] %></p>
            <h2 class="section-heading"><%- content[_k + '.heading'] %></h2>
            <p><%- content[_k + '.p1'] %></p>
            <p><%- content[_k + '.p2'] %></p>
            <%
              const _fBtnText = (content[_k + '.button_text'] || '').replace(/<[^>]+>/g, '').trim();
              const _fBtnSlug = (content[_k + '.button_link'] || '').trim();
              const _fValidSlug = /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(_fBtnSlug);
              const _fBtnHref = _fBtnSlug === 'main' ? '/' : (_fValidSlug ? '/' + _fBtnSlug : '#conversation');
            %>
            <% if (_fBtnText) { %>
            <a href="<%= _fBtnHref %>" class="btn btn-primary"><%- content[_k + '.button_text'] %></a>
            <% } %>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'proofstrip') { %>
<% const _k = _iid; %>
<!-- PROOF STRIP -->
<section class="proofstrip<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <div class="proofstrip-inner">
            <% if ((content[_k + '.label'] || '').replace(/<[^>]+>/g, '').trim()) { %>
            <p class="section-label"><%- content[_k + '.label'] %></p>
            <% } %>
            <div class="proofstrip-rows">
                <% for (let _r = 1; _r <= 3; _r++) { %>
                <% const _action = content[_k + '.row_' + _r + '_action']; %>
                <% const _client = content[_k + '.row_' + _r + '_client']; %>
                <% if ((_action || _client) && ((_action || '') + (_client || '')).trim()) { %>
                <div class="proof-row">
                    <div class="proof-action"><%- _action %></div>
                    <div class="proof-client"><%- _client %></div>
                </div>
                <% } %>
                <% } %>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'contact') { %>
<!-- contact now rendered in footer -->
<% } %>

<% } %>
</div>

<!-- FOOTER / CONTACT -->
<footer id="conversation">
    <div class="footer-contact cms-section" data-section="contact">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="contact" title="Edit section">&#9998;</button><% } %>
        <p class="section-label"><%- content['contact.label'] %></p>
        <h2 class="section-heading"><%- content['contact.heading'] %></h2>
        <p><%- content['contact.body'] %></p>
        <%
          const _rawEmail = (content['contact.email'] || '').trim();
          const _atIdx = _rawEmail.indexOf('@');
          const _eU = _atIdx >= 0 ? _rawEmail.slice(0, _atIdx) : _rawEmail;
          const _eD = _atIdx >= 0 ? _rawEmail.slice(_atIdx + 1) : '';
          const _rawPhone = (content['contact.phone'] || '').trim();
          const _pMid = Math.ceil(_rawPhone.length / 2);
          const _pA = _rawPhone.slice(0, _pMid);
          const _pB = _rawPhone.slice(_pMid);
          const _pDigits = _rawPhone.replace(/[^0-9+]/g, '');
          const _pDigitsMid = Math.ceil(_pDigits.length / 2);
          const _pDigitsA = _pDigits.slice(0, _pDigitsMid);
          const _pDigitsB = _pDigits.slice(_pDigitsMid);
        %>
        <div class="contact-details">
            <a href="#" class="js-email-link" data-u="<%= _eU %>" data-d="<%= _eD %>" rel="nofollow"><%= _eU %> <span aria-hidden="true">[at]</span> <%= _eD %></a>
            <a href="#" class="js-phone-link" data-pa="<%= _pDigitsA %>" data-pb="<%= _pDigitsB %>" rel="nofollow"><%= _pA %><span aria-hidden="true">&#8203;</span><%= _pB %></a>
        </div>
    </div>
    <div class="footer-credit cms-section" data-section="footer">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="footer" title="Edit name">&#9998;</button><% } %>
        <%= content['footer.name'] || '' %>
    </div>
</footer>

<script nonce="<%= nonce %>">
    // Reveal obfuscated email / phone links. Runs before any generic anchor
    // handling below so the mailto:/tel: hrefs are live by the time other
    // listeners attach.
    document.querySelectorAll('.js-email-link').forEach(a => {
        const u = a.dataset.u, d = a.dataset.d;
        if (!u || !d) return;
        const addr = u + '@' + d;
        a.href = 'mailto:' + addr + '?subject=Let%27s%20talk';
        a.textContent = addr;
    });
    document.querySelectorAll('.js-phone-link').forEach(a => {
        const pa = a.dataset.pa || '', pb = a.dataset.pb || '';
        const digits = pa + pb;
        if (!digits) return;
        a.href = 'tel:' + digits;
    });

    // Google Ads conversion: visitor tapped a phone or email link.
    // Runs after the reassembly above so the href prefixes are live.
    document.querySelectorAll('a[href^="tel:"], a[href^="mailto:"]').forEach(a => {
        a.addEventListener('click', () => {
            const kind = a.href.indexOf('tel:') === 0 ? 'phone' : 'email';
            console.log('[Google Ads] conversion fired:', {
                action: 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD',
                trigger: kind + ' link click',
                href: a.href
            });
            if (typeof gtag === 'function') {
                gtag('event', 'conversion', { 'send_to': 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD' });
            } else {
                console.warn('[Google Ads] gtag not loaded — conversion not sent');
            }
        });
    });

    window.addEventListener('scroll', () => {
        document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 20);
    });

    // Hamburger menu toggle
    (function () {
        const btn = document.getElementById('navHamburger');
        const menu = document.getElementById('mobileMenu');
        if (!btn || !menu) return;

        btn.addEventListener('click', () => {
            const open = btn.classList.toggle('open');
            menu.classList.toggle('open', open);
            btn.setAttribute('aria-expanded', open);
            document.body.style.overflow = open ? 'hidden' : '';
        });

        // Close menu when a link is tapped
        menu.querySelectorAll('a').forEach(a => {
            a.addEventListener('click', () => {
                btn.classList.remove('open');
                menu.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
            });
        });
    })();

    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            const target = document.querySelector(a.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.step, .insight-card, .fourcard, .case-phase, .aq, .credential-block').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(16px)';
        el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        observer.observe(el);
    });
</script>

