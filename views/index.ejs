        /* ---- CONTACT (in footer) ---- */

        /* ---- FOOTER ---- */
        footer {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .footer-contact {
            text-align: center;
            max-width: 580px;
            margin: 0 auto;
            padding: 5rem 2rem;
