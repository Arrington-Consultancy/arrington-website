            <% const _hTag = _h1Used ? 'h2' : 'h1'; _h1Used = true; %><<%= _hTag %> class="section-heading"><%- content[_k + '.heading'] %></<%= _hTag %>>
            <% if (_filterIntro) { %><div class="filter-intro"><%- content[_k + '.intro'] %></div><% } %>
            <% if ((content[_k + '.p1'] || '').trim()) { %>
            <div class="filter-body"><%- content[_k + '.p1'] %></div>
            <% } %>
            <% if (_filterItems.length > 0) { %>
            <ul class="filter-list">
                <% _filterItems.forEach(function(_item) { %>
                <li><%- _item %></li>
                <% }); %>
            </ul>
            <% } %>
            <% if ((content[_k + '.row_1_action'] || '').trim()) { %>
            <div class="proofstrip-rows filter-proof-rows">
                <% for (let _r = 1; _r <= 3; _r++) { %>
                <% const _fAction = content[_k + '.row_' + _r + '_action']; %>
                <% const _fClient = content[_k + '.row_' + _r + '_client']; %>
                <% const _fTarget = (caseStudyAnchors || [])[_r - 1]; %>
                <% if ((_fAction || _fClient) && ((_fAction || '') + (_fClient || '')).trim()) { %>
                <% if (_fTarget) { %>
                <a class="proof-row proof-row-link" href="<%= _fTarget %>">
                    <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- PROOF_ICONS[_r - 1] %></svg>
                    <div class="proof-action"><%- _fAction %></div>
                    <div class="proof-client"><%- _fClient %></div>
                </a>
                <% } else { %>
                <div class="proof-row">
                    <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- PROOF_ICONS[_r - 1] %></svg>
                    <div class="proof-action"><%- _fAction %></div>
                    <div class="proof-client"><%- _fClient %></div>
                </div>
                <% } %>
                <% } %>
                <% } %>
            </div>
            <% } else { %>
            <% if ((content[_k + '.p2'] || '').trim()) { %>
            <div class="filter-body"><%- content[_k + '.p2'] %></div>
            <% } %>
            <% } %>
            <% if (_filterClosing) { %><div class="filter-closing"><%- content[_k + '.closing'] %></div><% } %>
            <%
              const _fBtnText = (content[_k + '.button_text'] || '').replace(/<[^>]+>/g, '').trim();
              const _fBtnSlug = (content[_k + '.button_link'] || '').trim();
              // Optional trailing #fragment — see the matching comment on
              // the intervention template's button_link handling above.
              // Allows one optional nested path segment on top of the plain
              // slug pattern, so a filter button can point at a route that is
              // not a `pages` row, e.g. "where-to-start/commercial-review".
              // Without this the value fails validation and _fBtnHref silently
              // falls back to #conversation, which would render a button whose
              // label promises one destination and whose href goes somewhere
              // else. _resolvePageHref already builds the path correctly once
              // the value is allowed through. Scoped to the filter template on
              // purpose; the intervention picker is unchanged.
              const _fValidSlug = /^[a-z0-9]+(?:-[a-z0-9]+)*(?:\/[a-z0-9]+(?:-[a-z0-9]+)*)?(#[a-z0-9_-]+)?$/.test(_fBtnSlug);
              const _fBtnHref = _fBtnSlug === 'main' ? '/' : (_fValidSlug ? _resolvePageHref(_fBtnSlug) : '#conversation');
              const _fIsPrimaryCta = _fBtnSlug === '' || _fBtnSlug === 'book-a-30-minute-conversation';
            %>
            <% if (_fBtnText) { %>
            <a href="<%= _fBtnHref %>" class="btn <%= _fIsPrimaryCta ? 'btn-primary' : 'btn-outline' %>"><%- content[_k + '.button_text'] %></a>
            <% } %>
        </div>
    </div>
</section>
<% } %>

