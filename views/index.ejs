<% if (_tpl === 'documents') { %>
<% const _k = _iid; %>
<%
  // Document links and previews are root-relative paths held in the content
  // table. Validate them at render time (defence-in-depth alongside EJS
  // escaping) so no scheme-bearing or protocol-relative value can reach an
  // href or src. A value that fails simply renders nothing.
  const _docPdf = (p) => /^\/[A-Za-z0-9._\-\/]*\.pdf$/i.test(p || '') && !p.includes('..') ? p : '';
  const _docImg = (p) => /^\/[A-Za-z0-9._\-\/]*\.(jpe?g|png|webp|avif)$/i.test(p || '') && !p.includes('..') ? p : '';
  const _docs = [];
  for (let _n = 1; _n <= 4; _n++) {
    const _title = (content[_k + '.doc_' + _n + '_title'] || '').trim();
    if (!_title) continue;
    _docs.push({
      n: _n,
      title: _title,
      blurb: content[_k + '.doc_' + _n + '_blurb'] || '',
      meta: (content[_k + '.doc_' + _n + '_meta'] || '').replace(/<[^>]+>/g, '').trim(),
      file: _docPdf((content[_k + '.doc_' + _n + '_file'] || '').trim()),
      basename: _docPdf((content[_k + '.doc_' + _n + '_file'] || '').trim()).split('/').pop(),
      image: _docImg((content[_k + '.doc_' + _n + '_image'] || '').trim())
    });
  }
  const _montage = _docs.filter(d => d.image);
%>
<!-- DOCUMENTS -->
<section class="documents<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <div class="documents-header">
            <div class="documents-intro">
                <% if ((content[_k + '.label'] || '').trim()) { %>
                <p class="section-label"><%- content[_k + '.label'] %></p>
                <% } %>
                <h2 class="section-heading"><%- content[_k + '.heading'] %></h2>
                <p class="documents-lede"><%- content[_k + '.intro'] %></p>
            </div>
            <% if (_montage.length > 0) { %>
            <div class="documents-montage" aria-hidden="true">
                <% for (const _d of _montage) { %>
                <img src="<%= _d.image %>" alt="">
                <% } %>
            </div>
            <% } %>
        </div>
        <div class="documents-list">
            <% for (const _d of _docs) { %>
            <article class="document-card<%= _d.image ? '' : ' document-card-noimg' %>">
                <% if (_d.image) { %>
                <img src="<%= _d.image %>" alt="First page of <%= _d.title %>" class="document-thumb" loading="lazy">
                <% } %>
                <div class="document-body">
                    <div class="document-number"><%= String(_d.n).padStart(2, '0') %></div>
                    <h3><%- _d.title %></h3>
                    <p><%- _d.blurb %></p>
                    <% if (_d.meta) { %><p class="document-meta"><%= _d.meta %></p><% } %>
                    <% if (_d.file) { %>
                    <button type="button" class="btn btn-outline js-doc-request" data-doc="<%= _d.basename %>" data-title="<%- _d.title %>">Get the full PDF</button>
                    <% } %>
                </div>
            </article>
            <% } %>
        </div>
    </div>
</section>
<% } %>

