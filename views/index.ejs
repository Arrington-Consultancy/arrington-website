            margin-top: 2.25rem;
        }

        /* ---- PROOF STRIP ---- */
        .proofstrip {
            background: var(--charcoal);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .proofstrip-inner {
            max-width: 1000px;
            margin: 0 auto;
        }

        .proofstrip .section-label {
            text-align: center;
            margin-bottom: 2rem;
        }

        .proofstrip-rows {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            border-top: 1px solid var(--border);
        }

        .proof-row {
            padding: 1.75rem 1.5rem;
            text-align: center;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .proof-row:last-child {
            border-right: 0;
        }

        .proof-row-link {
            color: inherit;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .proof-row-link:hover,
        .proof-row-link:focus-visible {
            background-color: var(--surface-alt, rgba(0, 0, 0, 0.03));
        }

        .proof-icon {
            width: 26px;
            height: 26px;
            color: var(--accent);
            margin: 0 auto;
        }

        .proof-action {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-weight: 500;
            color: var(--accent);
        }

        .proof-client {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
            line-height: 1.3;
        }

        /* ---- ARTICLE (Useful Thinking long-form pieces) ---- */
        .article-back {
            display: inline-block;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            margin-bottom: 1.75rem;
        }

        .article-back:hover,
        .article-back:focus-visible {
            color: var(--accent);
        }

        .article-inner {
            max-width: 640px;
            margin: 0 auto;
        }

        /* Buyer-language standfirst (23/08/2026, approved AI Recommendation
           Visibility test — see db/seed.js for the source instruction).
           Deliberately plain sans-serif at body scale, not the serif
           .section-heading display face, so it reads as a restrained
           subheading under the title rather than a second headline. */
        .article-standfirst {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-top: 0.35rem;
            margin-bottom: 1.5rem;
        }

        .article-image {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 6px;
            margin-top: 1.75rem;
        }

        .article-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            text-align: left;
            margin-top: 1.5rem;
        }

        .article-body p {
            margin: 0 0 1.25rem;
        }

        .article-body p:last-child {
            margin-bottom: 0;
        }

        .article-related {
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .article-related a {
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        /* ---- USEFUL THINKING LIBRARY (editorial index) ---- */
        .utlibrary-inner {
            max-width: 780px;
            margin: 0 auto;
        }

        /* Strengthens "Useful Thinking" as the section's own identity
           (bigger, bolder eyebrow) and steps "That gut feeling is not
           guesswork." down to a clearly supporting line underneath it,
           rather than the dominant headline the generic .section-heading
           treatment gives every other section. Scoped to .utlibrary only,
           doesn't touch the shared .section-label/.section-heading rules
           used elsewhere on the site. */
        .utlibrary .section-label {
            font-size: 0.95rem;
            letter-spacing: 0.1em;
            font-weight: 800;
            margin-bottom: 0.9rem;
        }

        .utlibrary .section-heading {
            font-size: clamp(1.3rem, 2.4vw, 1.7rem);
