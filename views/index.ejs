<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="sPNF5F-T4o7nZq7QWnPfJa3YxSLmRX-7PntiBD5zWZw">
    <title><%= seo.title %></title>
    <% if (seo.description) { %><meta name="description" content="<%= seo.description %>"><% } %>
    <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
    <% if (seo.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <%# ---- Open Graph (Facebook, LinkedIn, etc.) ---- %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= seo.siteName %>">
    <meta property="og:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta property="og:description" content="<%= seo.ogDescription %>"><% } %>
    <meta property="og:url" content="<%= seo.ogUrl %>">
    <% if (seo.ogImage) { %><meta property="og:image" content="<%= seo.ogImage %>"><% } %>
    <%# ---- Twitter card (falls back to the Open Graph values) ---- %>
    <meta name="twitter:card" content="<%= seo.ogImage ? 'summary_large_image' : 'summary' %>">
    <% if (seo.twitterHandle) { %><meta name="twitter:site" content="<%= seo.twitterHandle %>"><% } %>
    <meta name="twitter:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta name="twitter:description" content="<%= seo.ogDescription %>"><% } %>
    <% if (seo.ogImage) { %><meta name="twitter:image" content="<%= seo.ogImage %>"><% } %>
    <%# ---- Structured data (Schema.org). Verified facts only: legal name,
         trading name, company number, phone, email, service area.
         No aggregateRating/Review here: Google's own review-snippet policy
         disqualifies markup where the reviewed entity controls the reviews
         shown about itself on its own site - including via a Google Business
         reviews widget, which is exactly what the reviews section is. That
         data is real (pulled live from Google), but it's not eligible for
         review-snippet structured data on this domain regardless. ---- %>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "name": "Arrington Consultancy",
      "legalName": "Arrington Business Consultancy Ltd",
      "alternateName": "Arrington Business Consultancy Ltd",
      "url": "https://www.arringtonconsultancy.com/",
      "telephone": "+441752477026",
      "email": "tom@arringtonconsultancy.com",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "GB:CompanyNumber",
        "value": "17122684"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Devon" },
        { "@type": "AdministrativeArea", "name": "Cornwall" }
      ],
      "founder": {
        "@type": "Person",
        "name": "Tom Arrington",
        "jobTitle": "Managing Director"
      },
      "sameAs": [
        "https://www.google.com/maps/place/Arrington+Business+Consultancy/data=!4m7!3m6!1s0x68ae21a1b13dfe61:0x1e5cd5fd5fd3d54a!8m2!3d47.73855!4d12.5088275!16s%2Fg%2F11z309prfq!19sChIJYf49saEhrmgRStXTX_3VXB4"
      ]
    }
    </script>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Arrington Consultancy",
      "url": "https://www.arringtonconsultancy.com/"
    }
    </script>
    <% if (currentPage.slug === 'about-us') { %>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Tom Arrington",
      "jobTitle": "Managing Director",
      "worksFor": {
        "@type": "Organization",
        "name": "Arrington Consultancy",
        "url": "https://www.arringtonconsultancy.com/"
      },
      "url": "https://www.arringtonconsultancy.com/about-us"
    }
    </script>
    <% } %>
    <%
      const _schemaPageName = currentPage.slug === 'main' ? 'Home' : (currentPage.title || seo.title || '');
      const _schemaBreadcrumb = {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.arringtonconsultancy.com/' },
          { '@type': 'ListItem', position: 2, name: _schemaPageName, item: seo.canonical }
        ]
      };
      const _schemaServices = {
        'what-we-do': {
          '@context': 'https://schema.org',
          '@type': 'Service',
          name: 'Business consultancy for owner run businesses',
          provider: { '@type': 'Organization', name: 'Arrington Consultancy', url: 'https://www.arringtonconsultancy.com/' },
          areaServed: [{ '@type': 'AdministrativeArea', name: 'Devon' }, { '@type': 'AdministrativeArea', name: 'Cornwall' }],
          url: seo.canonical
        },
        'websites-and-ai': {
          '@context': 'https://schema.org',
          '@type': 'Service',
          name: 'Websites and AI for owner run businesses',
          provider: { '@type': 'Organization', name: 'Arrington Consultancy', url: 'https://www.arringtonconsultancy.com/' },
          areaServed: [{ '@type': 'AdministrativeArea', name: 'Devon' }, { '@type': 'AdministrativeArea', name: 'Cornwall' }],
          offers: { '@type': 'Offer', price: '999', priceCurrency: 'GBP', url: seo.canonical },
          url: seo.canonical
        },
        'business-consultant-devon': {
          '@context': 'https://schema.org',
          '@type': 'Service',
          name: 'Business consultant Devon and Cornwall',
          provider: { '@type': 'Organization', name: 'Arrington Consultancy', url: 'https://www.arringtonconsultancy.com/' },
          areaServed: [{ '@type': 'AdministrativeArea', name: 'Devon' }, { '@type': 'AdministrativeArea', name: 'Cornwall' }],
          url: seo.canonical
        }
      };
      const _schemaExtra = isUsefulThinkingArticle
        ? {
            '@context': 'https://schema.org',
            '@type': 'Article',
            headline: currentPage.title,
            description: seo.description,
            author: { '@type': 'Person', name: 'Tom Arrington' },
            publisher: { '@type': 'Organization', name: 'Arrington Consultancy', url: 'https://www.arringtonconsultancy.com/' },
            mainEntityOfPage: seo.canonical,
            url: seo.canonical
          }
        : _schemaServices[currentPage.slug];
      const _schemaList = currentPage.slug === 'main'
        ? []
        : [_schemaBreadcrumb].concat(_schemaExtra ? [_schemaExtra] : []);
    %>
    <% _schemaList.forEach(function(_schema) { %>
    <script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify(_schema).replace(/</g, '\\u003c') %></script>
    <% }); %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        // GA4 shares the same gtag.js loader as the Ads tag above — no second
        // script tag needed, just a second config call once the property exists.
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% if (user) { %>
    <meta name="page-slug" content="<%= currentPage.slug %>">
    <meta name="page-hidden" content="<%= currentPage.hidden ? 'true' : 'false' %>">
    <meta name="all-pages" content="<%= JSON.stringify(allPages.map(p => ({ slug: p.slug, title: p.title }))) %>">
    <% if (showAdminPanel) { %><link rel="stylesheet" href="/css/admin.css?v=<%= Date.now() %>"><% } %>
    <% if (capabilities.view_csp) { %>
    <script nonce="<%= nonce %>">
        // Capture CSP violations as they happen so the admin menu can show
        // them (registered in <head> so we don't miss any fired during
        // initial page load).
        window.__cspViolations = [];
        document.addEventListener('securitypolicyviolation', function (e) {
            window.__cspViolations.push({
                directive: e.violatedDirective,
                blocked: e.blockedURI || '(inline)',
                source: e.sourceFile || '',
                line: e.lineNumber || 0,
                sample: e.sample || '',
                time: new Date().toISOString()
            });
        });
    </script>
    <% } %>
    <% } %>
    <style nonce="<%= nonce %>">
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>

            /* Height of the fixed header: the 88px nav plus the 37px page
               menu under it. The header takes no space in the flow, so
               anything that must start below it reserves this by hand.
               Standalone pages get the same variable from
               partials/site-chrome-styles.ejs; this file carries its own copy
               of the chrome CSS and does not include that partial, so the
               value is declared in both places and must stay in step. */
            --site-chrome: 125px;
        }

        @media (max-width: 900px) {
            /* The page menu is hidden at this width. */
            :root { --site-chrome: 65px; }
        }

        /* ---- THREE-SURFACE VISUAL SYSTEM (22/08/2026) ----
           Kept in step with the identical block in
           partials/site-chrome-styles.ejs (see the comment there for the
           full rationale) — this file does not include that partial, so
           the rule has to be declared here too. */
        .surface-midnight { background: var(--near-black); }

        .surface-paper {
            background: var(--surface-paper);
            --text: var(--surface-paper-text);
            --text-muted: var(--surface-paper-text-muted);
            --text-bright: var(--surface-paper-text);
            --border: color-mix(in srgb, var(--surface-paper-text) 14%, transparent);
            --near-black: color-mix(in srgb, var(--surface-paper) 92%, black 8%);
            --dark-grey: color-mix(in srgb, var(--surface-paper) 88%, black 12%);
            --charcoal: color-mix(in srgb, var(--surface-paper) 84%, black 16%);
            --mid-grey: color-mix(in srgb, var(--surface-paper) 78%, black 22%);
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background: var(--black);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ---- NAV ---- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            /* Tinted with the theme's own --black rather than plain black,
               so the fixed bar matches the page's actual background colour
               (navy in the Oxford theme) instead of reading as a different,
               blacker colour once scrolled past the hero photo. */
            background: color-mix(in srgb, var(--black) 90%, transparent);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            transition: box-shadow 0.3s;
        }

        nav.scrolled {
            box-shadow: 0 1px 20px rgba(0,0,0,0.5);
        }

        .nav-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 88px;
        }

        .nav-logo {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--text-bright);
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .nav-logo-img {
            width: 200px;
            height: auto;
            display: block;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .nav-cta {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .nav-cta:hover {
            color: var(--text-bright);
        }

        .nav-cta-whatsapp {
            color: #25D366;
        }

        .nav-cta-whatsapp:hover {
            color: #1da851;
        }

        /* ---- HAMBURGER ---- */
        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 110;
        }

        .nav-hamburger span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-bright);
            border-radius: 1px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .nav-hamburger span + span {
            margin-top: 5px;
        }

        .nav-hamburger.open span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-hamburger.open span:nth-child(2) {
            opacity: 0;
        }

        .nav-hamburger.open span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* ---- MOBILE MENU ---- */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 105;
            background: color-mix(in srgb, var(--black) 95%, transparent);
            backdrop-filter: blur(20px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2rem;
        }

        .mobile-menu.open {
            display: flex;
        }

        .mobile-menu a {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-sublink {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-muted);
            opacity: 0.85;
            margin-top: -1.5rem;
        }

        .mobile-menu .mobile-menu-sublink::before {
            content: '\203A';
            margin-right: 0.4rem;
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-divider {
            width: 40px;
            height: 1px;
            background: var(--border);
        }

        .mobile-menu .mobile-menu-cta {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-whatsapp {
            color: #25D366;
        }

        /* ---- HERO ---- */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: var(--black);
            position: relative;
        }

        .hero-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 9.5rem 2rem 6rem;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 4rem;
            align-items: center;
        }

        .hero-text .hero-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            color: var(--text-bright);
            line-height: 1.12;
            margin-bottom: 1.5rem;
        }

        .hero-text .sub {
            font-size: 1.15rem;
            color: var(--text);
            margin-bottom: 2.5rem;
            max-width: 520px;
            line-height: 1.7;
        }

        .hero-text .btn {
            display: inline-flex;
        }

        .hero-label {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 1rem;
        }

        .hero-bullets {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem 1.25rem;
            padding: 0;
            margin: -1.15rem 0 2rem;
            list-style: none;
        }

        .hero-bullets li {
            position: relative;
            padding-left: 1rem;
            color: var(--text);
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .hero-bullets li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.58em;
            width: 0.38rem;
            height: 0.38rem;
            border-radius: 50%;
            background: var(--accent);
        }

        .hero-cta-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem 1.25rem;
        }

        .hero-secondary-link {
            color: var(--accent);
            font-size: 0.92rem;
            font-weight: 700;
            text-decoration: none;
        }

        .hero-secondary-link:hover {
            color: var(--text-bright);
        }

        .hero-proof-link {
            display: inline-block;
            margin: -1.3rem 0 2rem;
            color: var(--accent);
            font-size: 0.95rem;
            font-weight: 700;
            text-decoration: none;
        }

        .hero-proof-link:hover {
            color: var(--text-bright);
        }

        /* Restrained credibility line beneath the CTA (15/08/2026) —
           deliberately no border, background, icon or badge treatment.
           Quieter than the CTA and supporting line, separated by space
           rather than boxed, so it reads as a quiet fact rather than an
           award strip.

           Laid out as flex items rather than one run of text (15/08/2026):
           the credentials were previously joined by " · " in the content
           value, which stranded a separator at the end of a line whenever
           the strip wrapped. The view now splits that same content value
           on the middot and renders each credential as its own nowrap
           item, so the gap does the separating and nothing can dangle.
           The stored content keeps its readable "A · B · C" form for
           whoever edits it in the CMS. */
        .hero-proof-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem 1.4rem;
            margin: 1.05rem 0 0;
            font-size: 0.82rem;
            font-weight: 500;
            letter-spacing: 0.03em;
            color: var(--text);
        }

        .hero-proof-strip span { white-space: nowrap; }

        .hero-photo {
            background: var(--black);
            border: 1px solid var(--border);
            border-radius: 8px;
            aspect-ratio: 3 / 4;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-photo picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        /* ---- FULL-BLEED HERO: image as background, text overlaid, carried
             over from the /homepage-concept design exploration. Scoped to the
             three genuine page-opening heroes (homepage, Business Consultant
             Devon, 30 Minute Conversation). About Us's hero instance sits at
             the BOTTOM of that page as a closing section, not an opening one,
             so it keeps the side-by-side hero-photo layout — full-bleed only
             makes sense as a first impression. ---- */
        .hero[data-section-id="hero"],
        .hero[data-section-id="hero__3"],
        .hero[data-section-id="hero__4"] {
            min-height: 100vh;
            align-items: flex-end;
            overflow: hidden;
        }

        .hero[data-section-id="hero__3"]::after,
        .hero[data-section-id="hero__4"]::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(0deg, rgba(0,10,25,0.94) 0%, rgba(0,10,25,0.55) 42%, rgba(0,10,25,0.15) 68%, rgba(0,10,25,0.35) 100%);
            pointer-events: none;
        }

        /* Homepage hero only (15/08/2026): the shared gradient above dips to
           0.15 opacity around the 68% stop, which is exactly where the
           headline's brightest lines sit against open sky — the weak point
           flagged in the mobile contrast review. Raised and made monotonic
           from 42% to the top so the whole zone behind the headline is
           consistently darker, while the 0%/42% stops (behind the supporting
           line and CTA, already good contrast) are left untouched — tapers
           back to the existing treatment lower down rather than darkening
           the full image. */
        .hero[data-section-id="hero"]::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(0deg, rgba(0,10,25,0.94) 0%, rgba(0,10,25,0.55) 42%, rgba(0,10,25,0.6) 65%, rgba(0,10,25,0.7) 100%);
            pointer-events: none;
        }

        .hero[data-section-id="hero"] .hero-inner,
        .hero[data-section-id="hero__3"] .hero-inner,
        .hero[data-section-id="hero__4"] .hero-inner {
            display: block;
            max-width: none;
            width: 100%;
            padding: 9.5rem 2rem 4.5rem;
        }

        .hero[data-section-id="hero"] .hero-text,
        .hero[data-section-id="hero__3"] .hero-text,
        .hero[data-section-id="hero__4"] .hero-text {
            position: relative;
            z-index: 2;
            max-width: 1100px;
            margin: 0 auto;
        }

        .hero[data-section-id="hero"] .hero-text .sub,
        .hero[data-section-id="hero__3"] .hero-text .sub,
        .hero[data-section-id="hero__4"] .hero-text .sub {
            max-width: 560px;
        }

        .hero[data-section-id="hero"] .hero-photo,
        .hero[data-section-id="hero__3"] .hero-photo,
        .hero[data-section-id="hero__4"] .hero-photo {
            position: absolute;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            max-width: none;
            margin: 0;
            border: none;
            border-radius: 0;
            aspect-ratio: auto;
        }

        .hero[data-section-id="hero"] .hero-photo img { object-position: 60% 40%; }
        .hero[data-section-id="hero__3"] .hero-photo img { object-position: 65% 50%; }
        .hero[data-section-id="hero__4"] .hero-photo img { object-position: 60% 40%; }

        /* Homepage hero only (15/08/2026): bind the supporting sentence,
           CTA and credibility line into one sequence — message, action,
           reassurance — rather than three evenly-spaced slabs. Scoped to
           this instance deliberately: the other heroes carry different
           supporting copy and no credibility line, and shifting their
           rhythm would be an unrelated change. */
        .hero[data-section-id="hero"] .hero-text .sub { margin-bottom: 2rem; }

        /* Continuation cue. The hero deliberately stays full-screen, so
           without this the page reads as complete at the fold. Static and
           low-opacity on purpose — a moving arrow would undercut the tone,
           and nothing here needs the viewer's attention pulled. Hidden by
           default; only the homepage hero shows it. */
        .hero-scroll-cue { display: none; }

        .hero[data-section-id="hero"] .hero-scroll-cue {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 1.25rem;
            z-index: 2;
            display: flex;
            justify-content: center;
            pointer-events: none;
        }

        .hero[data-section-id="hero"] .hero-scroll-cue svg {
            width: 22px;
            height: 22px;
            color: var(--accent);
            opacity: 0.45;
        }

        /* Product Guide teaser (22/08/2026) — deliberately plain: a label,
           a heading, one line of body copy and an outline button, centred,
           on the midnight surface. No card, no icon, no equal-weight
           competition with the hero's own CTA above it. */
        .pg-teaser { padding: 4rem 2rem; }
        .pg-teaser-inner { max-width: 560px; margin: 0 auto; text-align: center; }
        .pg-teaser-label {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }
        .pg-teaser-heading { font-size: clamp(1.5rem, 3.2vw, 1.9rem); margin-bottom: 0.9rem; }
        .pg-teaser-body { font-size: 1.02rem; color: var(--text-muted); margin-bottom: 1.75rem; }

        @media (max-width: 600px) {
            .pg-teaser { padding: 3rem 1.5rem; }
        }

        /* Desktop-only homepage hero refinements (15/08/2026). Deliberately
           a min-width query rather than edits to the base rules: the mobile
           treatment is signed off and must not move, and the base rules are
           what mobile inherits. 901px is the site's existing desktop
           boundary (below it the nav switches to the hamburger), so this
           block and the max-width blocks below can never both apply.
           Type sizes and the button's own padding only — no change to
           margins, hero height, gradient or composition. The tighter
           line-height offsets the larger supporting-copy size so that
           block occupies the same vertical space as before. */
        @media (min-width: 901px) {
            .hero[data-section-id="hero"] .hero-text .sub {
                font-size: 1.22rem;
                line-height: 1.62;
                max-width: 620px;
            }

            .hero[data-section-id="hero"] .hero-cta-row .btn-primary {
                padding: 1.05rem 2.7rem;
                font-size: 0.98rem;
                letter-spacing: 0.03em;
            }

            .hero[data-section-id="hero"] .hero-proof-strip {
                font-size: 0.95rem;
                gap: 0.4rem 2.4rem;
            }
        }

        @media (max-width: 700px) {
            .hero[data-section-id="hero"],
            .hero[data-section-id="hero__3"],
            .hero[data-section-id="hero__4"] { min-height: 92vh; }
            .hero[data-section-id="hero"] .hero-photo img { object-position: 70% 45%; }
            .hero[data-section-id="hero__3"] .hero-photo img { object-position: 75% 50%; }
            .hero[data-section-id="hero__4"] .hero-photo img { object-position: 70% 45%; }
            .hero[data-section-id="hero"] .hero-inner,
            .hero[data-section-id="hero__3"] .hero-inner,
            .hero[data-section-id="hero__4"] .hero-inner { padding: 6.5rem 1.25rem 3.5rem; }
        }

        /* ---- BUTTONS ---- */
        .btn {
            align-items: center;
            padding: 0.9rem 2.2rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            font-family: inherit;
            letter-spacing: 0.02em;
        }

        .btn-primary {
            background: var(--accent);
            color: var(--black);
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-bright);
            border: 1px solid var(--accent);
        }

        .btn-outline:hover {
            border-color: var(--accent);
        }

        .btn-whatsapp {
            background: #3d6b52;
            color: #fff;
        }

        .btn-whatsapp:hover {
            background: #2f5540;
        }

        .hero-cta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        /* ---- SECTIONS ---- */
        section {
            padding: 6rem 2rem;
        }

        .section-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.7rem, 3vw, 2.2rem);
            color: var(--text-bright);
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .section-sub {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 600px;
            line-height: 1.75;
        }

        .evidence-intro {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 640px;
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        /* ---- STAT CALLOUT ---- */
        .stat-callout {
            display: inline-flex;
            align-items: baseline;
            gap: 0.85rem;
            margin: 1.25rem 0 1.75rem;
            padding: 0.9rem 1.35rem;
            background: color-mix(in srgb, var(--accent) 10%, transparent);
            border-left: 2px solid var(--accent);
            border-radius: 3px;
        }

        .stat-callout .stat-num {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent);
            line-height: 1.2;
            white-space: nowrap;
        }

        .stat-callout .stat-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text);
            line-height: 1.4;
            max-width: 260px;
        }

        @media (max-width: 640px) {
            .stat-callout {
                display: flex;
            }
            .stat-callout .stat-num {
                white-space: normal;
            }
        }

        /* ---- PULL QUOTE ---- */
        .intervention-quote-mark {
            font-family: 'DM Serif Display', serif;
            font-size: 3rem;
            color: var(--accent);
            line-height: 0.4;
            display: block;
            margin-bottom: 0.75rem;
        }

        .intervention-quote-text {
            font-family: 'DM Serif Display', serif;
            font-style: italic;
            font-size: 1.4rem;
            color: var(--text-bright);
            line-height: 1.5;
            margin-bottom: 1rem;
        }

        .intervention-quote-attribution-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .intervention-quote-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        .intervention-quote-attribution {
            font-size: 0.95rem;
            color: var(--text);
        }

        .intervention-google-rating {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.88rem;
            color: var(--text-muted);
            text-decoration: none;
        }

        .intervention-google-rating:hover {
            color: var(--text-bright);
        }

        .intervention-google-rating-stars {
            color: var(--accent);
            font-size: 0.85rem;
            letter-spacing: 0.05em;
        }

        /* ---- DIVIDER ---- */
        .divider {
            max-width: 1100px;
            margin: 0 auto;
            height: 1px;
            background: var(--border);
        }

        /* ---- CREDENTIALS ---- */
        .credentials {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .credentials-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .credential-block {
            padding: 2.5rem 0;
            text-align: center;
        }

        .credential-badge-wrap {
            position: relative;
            display: inline-block;
            margin-bottom: 1.25rem;
        }

        .credential-badge {
            width: 200px;
            height: auto;
            display: block;
            border-radius: 4px;
        }

        .credential-block h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.5rem;
        }

        .credential-block p {
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.7;
        }

        .credential-stat {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 2.3rem;
            letter-spacing: -0.01em;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        /* ---- PROBLEM ---- */
        .problem {
            background: var(--black);
        }

        .problem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3rem;
            align-items: start;
        }

        .problem-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .problem-list li {
            font-size: 1rem;
            color: var(--text);
            padding-left: 1.5rem;
            position: relative;
            line-height: 1.6;
        }

        .problem-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55rem;
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

        .problem-right p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
        }

        .problem-right p strong {
            color: var(--text-bright);
        }

        /* ---- APPROACH ---- */
        .approach {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .approach-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .step {
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .step-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .step h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
        }

        .step p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* ---- INSIGHTS ---- */
        .insights {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .insights-header {
            margin-bottom: 3rem;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
        }

        /* De-boxed to match the fourcards treatment: a top border only,
           not a filled card — this section already sits inside its own
           distinct background band, so a card-within-a-card read as
           doubled-up boxing. */
        /* Made a whole-card destination 16/08/2026. Previously only the small
           title text was clickable, so three routes read as three more blocks
           of body copy. The click target is stretched from the existing title
           anchor with a pseudo-element rather than by wrapping the card in an
           <a>: one real anchor, correct semantics for screen readers, no
           markup restructure. */
        .insight-card {
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
            position: relative;
            transition: border-color 0.2s;
        }

        .insight-card:hover,
        .insight-card:focus-within {
            border-top-color: var(--accent);
            cursor: pointer;
        }

        .insight-card h3 a::after {
            content: '';
            position: absolute;
            inset: 0;
        }

        /* Optional per-card image. Renders nothing when the field is empty, so
           a card without artwork is a deliberate state rather than a gap.
           object-position: top because both real assets here (a document's
           first page, a website homepage) carry their identity at the top;
           a centred cover crop lands mid-page and reads as grey texture. */
        .insight-image {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            object-position: top;
            border: 1px solid var(--border);
            border-radius: 4px;
            margin-bottom: 1.25rem;
            opacity: 0.85;
            transition: opacity 0.2s;
        }

        /* When some cards in a row have artwork and others do not, the
           imageless card's text would start higher and the row reads as
           broken rather than as a deliberate choice. This reserves the same
           vertical slot with nothing in it: transparent, so it is whitespace
           on the section background, and the three text blocks line up. */
        .insight-image-spacer {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            margin-bottom: 1.25rem;
        }

        @media (max-width: 900px) {
            /* Stacked, so there is no row to align to and the empty slot
               would just be dead space. */
            .insight-image-spacer { display: none; }
        }

        .insight-card:hover .insight-image,
        .insight-card:focus-within .insight-image {
            opacity: 1;
        }

        /* Arrow affordance. Kept in the markup as a span so it can move
           independently of the title text. */
        .insight-arrow {
            display: inline-block;
            margin-left: 0.35rem;
            color: var(--accent);
            transition: transform 0.2s;
        }

        .insight-card:hover .insight-arrow,
        .insight-card:focus-within .insight-arrow {
            transform: translateX(4px);
        }

        /* The stretched anchor has no box of its own, so the browser's default
           focus ring would be invisible. Put it on the card instead. */
        .insight-card h3 a:focus-visible {
            outline: none;
        }

        .insight-card:focus-within {
            outline: 2px solid var(--accent);
            outline-offset: 6px;
        }

        /* Scoped to .insight-card so it outranks the `.insight-card p` body
           rule below. .insight-tag is itself a <p> inside that card, so the
           class-plus-element selector was winning and every insights tag on
           the site rendered in body grey instead of accent gold. Same
           specificity trap that rendered the offerpair prices at body size. */
        .insight-card .insight-tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .insight-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.35;
        }

        .insight-card p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .insight-card a {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .insight-card a:hover {
            color: var(--text-bright);
        }

        /* A linked card title keeps the heading's own typography (serif,
           size, bright colour) rather than the smaller accent-coloured
           style above, which is meant for a separate "read more"-style
           link, not the heading itself. */
        .insight-card h3 a {
            color: inherit;
            font-size: inherit;
            font-weight: inherit;
            text-decoration: none;
        }

        .insight-card h3 a:hover {
            color: var(--accent);
        }

        @media (max-width: 900px) {
            .insights-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- FOUR CARDS ---- */
        .fourcards {
            background: var(--black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .fourcards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2.5rem;
            margin-top: 3rem;
        }

        /* De-boxed to match the editorial, fewer-containers treatment used
           elsewhere (credentials, proof strip): a top border only, not a
           filled card around each item — the numbering and typography carry
           the separation instead of a background/border box. */
        .fourcard {
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
        }

        .fourcard-header {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 1rem;
        }

        .fourcard-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        .fourcard-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
        }

        .fourcard h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .fourcard p {
            font-size: 0.88rem;
            color: var(--text);
            line-height: 1.7;
        }

        .fourcard-link {
            display: inline-block;
            margin-top: 0.9rem;
            font-size: 0.82rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .fourcard-link:hover {
            color: var(--text-bright);
        }

        /* ---- GOOGLE REVIEWS ---- */
        .google-reviews-summary {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin: 1rem 0 2.5rem;
        }

        .google-reviews-stars {
            font-size: 1.3rem;
            color: var(--accent);
            letter-spacing: 0.1rem;
        }

        .google-reviews-score {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
        }

        .google-reviews-count {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .google-reviews-count a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .google-reviews-count a:hover {
            color: var(--text-bright);
        }

        .google-reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .google-review-card {
            padding: 1.5rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .google-review-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.85rem;
        }

        .google-review-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .google-review-author {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-bright);
            margin-bottom: 0.15rem;
        }

        .google-review-stars {
            font-size: 0.85rem;
            color: var(--accent);
        }

        .google-review-text {
            font-size: 0.88rem;
            color: var(--text);
            line-height: 1.65;
            display: -webkit-box;
            -webkit-line-clamp: 6;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .google-review-time {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 0.75rem;
        }

        @media (max-width: 900px) {
            .fourcards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .fourcards-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- WHAT WE DO PAGE SCOPE ----
           Everything here is scoped to .page-what-we-do so the shared
           fourcards and intervention templates keep their existing appearance
           on Websites and AI and everywhere else. */

        /* Four commercial questions, 2x2 rather than 4-across. At the 1100px
           container, four columns give each question 245px and two of the four
           wrap onto two lines. 2x2 gives ~525px and all four fit on one line. */
        @media (min-width: 901px) {
            .page-what-we-do .fourcards-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 3rem 4rem;
            }
        }

        /* The numerals were 2rem at opacity 0.4, which on this navy reads as
           barely there. Full-strength accent at a larger size, with the muting
           done by weight and letterform rather than transparency. */
        /* The numeral rules that used to live here are gone with the numerals
           themselves. 01-04 read as a sequence, which made four things we
           happen to look at look like a four-step method. The cards now carry
           a name instead, and the card header is skipped entirely when a card
           has no number, so nothing is left holding its space. */

        /* Six months on: supporting information, not another chapter. A thin
           band, at body scale, instead of a full section with a centred
           display heading.
           Scoped to .page-what-we-do .intervention rather than a modifier
           class because after this rebuild the six-months block is the only
           intervention left on the page. If a second one is ever added here it
           will inherit this treatment, which is the trade for not adding a
           template field nobody else would use. */
        /* The height comes from the global `section { padding: 6rem 2rem }`,
           so the strip has to reduce that, not just the inner block. */
        /* Desktop QC (22/08/2026): this band previously ran left-aligned with
           a left accent rule at 900px, sitting directly above the footer's
           contact block, which is centred at 580px (.footer-contact). The two
           read as different content systems rather than one page. Dropped
           the left-rail treatment and matched the footer's own column width
           so heading, body and the form below all share one centre line -
           see the matching .page-book-a-30-minute-conversation rule below,
           which applies the same width to that page's equivalent closing
           sections rather than inventing a second fix. */
        .page-what-we-do .intervention {
            padding-top: 2.5rem;
            padding-bottom: 2.5rem;
        }

        .page-what-we-do .intervention .section-inner {
            max-width: 580px;
        }

        .page-what-we-do .intervention .section-heading {
            font-size: 1.15rem;
            margin-bottom: 0.6rem;
        }

        .page-what-we-do .intervention .intervention-body {
            font-size: 0.95rem;
        }

        /* Offers: a little more air between the two on mobile so they do not
           blur into one list, and the price bound more tightly to its name. */
        @media (max-width: 700px) {
            .page-what-we-do .offerpair-grid { gap: 3rem; }
        }

        .page-what-we-do .offer-item .offer-price { margin-bottom: 0.35rem; }

        /* ---- 30 MINUTE CONVERSATION PAGE SCOPE (desktop QC, 22/08/2026) ----
           This page's closing sections ("Not sure yet?", "Want proof first?")
           sit directly above the global footer contact block, which is
           centred at 580px (.footer-contact). Both templates default to a
           wider centred column (.filter-inner 680px, .intervention
           .section-inner 760px), so the closing run of sections did not
           share the footer's column edges even though each block was itself
           centred on the page. Narrowed both to the footer's own width, the
           same fix and the same number used on What We Do's equivalent
           closing band above, rather than a second bespoke treatment. */
        .page-book-a-30-minute-conversation .filter-inner,
        .page-book-a-30-minute-conversation .intervention .section-inner {
            max-width: 580px;
        }

        /* ---- HERO MONTAGE ----
           Opening treatment for What We Do (16/08/2026). The page describes a
           commercial review; what a commercial review produces is the four
           documents already published, redacted, on Evidence. Showing the real
           output beats another photograph of Tom, and needs no new asset.

           Built as its own template rather than bending `intervention`,
           because that template has no image slot and forcing one in is what
           produced the empty-slot problems elsewhere in this stylesheet.

           Grid areas rather than nesting, so mobile can put the montage
           between the opening line and the rest of the copy while desktop
           keeps it in a column of its own. */
        .heromontage {
            background: var(--dark-grey);
        }

        .hm-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-areas:
                "heading montage"
                "intro   montage"
                "body    montage";
            grid-template-rows: auto auto 1fr;
            gap: 0 4rem;
            align-items: start;
        }

        .hm-heading { grid-area: heading; margin-bottom: 1.75rem; }
        .hm-intro   { grid-area: intro; }
        .hm-body    { grid-area: body; }
        .hm-montage { grid-area: montage; }

        .hm-intro,
        .hm-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.8;
            max-width: 620px;
        }

        .hm-intro { margin-bottom: 1.6rem; }

        /* Same fanned-sheet device as the documents montage on Evidence:
           absolute sheets, rotation increasing outward, shadow for depth. */
        /* Height is a ratio of the container width, not a fixed pixel value:
           the sheets are absolutely positioned and sized as a percentage of
           this box, so a fixed height stops matching them the moment the
           viewport changes and they spill over whatever follows. Sized for
           the tallest asset (a portrait A4 first page, ratio 1.414) plus the
           rotation and offset the fan applies. */
        .hm-montage {
            position: relative;
            aspect-ratio: 100 / 66;
        }

        .hm-montage img {
            position: absolute;
            top: 0;
            width: 42%;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 42px rgba(0,0,0,0.55);
            background: var(--charcoal);
        }

        .hm-montage img:nth-child(1) { left: 0;   z-index: 1; transform: rotate(-7deg)   translateY(16px); }
        .hm-montage img:nth-child(2) { left: 18%; z-index: 2; transform: rotate(-2.5deg) translateY(4px); }
        .hm-montage img:nth-child(3) { left: 36%; z-index: 3; transform: rotate(2.5deg)  translateY(4px); }
        .hm-montage img:nth-child(4) { left: 54%; z-index: 4; transform: rotate(7deg)    translateY(16px); }

        .heromontage .cms-edit-btn,
        .heromontage .cms-move-btn {
            z-index: 5;
            background: rgba(10,10,10,0.8);
        }

        @media (max-width: 900px) {
            .hm-grid {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "heading"
                    "intro"
                    "montage"
                    "body";
                gap: 0;
            }

            /* Capped because the sheets are sized as a percentage of this
               box: single-column at tablet width it would otherwise grow to
               most of the screen. */
            .hm-montage {
                aspect-ratio: 100 / 72;
                max-width: 460px;
                margin: 0.5rem 0 2rem;
            }

            .hm-montage img { width: 44%; }

            .hm-intro,
            .hm-body { font-size: 1rem; }
        }

        /* Final mobile trim for What We Do (16/08/2026): the opening was still
           taking too long to clear on a 390px viewport even after the montage
           pass. Keep the approved heading and copy; only tighten the phone
           spacing and the montage's reserved height on this page. */
        @media (max-width: 480px) {
            .page-what-we-do .heromontage {
                padding-top: 4rem;
                padding-bottom: 3.75rem;
            }

            .page-what-we-do .hm-heading {
                margin-bottom: 1.25rem;
            }

            .page-what-we-do .hm-intro,
            .page-what-we-do .hm-body {
                font-size: 0.98rem;
                line-height: 1.72;
            }

            .page-what-we-do .hm-intro {
                margin-bottom: 1rem;
            }

            /* The montage is shortened by shrinking the sheets, not by
               shrinking the box. The sheets are absolutely positioned and
               sized as a percentage of this container, so cutting the
               container's height alone does not move them: they keep their
               size and spill out of the bottom onto the body copy below.
               Narrower sheets, with the fan's offsets rescaled so the group
               still spans the full width, and a ratio that contains them. */
            .page-what-we-do .hm-montage {
                aspect-ratio: 100 / 58;
                max-width: 390px;
                margin: 0.25rem 0 1.4rem;
            }

            .page-what-we-do .hm-montage img { width: 34%; }

            .page-what-we-do .hm-montage img:nth-child(1) { left: 0; }
            .page-what-we-do .hm-montage img:nth-child(2) { left: 21%; }
            .page-what-we-do .hm-montage img:nth-child(3) { left: 43%; }
            .page-what-we-do .hm-montage img:nth-child(4) { left: 64%; }
        }

        /* ---- OFFER PAIR ----
           Two priced options side by side, built 16/08/2026 for What We Do.
           No existing template could carry this: assessment renders six boxes
           unconditionally, insights three and fourcards four, so all would show
           empty slots for a two-item comparison, credentials has the Oxford
           badge hardcoded, and biography cannot style a price because content
           sanitisation strips class attributes.

           Deliberately in the same de-boxed language as fourcards, insights and
           the Where to Start offer rows: a top hairline, no filled card, with
           the price carrying the weight. Both columns are styled identically so
           neither option can read as the lesser one. */
        /* --near-black, the same section tone as insights, assessment and
           credentials. Deliberately not --charcoal: nothing else on the site
           uses that as a full-section background, and this block should sit
           inside the established rhythm rather than introduce a new tone. */
        .offerpair {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .offerpair-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
            margin-top: 3rem;
        }

        .offer-item {
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
        }

        /* Scoped to .offer-item so it outranks the `.offer-item p` body rule
           below, which is a class-plus-element selector and would otherwise
           win and render the price at body size in body grey. */
        .offer-item .offer-price {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 2.3rem;
            letter-spacing: -0.01em;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.6rem;
        }

        .offer-item h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--text-bright);
            line-height: 1.35;
            margin-bottom: 0.85rem;
        }

        .offer-item p {
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* Identical treatment on both offers, deliberately: neither route may
           read as the dominant one. display:flex so the button sizes to its
           own text rather than filling the column. */
        .offer-item .offer-btn {
            display: inline-flex;
            margin-top: 1.6rem;
        }

        .offerpair-note {
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        .offerpair .btn {
            display: inline-flex;
            margin-top: 2rem;
        }

        @media (max-width: 700px) {
            .offerpair-grid {
                grid-template-columns: 1fr;
                gap: 2.25rem;
                margin-top: 2.25rem;
            }
        }

        /* ---- DOCUMENTS ---- */
        /* Evidence visual pass (22/08/2026): the documents template shows
           real client PDF pages, so it is the most literal fit in the
           whole site for the warm-paper surface — genuine document pages,
           on something that reads like paper. .surface-paper is added on
           the section tag itself (see the template above); this rule pins
           the true paper tone rather than the darker near-black-derived
           shade .surface-paper's own override would otherwise produce here
           (that mixed shade is still used correctly by nested elements
           like the montage image background below). */
        .documents.surface-paper {
            background: var(--surface-paper);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .documents-header {
            display: grid;
            grid-template-columns: 1fr 0.8fr;
            gap: 4rem;
            align-items: center;
        }

        .documents-lede {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.8;
            max-width: 34rem;
            margin-top: 1.5rem;
        }

        /* Fanned montage of the document covers. Sheets are positioned by
           nth-child so the markup stays a plain list of images (no inline
           style attributes, which the strict CSP would block). */
        .documents-montage {
            position: relative;
            height: 290px;
        }

        .documents-montage img {
            position: absolute;
            top: 0;
            width: 40%;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 42px rgba(0,0,0,0.55);
            background: var(--charcoal);
        }

        .documents-montage img:nth-child(1) { left: 0;   z-index: 1; transform: rotate(-7deg)   translateY(16px); }
        .documents-montage img:nth-child(2) { left: 19%; z-index: 2; transform: rotate(-2.5deg) translateY(4px); }
        .documents-montage img:nth-child(3) { left: 38%; z-index: 3; transform: rotate(2.5deg)  translateY(4px); }
        .documents-montage img:nth-child(4) { left: 57%; z-index: 4; transform: rotate(7deg)    translateY(16px); }

        /* The montage sheets are stacked with z-index, so lift the CMS
           controls above them or the edit/move buttons sit underneath. The
           solid backing keeps them legible where they overlap a white page. */
        .documents .cms-edit-btn,
        .documents .cms-move-btn {
            z-index: 5;
            background: rgba(10,10,10,0.8);
        }

        .documents-list {
            margin-top: 4.5rem;
            display: flex;
            flex-direction: column;
            gap: 3.5rem;
        }

        /* De-boxed to match fourcards/insight-cards: a top border only, not
           a filled card — the document thumbnail's own drop shadow already
           gives it plenty of visual weight against the flat page. */
        .document-card {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 2.5rem;
            align-items: start;
            padding-top: 2.5rem;
            border-top: 1px solid var(--border);
        }

        .documents-list .document-card:first-child {
            padding-top: 0;
            border-top: none;
        }

        /* One dominant evidence asset, smaller supporting ones after it
           (22/08/2026 evidence visual pass) — the first document's preview
           reads meaningfully larger than the rest, rather than four
           equal-weight thumbnails. */
        .documents-list .document-card:first-child {
            grid-template-columns: 320px 1fr;
        }
        .documents-list .document-card:first-child .document-thumb {
            box-shadow: 0 16px 36px rgba(0,0,0,0.22);
        }

        /* A document with no preview image set gets the full card width. */
        .document-card-noimg {
            grid-template-columns: 1fr;
        }

        .document-thumb {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 26px rgba(0,0,0,0.45);
        }

        .document-number {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 0.6rem;
        }

        .document-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
            line-height: 1.3;
            margin-bottom: 0.85rem;
        }

        .document-card p {
            font-size: 0.93rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
            max-width: 40rem;
        }

        .document-meta {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .document-card .btn {
            display: inline-block;
            padding: 0.7rem 1.6rem;
            font-size: 0.85rem;
        }

        @media (max-width: 900px) {
            .documents-header {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .documents-montage {
                height: 200px;
                max-width: 420px;
            }

            .documents-list {
                margin-top: 3rem;
            }

            .document-card {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                padding-top: 1.75rem;
            }

            .documents-list .document-card:first-child {
                padding-top: 0;
                grid-template-columns: 1fr;
            }

            .document-thumb {
                max-width: 200px;
            }
        }

        /* ---- CASE STUDY ---- */
        .case-study {
            background: var(--black);
        }

        .case-inner {
            max-width: 800px;
        }

        .case-photo {
            aspect-ratio: 3 / 2;
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            margin: 1.75rem 0;
        }

        .case-photo picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .case-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .case-timeline {
            margin-top: 3rem;
            position: relative;
            padding-left: 1.75rem;
        }

        .case-timeline::before {
            content: '';
            position: absolute;
            left: 4px;
            top: 6px;
            bottom: 6px;
            width: 1px;
            background: var(--border);
        }

        .case-phase {
            position: relative;
            padding-bottom: 2.5rem;
        }

        .case-phase:last-child {
            padding-bottom: 0;
        }

        .case-phase::before {
            content: '';
            position: absolute;
            left: -1.75rem;
            top: 0.35rem;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--accent);
        }

        .phase-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.6rem;
        }

        .phase-content p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .phase-content p strong {
            color: var(--text-bright);
        }

        .phase-capstone {
            display: block;
            margin-top: 0.85rem;
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
        }

        /* ---- CASE STUDY 2 (TRISTAN) ---- */
        .casestudy2 {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .casestudy2-inner {
            /* Widened from 760px (22/08/2026 evidence visual pass) so the
               real project screenshots below have genuine room to be
               inspected — still a comfortable prose reading width, just no
               longer needlessly capping the one thing on this template
               that benefits from being larger. */
            max-width: 860px;
        }

        .casestudy2-intro {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.15rem, 2vw, 1.35rem);
            color: var(--text-bright);
            line-height: 1.55;
            margin-top: 2rem;
            margin-bottom: 2.5rem;
        }

        .casestudy2-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 2rem;
        }

        .casestudy2-outcome {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1.5rem 1.75rem;
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .casestudy2-outcome strong {
            color: var(--text-bright);
        }

        .casestudy2-included-heading {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
            margin: 0 0 1rem;
        }

        .casestudy2-list,
        .filter-list {
            display: grid;
            gap: 0.75rem;
            margin: 0 0 2rem;
            padding: 0;
            list-style: none;
            text-align: left;
        }

        .casestudy2-list li,
        .filter-list li {
            position: relative;
            padding-left: 1.35rem;
            color: var(--text);
            font-size: 1rem;
            line-height: 1.55;
        }

        .casestudy2-list li::before,
        .filter-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.72em;
            width: 0.42rem;
            height: 0.42rem;
            border-radius: 50%;
            background: var(--accent);
        }

        .casestudy2 .btn {
            display: inline-flex;
            margin-top: 2rem;
            max-width: 100%;
            white-space: normal;
            overflow-wrap: break-word;
            text-align: center;
            justify-content: center;
            height: auto;
            min-height: 3rem;
            box-sizing: border-box;
        }

        .cs2-screenshots {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin: 2rem 0 2.25rem;
        }

        .cs2-screenshots:empty,
        .cs2-screenshots.cs2-screenshots--empty {
            display: none;
        }

        .cs2-screenshots.cs2-screenshots--single {
            grid-template-columns: 1fr;
        }

        .cs2-screenshots.cs2-screenshots--pair {
            grid-template-columns: repeat(2, 1fr);
        }

        .cs2-screenshot {
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--charcoal);
            position: relative;
            /* Restrained case-file framing (22/08/2026 evidence visual
               pass): a thin warm-paper mat around each real screenshot,
               like a photo mounted in a folder, rather than the image
               sitting flush against the section background. */
            padding: 0.6rem;
            background-color: var(--surface-paper);
        }

        .cs2-screenshots:not(.cs2-screenshots--single):not(.cs2-screenshots--pair) .cs2-screenshot:first-child {
            grid-column: span 2;
            grid-row: span 2;
        }

        .cs2-screenshot img {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 2px;
        }

        .cs2-screenshot.cs2-screenshot--empty {
            display: none;
        }

        @media (max-width: 900px) {
            .cs2-screenshots {
                grid-template-columns: 1fr;
            }
        }


        .assessment {
            background: var(--near-black);
            border-top: 1px solid var(--border);
        }

        .assessment-inner {
            text-align: center;
            max-width: 680px;
            margin: 0 auto;
        }

        .assessment .section-heading {
            margin-bottom: 1.5rem;
        }

        .assessment p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        .assessment-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .assessment-questions {
            text-align: left;
            margin: 2.5rem 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
