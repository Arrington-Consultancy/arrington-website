            .lead-row {
                grid-template-columns: 1fr;
            }
        }

        /* ---- GATED PDF DOWNLOAD MODAL ---- */
        .doc-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(6px);
            z-index: 200;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .doc-modal-overlay.open {
            display: flex;
        }

        .doc-modal {
            position: relative;
            background: var(--dark-grey);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;
        }

        .doc-modal h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            margin-bottom: 0.6rem;
            color: var(--text-bright);
        }

        .doc-modal p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .doc-modal input {
            width: 100%;
            background: var(--charcoal);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.8rem 1rem;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-bright);
            margin-bottom: 1rem;
        }

        .doc-modal input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .doc-modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1rem;
            cursor: pointer;
        }

        .doc-modal-close:hover {
            color: var(--text-bright);
        }

        .footer-credit {
            position: relative;
            text-align: center;
            padding: 1.5rem 2rem 2.25rem;
            font-size: 0.78rem;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .footer-links {
            text-align: center;
            padding: 0 2rem;
        }

        .footer-links a {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }

        .footer-links a:hover {
            color: var(--text-bright);
            border-bottom-color: var(--text-bright);
        }

        /* ---- PAGE MENU ---- */
        .page-menu {
            position: fixed;
            top: 88px;
            left: 0;
            right: 0;
            z-index: 99;
            background: color-mix(in srgb, var(--black) 75%, transparent);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .page-menu-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            gap: 1.25rem;
            height: 36px;
            align-items: center;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
        }

        .page-menu-inner::-webkit-scrollbar {
            display: none;
        }

        .page-menu-link {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            letter-spacing: 0.03em;
            padding: 0.35rem 0;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
            flex-shrink: 0;
            transition: color 0.2s, border-color 0.2s;
        }

        .page-menu-link:hover {
            color: var(--text-bright);
        }

        .page-menu-link.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .page-menu-link.page-menu-hidden {
            opacity: 0.4;
            font-style: italic;
        }

        .page-menu-link-child {
            font-size: 0.72rem;
            color: var(--text-muted);
            opacity: 0.85;
            margin-left: -0.5rem;
        }

        .page-menu-link-child::before {
            content: '\203A';
            margin-right: 0.35rem;
            color: var(--accent);
        }

        /* ---- FIRST-SECTION NAV CLEARANCE ----
           Was a flat 8.5rem (136px) against a 125px header, so the first
           heading on every CMS page cleared the page-menu bar by 11px, which
           reads as content jammed under the header rather than as a page
           starting. Derived from --site-chrome now so it tracks the header. */
        #cms-sections > section:first-child:not(.hero) {
            padding-top: calc(var(--site-chrome) + 3rem);
        }

        /* ---- MOBILE ---- */
        @media (max-width: 900px) {
            .nav-hamburger {
                display: block;
            }

            .nav-actions {
                display: none;
            }

            .page-menu {
                display: none;
            }

            .nav-logo-img {
                width: 140px;
            }

            .nav-inner {
                height: 64px;
            }

            .hero-inner {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                padding-top: 6rem;
            }

            .hero-photo {
                max-width: 300px;
                margin: 0 auto;
            }

            .credentials-inner {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .credential-block {
                padding: 1.5rem 0;
            }

            .credential-block + .credential-block {
                border-top: 1px solid var(--border);
            }

            .problem-grid {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .approach-steps {
                grid-template-columns: 1fr;
            }

            .case-timeline {
                padding-left: 1.4rem;
            }

            .case-phase::before {
                left: -1.4rem;
            }

            .footer-contact .contact-details {
                flex-direction: column;
                gap: 1rem;
            }

            .proofstrip-rows {
                grid-template-columns: 1fr;
            }

            .proof-row {
                border-right: 0;
                border-bottom: 1px solid var(--border);
            }

            .proof-row:last-child {
                border-bottom: 0;
            }

            #cms-sections > section:first-child:not(.hero) {
                padding-top: 8rem;
            }
        }

        @media (max-width: 600px) {
            section {
                padding: 4rem 1.25rem;
            }

            .hero-inner {
                padding: 5.5rem 1.25rem 3.5rem;
            }

            .hero-text .hero-heading {
                font-size: 1.85rem;
            }

            .hero-text .sub {
                font-size: 1rem;
            }

            /* Homepage hero only: at 1rem this sentence wrapped to four
               lines on a 390px screen and dropped "owner." alone onto the
               last one. Half a step down lands it on three balanced lines;
               text-wrap: pretty guards the rag where the browser supports
               it, and is harmlessly ignored where it does not. */
            .hero[data-section-id="hero"] .hero-text .sub {
                font-size: 0.95rem;
                text-wrap: pretty;
            }

            .hero-bullets {
                flex-direction: column;
                gap: 0.65rem;
            }

            .hero-cta-row {
                align-items: stretch;
                flex-direction: column;
            }

            .section-heading {
                font-size: 1.5rem;
            }

            .step {
                padding: 1.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
                text-align: center;
            }

            .casestudy2 .btn {
                width: 100%;
            }
        }
    </style>
</head>
<%# Page-scoping hook (16/08/2026). Templates are shared across pages, so
    per-page styling needs something to scope against and there was nothing.
    Scoping by section instance ID instead would break the moment a section is
    deleted and re-added, since the ID changes. Slug is already validated as
    lowercase-and-hyphens before it reaches a route, so it is safe in a class. %>
<body class="page-<%= currentPage.slug %>">

<%- include('partials/site-header', { currentPage, navPages, canEdit, content, pageContact }) %>


<%
  // Three line icons for the proof-strip rows (built/exited, turnaround,
  // improved margin). Hand-drawn paths, single stroke weight, no fill -
  // they inherit colour from .proof-icon via currentColor.
  const PROOF_ICONS = [
    '<path d="M7 17L17 7"/><path d="M9 7h8v8"/>',
    '<path d="M4 12a8 8 0 1 0 8-8"/><path d="M4 12l4-4M4 12l4 4"/>',
    '<path d="M5 19V13"/><path d="M12 19V9"/><path d="M19 19V5"/>'
  ];
  // Every page must have exactly one H1. hero renders a real <h1> itself and
  // flips this flag; every other template's main heading promotes to <h1>
  // only if nothing has claimed it yet on this page, then falls back to <h2>
  // for every subsequent heading - so page order determines which section's
  // heading becomes the H1, and it's never duplicated.
  let _h1Used = false;

  // Shared by every button/card link-slug picker below (intervention,
  // filter, insights). Useful Thinking articles are real pages but render
  // at a nested /useful-thinking/{slug} URL rather than the flat /{slug}
  // every other page uses (see server.js), so anything resolving a picked
  // page slug into an href needs to check for that case rather than
  // always prefixing with a single slash.
  const _isUtArticleSlug = (slug) => (usefulThinkingArticles || []).some((a) => a.slug === slug);
  // slugWithFragment may carry a trailing #fragment (e.g. "evidence#documents").
  const _resolvePageHref = (slugWithFragment) => {
    const hashIdx = slugWithFragment.indexOf('#');
    const slug = hashIdx === -1 ? slugWithFragment : slugWithFragment.slice(0, hashIdx);
    const fragment = hashIdx === -1 ? '' : slugWithFragment.slice(hashIdx);
    return (_isUtArticleSlug(slug) ? `/useful-thinking/${slug}` : `/${slug}`) + fragment;
  };
%>
<div id="cms-sections">
<% for (let _i = 0; _i < sectionOrder.length; _i++) { %>
<% const _iid = sectionOrder[_i]; %>
<% const _tpl = instanceTemplates[_iid] || _iid; %>

<% if (_tpl === 'hero') { %>
<% const _k = _iid; %>
<% const _heroImg = _iid === 'hero' ? 'headshot' : 'headshot__' + _iid; %>
<% const _heroHTag = _h1Used ? 'h2' : 'h1'; _h1Used = true; %>
<%
  const _heroLabel = (content[_k + '.label'] || '').trim();
  const _heroBullets = [1, 2, 3].map((n) => content[_k + '.bullet_' + n] || '').filter((v) => v.replace(/<[^>]+>/g, '').trim());
  const _heroProofText = (content[_k + '.proof_text'] || '').replace(/<[^>]+>/g, '').trim();
  const _heroProofHref = (content[_k + '.proof_href'] || '').trim();
  const _heroProofHrefValid = /^#[A-Za-z0-9_-]+(?:__[0-9]+)?$/.test(_heroProofHref);
%>
<!-- HERO -->
<section class="hero<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="hero-inner">
        <div class="hero-text cms-section" data-section="<%= _k %>">
            <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
            <% if (_heroLabel) { %><p class="hero-label"><%- content[_k + '.label'] %></p><% } %>
            <<%= _heroHTag %> class="hero-heading"><%- content[_k + '.heading'] %></<%= _heroHTag %>>
            <p class="sub"><%- content[_k + '.subtext'] %></p>
            <% if (_heroProofText && _heroProofHrefValid) { %>
            <a href="<%= _heroProofHref %>" class="hero-proof-link"><%- content[_k + '.proof_text'] %></a>
            <% } %>
            <% if (_heroBullets.length > 0) { %>
            <ul class="hero-bullets">
                <% _heroBullets.forEach(function(_bullet) { %>
                <li><%- _bullet %></li>
                <% }); %>
            </ul>
            <% } %>
            <%
              const _heroWa = (content[_k + '.whatsapp'] || '').trim();
              const _heroWaValid = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_heroWa);
              const _heroCtaLink = (content[_k + '.cta_link'] || '').trim();
              const _heroCtaLinkValid = /^https:\/\/calendar\.app\.google\//.test(_heroCtaLink);
              const _heroCtaHref = (content[_k + '.cta_href'] || '').trim();
              const _heroCtaHrefValid = /^#[A-Za-z0-9_-]+(?:__[0-9]+)?$/.test(_heroCtaHref);
              const _heroSecondaryText = (content[_k + '.secondary_text'] || '').replace(/<[^>]+>/g, '').trim();
