<script nonce="<%= nonce %>">
    // Reveal obfuscated email / phone links. Runs before any generic anchor
    // handling below so the mailto:/tel: hrefs are live by the time other
    // listeners attach.
    document.querySelectorAll('.js-email-link').forEach(a => {
        const u = a.dataset.u, d = a.dataset.d;
        if (!u || !d) return;
        const addr = u + '@' + d;
        a.href = 'mailto:' + addr;
        a.textContent = addr;
    });
    document.querySelectorAll('.js-phone-link').forEach(a => {
        const pa = a.dataset.pa || '', pb = a.dataset.pb || '';
        const digits = pa + pb;
        if (!digits) return;
        a.href = 'tel:' + digits;
    });

    window.addEventListener('scroll', () => {
        document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 20);
    });

    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            const target = document.querySelector(a.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.step, .insight-card, .case-phase, .aq, .credential-block').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(16px)';
        el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        observer.observe(el);
    });
</script>

