          // Does any card in this instance carry artwork? If so the cards
          // that do not get an empty slot of the same height so the row's
          // text stays aligned (see .insight-image-spacer).
          const _inImgValid = (v) => /^\/[A-Za-z0-9._\-\/]*\.(jpe?g|png|webp|avif)$/.test(v) && !v.includes('..');
          let _inAnyImg = false;
          for (let _c = 1; _c <= 3; _c++) {
            if (_inImgValid((content[_k + '.card_' + _c + '_image'] || '').trim())) { _inAnyImg = true; }
          }
        %>
        <div class="insights-grid">
            <% for (let _n = 1; _n <= 3; _n++) { %>
            <%
              // Optional link, same pattern as fourcards' card_N_link: a page
              // slug with an optional #fragment deep-link. Empty or invalid
              // just renders the title as plain text, same as before this
              // field existed.
              const _inLink = (content[_k + '.card_' + _n + '_link'] || '').trim();
              const _inMatch = /^([a-z0-9]+(?:-[a-z0-9]+)*)(?:#([a-z0-9]+(?:__[0-9]+)?))?$/.exec(_inLink);
            %>
            <%
              // Optional card artwork. Validated the same way as the documents
              // template's paths: root-relative, known image extension, no
              // traversal. Empty or invalid simply renders no image, so cards
              // without artwork stay a deliberate state rather than a gap.
              const _inImg = (content[_k + '.card_' + _n + '_image'] || '').trim();
              const _inImgOk = _inImgValid(_inImg);
            %>
            <article class="insight-card">
                <% if (_inImgOk) { %>
                <img class="insight-image" src="<%= _inImg %>" alt="" loading="lazy">
                <% } else if (_inAnyImg) { %>
                <span class="insight-image-spacer" aria-hidden="true"></span>
                <% } %>
                <p class="insight-tag"><%- content[_k + '.card_' + _n + '_tag'] %></p>
                <% if (_inMatch) { %>
                <h3><a href="<%= _resolvePageHref(_inMatch[1] + (_inMatch[2] ? '#' + _inMatch[2] : '')) %>"><%- content[_k + '.card_' + _n + '_title'] %><span class="insight-arrow" aria-hidden="true">&rarr;</span></a></h3>
                <% } else { %>
                <h3><%- content[_k + '.card_' + _n + '_title'] %></h3>
                <% } %>
                <p><%- content[_k + '.card_' + _n + '_body'] %></p>
            </article>
            <% } %>
        </div>
    </div>
</section>
<% } %>


