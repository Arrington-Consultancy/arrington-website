        }

        .utlibrary-featured-label {
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 0.9rem;
        }

        .utlibrary-featured-title {
            font-family: 'DM Serif Display', serif;
