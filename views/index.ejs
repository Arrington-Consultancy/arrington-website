            color: var(--text-muted);
            line-height: 1.7;
            margin: 0 0 1.25rem;
            max-width: 640px;
        }

        /* Flat editorial list */
        .utlibrary-list {
            margin-top: 3rem;
        }

        .utlibrary-item {
