        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <div class="utlibrary-inner">
            <p class="section-label"><%- content[_k + '.label'] %></p>
            <% const _hTag = _h1Used ? 'h2' : 'h1'; _h1Used = true; %><<%= _hTag %> class="section-heading"><%- content[_k + '.heading'] %></<%= _hTag %>>
            <div class="utlibrary-list">
                <% (typeof usefulThinkingArticles !== 'undefined' ? usefulThinkingArticles : []).forEach(function(_art, _artIdx) { %>
                <a class="utlibrary-row" href="/useful-thinking/<%= _art.slug %>">
                    <span class="utlibrary-number" aria-hidden="true"><%= String(_artIdx + 1).padStart(2, '0') %></span>
                    <span class="utlibrary-content">
                        <p class="utlibrary-title"><%- (content[_art.instanceId + '.heading'] || '').replace(/<[^>]+>/g, '') %></p>
                        <p class="utlibrary-summary"><%- (content[_art.instanceId + '.index_summary'] || '').replace(/<[^>]+>/g, '') %></p>
                        <span class="utlibrary-cta">Read the story &rarr;</span>
                    </span>
                </a>
                <% }); %>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'contact') { %>
<!-- contact now rendered in footer -->
<% } %>

<% } %>
</div>

<!-- FOOTER / CONTACT -->
<footer id="conversation">
    <div class="footer-contact cms-section" data-section="contact">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="contact" title="Edit section">&#9998;</button><% } %>
        <p class="section-label"><%- pageContact.label %></p>
        <h2 class="section-heading"><%- pageContact.heading %></h2>
        <p><%- pageContact.body %></p>
        <%
          const _rawEmail = (content['contact.email'] || '').trim();
          const _atIdx = _rawEmail.indexOf('@');
          const _eU = _atIdx >= 0 ? _rawEmail.slice(0, _atIdx) : _rawEmail;
          const _eD = _atIdx >= 0 ? _rawEmail.slice(_atIdx + 1) : '';
          const _rawPhone = (content['contact.phone'] || '').trim();
          const _pMid = Math.ceil(_rawPhone.length / 2);
          const _pA = _rawPhone.slice(0, _pMid);
          const _pB = _rawPhone.slice(_pMid);
          const _pDigits = _rawPhone.replace(/[^0-9+]/g, '');
          const _pDigitsMid = Math.ceil(_pDigits.length / 2);
          const _pDigitsA = _pDigits.slice(0, _pDigitsMid);
          const _pDigitsB = _pDigits.slice(_pDigitsMid);
          const _waUrl = (content['contact.whatsapp'] || '').trim();
          const _waValid = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_waUrl);
        %>
        <form class="lead-form" id="leadForm">
            <div class="lead-hp" aria-hidden="true">
                <label>Leave this field blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <div class="lead-row">
                <input type="text" name="name" placeholder="Your name" maxlength="200" required>
                <input type="email" name="email" placeholder="Your email" maxlength="255" required>
            </div>
            <div class="lead-row">
                <input type="tel" name="phone" placeholder="Phone (optional)" maxlength="50">
                <input type="text" name="preferred_time" placeholder="Best day/time for a 30 min call (optional)" maxlength="255">
            </div>
            <textarea name="message" placeholder="<%= pageContact.messagePlaceholder %>" maxlength="2000" rows="4"></textarea>
            <button type="submit" class="btn btn-primary"><%= pageContact.submitText %></button>
            <p class="lead-form-status" id="leadFormStatus" aria-live="polite"></p>
        </form>
        <p class="lead-form-alt">Prefer to call, email or WhatsApp instead?</p>
        <div class="contact-details">
            <a href="#" class="js-email-link" data-u="<%= _eU %>" data-d="<%= _eD %>" rel="nofollow"><%= _eU %> <span aria-hidden="true">[at]</span> <%= _eD %></a>
            <a href="#" class="js-phone-link" data-pa="<%= _pDigitsA %>" data-pb="<%= _pDigitsB %>" rel="nofollow"><%= _pA %><span aria-hidden="true">&#8203;</span><%= _pB %></a>
            <% if (_waValid) { %>
            <a href="<%= _waUrl %>" class="btn btn-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
            <% } %>
        </div>
    </div>
    <div class="footer-links">
        <a href="/useful-thinking">For more on how we think, see Useful Thinking</a>
    </div>
    <div class="footer-credit cms-section" data-section="footer">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="footer" title="Edit name">&#9998;</button><% } %>
        <%= content['footer.name'] || '' %>
    </div>
</footer>

<div class="doc-modal-overlay" id="docModalOverlay">
    <div class="doc-modal">
        <button type="button" class="doc-modal-close" id="docModalClose" aria-label="Close">&#10005;</button>
        <h3 id="docModalTitle">Get the full PDF</h3>
        <p>Enter your email and we will send you straight to the download.</p>
        <form id="docModalForm">
            <div class="lead-hp" aria-hidden="true">
                <label>Leave this field blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <input type="email" name="email" placeholder="Your email" maxlength="255" required>
            <button type="submit" class="btn btn-primary">Get the PDF</button>
            <p class="lead-form-status" id="docModalStatus" aria-live="polite"></p>
        </form>
    </div>
</div>

<script nonce="<%= nonce %>">
    // Reveal obfuscated email / phone links. Runs before any generic anchor
    // handling below so the mailto:/tel: hrefs are live by the time other
    // listeners attach.
    document.querySelectorAll('.js-email-link').forEach(a => {
        const u = a.dataset.u, d = a.dataset.d;
        if (!u || !d) return;
        const addr = u + '@' + d;
        a.href = 'mailto:' + addr + '?subject=Let%27s%20talk';
        a.textContent = addr;
    });
    document.querySelectorAll('.js-phone-link').forEach(a => {
        const pa = a.dataset.pa || '', pb = a.dataset.pb || '';
        const digits = pa + pb;
        if (!digits) return;
        a.href = 'tel:' + digits;
    });

    // Google Ads conversion: visitor tapped a phone, email or WhatsApp link.
    // Runs after the reassembly above so the href prefixes are live.
    // The three kinds currently share one Ads conversion label (Ads can't
    // separate them yet - see the measurement doc for what needs creating
    // there), but each fires its own distinct GA4 event alongside it so
    // GA4 can already answer "which contact method do people actually use".
    document.querySelectorAll('a[href^="tel:"], a[href^="mailto:"], a[href^="https://wa.me/"], a[href^="https://api.whatsapp.com/"]').forEach(a => {
        a.addEventListener('click', () => {
            const kind = a.href.indexOf('tel:') === 0 ? 'phone'
                : a.href.indexOf('mailto:') === 0 ? 'email'
                : 'whatsapp';
            console.log('[Google Ads] conversion fired:', {
                action: 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD',
                trigger: kind + ' link click',
                href: a.href
            });
            if (typeof gtag === 'function') {
                gtag('event', 'conversion', { 'send_to': 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD' });
                gtag('event', kind + '_click', { event_category: 'contact', page_path: location.pathname });
            } else {
                console.warn('[Google Ads] gtag not loaded — conversion not sent');
            }
        });
    });

    // Google Calendar booking link — its own named event, kept separate from
    // the phone/email/WhatsApp conversion above since there is no dedicated
    // Google Ads conversion label for it yet (see deployment report).
    document.querySelectorAll('a[href^="https://calendar.app.google/"]').forEach(a => {
        a.addEventListener('click', () => {
            console.log('[Tracking] calendar_booking_click fired:', { href: a.href });
            if (typeof gtag === 'function') {
                gtag('event', 'calendar_booking_click', {
                    event_category: 'booking',
                    event_label: 'Book a 30 minute conversation'
                });
            } else {
                console.warn('[Tracking] gtag not loaded — calendar_booking_click not sent');
            }
        });
    });

    // Footer contact/booking form.
    (function () {
        const form = document.getElementById('leadForm');
        if (!form) return;
        const status = document.getElementById('leadFormStatus');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(form).entries());
            btn.disabled = true;
            status.textContent = 'Sending...';
            status.classList.remove('lead-form-error');
            try {
                const res = await fetch('/api/leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!res.ok) throw new Error(result.error || 'Something went wrong.');
                form.reset();
                status.textContent = 'Thanks — I will get back to you shortly.';
                if (typeof gtag === 'function') {
                    gtag('event', 'conversion', { 'send_to': 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD' });
                    gtag('event', 'contact_form_submit', { event_category: 'contact', page_path: location.pathname });
                }
            } catch (err) {
                status.textContent = err.message || 'Something went wrong. Please try again or email us directly.';
                status.classList.add('lead-form-error');
            } finally {
                btn.disabled = false;
            }
        });
    })();

    // Gated PDF downloads: click "Get the full PDF" -> email-capture modal ->
    // server logs the lead and hands back a short-lived signed download link.
    (function () {
        const overlay = document.getElementById('docModalOverlay');
        const form = document.getElementById('docModalForm');
        if (!overlay || !form) return;
        const titleEl = document.getElementById('docModalTitle');
        const status = document.getElementById('docModalStatus');
        const closeBtn = document.getElementById('docModalClose');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        let currentDoc = '';

        function openModal(doc, title) {
            currentDoc = doc;
            titleEl.textContent = title ? `Get "${title}"` : 'Get the full PDF';
            status.textContent = '';
            status.classList.remove('lead-form-error');
            form.reset();
            overlay.classList.add('open');
            if (typeof gtag === 'function') {
                gtag('event', 'document_preview_open', { event_category: 'documents', document_name: doc || title || 'unknown' });
            }
        }
        function closeModal() {
            overlay.classList.remove('open');
        }

        document.querySelectorAll('.js-doc-request').forEach(btn => {
            btn.addEventListener('click', () => openModal(btn.dataset.doc, btn.dataset.title));
        });
        closeBtn.addEventListener('click', closeModal);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(form).entries());
            data.doc = currentDoc;
            btn.disabled = true;
            status.textContent = 'One moment...';
            status.classList.remove('lead-form-error');
            try {
                const res = await fetch('/api/documents/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!res.ok) throw new Error(result.error || 'Something went wrong.');
                if (typeof gtag === 'function') {
                    gtag('event', 'conversion', { 'send_to': 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD' });
                    gtag('event', 'document_request_submit', { event_category: 'documents', document_name: currentDoc || 'unknown' });
                }
                if (result.url) window.location.href = result.url;
                status.textContent = 'Your download is starting...';
            } catch (err) {
                status.textContent = err.message || 'Something went wrong. Please try again.';
                status.classList.add('lead-form-error');
            } finally {
                btn.disabled = false;
            }
        });
    })();

    // Case study clicks - proof-strip rows and testimonial back-links all
    // point at #biography__N / #casestudy__N / #casestudy2__N, same page or
    // cross-page. One listener covers every instance of that pattern so a
    // future case study needs no tracking code of its own.
    document.querySelectorAll('a[href*="#biography__"], a[href*="#casestudy__"], a[href*="#casestudy2__"]').forEach(a => {
        a.addEventListener('click', () => {
            const target = a.getAttribute('href').split('#')[1] || 'unknown';
            if (typeof gtag === 'function') {
                gtag('event', 'case_study_click', { event_category: 'proof', case_study: target, page_path: location.pathname });
            }
        });
    });

    // Google review link click - the "on Google" link in the reviews summary.
    document.querySelectorAll('.js-google-review-link').forEach(a => {
        a.addEventListener('click', () => {
            if (typeof gtag === 'function') {
                gtag('event', 'google_review_link_click', { event_category: 'trust', page_path: location.pathname });
            }
        });
    });

    // Outbound link clicks - anything leaving the site that doesn't already
    // have its own named event above (tel/mailto/whatsapp/calendar/reviews),
    // so it isn't double-counted under two event names.
    document.querySelectorAll('a[href^="http"]').forEach(a => {
        if (a.hostname === location.hostname) return;
        if (a.matches('a[href^="https://wa.me/"], a[href^="https://api.whatsapp.com/"], a[href^="https://calendar.app.google/"], .js-google-review-link')) return;
        a.addEventListener('click', () => {
            if (typeof gtag === 'function') {
                gtag('event', 'outbound_link_click', { event_category: 'outbound', destination: a.hostname, page_path: location.pathname });
            }
        });
    });

    // Scroll depth - fires once per threshold per page view. Answers "do
    // people actually read this page" for long-form content like Useful
    // Thinking, where there's no click to measure engagement by otherwise.
    (function () {
        const thresholds = [25, 50, 75, 90];
        const fired = new Set();
        window.addEventListener('scroll', () => {
            const scrollable = document.documentElement.scrollHeight - window.innerHeight;
            if (scrollable <= 0) return;
            const percent = (window.scrollY / scrollable) * 100;
            thresholds.forEach(t => {
                if (percent >= t && !fired.has(t)) {
                    fired.add(t);
                    if (typeof gtag === 'function') {
                        gtag('event', 'scroll_depth', { event_category: 'engagement', percent: t, page_path: location.pathname });
                    }
                }
            });
        }, { passive: true });
    })();

    window.addEventListener('scroll', () => {
        document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 20);
    });

    // Hamburger menu toggle
    (function () {
        const btn = document.getElementById('navHamburger');
        const menu = document.getElementById('mobileMenu');
        if (!btn || !menu) return;

        btn.addEventListener('click', () => {
            const open = btn.classList.toggle('open');
            menu.classList.toggle('open', open);
            btn.setAttribute('aria-expanded', open);
            document.body.style.overflow = open ? 'hidden' : '';
        });

        // Close menu when a link is tapped
        menu.querySelectorAll('a').forEach(a => {
            a.addEventListener('click', () => {
                btn.classList.remove('open');
                menu.classList.remove('open');
                btn.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
            });
        });
    })();

    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            const target = document.querySelector(a.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.step, .insight-card, .case-phase, .aq, .credential-block').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(16px)';
        el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        observer.observe(el);
    });

    // Hide casestudy2 screenshot slots where no image has been uploaded yet.
    // The .cs2-screenshot--empty class suppresses layout for the slot. An
    // error handler on the <img> fires after the server returns 404 for the
    // derived key (screenshot__{instanceId}__N) so public visitors never see
    // a broken-image placeholder.
    document.querySelectorAll('.cs2-screenshot img').forEach(function(img) {
        function hide() { img.closest('.cs2-screenshot').classList.add('cs2-screenshot--empty'); }
        if (img.complete) {
            if (!img.naturalHeight) hide();
        } else {
            img.addEventListener('error', hide);
        }
    });
</script>

