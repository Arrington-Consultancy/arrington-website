<% if (_tpl === 'documents') { %>
<% const _k = _iid; %>
<%
  // Document links and previews are root-relative paths held in the content
  // table. Validate them at render time (defence-in-depth alongside EJS
  // escaping) so no scheme-bearing or protocol-relative value can reach an
  // href or src. A value that fails simply renders nothing.
  const _docPdf = (p) => /^\/[A-Za-z0-9._\-\/]*\.pdf$/i.test(p || '') && !p.includes('..') ? p : '';
  const _docImg = (p) => /^\/[A-Za-z0-9._\-\/]*\.(jpe?g|png|webp|avif)$/i.test(p || '') && !p.includes('..') ? p : '';
  const _docs = [];
  for (let _n = 1; _n <= 4; _n++) {
    const _title = (content[_k + '.doc_' + _n + '_title'] || '').trim();
    if (!_title) continue;
    _docs.push({
      n: _n,
      title: _title,
      blurb: content[_k + '.doc_' + _n + '_blurb'] || '',
      meta: (content[_k + '.doc_' + _n + '_meta'] || '').replace(/<[^>]+>/g, '').trim(),
      file: _docPdf((content[_k + '.doc_' + _n + '_file'] || '').trim()),
      basename: _docPdf((content[_k + '.doc_' + _n + '_file'] || '').trim()).split('/').pop(),
      image: _docImg((content[_k + '.doc_' + _n + '_image'] || '').trim())
    });
  }
  const _montage = _docs.filter(d => d.image);
%>
<!-- DOCUMENTS -->
<section class="documents<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" id="<%= _iid %>" data-section-id="<%= _iid %>">
