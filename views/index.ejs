        /* ---- FILTER ---- */
        .filter {
            background: var(--black);
            border-top: 1px solid var(--border);
        }

        .filter-inner {
            max-width: 680px;
            margin: 0 auto;
            text-align: center;
        }

        .filter .section-heading {
            margin-bottom: 1.5rem;
        }

        .filter p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 0.75rem;
        }

        .filter-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 0.75rem;
            text-align: left;
        }

        .filter-intro {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 2rem;
            text-align: left;
        }

        .filter-closing {
            margin-top: 2rem;
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            text-align: left;
        }

        .filter-proof-rows {
