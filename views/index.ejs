<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <% if (seo.description) { %><meta name="description" content="<%= seo.description %>"><% } %>
    <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
    <% if (seo.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <%# ---- Open Graph (Facebook, LinkedIn, etc.) ---- %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= seo.siteName %>">
    <meta property="og:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta property="og:description" content="<%= seo.ogDescription %>"><% } %>
    <meta property="og:url" content="<%= seo.ogUrl %>">
    <% if (seo.ogImage) { %><meta property="og:image" content="<%= seo.ogImage %>"><% } %>
    <%# ---- Twitter card (falls back to the Open Graph values) ---- %>
    <meta name="twitter:card" content="<%= seo.ogImage ? 'summary_large_image' : 'summary' %>">
    <% if (seo.twitterHandle) { %><meta name="twitter:site" content="<%= seo.twitterHandle %>"><% } %>
    <meta name="twitter:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta name="twitter:description" content="<%= seo.ogDescription %>"><% } %>
    <% if (seo.ogImage) { %><meta name="twitter:image" content="<%= seo.ogImage %>"><% } %>
    <%# ---- Structured data (Schema.org). Verified facts only: legal name,
         trading name, company number, phone, email, service area.
         No aggregateRating/Review here: Google's own review-snippet policy
         disqualifies markup where the reviewed entity controls the reviews
         shown about itself on its own site - including via a Google Business
         reviews widget, which is exactly what the reviews section is. That
         data is real (pulled live from Google), but it's not eligible for
         review-snippet structured data on this domain regardless. ---- %>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "name": "Arrington Consultancy",
      "legalName": "Arrington Business Consultancy Ltd",
      "alternateName": "Arrington Business Consultancy Ltd",
      "url": "https://www.arringtonconsultancy.com/",
      "telephone": "+441752477026",
      "email": "tom@arringtonconsultancy.com",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "GB:CompanyNumber",
        "value": "17122684"
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Devon" },
        { "@type": "AdministrativeArea", "name": "Cornwall" }
      ],
      "founder": {
        "@type": "Person",
        "name": "Tom Arrington",
        "jobTitle": "Managing Director"
      },
      "sameAs": [
        "https://www.google.com/maps/place/Arrington+Business+Consultancy/data=!4m7!3m6!1s0x68ae21a1b13dfe61:0x1e5cd5fd5fd3d54a!8m2!3d47.73855!4d12.5088275!16s%2Fg%2F11z309prfq!19sChIJYf49saEhrmgRStXTX_3VXB4"
      ]
    }
    </script>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Arrington Consultancy",
      "url": "https://www.arringtonconsultancy.com/"
    }
    </script>
    <% if (currentPage.slug === 'about-us') { %>
    <script type="application/ld+json" nonce="<%= nonce %>">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Tom Arrington",
      "jobTitle": "Managing Director",
      "worksFor": {
        "@type": "Organization",
        "name": "Arrington Consultancy",
        "url": "https://www.arringtonconsultancy.com/"
      },
      "url": "https://www.arringtonconsultancy.com/about-us"
    }
    </script>
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        // GA4 shares the same gtag.js loader as the Ads tag above — no second
        // script tag needed, just a second config call once the property exists.
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% if (user) { %>
    <meta name="page-slug" content="<%= currentPage.slug %>">
    <meta name="page-hidden" content="<%= currentPage.hidden ? 'true' : 'false' %>">
    <meta name="all-pages" content="<%= JSON.stringify(allPages.map(p => ({ slug: p.slug, title: p.title }))) %>">
    <% if (showAdminPanel) { %><link rel="stylesheet" href="/css/admin.css?v=<%= Date.now() %>"><% } %>
    <% if (capabilities.view_csp) { %>
    <script nonce="<%= nonce %>">
        // Capture CSP violations as they happen so the admin menu can show
        // them (registered in <head> so we don't miss any fired during
        // initial page load).
        window.__cspViolations = [];
        document.addEventListener('securitypolicyviolation', function (e) {
            window.__cspViolations.push({
                directive: e.violatedDirective,
                blocked: e.blockedURI || '(inline)',
                source: e.sourceFile || '',
                line: e.lineNumber || 0,
                sample: e.sample || '',
                time: new Date().toISOString()
            });
        });
    </script>
    <% } %>
    <% } %>
    <style nonce="<%= nonce %>">
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background: var(--black);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ---- NAV ---- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            /* Tinted with the theme's own --black rather than plain black,
               so the fixed bar matches the page's actual background colour
               (navy in the Oxford theme) instead of reading as a different,
               blacker colour once scrolled past the hero photo. */
            background: color-mix(in srgb, var(--black) 90%, transparent);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            transition: box-shadow 0.3s;
        }

        nav.scrolled {
            box-shadow: 0 1px 20px rgba(0,0,0,0.5);
        }

        .nav-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 88px;
        }

        .nav-logo {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--text-bright);
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .nav-logo-img {
            width: 200px;
            height: auto;
            display: block;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .nav-cta {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .nav-cta:hover {
            color: var(--text-bright);
        }

        .nav-cta-whatsapp {
            color: #25D366;
        }

        .nav-cta-whatsapp:hover {
            color: #1da851;
        }

        /* ---- HAMBURGER ---- */
        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 110;
        }

        .nav-hamburger span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-bright);
            border-radius: 1px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .nav-hamburger span + span {
            margin-top: 5px;
        }

        .nav-hamburger.open span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-hamburger.open span:nth-child(2) {
            opacity: 0;
        }

        .nav-hamburger.open span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* ---- MOBILE MENU ---- */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 105;
            background: color-mix(in srgb, var(--black) 95%, transparent);
            backdrop-filter: blur(20px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2rem;
        }

        .mobile-menu.open {
            display: flex;
        }

        .mobile-menu a {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-sublink {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-muted);
            opacity: 0.85;
            margin-top: -1.5rem;
        }

        .mobile-menu .mobile-menu-sublink::before {
            content: '\203A';
            margin-right: 0.4rem;
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-divider {
            width: 40px;
            height: 1px;
            background: var(--border);
        }

        .mobile-menu .mobile-menu-cta {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-whatsapp {
            color: #25D366;
        }

        /* ---- HERO ---- */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: var(--black);
            position: relative;
        }

        .hero-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 9.5rem 2rem 6rem;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 4rem;
            align-items: center;
        }

        .hero-text .hero-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            color: var(--text-bright);
            line-height: 1.12;
            margin-bottom: 1.5rem;
        }

        .hero-text .sub {
            font-size: 1.15rem;
            color: var(--text);
            margin-bottom: 2.5rem;
            max-width: 520px;
            line-height: 1.7;
        }

        .hero-text .btn {
            display: inline-flex;
        }

        .hero-label {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 1rem;
        }

        .hero-bullets {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem 1.25rem;
            padding: 0;
            margin: -1.15rem 0 2rem;
            list-style: none;
        }

        .hero-bullets li {
            position: relative;
            padding-left: 1rem;
            color: var(--text);
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .hero-bullets li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.58em;
            width: 0.38rem;
            height: 0.38rem;
            border-radius: 50%;
            background: var(--accent);
        }

        .hero-cta-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem 1.25rem;
        }

        .hero-secondary-link {
            color: var(--accent);
            font-size: 0.92rem;
            font-weight: 700;
            text-decoration: none;
        }

        .hero-secondary-link:hover {
            color: var(--text-bright);
        }

        .hero-photo {
            background: var(--black);
            border: 1px solid var(--border);
            border-radius: 8px;
            aspect-ratio: 3 / 4;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-photo picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        /* ---- FULL-BLEED HERO: image as background, text overlaid, carried
             over from the /homepage-concept design exploration. Scoped to the
             three genuine page-opening heroes (homepage, Business Consultant
             Devon, 30 Minute Conversation). About Us's hero instance sits at
             the BOTTOM of that page as a closing section, not an opening one,
             so it keeps the side-by-side hero-photo layout — full-bleed only
             makes sense as a first impression. ---- */
        .hero[data-section-id="hero"],
        .hero[data-section-id="hero__3"],
        .hero[data-section-id="hero__4"] {
            min-height: 100vh;
            align-items: flex-end;
            overflow: hidden;
        }

        .hero[data-section-id="hero"]::after,
        .hero[data-section-id="hero__3"]::after,
        .hero[data-section-id="hero__4"]::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(0deg, rgba(0,10,25,0.94) 0%, rgba(0,10,25,0.55) 42%, rgba(0,10,25,0.15) 68%, rgba(0,10,25,0.35) 100%);
            pointer-events: none;
        }

        .hero[data-section-id="hero"] .hero-inner,
        .hero[data-section-id="hero__3"] .hero-inner,
        .hero[data-section-id="hero__4"] .hero-inner {
            display: block;
            max-width: none;
            width: 100%;
            padding: 9.5rem 2rem 4.5rem;
        }

        .hero[data-section-id="hero"] .hero-text,
        .hero[data-section-id="hero__3"] .hero-text,
        .hero[data-section-id="hero__4"] .hero-text {
            position: relative;
            z-index: 2;
            max-width: 1100px;
            margin: 0 auto;
        }

        .hero[data-section-id="hero"] .hero-text .sub,
        .hero[data-section-id="hero__3"] .hero-text .sub,
        .hero[data-section-id="hero__4"] .hero-text .sub {
            max-width: 560px;
        }

        .hero[data-section-id="hero"] .hero-photo,
        .hero[data-section-id="hero__3"] .hero-photo,
        .hero[data-section-id="hero__4"] .hero-photo {
            position: absolute;
            inset: 0;
            z-index: 0;
            width: 100%;
            height: 100%;
            max-width: none;
            margin: 0;
            border: none;
            border-radius: 0;
            aspect-ratio: auto;
        }

        .hero[data-section-id="hero"] .hero-photo img { object-position: 60% 40%; }
        .hero[data-section-id="hero__3"] .hero-photo img { object-position: 65% 50%; }
        .hero[data-section-id="hero__4"] .hero-photo img { object-position: 60% 40%; }

        @media (max-width: 700px) {
            .hero[data-section-id="hero"],
            .hero[data-section-id="hero__3"],
            .hero[data-section-id="hero__4"] { min-height: 92vh; }
            .hero[data-section-id="hero"] .hero-photo img { object-position: 70% 45%; }
            .hero[data-section-id="hero__3"] .hero-photo img { object-position: 75% 50%; }
            .hero[data-section-id="hero__4"] .hero-photo img { object-position: 70% 45%; }
            .hero[data-section-id="hero"] .hero-inner,
            .hero[data-section-id="hero__3"] .hero-inner,
            .hero[data-section-id="hero__4"] .hero-inner { padding: 6.5rem 1.25rem 3.5rem; }
        }

        /* ---- BUTTONS ---- */
        .btn {
            align-items: center;
            padding: 0.9rem 2.2rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            font-family: inherit;
            letter-spacing: 0.02em;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-bright);
            border: 1px solid var(--accent);
        }

        .btn-outline:hover {
            border-color: var(--accent);
        }

        .btn-whatsapp {
            background: #3d6b52;
            color: #fff;
        }

        .btn-whatsapp:hover {
            background: #2f5540;
        }

        .hero-cta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        /* ---- SECTIONS ---- */
        section {
            padding: 6rem 2rem;
        }

        .section-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.7rem, 3vw, 2.2rem);
            color: var(--text-bright);
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .section-sub {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 600px;
            line-height: 1.75;
        }

        .evidence-intro {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 640px;
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        /* ---- STAT CALLOUT ---- */
        .stat-callout {
            display: inline-flex;
            align-items: baseline;
            gap: 0.85rem;
            margin: 1.25rem 0 1.75rem;
            padding: 0.9rem 1.35rem;
            background: color-mix(in srgb, var(--accent) 10%, transparent);
            border-left: 2px solid var(--accent);
            border-radius: 3px;
        }

        .stat-callout .stat-num {
            font-family: 'DM Serif Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent);
            line-height: 1.2;
            white-space: nowrap;
        }

        .stat-callout .stat-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text);
            line-height: 1.4;
            max-width: 260px;
        }

        @media (max-width: 640px) {
            .stat-callout {
                display: flex;
            }
            .stat-callout .stat-num {
                white-space: normal;
            }
        }

        /* ---- PULL QUOTE ---- */
        .intervention-quote-mark {
            font-family: 'DM Serif Display', serif;
            font-size: 3rem;
            color: var(--accent);
            line-height: 0.4;
            display: block;
            margin-bottom: 0.75rem;
        }

        .intervention-quote-text {
            font-family: 'DM Serif Display', serif;
            font-style: italic;
            font-size: 1.4rem;
            color: var(--text-bright);
            line-height: 1.5;
            margin-bottom: 1rem;
        }

        .intervention-quote-attribution-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .intervention-quote-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        .intervention-quote-attribution {
            font-size: 0.95rem;
            color: var(--text);
        }

        .intervention-google-rating {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.88rem;
            color: var(--text-muted);
            text-decoration: none;
        }

        .intervention-google-rating:hover {
            color: var(--text-bright);
        }

        .intervention-google-rating-stars {
            color: var(--accent);
            font-size: 0.85rem;
            letter-spacing: 0.05em;
        }

        /* ---- DIVIDER ---- */
        .divider {
            max-width: 1100px;
            margin: 0 auto;
            height: 1px;
            background: var(--border);
        }

        /* ---- CREDENTIALS ---- */
        .credentials {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .credentials-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .credential-block {
            padding: 2.5rem 0;
            text-align: center;
        }

        .credential-badge-wrap {
            position: relative;
            display: inline-block;
            margin-bottom: 1.25rem;
        }

        .credential-badge {
            width: 200px;
            height: auto;
            display: block;
            border-radius: 4px;
        }

        .credential-block h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.5rem;
        }

        .credential-block p {
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.7;
        }

        .credential-stat {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 2.3rem;
            letter-spacing: -0.01em;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        /* ---- PROBLEM ---- */
        .problem {
            background: var(--black);
        }

        .problem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3rem;
            align-items: start;
        }

        .problem-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .problem-list li {
            font-size: 1rem;
            color: var(--text);
            padding-left: 1.5rem;
            position: relative;
            line-height: 1.6;
        }

        .problem-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55rem;
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

        .problem-right p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
        }

        .problem-right p strong {
            color: var(--text-bright);
        }

        /* ---- APPROACH ---- */
        .approach {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .approach-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .step {
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .step-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .step h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
        }

        .step p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* ---- INSIGHTS ---- */
        .insights {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .insights-header {
            margin-bottom: 3rem;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
        }

        /* De-boxed to match the fourcards treatment: a top border only,
           not a filled card — this section already sits inside its own
           distinct background band, so a card-within-a-card read as
           doubled-up boxing. */
        .insight-card {
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
        }

        .insight-tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .insight-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.35;
        }

        .insight-card p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .insight-card a {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .insight-card a:hover {
            color: var(--text-bright);
        }

        /* A linked card title keeps the heading's own typography (serif,
           size, bright colour) rather than the smaller accent-coloured
           style above, which is meant for a separate "read more"-style
           link, not the heading itself. */
        .insight-card h3 a {
            color: inherit;
            font-size: inherit;
            font-weight: inherit;
            text-decoration: none;
        }

        .insight-card h3 a:hover {
            color: var(--accent);
        }

        @media (max-width: 900px) {
            .insights-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- FOUR CARDS ---- */
        .fourcards {
            background: var(--black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .fourcards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2.5rem;
            margin-top: 3rem;
        }

        /* De-boxed to match the editorial, fewer-containers treatment used
           elsewhere (credentials, proof strip): a top border only, not a
           filled card around each item — the numbering and typography carry
           the separation instead of a background/border box. */
        .fourcard {
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
        }

        .fourcard-header {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 1rem;
        }

        .fourcard-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        .fourcard-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
        }

        .fourcard h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .fourcard p {
            font-size: 0.88rem;
            color: var(--text);
            line-height: 1.7;
        }

        .fourcard-link {
            display: inline-block;
            margin-top: 0.9rem;
            font-size: 0.82rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .fourcard-link:hover {
            color: var(--text-bright);
        }

        /* ---- GOOGLE REVIEWS ---- */
        .google-reviews-summary {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin: 1rem 0 2.5rem;
        }

        .google-reviews-stars {
            font-size: 1.3rem;
            color: var(--accent);
            letter-spacing: 0.1rem;
        }

        .google-reviews-score {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
        }

        .google-reviews-count {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .google-reviews-count a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .google-reviews-count a:hover {
            color: var(--text-bright);
        }

        .google-reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .google-review-card {
            padding: 1.5rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .google-review-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.85rem;
        }

        .google-review-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .google-review-author {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-bright);
            margin-bottom: 0.15rem;
        }

        .google-review-stars {
            font-size: 0.85rem;
            color: var(--accent);
        }

        .google-review-text {
            font-size: 0.88rem;
            color: var(--text);
            line-height: 1.65;
            display: -webkit-box;
            -webkit-line-clamp: 6;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .google-review-time {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 0.75rem;
        }

        @media (max-width: 900px) {
            .fourcards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .fourcards-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- DOCUMENTS ---- */
        .documents {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .documents-header {
            display: grid;
            grid-template-columns: 1fr 0.8fr;
            gap: 4rem;
            align-items: center;
        }

        .documents-lede {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.8;
            max-width: 34rem;
            margin-top: 1.5rem;
        }

        /* Fanned montage of the document covers. Sheets are positioned by
           nth-child so the markup stays a plain list of images (no inline
           style attributes, which the strict CSP would block). */
        .documents-montage {
            position: relative;
            height: 290px;
        }

        .documents-montage img {
            position: absolute;
            top: 0;
            width: 40%;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 42px rgba(0,0,0,0.55);
            background: var(--charcoal);
        }

        .documents-montage img:nth-child(1) { left: 0;   z-index: 1; transform: rotate(-7deg)   translateY(16px); }
        .documents-montage img:nth-child(2) { left: 19%; z-index: 2; transform: rotate(-2.5deg) translateY(4px); }
        .documents-montage img:nth-child(3) { left: 38%; z-index: 3; transform: rotate(2.5deg)  translateY(4px); }
        .documents-montage img:nth-child(4) { left: 57%; z-index: 4; transform: rotate(7deg)    translateY(16px); }

        /* The montage sheets are stacked with z-index, so lift the CMS
           controls above them or the edit/move buttons sit underneath. The
           solid backing keeps them legible where they overlap a white page. */
        .documents .cms-edit-btn,
        .documents .cms-move-btn {
            z-index: 5;
            background: rgba(10,10,10,0.8);
        }

        .documents-list {
            margin-top: 4.5rem;
            display: flex;
            flex-direction: column;
            gap: 3.5rem;
        }

        /* De-boxed to match fourcards/insight-cards: a top border only, not
           a filled card — the document thumbnail's own drop shadow already
           gives it plenty of visual weight against the flat page. */
        .document-card {
            display: grid;
            grid-template-columns: 190px 1fr;
            gap: 2.5rem;
            align-items: start;
            padding-top: 2.5rem;
            border-top: 1px solid var(--border);
        }

        .documents-list .document-card:first-child {
            padding-top: 0;
            border-top: none;
        }

        /* A document with no preview image set gets the full card width. */
        .document-card-noimg {
            grid-template-columns: 1fr;
        }

        .document-thumb {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 26px rgba(0,0,0,0.45);
        }

        .document-number {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 0.6rem;
        }

        .document-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
            line-height: 1.3;
            margin-bottom: 0.85rem;
        }

        .document-card p {
            font-size: 0.93rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
            max-width: 40rem;
        }

        .document-meta {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .document-card .btn {
            display: inline-block;
            padding: 0.7rem 1.6rem;
            font-size: 0.85rem;
        }

        @media (max-width: 900px) {
            .documents-header {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .documents-montage {
                height: 200px;
                max-width: 420px;
            }

            .documents-list {
                margin-top: 3rem;
            }

            .document-card {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                padding-top: 1.75rem;
            }

            .documents-list .document-card:first-child {
                padding-top: 0;
            }

            .document-thumb {
                max-width: 200px;
            }
        }

        /* ---- CASE STUDY ---- */
        .case-study {
            background: var(--black);
        }

        .case-inner {
            max-width: 800px;
        }

        .case-photo {
            aspect-ratio: 3 / 2;
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            margin: 1.75rem 0;
        }

        .case-photo picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .case-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .case-timeline {
            margin-top: 3rem;
            position: relative;
            padding-left: 1.75rem;
        }

        .case-timeline::before {
            content: '';
            position: absolute;
            left: 4px;
            top: 6px;
            bottom: 6px;
            width: 1px;
            background: var(--border);
        }

        .case-phase {
            position: relative;
            padding-bottom: 2.5rem;
        }

        .case-phase:last-child {
            padding-bottom: 0;
        }

        .case-phase::before {
            content: '';
            position: absolute;
            left: -1.75rem;
            top: 0.35rem;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--accent);
        }

        .phase-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.6rem;
        }

        .phase-content p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .phase-content p strong {
            color: var(--text-bright);
        }

        .phase-capstone {
            display: block;
            margin-top: 0.85rem;
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
        }

        /* ---- CASE STUDY 2 (TRISTAN) ---- */
        .casestudy2 {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .casestudy2-inner {
            max-width: 760px;
        }

        .casestudy2-intro {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.15rem, 2vw, 1.35rem);
            color: var(--text-bright);
            line-height: 1.55;
            margin-top: 2rem;
            margin-bottom: 2.5rem;
        }

        .casestudy2-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 2rem;
        }

        .casestudy2-outcome {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1.5rem 1.75rem;
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .casestudy2-outcome strong {
            color: var(--text-bright);
        }

        .casestudy2-included-heading {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
            margin: 0 0 1rem;
        }

        .casestudy2-list,
        .filter-list {
            display: grid;
            gap: 0.75rem;
            margin: 0 0 2rem;
            padding: 0;
            list-style: none;
            text-align: left;
        }

        .casestudy2-list li,
        .filter-list li {
            position: relative;
            padding-left: 1.35rem;
            color: var(--text);
            font-size: 1rem;
            line-height: 1.55;
        }

        .casestudy2-list li::before,
        .filter-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.72em;
            width: 0.42rem;
            height: 0.42rem;
            border-radius: 50%;
            background: var(--accent);
        }

        .casestudy2 .btn {
            display: inline-flex;
            margin-top: 2rem;
            max-width: 100%;
            white-space: normal;
            overflow-wrap: break-word;
            text-align: center;
            justify-content: center;
            height: auto;
            min-height: 3rem;
            box-sizing: border-box;
        }

        .cs2-screenshots {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-top: 2rem;
        }

        .cs2-screenshots:empty {
            display: none;
        }

        .cs2-screenshot {
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--charcoal);
            position: relative;
        }

        .cs2-screenshot img {
            display: block;
            width: 100%;
            height: auto;
        }

        .cs2-screenshot.cs2-screenshot--empty {
            display: none;
        }

        @media (max-width: 900px) {
            .cs2-screenshots {
                grid-template-columns: 1fr;
            }
        }


        .assessment {
            background: var(--near-black);
            border-top: 1px solid var(--border);
        }

        .assessment-inner {
            text-align: center;
            max-width: 680px;
            margin: 0 auto;
        }

        .assessment .section-heading {
            margin-bottom: 1.5rem;
        }

        .assessment p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        .assessment-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .assessment-questions {
            text-align: left;
            margin: 2.5rem 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .aq {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1rem 1.25rem;
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.6;
        }

        .assessment .btn {
            display: inline-flex;
            margin-bottom: 1.5rem;
        }

        .assessment .note {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ---- INTERVENTION ---- */
        .intervention {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .intervention .section-inner {
            max-width: 760px;
            text-align: center;
        }

        .intervention .section-heading {
            margin-bottom: 1.5rem;
        }

        .intervention-body {
            font-size: 1.1rem;
            color: var(--text);
            line-height: 1.75;
            text-align: left;
        }

        .intervention-body strong {
            color: var(--text-bright);
        }

        .intervention-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            text-align: left;
            margin-bottom: 1.5rem;
        }

        .intervention-header picture {
            display: block;
            flex-shrink: 0;
        }

        .intervention-photo {
            width: 100px;
            height: 125px;
            object-fit: cover;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .intervention-heading-left {
            text-align: left;
            margin-bottom: 0;
        }

        .intervention-monogram {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: 1px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        @media (max-width: 640px) {
            .intervention-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        .intervention .btn {
            display: inline-flex;
            margin-top: 2.25rem;
        }

        /* ---- FILTER ---- */
        .filter {
            background: var(--black);
            border-top: 1px solid var(--border);
        }

        .filter-inner {
            max-width: 680px;
            margin: 0 auto;
            text-align: center;
        }

        .filter .section-heading {
            margin-bottom: 1.5rem;
        }

        .filter p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 0.75rem;
        }

        .filter-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 0.75rem;
            text-align: left;
        }

        .filter-intro {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 2rem;
            text-align: left;
        }

        .filter-closing {
            margin-top: 2rem;
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            text-align: left;
        }

        .filter-proof-rows {
            margin-top: 2rem;
            background: var(--charcoal);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .filter .btn {
            display: inline-flex;
            margin-top: 2.25rem;
        }

        /* ---- PROOF STRIP ---- */
        .proofstrip {
            background: var(--charcoal);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .proofstrip-inner {
            max-width: 1000px;
            margin: 0 auto;
        }

        .proofstrip .section-label {
            text-align: center;
            margin-bottom: 2rem;
        }

        .proofstrip-rows {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            border-top: 1px solid var(--border);
        }

        .proof-row {
            padding: 1.75rem 1.5rem;
            text-align: center;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .proof-row:last-child {
            border-right: 0;
        }

        .proof-row-link {
            color: inherit;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .proof-row-link:hover,
        .proof-row-link:focus-visible {
            background-color: var(--surface-alt, rgba(0, 0, 0, 0.03));
        }

        .proof-icon {
            width: 26px;
            height: 26px;
            color: var(--accent);
            margin: 0 auto;
        }

        .proof-action {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-weight: 500;
            color: var(--accent);
        }

        .proof-client {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
            line-height: 1.3;
        }

        /* ---- ARTICLE (Useful Thinking long-form pieces) ---- */
        .article-back {
            display: inline-block;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            margin-bottom: 1.75rem;
        }

        .article-back:hover,
        .article-back:focus-visible {
            color: var(--accent);
        }

        .article-inner {
            max-width: 640px;
            margin: 0 auto;
        }

        .article-image {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 6px;
            margin-top: 1.75rem;
        }

        .article-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            text-align: left;
            margin-top: 1.5rem;
        }

        .article-body p {
            margin: 0 0 1.25rem;
        }

        .article-body p:last-child {
            margin-bottom: 0;
        }

        .article-related {
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .article-related a {
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        /* ---- USEFUL THINKING LIBRARY (article index list) ---- */
        .utlibrary-inner {
            max-width: 720px;
            margin: 0 auto;
        }

        .utlibrary-list {
            margin-top: 2rem;
            border-top: 1px solid var(--border);
        }

        .utlibrary-row {
            display: flex;
            align-items: flex-start;
            gap: 1.5rem;
            padding: 1.75rem 0;
            border-bottom: 1px solid var(--border);
            text-decoration: none;
            color: inherit;
            transition: padding-left 0.2s ease;
        }

        .utlibrary-row:hover,
        .utlibrary-row:focus-visible {
            padding-left: 0.5rem;
        }

        .utlibrary-number {
            flex-shrink: 0;
            width: 2.25rem;
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1.3;
        }

        .utlibrary-content {
            flex: 1;
            min-width: 0;
        }

        .utlibrary-title {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
            margin: 0 0 0.5rem;
            line-height: 1.3;
        }

        .utlibrary-row:hover .utlibrary-title,
        .utlibrary-row:focus-visible .utlibrary-title {
            color: var(--accent);
        }

        .utlibrary-summary {
            font-size: 0.98rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin: 0;
        }

        .utlibrary-cta {
            display: inline-block;
            margin-top: 0.75rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        @media (max-width: 600px) {
            .utlibrary-row {
                gap: 1rem;
            }

            .utlibrary-number {
                width: 1.75rem;
                font-size: 1.15rem;
            }
        }

        /* ---- CONTACT (in footer) ---- */

        /* ---- FOOTER ---- */
        footer {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .footer-contact {
            text-align: center;
            max-width: 580px;
            margin: 0 auto;
            padding: 5rem 2rem;
        }

        .footer-contact p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .footer-contact .contact-details {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2.5rem;
            flex-wrap: wrap;
        }

        .footer-contact .contact-details a {
            color: var(--text-bright);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        .footer-contact .contact-details a:hover {
            color: var(--accent);
        }

        .lead-form {
            text-align: left;
            margin: 0 0 2rem;
        }

        .lead-hp {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .lead-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.9rem;
            margin-bottom: 0.9rem;
        }

        .lead-form input,
        .lead-form textarea {
            width: 100%;
            background: var(--charcoal);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.8rem 1rem;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-bright);
        }

        .lead-form textarea {
            margin-bottom: 1.1rem;
            resize: vertical;
        }

        .lead-form input::placeholder,
        .lead-form textarea::placeholder {
            color: var(--text-muted);
        }

        .lead-form input:focus,
        .lead-form textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .lead-form-status {
            margin: 0.9rem 0 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            min-height: 1.2em;
        }

        .lead-form-status.lead-form-error {
            color: #e07a6d;
        }

        .lead-form-alt {
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1rem !important;
        }

        @media (max-width: 600px) {
            .lead-row {
                grid-template-columns: 1fr;
            }
        }

        /* ---- GATED PDF DOWNLOAD MODAL ---- */
        .doc-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(6px);
            z-index: 200;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .doc-modal-overlay.open {
            display: flex;
        }

        .doc-modal {
            position: relative;
            background: var(--dark-grey);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;
        }

        .doc-modal h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            margin-bottom: 0.6rem;
            color: var(--text-bright);
        }

        .doc-modal p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .doc-modal input {
            width: 100%;
            background: var(--charcoal);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.8rem 1rem;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-bright);
            margin-bottom: 1rem;
        }

        .doc-modal input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .doc-modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1rem;
            cursor: pointer;
        }

        .doc-modal-close:hover {
            color: var(--text-bright);
        }

        .footer-credit {
            position: relative;
            text-align: center;
            padding: 1.5rem 2rem 2.25rem;
            font-size: 0.78rem;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .footer-links {
            text-align: center;
            padding: 0 2rem;
        }

        .footer-links a {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }

        .footer-links a:hover {
            color: var(--text-bright);
            border-bottom-color: var(--text-bright);
        }

        /* ---- PAGE MENU ---- */
        .page-menu {
            position: fixed;
            top: 88px;
            left: 0;
            right: 0;
            z-index: 99;
            background: color-mix(in srgb, var(--black) 75%, transparent);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .page-menu-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            gap: 1.25rem;
            height: 36px;
            align-items: center;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
        }

        .page-menu-inner::-webkit-scrollbar {
            display: none;
        }

        .page-menu-link {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            letter-spacing: 0.03em;
            padding: 0.35rem 0;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
            flex-shrink: 0;
            transition: color 0.2s, border-color 0.2s;
        }

        .page-menu-link:hover {
            color: var(--text-bright);
        }

        .page-menu-link.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .page-menu-link.page-menu-hidden {
            opacity: 0.4;
            font-style: italic;
        }

        .page-menu-link-child {
            font-size: 0.72rem;
            color: var(--text-muted);
            opacity: 0.85;
            margin-left: -0.5rem;
        }

        .page-menu-link-child::before {
            content: '\203A';
            margin-right: 0.35rem;
            color: var(--accent);
        }

        /* ---- FIRST-SECTION NAV CLEARANCE ---- */
        #cms-sections > section:first-child:not(.hero) {
            padding-top: 8.5rem;
        }

        /* ---- MOBILE ---- */
        @media (max-width: 900px) {
            .nav-hamburger {
                display: block;
            }

            .nav-actions {
                display: none;
            }

            .page-menu {
                display: none;
            }

            .nav-logo-img {
                width: 140px;
            }

            .nav-inner {
                height: 64px;
            }

            .hero-inner {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                padding-top: 6rem;
            }

            .hero-photo {
                max-width: 300px;
                margin: 0 auto;
            }

            .credentials-inner {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .credential-block {
                padding: 1.5rem 0;
            }

            .credential-block + .credential-block {
                border-top: 1px solid var(--border);
            }

            .problem-grid {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .approach-steps {
                grid-template-columns: 1fr;
            }

            .case-timeline {
                padding-left: 1.4rem;
            }

            .case-phase::before {
                left: -1.4rem;
            }

            .footer-contact .contact-details {
                flex-direction: column;
                gap: 1rem;
            }

            .proofstrip-rows {
                grid-template-columns: 1fr;
            }

            .proof-row {
                border-right: 0;
                border-bottom: 1px solid var(--border);
            }

            .proof-row:last-child {
                border-bottom: 0;
            }

            #cms-sections > section:first-child:not(.hero) {
                padding-top: 8rem;
            }
        }

        @media (max-width: 600px) {
            section {
                padding: 4rem 1.25rem;
            }

            .hero-inner {
                padding: 5.5rem 1.25rem 3.5rem;
            }

            .hero-text .hero-heading {
                font-size: 1.85rem;
            }

            .hero-text .sub {
                font-size: 1rem;
            }

            .hero-bullets {
                flex-direction: column;
                gap: 0.65rem;
            }

            .hero-cta-row {
                align-items: stretch;
                flex-direction: column;
            }

            .section-heading {
                font-size: 1.5rem;
            }

            .step {
                padding: 1.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
                text-align: center;
            }

            .casestudy2 .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<!-- NAV -->
<nav id="nav">
    <div class="nav-inner">
        <a href="/" class="nav-logo">
            <img src="/img/logo" alt="Arrington Business Consultancy" class="nav-logo-img">
            <% if (canEdit) { %><button class="cms-img-btn" data-image="logo" title="Change logo">&#9998;</button><% } %>
        </a>
        <div class="nav-actions">
            <a href="#conversation" class="nav-cta"><%= pageContact.headerCtaText %></a>
            <% const _navWa = (content['contact.whatsapp'] || '').trim(); %>
            <% if (/^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_navWa)) { %>
            <a href="<%= _navWa %>" class="nav-cta nav-cta-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
            <% } %>
        </div>
        <button class="nav-hamburger" id="navHamburger" aria-label="Menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
    <% if (navPages.length > 1) { %>
        <% for (const _p of navPages) { %>
            <% if (!_p.hidden || canEdit) { %>
            <a href="<%= _p.slug === 'main' ? '/' : '/' + _p.slug %>"
               class="<%= _p.slug === currentPage.slug ? 'active' : '' %>">
                <%= _p.nav_label || _p.title %>
            </a>
            <% } %>
            <% if (_p.slug === 'what-we-do') { %>
            <a href="/websites-and-ai" class="mobile-menu-sublink<%= currentPage.slug === 'websites-and-ai' ? ' active' : '' %>">Websites and AI</a>
            <% } %>
        <% } %>
        <div class="mobile-menu-divider"></div>
    <% } %>
    <a href="#conversation" class="mobile-menu-cta"><%= pageContact.headerCtaText %></a>
    <% const _mWa = (content['contact.whatsapp'] || '').trim(); %>
    <% if (/^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_mWa)) { %>
    <a href="<%= _mWa %>" class="mobile-menu-cta mobile-menu-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
    <% } %>
</div>

<% if (navPages.length > 1) { %>
<div class="page-menu" id="pageMenu">
    <div class="page-menu-inner">
        <% for (const _p of navPages) { %>
        <a href="<%= _p.slug === 'main' ? '/' : '/' + _p.slug %>"
           class="page-menu-link<%= _p.slug === currentPage.slug ? ' active' : '' %><%= ((_p.hidden || !_p.show_in_nav) && canEdit) ? ' page-menu-hidden' : '' %>"
           <% if (canEdit && !_p.hidden && !_p.show_in_nav) { %>title="Out of the main nav (Show in nav is off), but reachable by direct URL and indexed"<% } %>>
            <%= _p.nav_label || _p.title %>
        </a>
        <% if (_p.slug === 'what-we-do') { %>
        <a href="/websites-and-ai" class="page-menu-link page-menu-link-child<%= currentPage.slug === 'websites-and-ai' ? ' active' : '' %>">Websites and AI</a>
        <% } %>
        <% } %>
    </div>
</div>
<% } %>


<%
  // Three line icons for the proof-strip rows (built/exited, turnaround,
  // improved margin). Hand-drawn paths, single stroke weight, no fill -
  // they inherit colour from .proof-icon via currentColor.
  const PROOF_ICONS = [
    '<path d="M7 17L17 7"/><path d="M9 7h8v8"/>',
    '<path d="M4 12a8 8 0 1 0 8-8"/><path d="M4 12l4-4M4 12l4 4"/>',
    '<path d="M5 19V13"/><path d="M12 19V9"/><path d="M19 19V5"/>'
  ];
  // Every page must have exactly one H1. hero renders a real <h1> itself and
  // flips this flag; every other template's main heading promotes to <h1>
  // only if nothing has claimed it yet on this page, then falls back to <h2>
  // for every subsequent heading - so page order determines which section's
  // heading becomes the H1, and it's never duplicated.
  let _h1Used = false;

  // Shared by every button/card link-slug picker below (intervention,
  // filter, insights). Useful Thinking articles are real pages but render
  // at a nested /useful-thinking/{slug} URL rather than the flat /{slug}
  // every other page uses (see server.js), so anything resolving a picked
  // page slug into an href needs to check for that case rather than
  // always prefixing with a single slash.
  const _isUtArticleSlug = (slug) => (usefulThinkingArticles || []).some((a) => a.slug === slug);
  // slugWithFragment may carry a trailing #fragment (e.g. "evidence#documents").
  const _resolvePageHref = (slugWithFragment) => {
    const hashIdx = slugWithFragment.indexOf('#');
    const slug = hashIdx === -1 ? slugWithFragment : slugWithFragment.slice(0, hashIdx);
    const fragment = hashIdx === -1 ? '' : slugWithFragment.slice(hashIdx);
    return (_isUtArticleSlug(slug) ? `/useful-thinking/${slug}` : `/${slug}`) + fragment;
  };
%>
<div id="cms-sections">
<% for (let _i = 0; _i < sectionOrder.length; _i++) { %>
<% const _iid = sectionOrder[_i]; %>
<% const _tpl = instanceTemplates[_iid] || _iid; %>

<% if (_tpl === 'hero') { %>
<% const _k = _iid; %>
<% const _heroImg = _iid === 'hero' ? 'headshot' : 'headshot__' + _iid; %>
<% const _heroHTag = _h1Used ? 'h2' : 'h1'; _h1Used = true; %>
<%
  const _heroLabel = (content[_k + '.label'] || '').trim();
  const _heroBullets = [1, 2, 3].map((n) => content[_k + '.bullet_' + n] || '').filter((v) => v.replace(/<[^>]+>/g, '').trim());
%>
<!-- HERO -->
<section class="hero<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="hero-inner">
        <div class="hero-text cms-section" data-section="<%= _k %>">
            <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
            <% if (_heroLabel) { %><p class="hero-label"><%- content[_k + '.label'] %></p><% } %>
            <<%= _heroHTag %> class="hero-heading"><%- content[_k + '.heading'] %></<%= _heroHTag %>>
            <p class="sub"><%- content[_k + '.subtext'] %></p>
            <% if (_heroBullets.length > 0) { %>
            <ul class="hero-bullets">
                <% _heroBullets.forEach(function(_bullet) { %>
                <li><%- _bullet %></li>
                <% }); %>
            </ul>
            <% } %>
            <%
              const _heroWa = (content[_k + '.whatsapp'] || '').trim();
              const _heroWaValid = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_heroWa);
              const _heroCtaLink = (content[_k + '.cta_link'] || '').trim();
              const _heroCtaLinkValid = /^https:\/\/calendar\.app\.google\//.test(_heroCtaLink);
              const _heroCtaHref = (content[_k + '.cta_href'] || '').trim();
              const _heroCtaHrefValid = /^#[A-Za-z0-9_-]+(?:__[0-9]+)?$/.test(_heroCtaHref);
              const _heroSecondaryText = (content[_k + '.secondary_text'] || '').replace(/<[^>]+>/g, '').trim();
              const _heroSecondaryHref = (content[_k + '.secondary_href'] || '').trim();
              const _heroSecondaryHrefValid = /^#[A-Za-z0-9_-]+(?:__[0-9]+)?$/.test(_heroSecondaryHref);
            %>
            <div class="hero-cta-row">
                <% if (_heroCtaLinkValid) { %>
                <a href="<%= _heroCtaLink %>" class="btn btn-primary" target="_blank" rel="noopener"><%- content[_k + '.cta'] %></a>
                <% } else if (_heroCtaHrefValid) { %>
                <a href="<%= _heroCtaHref %>" class="btn btn-primary"><%- content[_k + '.cta'] %></a>
                <% } else { %>
                <a href="#conversation" class="btn btn-primary"><%- content[_k + '.cta'] %></a>
                <% } %>
                <% if (_heroWaValid) { %>
                <a href="<%= _heroWa %>" class="btn btn-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
                <% } %>
                <% if (_heroSecondaryText && _heroSecondaryHrefValid) { %>
                <a href="<%= _heroSecondaryHref %>" class="hero-secondary-link"><%- content[_k + '.secondary_text'] %></a>
                <% } %>
            </div>
        </div>
        <div class="hero-photo">
            <picture>
                <source srcset="/img/<%= _heroImg %>.webp" type="image/webp">
                <img src="/img/<%= _heroImg %>" alt="Arrington Business Consultancy"<%- _heroHTag === 'h2' ? ' loading="lazy"' : '' %>>
            </picture>
            <% if (canEdit) { %><button class="cms-img-btn" data-image="<%= _heroImg %>" title="Change photo">&#9998;</button><% } %>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'credentials') { %>
<% const _k = _iid; %>
<% const _kOx = _iid + '_oxford'; %>
<% const _kSt = _iid + '_stat'; %>
<!-- CREDENTIALS -->
<section class="credentials<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner">
        <div class="credentials-inner">
            <div class="credential-block cms-section" data-section="<%= _kSt %>">
                <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _kSt %>" title="Edit section">&#9998;</button><% } %>
