    <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="client-logout-btn">Log out</button>
    </form>
</div>
<style nonce="<%= nonce %>">
    .client-logout { position: fixed; bottom: 1rem; right: 1rem; z-index: 100; }
    .client-logout-btn { background: var(--charcoal); color: var(--text); border: 1px solid var(--border); padding: 0.4rem 0.9rem; border-radius: 4px; font-size: 0.75rem; cursor: pointer; font-family: 'DM Sans', sans-serif; }
    .client-logout-btn:hover { background: var(--mid-grey); }
</style>
<% } %>

</body>
</html>
