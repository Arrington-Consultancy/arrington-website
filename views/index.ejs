<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= currentPage.slug !== 'main' ? currentPage.title + ' | ' : '' %>Arrington Business Consultancy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <% if (user) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="page-slug" content="<%= currentPage.slug %>">
    <meta name="page-hidden" content="<%= currentPage.hidden ? 'true' : 'false' %>">
    <link rel="stylesheet" href="/css/admin.css?v=<%= Date.now() %>">
    <% if (user.role === 'admin') { %>
    <script nonce="<%= nonce %>">
        // Capture CSP violations as they happen so the admin menu can show
        // them (registered in <head> so we don't miss any fired during
        // initial page load).
        window.__cspViolations = [];
        document.addEventListener('securitypolicyviolation', function (e) {
            window.__cspViolations.push({
                directive: e.violatedDirective,
                blocked: e.blockedURI || '(inline)',
                source: e.sourceFile || '',
                line: e.lineNumber || 0,
                sample: e.sample || '',
                time: new Date().toISOString()
            });
        });
    </script>
    <% } %>
    <% } %>
    <style nonce="<%= nonce %>">
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background: var(--black);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ---- NAV ---- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            transition: box-shadow 0.3s;
        }

        nav.scrolled {
            box-shadow: 0 1px 20px rgba(0,0,0,0.5);
        }

        .nav-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 64px;
        }

        .nav-logo {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--text-bright);
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .nav-logo-img {
            width: 480px;
            height: auto;
            display: block;
        }

        .nav-inner {
            height: 260px;
        }

        .nav-cta {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .nav-cta:hover {
            color: var(--text-bright);
        }

        /* ---- HERO ---- */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: var(--black);
            position: relative;
        }

        .hero-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 18rem 2rem 6rem;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 4rem;
            align-items: center;
        }

        .hero-text h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            color: var(--text-bright);
            line-height: 1.12;
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero-text .sub {
            font-size: 1.15rem;
            color: var(--text);
            margin-bottom: 2.5rem;
            max-width: 520px;
            line-height: 1.7;
        }

        .hero-text .btn {
            display: inline-flex;
        }

        .hero-photo {
            background: var(--black);
            border: 1px solid var(--border);
            border-radius: 8px;
            aspect-ratio: 3 / 4;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        /* ---- BUTTONS ---- */
        .btn {
            align-items: center;
            padding: 0.9rem 2.2rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            font-family: inherit;
            letter-spacing: 0.02em;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-bright);
            border: 1px solid rgba(255,255,255,0.15);
        }

        .btn-outline:hover {
            border-color: rgba(255,255,255,0.35);
        }

        /* ---- SECTIONS ---- */
        section {
            padding: 6rem 2rem;
        }

        .section-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.7rem, 3vw, 2.2rem);
            color: var(--text-bright);
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .section-sub {
            font-size: 1.05rem;
            color: var(--text-muted);
            max-width: 600px;
            line-height: 1.75;
        }

        /* ---- DIVIDER ---- */
        .divider {
            max-width: 1100px;
            margin: 0 auto;
            height: 1px;
            background: var(--border);
        }

        /* ---- CREDENTIALS ---- */
        .credentials {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .credentials-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }

        .credential-block {
            padding: 2.5rem 0;
        }

        .credential-badge-wrap {
            position: relative;
            display: inline-block;
            margin-bottom: 1.25rem;
        }

        .credential-badge {
            width: 200px;
            height: auto;
            display: block;
            border-radius: 4px;
        }

        .credential-block h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.5rem;
        }

        .credential-block p {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.7;
        }

        .credential-stat {
            font-family: 'DM Serif Display', serif;
            font-size: 2.8rem;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        /* ---- PROBLEM ---- */
        .problem {
            background: var(--black);
        }

        .problem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3rem;
            align-items: start;
        }

        .problem-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .problem-list li {
            font-size: 1rem;
            color: var(--text);
            padding-left: 1.5rem;
            position: relative;
            line-height: 1.6;
        }

        .problem-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55rem;
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

        .problem-right p {
            font-size: 1.05rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 1.25rem;
        }

        .problem-right p strong {
            color: var(--text-bright);
        }

        /* ---- APPROACH ---- */
        .approach {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .approach-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .step {
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .step-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .step h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
        }

        .step p {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.7;
        }

        /* ---- INSIGHTS ---- */
        .insights {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .insights-header {
            margin-bottom: 3rem;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .insight-card {
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
            padding: 2rem;
            transition: border-color 0.2s;
        }

        .insight-card:hover {
            border-color: rgba(255,255,255,0.12);
        }

        .insight-tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .insight-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.35;
        }

        .insight-card p {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .insight-card a {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .insight-card a:hover {
            color: var(--text-bright);
        }

        @media (max-width: 900px) {
            .insights-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- CASE STUDY ---- */
        .case-study {
            background: var(--black);
        }

        .case-inner {
            max-width: 800px;
        }

        .case-timeline {
            margin-top: 3rem;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .case-phase {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 2rem;
            padding: 2rem 0;
            border-bottom: 1px solid var(--border);
        }

        .case-phase:last-child {
            border-bottom: none;
        }

        .phase-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            padding-top: 0.15rem;
        }

        .phase-content p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .phase-content p strong {
            color: var(--text-bright);
        }

        /* ---- CASE STUDY 2 (TRISTAN) ---- */
        .casestudy2 {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .casestudy2-inner {
            max-width: 760px;
        }

        .casestudy2-intro {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.15rem, 2vw, 1.35rem);
            color: var(--text-bright);
            line-height: 1.55;
            margin-top: 2rem;
            margin-bottom: 2.5rem;
        }

        .casestudy2-body {
            font-size: 1.05rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 2.5rem;
        }

        .casestudy2-outcome {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1.5rem 1.75rem;
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .casestudy2-outcome strong {
            color: var(--text-bright);
        }

        /* ---- ASSESSMENT ---- */
        .assessment {
            background: var(--near-black);
            border-top: 1px solid var(--border);
        }

        .assessment-inner {
            text-align: center;
            max-width: 680px;
            margin: 0 auto;
        }

        .assessment .section-heading {
            margin-bottom: 1.5rem;
        }

        .assessment p {
            font-size: 1.05rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        .assessment-questions {
            text-align: left;
            margin: 2.5rem 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .aq {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1rem 1.25rem;
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.6;
        }

        .assessment .btn {
            display: inline-flex;
            margin-bottom: 1.5rem;
        }

        .assessment .note {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ---- INTERVENTION ---- */
        .intervention {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .intervention .section-inner {
            max-width: 760px;
            text-align: center;
        }

        .intervention .section-heading {
            margin-bottom: 1.5rem;
        }

        .intervention-body {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.75;
        }

        .intervention-body strong {
            color: var(--text-bright);
        }

        /* ---- FILTER ---- */
        .filter {
            background: var(--black);
            border-top: 1px solid var(--border);
        }

        .filter-inner {
            max-width: 680px;
            margin: 0 auto;
            text-align: center;
        }

        .filter .section-heading {
            margin-bottom: 1.5rem;
        }

        .filter p {
            font-size: 1.05rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 0.75rem;
        }

        /* ---- CONTACT ---- */
        .contact {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .contact-inner {
            text-align: center;
            max-width: 580px;
            margin: 0 auto;
        }

        .contact p {
            font-size: 1rem;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .contact-details {
            display: flex;
            justify-content: center;
            gap: 2.5rem;
            flex-wrap: wrap;
        }

        .contact-details a {
            color: var(--text-bright);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        .contact-details a:hover {
            color: var(--accent);
        }

        /* ---- FOOTER ---- */
        footer {
            background: var(--black);
            border-top: 1px solid var(--border);
            padding: 2rem;
        }

        .footer-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: var(--text-muted);
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .footer-inner a {
            color: var(--text-muted);
            text-decoration: none;
        }

        .footer-inner a:hover {
            color: var(--text);
        }

        /* ---- PAGE MENU ---- */
        .page-menu {
            position: fixed;
            top: 260px;
            left: 0;
            right: 0;
            z-index: 99;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .page-menu-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            gap: 1.5rem;
            height: 36px;
            align-items: center;
        }

        .page-menu-link {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            letter-spacing: 0.03em;
            padding: 0.35rem 0;
            border-bottom: 2px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }

        .page-menu-link:hover {
            color: var(--text-bright);
        }

        .page-menu-link.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .page-menu-link.page-menu-hidden {
            opacity: 0.4;
            font-style: italic;
        }

        /* ---- FIRST-SECTION NAV CLEARANCE ---- */
        #cms-sections > section:first-child:not(.hero) {
            padding-top: 20rem;
        }

        /* ---- MOBILE ---- */
        @media (max-width: 900px) {
            .page-menu {
                top: 64px;
            }

            .nav-logo-img {
                width: 140px;
            }

            .nav-inner {
                height: 64px;
            }

            .hero-inner {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                padding-top: 6rem;
            }

            .hero-photo {
                max-width: 300px;
                margin: 0 auto;
            }

            .credentials-inner {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .credential-block {
                padding: 1.5rem 0;
            }

            .credential-block + .credential-block {
                border-top: 1px solid var(--border);
            }

            .problem-grid {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .approach-steps {
                grid-template-columns: 1fr;
            }

            .case-phase {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }

            .contact-details {
                flex-direction: column;
                gap: 1rem;
            }

            #cms-sections > section:first-child:not(.hero) {
                padding-top: 8rem;
            }
        }

        @media (max-width: 600px) {
            section {
                padding: 4rem 1.25rem;
            }

            .hero-inner {
                padding: 5.5rem 1.25rem 3.5rem;
            }

            .hero-text h1 {
                font-size: 1.85rem;
            }

            .hero-text .sub {
                font-size: 1rem;
            }

            .section-heading {
                font-size: 1.5rem;
            }

            .step {
                padding: 1.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
                text-align: center;
            }
        }
    </style>
</head>
<body>

<!-- NAV -->
<nav id="nav">
    <div class="nav-inner">
        <a href="#" class="nav-logo">
            <img src="/img/logo" alt="Arrington Business Consultancy" class="nav-logo-img">
            <% if (user) { %><button class="cms-img-btn" data-image="logo" title="Change logo">&#9998;</button><% } %>
        </a>
        <% if (hasContact) { %><a href="#conversation" class="nav-cta">Start a conversation</a><% } %>
    </div>
</nav>

<% if (allPages.length > 1) { %>
<div class="page-menu" id="pageMenu">
    <div class="page-menu-inner">
        <% for (const _p of allPages) { %>
        <a href="<%= _p.slug === 'main' ? '/' : '/' + _p.slug %>"
           class="page-menu-link<%= _p.slug === currentPage.slug ? ' active' : '' %><%= _p.hidden ? ' page-menu-hidden' : '' %>">
            <%= _p.title %>
        </a>
        <% } %>
    </div>
</div>
<% } %>

<div id="cms-sections">
<% for (let _i = 0; _i < sectionOrder.length; _i++) { %>
<% const _iid = sectionOrder[_i]; %>
<% const _tpl = instanceTemplates[_iid] || _iid; %>

<% if (_tpl === 'hero') { %>
<% const _k = _iid; %>
<!-- HERO -->
<section class="hero<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="hero-inner">
        <div class="hero-text cms-section" data-section="<%= _k %>">
            <% if (user) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
            <% if (user) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
            <% if (user) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (user) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (user) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
            <h1><%- content[_k + '.heading'] %></h1>
            <p class="sub"><%- content[_k + '.subtext'] %></p>
            <a href="#conversation" class="btn btn-primary"><%- content[_k + '.cta'] %></a>
        </div>
        <div class="hero-photo">
            <img src="/img/headshot" alt="Arrington Business Consultancy">
            <% if (user) { %><button class="cms-img-btn" data-image="headshot" title="Change photo">&#9998;</button><% } %>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'credentials') { %>
<% const _k = _iid; %>
<% const _kOx = _iid + '_oxford'; %>
<% const _kSt = _iid + '_stat'; %>
<!-- CREDENTIALS -->
<section class="credentials<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
