                <div class="google-review-header">
                    <% if (_rev.authorAttribution && _rev.authorAttribution.photoUri) { %>
                    <img src="<%= _rev.authorAttribution.photoUri %>" alt="" class="google-review-avatar" loading="lazy">
                    <% } %>
                    <div>
                        <p class="google-review-author"><%= (_rev.authorAttribution && _rev.authorAttribution.displayName) || 'Google user' %></p>
                        <span class="google-review-stars" aria-hidden="true"><%- _grStars(_rev.rating || 0) %></span>
                    </div>
                </div>
                <p class="google-review-text"><%= (_rev.text && _rev.text.text) || '' %></p>
                <p class="google-review-time"><%= _rev.relativePublishTimeDescription || '' %></p>
            </article>
            <% }); %>
        </div>
        <% } %>
    </div>
</section>
<% } %>

