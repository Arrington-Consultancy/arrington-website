<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <% if (seo.description) { %><meta name="description" content="<%= seo.description %>"><% } %>
    <% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
    <% if (seo.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
    <link rel="canonical" href="<%= seo.canonical %>">
    <%# ---- Open Graph (Facebook, LinkedIn, etc.) ---- %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= seo.siteName %>">
    <meta property="og:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta property="og:description" content="<%= seo.ogDescription %>"><% } %>
    <meta property="og:url" content="<%= seo.ogUrl %>">
    <% if (seo.ogImage) { %><meta property="og:image" content="<%= seo.ogImage %>"><% } %>
    <%# ---- Twitter card (falls back to the Open Graph values) ---- %>
    <meta name="twitter:card" content="<%= seo.ogImage ? 'summary_large_image' : 'summary' %>">
    <% if (seo.twitterHandle) { %><meta name="twitter:site" content="<%= seo.twitterHandle %>"><% } %>
    <meta name="twitter:title" content="<%= seo.ogTitle %>">
    <% if (seo.ogDescription) { %><meta name="twitter:description" content="<%= seo.ogDescription %>"><% } %>
    <% if (seo.ogImage) { %><meta name="twitter:image" content="<%= seo.ogImage %>"><% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
    </script>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% if (user) { %>
    <meta name="page-slug" content="<%= currentPage.slug %>">
    <meta name="page-hidden" content="<%= currentPage.hidden ? 'true' : 'false' %>">
    <meta name="all-pages" content="<%= JSON.stringify(allPages.map(p => ({ slug: p.slug, title: p.title }))) %>">
    <% if (showAdminPanel) { %><link rel="stylesheet" href="/css/admin.css?v=<%= Date.now() %>"><% } %>
    <% if (capabilities.view_csp) { %>
    <script nonce="<%= nonce %>">
        // Capture CSP violations as they happen so the admin menu can show
        // them (registered in <head> so we don't miss any fired during
        // initial page load).
        window.__cspViolations = [];
        document.addEventListener('securitypolicyviolation', function (e) {
            window.__cspViolations.push({
                directive: e.violatedDirective,
                blocked: e.blockedURI || '(inline)',
                source: e.sourceFile || '',
                line: e.lineNumber || 0,
                sample: e.sample || '',
                time: new Date().toISOString()
            });
        });
    </script>
    <% } %>
    <% } %>
    <style nonce="<%= nonce %>">
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background: var(--black);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ---- NAV ---- */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            transition: box-shadow 0.3s;
        }

        nav.scrolled {
            box-shadow: 0 1px 20px rgba(0,0,0,0.5);
        }

        .nav-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 88px;
        }

        .nav-logo {
            font-family: 'DM Serif Display', serif;
            font-size: 1.15rem;
            color: var(--text-bright);
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .nav-logo-img {
            width: 200px;
            height: auto;
            display: block;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .nav-cta {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .nav-cta:hover {
            color: var(--text-bright);
        }

        .nav-cta-whatsapp {
            color: #25D366;
        }

        .nav-cta-whatsapp:hover {
            color: #1da851;
        }

        /* ---- HAMBURGER ---- */
        .nav-hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 110;
        }

        .nav-hamburger span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-bright);
            border-radius: 1px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .nav-hamburger span + span {
            margin-top: 5px;
        }

        .nav-hamburger.open span:nth-child(1) {
            transform: translateY(7px) rotate(45deg);
        }

        .nav-hamburger.open span:nth-child(2) {
            opacity: 0;
        }

        .nav-hamburger.open span:nth-child(3) {
            transform: translateY(-7px) rotate(-45deg);
        }

        /* ---- MOBILE MENU ---- */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 105;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2rem;
        }

        .mobile-menu.open {
            display: flex;
        }

        .mobile-menu a {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }

        .mobile-menu a:hover,
        .mobile-menu a.active {
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-divider {
            width: 40px;
            height: 1px;
            background: var(--border);
        }

        .mobile-menu .mobile-menu-cta {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--accent);
        }

        .mobile-menu .mobile-menu-whatsapp {
            color: #25D366;
        }

        /* ---- HERO ---- */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: var(--black);
            position: relative;
        }

        .hero-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 9.5rem 2rem 6rem;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 4rem;
            align-items: center;
        }

        .hero-text h1 {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            color: var(--text-bright);
            line-height: 1.12;
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero-text .sub {
            font-size: 1.15rem;
            color: var(--text);
            margin-bottom: 2.5rem;
            max-width: 520px;
            line-height: 1.7;
        }

        .hero-text .btn {
            display: inline-flex;
        }

        .hero-photo {
            background: var(--black);
            border: 1px solid var(--border);
            border-radius: 8px;
            aspect-ratio: 3 / 4;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
        }

        /* ---- BUTTONS ---- */
        .btn {
            align-items: center;
            padding: 0.9rem 2.2rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
            font-family: inherit;
            letter-spacing: 0.02em;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-bright);
            border: 1px solid rgba(255,255,255,0.15);
        }

        .btn-outline:hover {
            border-color: rgba(255,255,255,0.35);
        }

        .btn-whatsapp {
            background: #25D366;
            color: #fff;
        }

        .btn-whatsapp:hover {
            background: #1da851;
        }

        .hero-cta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        /* ---- SECTIONS ---- */
        section {
            padding: 6rem 2rem;
        }

        .section-inner {
            max-width: 1100px;
            margin: 0 auto;
        }

        .section-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .section-heading {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.7rem, 3vw, 2.2rem);
            color: var(--text-bright);
            margin-bottom: 1rem;
            letter-spacing: -0.01em;
            line-height: 1.2;
        }

        .section-sub {
            font-size: 1.05rem;
            color: var(--text);
            max-width: 600px;
            line-height: 1.75;
        }

        /* ---- DIVIDER ---- */
        .divider {
            max-width: 1100px;
            margin: 0 auto;
            height: 1px;
            background: var(--border);
        }

        /* ---- CREDENTIALS ---- */
        .credentials {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .credentials-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
        }

        .credential-block {
            padding: 2.5rem 0;
            text-align: center;
        }

        .credential-badge-wrap {
            position: relative;
            display: inline-block;
            margin-bottom: 1.25rem;
        }

        .credential-badge {
            width: 200px;
            height: auto;
            display: block;
            border-radius: 4px;
        }

        .credential-block h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.5rem;
        }

        .credential-block p {
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.7;
        }

        .credential-stat {
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 2.3rem;
            letter-spacing: -0.01em;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        /* ---- PROBLEM ---- */
        .problem {
            background: var(--black);
        }

        .problem-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3rem;
            align-items: start;
        }

        .problem-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .problem-list li {
            font-size: 1rem;
            color: var(--text);
            padding-left: 1.5rem;
            position: relative;
            line-height: 1.6;
        }

        .problem-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55rem;
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

        .problem-right p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
        }

        .problem-right p strong {
            color: var(--text-bright);
        }

        /* ---- APPROACH ---- */
        .approach {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .approach-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .step {
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .step-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .step h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.1rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
        }

        .step p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* ---- INSIGHTS ---- */
        .insights {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .insights-header {
            margin-bottom: 3rem;
        }

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .insight-card {
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
            padding: 2rem;
            transition: border-color 0.2s;
        }

        .insight-card:hover {
            border-color: rgba(255,255,255,0.12);
        }

        .insight-tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .insight-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.35;
        }

        .insight-card p {
            font-size: 0.9rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .insight-card a {
            font-size: 0.85rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

        .insight-card a:hover {
            color: var(--text-bright);
        }

        @media (max-width: 900px) {
            .insights-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- FOUR CARDS ---- */
        .fourcards {
            background: var(--black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .fourcards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            margin-top: 3rem;
        }

        .fourcard {
            padding: 2rem 1.5rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        .fourcard-number {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 1rem;
        }

        .fourcard h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.05rem;
            color: var(--text-bright);
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .fourcard p {
            font-size: 0.88rem;
            color: var(--text);
            line-height: 1.7;
        }

        @media (max-width: 900px) {
            .fourcards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .fourcards-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---- DOCUMENTS ---- */
        .documents {
            background: var(--near-black);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .documents-header {
            display: grid;
            grid-template-columns: 1fr 0.8fr;
            gap: 4rem;
            align-items: center;
        }

        .documents-lede {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.8;
            max-width: 34rem;
            margin-top: 1.5rem;
        }

        /* Fanned montage of the document covers. Sheets are positioned by
           nth-child so the markup stays a plain list of images (no inline
           style attributes, which the strict CSP would block). */
        .documents-montage {
            position: relative;
            height: 290px;
        }

        .documents-montage img {
            position: absolute;
            top: 0;
            width: 40%;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 18px 42px rgba(0,0,0,0.55);
            background: var(--charcoal);
        }

        .documents-montage img:nth-child(1) { left: 0;   z-index: 1; transform: rotate(-7deg)   translateY(16px); }
        .documents-montage img:nth-child(2) { left: 19%; z-index: 2; transform: rotate(-2.5deg) translateY(4px); }
        .documents-montage img:nth-child(3) { left: 38%; z-index: 3; transform: rotate(2.5deg)  translateY(4px); }
        .documents-montage img:nth-child(4) { left: 57%; z-index: 4; transform: rotate(7deg)    translateY(16px); }

        /* The montage sheets are stacked with z-index, so lift the CMS
           controls above them or the edit/move buttons sit underneath. The
           solid backing keeps them legible where they overlap a white page. */
        .documents .cms-edit-btn,
        .documents .cms-move-btn {
            z-index: 5;
            background: rgba(10,10,10,0.8);
        }

        .documents-list {
            margin-top: 4.5rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .document-card {
            display: grid;
            grid-template-columns: 190px 1fr;
            gap: 2.5rem;
            align-items: start;
            padding: 2rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--charcoal);
        }

        /* A document with no preview image set gets the full card width. */
        .document-card-noimg {
            grid-template-columns: 1fr;
        }

        .document-thumb {
            display: block;
            width: 100%;
            height: auto;
            border-radius: 3px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 26px rgba(0,0,0,0.45);
        }

        .document-number {
            font-family: 'DM Serif Display', serif;
            font-size: 1.6rem;
            color: var(--accent);
            opacity: 0.4;
            line-height: 1;
            margin-bottom: 0.6rem;
        }

        .document-card h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
            line-height: 1.3;
            margin-bottom: 0.85rem;
        }

        .document-card p {
            font-size: 0.93rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.25rem;
            max-width: 40rem;
        }

        .document-meta {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .document-card .btn {
            display: inline-block;
            padding: 0.7rem 1.6rem;
            font-size: 0.85rem;
        }

        @media (max-width: 900px) {
            .documents-header {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .documents-montage {
                height: 200px;
                max-width: 420px;
            }

            .documents-list {
                margin-top: 3rem;
            }

            .document-card {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                padding: 1.5rem;
            }

            .document-thumb {
                max-width: 200px;
            }
        }

        /* ---- CASE STUDY ---- */
        .case-study {
            background: var(--black);
        }

        .case-inner {
            max-width: 800px;
        }

        .case-timeline {
            margin-top: 3rem;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .case-phase {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 2rem;
            padding: 2rem 0;
            border-bottom: 1px solid var(--border);
        }

        .case-phase:last-child {
            border-bottom: none;
        }

        .phase-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--accent);
            padding-top: 0.15rem;
        }

        .phase-content p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .phase-content p strong {
            color: var(--text-bright);
        }

        /* ---- CASE STUDY 2 (TRISTAN) ---- */
        .casestudy2 {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .casestudy2-inner {
            max-width: 760px;
        }

        .casestudy2-intro {
            font-family: 'DM Serif Display', serif;
            font-size: clamp(1.15rem, 2vw, 1.35rem);
            color: var(--text-bright);
            line-height: 1.55;
            margin-top: 2rem;
            margin-bottom: 2.5rem;
        }

        .casestudy2-body {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 2.5rem;
        }

        .casestudy2-outcome {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1.5rem 1.75rem;
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
        }

        .casestudy2-outcome strong {
            color: var(--text-bright);
        }

        /* ---- ASSESSMENT ---- */
        .assessment {
            background: var(--near-black);
            border-top: 1px solid var(--border);
        }

        .assessment-inner {
            text-align: center;
            max-width: 680px;
            margin: 0 auto;
        }

        .assessment .section-heading {
            margin-bottom: 1.5rem;
        }

        .assessment p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 1.5rem;
        }

        .assessment-questions {
            text-align: left;
            margin: 2.5rem 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .aq {
            background: var(--charcoal);
            border-left: 3px solid var(--accent);
            border-radius: 4px;
            padding: 1rem 1.25rem;
            font-size: 0.95rem;
            color: var(--text);
            line-height: 1.6;
        }

        .assessment .btn {
            display: inline-flex;
            margin-bottom: 1.5rem;
        }

        .assessment .note {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ---- INTERVENTION ---- */
        .intervention {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .intervention .section-inner {
            max-width: 760px;
            text-align: center;
        }

        .intervention .section-heading {
            margin-bottom: 1.5rem;
        }

        .intervention-body {
            font-size: 1.1rem;
            color: var(--text);
            line-height: 1.75;
        }

        .intervention-body strong {
            color: var(--text-bright);
        }

        .intervention .btn {
            display: inline-flex;
            margin-top: 2.25rem;
        }

        /* ---- FILTER ---- */
        .filter {
            background: var(--black);
            border-top: 1px solid var(--border);
        }

        .filter-inner {
            max-width: 680px;
            margin: 0 auto;
            text-align: center;
        }

        .filter .section-heading {
            margin-bottom: 1.5rem;
        }

        .filter p {
            font-size: 1.05rem;
            color: var(--text);
            line-height: 1.75;
            margin-bottom: 0.75rem;
        }

        .filter .btn {
            display: inline-flex;
            margin-top: 2.25rem;
        }

        /* ---- PROOF STRIP ---- */
        .proofstrip {
            background: var(--bg);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .proofstrip-inner {
            max-width: 1000px;
            margin: 0 auto;
        }

        .proofstrip .section-label {
            text-align: center;
            margin-bottom: 2rem;
        }

        .proofstrip-rows {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            border-top: 1px solid var(--border);
        }

        .proof-row {
            padding: 1.75rem 1.5rem;
            text-align: center;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .proof-row:last-child {
            border-right: 0;
        }

        .proof-action {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-weight: 500;
            color: var(--accent);
        }

        .proof-client {
            font-family: 'DM Serif Display', serif;
            font-size: 1.2rem;
            color: var(--text-bright);
            line-height: 1.3;
        }

        /* ---- CONTACT (in footer) ---- */

        /* ---- FOOTER ---- */
        footer {
            background: var(--dark-grey);
            border-top: 1px solid var(--border);
        }

        .footer-contact {
            text-align: center;
            max-width: 580px;
            margin: 0 auto;
            padding: 5rem 2rem;
        }

        .footer-contact p {
            font-size: 1rem;
            color: var(--text);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .footer-contact .contact-details {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 2.5rem;
            flex-wrap: wrap;
        }

        .footer-contact .contact-details a {
            color: var(--text-bright);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        .footer-contact .contact-details a:hover {
            color: var(--accent);
        }

        .lead-form {
            text-align: left;
            margin: 0 0 2rem;
        }

        .lead-hp {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .lead-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.9rem;
            margin-bottom: 0.9rem;
        }

        .lead-form input,
        .lead-form textarea {
            width: 100%;
            background: var(--charcoal);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.8rem 1rem;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-bright);
        }

        .lead-form textarea {
            margin-bottom: 1.1rem;
            resize: vertical;
        }

        .lead-form input::placeholder,
        .lead-form textarea::placeholder {
            color: var(--text-muted);
        }

        .lead-form input:focus,
        .lead-form textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .lead-form-status {
            margin: 0.9rem 0 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            min-height: 1.2em;
        }

        .lead-form-status.lead-form-error {
            color: #e07a6d;
        }

        .lead-form-alt {
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1rem !important;
        }

        @media (max-width: 600px) {
            .lead-row {
                grid-template-columns: 1fr;
            }
        }

        /* ---- GATED PDF DOWNLOAD MODAL ---- */
        .doc-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(6px);
            z-index: 200;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .doc-modal-overlay.open {
            display: flex;
        }

        .doc-modal {
            position: relative;
            background: var(--dark-grey);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 2.5rem;
            max-width: 420px;
            width: 100%;
        }

        .doc-modal h3 {
            font-family: 'DM Serif Display', serif;
            font-size: 1.4rem;
            margin-bottom: 0.6rem;
            color: var(--text-bright);
        }

        .doc-modal p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .doc-modal input {
            width: 100%;
            background: var(--charcoal);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 0.8rem 1rem;
            font-family: inherit;
            font-size: 0.92rem;
            color: var(--text-bright);
            margin-bottom: 1rem;
        }

        .doc-modal input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .doc-modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1rem;
            cursor: pointer;
        }

        .doc-modal-close:hover {
            color: var(--text-bright);
        }

        .footer-credit {
            position: relative;
            text-align: center;
            padding: 1.5rem 2rem 2.25rem;
            font-size: 0.78rem;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .footer-links {
            text-align: center;
            padding: 0 2rem;
        }

        .footer-links a {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }

        .footer-links a:hover {
            color: var(--text-bright);
            border-bottom-color: var(--text-bright);
        }

        /* ---- PAGE MENU ---- */
        .page-menu {
            position: fixed;
            top: 88px;
            left: 0;
            right: 0;
            z-index: 99;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }

        .page-menu-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            gap: 1.5rem;
            height: 36px;
            align-items: center;
        }

        .page-menu-link {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            letter-spacing: 0.03em;
            padding: 0.35rem 0;
            border-bottom: 2px solid transparent;
            transition: color 0.2s, border-color 0.2s;
        }

        .page-menu-link:hover {
            color: var(--text-bright);
        }

        .page-menu-link.active {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .page-menu-link.page-menu-hidden {
            opacity: 0.4;
            font-style: italic;
        }

        /* ---- FIRST-SECTION NAV CLEARANCE ---- */
        #cms-sections > section:first-child:not(.hero) {
            padding-top: 8.5rem;
        }

        /* ---- MOBILE ---- */
        @media (max-width: 900px) {
            .nav-hamburger {
                display: block;
            }

            .nav-actions {
                display: none;
            }

            .page-menu {
                display: none;
            }

            .nav-logo-img {
                width: 140px;
            }

            .nav-inner {
                height: 64px;
            }

            .hero-inner {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                padding-top: 6rem;
            }

            .hero-photo {
                max-width: 300px;
                margin: 0 auto;
            }

            .credentials-inner {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .credential-block {
                padding: 1.5rem 0;
            }

            .credential-block + .credential-block {
                border-top: 1px solid var(--border);
            }

            .problem-grid {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

            .approach-steps {
                grid-template-columns: 1fr;
            }

            .case-phase {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }

            .footer-contact .contact-details {
                flex-direction: column;
                gap: 1rem;
            }

            .proofstrip-rows {
                grid-template-columns: 1fr;
            }

            .proof-row {
                border-right: 0;
                border-bottom: 1px solid var(--border);
            }

            .proof-row:last-child {
                border-bottom: 0;
            }

            #cms-sections > section:first-child:not(.hero) {
                padding-top: 8rem;
            }
        }

        @media (max-width: 600px) {
            section {
                padding: 4rem 1.25rem;
            }

            .hero-inner {
                padding: 5.5rem 1.25rem 3.5rem;
            }

            .hero-text h1 {
                font-size: 1.85rem;
            }

            .hero-text .sub {
                font-size: 1rem;
            }

            .section-heading {
                font-size: 1.5rem;
            }

            .step {
                padding: 1.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
                text-align: center;
            }
        }
    </style>
</head>
<body>

<!-- NAV -->
<nav id="nav">
    <div class="nav-inner">
        <a href="/" class="nav-logo">
            <img src="/img/logo" alt="Arrington Business Consultancy" class="nav-logo-img">
            <% if (canEdit) { %><button class="cms-img-btn" data-image="logo" title="Change logo">&#9998;</button><% } %>
        </a>
        <div class="nav-actions">
            <a href="#conversation" class="nav-cta"><%= content['contact.label'] %></a>
            <% const _navWa = (content['contact.whatsapp'] || '').trim(); %>
            <% if (/^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_navWa)) { %>
            <a href="<%= _navWa %>" class="nav-cta nav-cta-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
            <% } %>
        </div>
        <button class="nav-hamburger" id="navHamburger" aria-label="Menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
    <% if (allPages.length > 1) { %>
        <% for (const _p of allPages) { %>
            <% if (!_p.hidden || canEdit) { %>
            <a href="<%= _p.slug === 'main' ? '/' : '/' + _p.slug %>"
               class="<%= _p.slug === currentPage.slug ? 'active' : '' %>">
                <%= _p.nav_label || _p.title %>
            </a>
            <% } %>
        <% } %>
        <div class="mobile-menu-divider"></div>
    <% } %>
    <a href="#conversation" class="mobile-menu-cta"><%= content['contact.label'] %></a>
    <% const _mWa = (content['contact.whatsapp'] || '').trim(); %>
    <% if (/^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_mWa)) { %>
    <a href="<%= _mWa %>" class="mobile-menu-cta mobile-menu-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
    <% } %>
</div>

<% if (allPages.length > 1) { %>
<div class="page-menu" id="pageMenu">
    <div class="page-menu-inner">
        <% for (const _p of allPages) { %>
        <a href="<%= _p.slug === 'main' ? '/' : '/' + _p.slug %>"
           class="page-menu-link<%= _p.slug === currentPage.slug ? ' active' : '' %><%= ((_p.hidden || !_p.show_in_nav) && canEdit) ? ' page-menu-hidden' : '' %>"
           <% if (canEdit && !_p.hidden && !_p.show_in_nav) { %>title="Out of the main nav (Show in nav is off), but reachable by direct URL and indexed"<% } %>>
            <%= _p.nav_label || _p.title %>
        </a>
        <% } %>
    </div>
</div>
<% } %>

<div id="cms-sections">
<% for (let _i = 0; _i < sectionOrder.length; _i++) { %>
<% const _iid = sectionOrder[_i]; %>
<% const _tpl = instanceTemplates[_iid] || _iid; %>

<% if (_tpl === 'hero') { %>
<% const _k = _iid; %>
<% const _heroImg = _iid === 'hero' ? 'headshot' : 'headshot__' + _iid; %>
<!-- HERO -->
<section class="hero<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="hero-inner">
        <div class="hero-text cms-section" data-section="<%= _k %>">
            <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
            <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
            <h1><%- content[_k + '.heading'] %></h1>
            <p class="sub"><%- content[_k + '.subtext'] %></p>
            <%
              const _heroWa = (content[_k + '.whatsapp'] || '').trim();
              const _heroWaValid = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_heroWa);
            %>
            <div class="hero-cta-row">
                <a href="#conversation" class="btn btn-primary"><%- content[_k + '.cta'] %></a>
                <% if (_heroWaValid) { %>
                <a href="<%= _heroWa %>" class="btn btn-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
                <% } %>
            </div>
        </div>
        <div class="hero-photo">
            <img src="/img/<%= _heroImg %>" alt="Arrington Business Consultancy">
            <% if (canEdit) { %><button class="cms-img-btn" data-image="<%= _heroImg %>" title="Change photo">&#9998;</button><% } %>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'credentials') { %>
<% const _k = _iid; %>
<% const _kOx = _iid + '_oxford'; %>
<% const _kSt = _iid + '_stat'; %>
<!-- CREDENTIALS -->
<section class="credentials<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner">
        <div class="credentials-inner">
            <div class="credential-block cms-section" data-section="<%= _kSt %>">
                <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _kSt %>" title="Edit section">&#9998;</button><% } %>
                <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
                <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
                <div class="credential-stat"><%- content[_kSt + '.stat'] %></div>
                <p><%- content[_kSt + '.text'] %></p>
            </div>
            <div class="credential-block cms-section" data-section="<%= _kOx %>">
                <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _kOx %>" title="Edit section">&#9998;</button><% } %>
                <div class="credential-badge-wrap">
                    <img src="/img/oxford" alt="Said Business School, University of Oxford" class="credential-badge">
                    <% if (canEdit) { %><button class="cms-img-btn" data-image="oxford" title="Change badge">&#9998;</button><% } %>
                </div>
                <h3><%- content[_kOx + '.title'] %></h3>
                <p><%- content[_kOx + '.text'] %></p>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'biography') { %>
<% const _k = _iid; %>
<!-- BIOGRAPHY -->
<section class="problem<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <p class="section-label"><%- content[_k + '.label'] %></p>
        <h2 class="section-heading"><%- content[_k + '.heading'] %></h2>
        <div class="problem-grid">
            <div class="problem-right">
                <p><%- content[_k + '.col_1_p1'] %></p>
                <p><%- content[_k + '.col_1_p2'] %></p>
            </div>
            <div class="problem-right">
                <p><%- content[_k + '.col_2_p1'] %></p>
                <p><%- content[_k + '.col_2_p2'] %></p>
            </div>
        </div>
    </div>
</section>
<% } %>

<% if (_tpl === 'intervention') { %>
<% const _k = _iid; %>
<!-- INTERVENTION -->
<section class="intervention<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
    <div class="section-inner cms-section" data-section="<%= _k %>">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="<%= _k %>" title="Edit section">&#9998;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-up" data-section-id="<%= _iid %>" title="Move up">&#9650;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-move-down" data-section-id="<%= _iid %>" title="Move down">&#9660;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-hide-btn<%= (hiddenSections || []).includes(_iid) ? ' cms-hide-btn-on' : '' %>" data-section-id="<%= _iid %>" title="<%= (hiddenSections || []).includes(_iid) ? 'Show section' : 'Hide section' %>">&#128065;</button><% } %>
        <% if (canEdit) { %><button class="cms-move-btn cms-delete-btn" data-section-id="<%= _iid %>" title="Delete section">&#10005;</button><% } %>
        <h2 class="section-heading"><%- content[_k + '.heading'] %></h2>
        <p class="intervention-body"><%- content[_k + '.subtext'] %></p>
        <%
          const _btnText = (content[_k + '.button_text'] || '').replace(/<[^>]+>/g, '').trim();
          const _btnSlug = (content[_k + '.button_link'] || '').trim();
          const _validSlug = /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(_btnSlug);
          const _btnHref = _btnSlug === 'main' ? '/' : (_validSlug ? '/' + _btnSlug : '#conversation');
        %>
        <% if (_btnText) { %>
        <a href="<%= _btnHref %>" class="btn btn-primary"><%- content[_k + '.button_text'] %></a>
        <% } %>
    </div>
</section>
<% } %>

<% if (_tpl === 'approach') { %>
<% const _k = _iid; %>
<!-- APPROACH -->
<section class="approach<%= (hiddenSections || []).includes(_iid) ? ' cms-section-hidden' : '' %>" data-section-id="<%= _iid %>">
