<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in - Arrington</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
    </script>
    <style nonce="<%= nonce %>">
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        html { font-size: 16px; }
        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--black);
            color: var(--text);
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
            position: relative;
            overflow: hidden;
            padding: 1.5rem;
        }

        /* Two soft accent glows drifting behind the card. Pure CSS, no
           images, theme-aware since they read the active accent colour -
           restrained enough to still look right on the light theme, where
           the glow just becomes a faint warm vignette. */
        body::before,
        body::after {
            content: '';
            position: fixed;
            width: 60vmax;
            height: 60vmax;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.16;
            pointer-events: none;
            z-index: 0;
        }
        body::before {
            top: -20vmax;
            left: -15vmax;
            background: radial-gradient(circle, var(--accent), transparent 65%);
            animation: drift1 22s ease-in-out infinite alternate;
        }
        body::after {
            bottom: -22vmax;
            right: -18vmax;
            background: radial-gradient(circle, var(--accent-hover), transparent 65%);
            animation: drift2 26s ease-in-out infinite alternate;
        }
        @keyframes drift1 {
            from { transform: translate(0, 0) scale(1); }
            to   { transform: translate(4vmax, 3vmax) scale(1.08); }
        }
        @keyframes drift2 {
            from { transform: translate(0, 0) scale(1); }
            to   { transform: translate(-3vmax, -4vmax) scale(1.1); }
        }

        .login-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 380px;
            padding: 3rem 2.5rem 2.5rem;
            background: color-mix(in srgb, var(--charcoal) 88%, transparent);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow:
                0 1px 0 0 color-mix(in srgb, var(--text-bright) 6%, transparent) inset,
                0 30px 60px -20px rgba(0, 0, 0, 0.55),
                0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent);
            animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        @keyframes rise {
            from { opacity: 0; transform: translateY(14px) scale(0.985); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        @media (prefers-reduced-motion: reduce) {
            .login-card { animation: none; }
            body::before, body::after { animation: none; }
        }

        .login-logo {
            display: block;
            text-decoration: none;
            margin-bottom: 1.75rem;
        }
        .login-logo img {
            width: 100%;
            max-width: 230px;
            height: auto;
            display: block;
            margin: 0 auto;
            filter: drop-shadow(0 8px 24px color-mix(in srgb, var(--accent) 20%, transparent));
        }
        .login-kicker {
            display: block;
            text-align: center;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-top: 1rem;
        }

        .login-rule {
            height: 1px;
            margin: 1.75rem 0 1.85rem;
            background: linear-gradient(90deg, transparent, var(--border) 20%, var(--border) 80%, transparent);
        }

        .form-group { margin-bottom: 1.35rem; }
        .form-group label {
            display: block;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }
        .form-group input {
            width: 100%;
            padding: 0.8rem 1rem;
            background: color-mix(in srgb, var(--dark-grey) 92%, transparent);
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text-bright);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }
        .form-group input:hover {
            border-color: color-mix(in srgb, var(--text-muted) 60%, var(--border));
        }
        .form-group input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
            background: color-mix(in srgb, var(--dark-grey) 100%, transparent);
        }

        .login-btn {
            width: 100%;
            padding: 0.9rem;
            margin-top: 0.4rem;
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            color: #fff;
            border: none;
            border-radius: 7px;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 0.03em;
            box-shadow: 0 8px 20px -6px color-mix(in srgb, var(--accent) 55%, transparent);
            transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }
        .login-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 26px -6px color-mix(in srgb, var(--accent) 65%, transparent);
            filter: brightness(1.05);
        }
        .login-btn:active {
            transform: translateY(0);
            filter: brightness(0.97);
        }
        .login-btn:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .error {
            background: rgba(220, 53, 69, 0.12);
            border: 1px solid rgba(220, 53, 69, 0.3);
            color: #f5a0a8;
            padding: 0.7rem 1rem;
            border-radius: 7px;
            font-size: 0.85rem;
            margin-bottom: 1.35rem;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 1.75rem;
            font-size: 0.82rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .back-link:hover { color: var(--accent); }
    </style>
</head>
<body>
    <div class="login-card">
        <a href="/" class="login-logo">
            <img src="/img/logo" alt="Arrington Business Consultancy">
            <span class="login-kicker">Client &amp; team access</span>
        </a>
        <div class="login-rule"></div>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form method="POST" action="/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="next" value="<%= nextPath || '/' %>">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" required autofocus>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="login-btn">Log in</button>
        </form>
        <a href="/" class="back-link">Back to site</a>
    </div>
</body>
</html>
