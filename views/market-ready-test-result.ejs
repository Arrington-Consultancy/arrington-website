<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your New Owner Ready Score | Arrington Consultancy</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
            --mrt-red: #c0524a; --mrt-red-bg: rgba(192,82,74,0.12);
            --mrt-amber: #c98a3e; --mrt-amber-bg: rgba(201,138,62,0.12);
            --mrt-green: #4a8f6a; --mrt-green-bg: rgba(74,143,106,0.12);
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
        body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--black); color: var(--text); line-height: 1.65; }
        header {
            padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        }
        header img { height: 32px; width: auto; }
        header a.mrt-back-link { font-size: 0.85rem; color: var(--text-muted); text-decoration: none; white-space: nowrap; }
        header a.mrt-back-link:hover { color: var(--accent); }
        main { max-width: 700px; margin: 0 auto; padding: 2.5rem 1.5rem 6rem; }
        .mrt-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--accent); margin-bottom: 0.9rem; }
        h1, h2, h3 { font-family: 'DM Serif Display', serif; font-weight: 400; color: var(--text-bright); line-height: 1.25; margin: 0 0 1rem; text-wrap: balance; }
        h1 { font-size: clamp(1.7rem, 5vw, 2.2rem); }
        h2 { font-size: 1.3rem; margin-top: 2.5rem; }
        h3 { font-size: 1.05rem; margin-bottom: 0.5rem; }
        p { color: var(--text); margin: 0 0 1.1rem; }

        .mrt-score-block {
            display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;
            padding: 1.6rem 1.7rem; border: 1px solid var(--border); border-radius: 6px; margin-bottom: 1.5rem;
        }
        .mrt-score-num { font-family: 'DM Serif Display', serif; font-size: 2.4rem; color: var(--text-bright); line-height: 1; font-variant-numeric: tabular-nums; }
        .mrt-score-rating { font-size: 0.95rem; color: var(--accent); font-weight: 600; flex-basis: 100%; }

        .mrt-share { margin: 0 0 1.75rem; padding: 1.1rem 1.3rem; border: 1px solid var(--border); border-radius: 6px; }
        .mrt-share-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; color: var(--text-muted); margin: 0 0 0.85rem; }
        .mrt-share-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
        .mrt-share-btn {
            display: inline-flex; align-items: center; gap: 0.45rem; font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem; font-weight: 600; padding: 0.55rem 1rem; border-radius: 3px;
            border: 1px solid var(--border); background: transparent; color: var(--text-bright);
            text-decoration: none; cursor: pointer;
        }
        .mrt-share-btn:hover, .mrt-share-btn:focus-visible { border-color: var(--accent); color: var(--accent); }
        .mrt-share-icon { flex-shrink: 0; }
        .mrt-share-status { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--accent); }

        .mrt-block { padding: 1.1rem 0; border-top: 1px solid var(--border); }
        .mrt-block:first-of-type { border-top: none; }
        .mrt-block h3 { margin-bottom: 0.35rem; }
        .mrt-block p { font-size: 0.95rem; }
        .mrt-evidence-ref { font-size: 0.8rem; color: var(--text-muted); }

        .mrt-flag { border-left: 3px solid var(--mrt-red); background: var(--mrt-red-bg); padding: 0.9rem 1.1rem; border-radius: 0 4px 4px 0; margin-bottom: 0.9rem; }
        .mrt-flag h3 { color: var(--mrt-red); font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.95rem; }

        .mrt-category { padding: 1rem 0; border-top: 1px solid var(--border); }
        .mrt-category:first-of-type { border-top: none; }
        .mrt-category-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
        .mrt-category-name { font-weight: 600; color: var(--text-bright); }
        .mrt-category-score { font-variant-numeric: tabular-nums; color: var(--accent); font-weight: 700; }
        .mrt-category p { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.4rem; margin-bottom: 0; }

        .mrt-priority { padding: 1.1rem 0; border-top: 1px solid var(--border); }
        .mrt-priority:first-of-type { border-top: none; }
        .mrt-priority-action { font-weight: 600; color: var(--text-bright); margin-bottom: 0.4rem; }
        .mrt-priority-why, .mrt-priority-evidence { font-size: 0.9rem; margin-bottom: 0.3rem; }
        .mrt-priority-evidence { color: var(--text-muted); }

        ul.mrt-list { margin: 0 0 1.1rem; padding-left: 1.3rem; }
        ul.mrt-list li { margin-bottom: 0.6rem; font-size: 0.95rem; }

        .mrt-closing { padding: 1.2rem 1.3rem; background: var(--charcoal, rgba(255,255,255,0.03)); border-radius: 6px; margin: 1.5rem 0; }
        .mrt-closing p { margin: 0; font-size: 0.92rem; color: var(--text-muted); }

        .mrt-next-step { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); }
        .mrt-cta-actions { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem; }
        .btn { display: inline-block; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; padding: 0.85rem 1.75rem; border-radius: 3px; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
        .btn-primary { background: var(--accent); color: var(--black); border-color: var(--accent); }
        .btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-primary:disabled { opacity: 0.6; cursor: default; }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover { border-color: var(--accent); color: var(--accent); }
        button.btn { font: inherit; }
        .mrt-request-status { margin-top: 0.75rem; font-size: 0.85rem; color: var(--accent); }

        @media (max-width: 480px) {
            .mrt-cta-actions { flex-direction: column; }
            .mrt-cta-actions .btn { text-align: center; }
        }
    </style>
</head>
<body>
    <header>
        <a href="/" aria-label="Arrington Consultancy home"><img src="/img/logo" alt="Arrington Business Consultancy"></a>
        <a href="/" class="mrt-back-link">&larr; Back to site</a>
    </header>

    <main>
        <p class="mrt-label">YOUR RESULT</p>
        <h1>Hello <%= firstName %>, here is your New Owner Ready Score</h1>

        <div class="mrt-score-block">
            <div class="mrt-score-num"><%= report.overall_score %>/100</div>
            <div class="mrt-score-rating"><%= report.rating %></div>
        </div>

        <div class="mrt-share">
            <p class="mrt-share-label">Share your result</p>
            <div class="mrt-share-actions">
                <a href="#" id="mrt-share-linkedin" target="_blank" rel="noopener" class="mrt-share-btn">
                    <svg class="mrt-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    LinkedIn
                </a>
                <a href="#" id="mrt-share-facebook" target="_blank" rel="noopener" class="mrt-share-btn">
                    <svg class="mrt-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.675 0h-21.35C.6 0 0 .6 0 1.326v21.348C0 23.4.6 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24h-1.918c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.4 24 24 23.4 24 22.674V1.326C24 .6 23.4 0 22.675 0"/></svg>
                    Facebook
                </a>
                <a href="#" id="mrt-share-x" target="_blank" rel="noopener" class="mrt-share-btn">
                    <svg class="mrt-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    X
                </a>
                <button type="button" id="mrt-share-copy-text" class="mrt-share-btn">Copy result text</button>
                <button type="button" id="mrt-share-copy-link" class="mrt-share-btn">Copy result link</button>
            </div>
            <p class="mrt-share-status" id="mrt-share-status" role="status" hidden></p>
        </div>

        <p><%= report.opening_assessment %></p>

        <% if ((report.strengths || []).length) { %>
        <h2>What strengthens the business</h2>
        <% report.strengths.forEach(function(s) { %>
        <div class="mrt-block">
            <h3><%= s.title %></h3>
            <p><%= s.explanation %></p>
        </div>
        <% }); %>
        <% } %>

        <% if ((report.concerns || []).length) { %>
        <h2>What may make a buyer hesitate</h2>
        <% report.concerns.forEach(function(c) { %>
        <div class="mrt-block">
            <h3><%= c.title %></h3>
            <p><%= c.explanation %></p>
        </div>
        <% }); %>
        <% } %>

        <h2>Red flags</h2>
        <% if ((report.red_flags || []).length) { %>
        <% report.red_flags.forEach(function(r) { %>
        <div class="mrt-flag">
            <h3><%= r.title %></h3>
            <p style="margin:0;"><%= r.explanation %></p>
        </div>
        <% }); %>
        <% } else { %>
        <p>No red flags were identified from your answers.</p>
        <% } %>

        <% if ((report.contradictions || []).length) { %>
        <h2>Where your answers do not fully align</h2>
        <% report.contradictions.forEach(function(c) { %>
        <div class="mrt-block">
            <h3><%= c.title %></h3>
            <p><%= c.explanation %></p>
        </div>
        <% }); %>
        <% } %>

        <% if ((report.buyer_questions || []).length) { %>
        <h2>What a serious buyer would ask next</h2>
        <ul class="mrt-list">
            <% report.buyer_questions.forEach(function(q) { %>
            <li><%= q %></li>
            <% }); %>
        </ul>
        <% } %>

        <% if ((report.priorities || []).length) { %>
        <h2>Priorities before approaching the market</h2>
        <% report.priorities.forEach(function(p) { %>
        <div class="mrt-priority">
            <div class="mrt-priority-action"><%= p.action %></div>
            <div class="mrt-priority-why"><%= p.why_it_matters %></div>
            <div class="mrt-priority-evidence">A buyer would expect to see: <%= p.evidence_a_buyer_would_expect %></div>
        </div>
        <% }); %>
        <% } %>

        <h2>Category scores</h2>
        <%
          const catLabels = {
            transferability: ['Transferability', 20],
            commercial_resilience: ['Commercial resilience', 20],
            financial_credibility: ['Financial and evidential credibility', 15],
            preparation_for_sale: ['Preparation for sale', 15],
            buyer_confidence: ['Buyer confidence', 15],
            owner_readiness: ['Owner readiness', 15]
          };
        %>
        <% for (const [key, [label, max]] of Object.entries(catLabels)) { %>
        <div class="mrt-category">
            <div class="mrt-category-head">
                <span class="mrt-category-name"><%= label %></span>
                <span class="mrt-category-score"><%= report.category_scores[key] %>/<%= max %></span>
            </div>
            <% if (report.category_explanations && report.category_explanations[key]) { %>
            <p><%= report.category_explanations[key] %></p>
            <% } %>
        </div>
        <% } %>

        <% if ((report.needs_checking || []).length) { %>
        <h2>What still needs checking</h2>
        <ul class="mrt-list">
            <% report.needs_checking.forEach(function(item) { %>
            <li><%= item %></li>
            <% }); %>
        </ul>
        <% } %>

        <div class="mrt-closing">
            <p><%= report.closing_statement %></p>
            <p style="margin-top:0.9rem;">This assessment is based entirely on what you told us. It is not a valuation and it does not replace legal, financial or tax advice.</p>
        </div>

        <div class="mrt-next-step">
            <h2>Want Tom to challenge the result?</h2>
            <p>This score is based entirely on your own answers. It cannot walk through the business, test the evidence or challenge the assumptions behind what you have said.</p>
            <p>Tom Arrington has bought, built and sold owner run businesses himself. A proper commercial review looks at what is really happening, what a buyer is likely to question and what is worth strengthening before you approach the market.</p>
            <div class="mrt-cta-actions">
                <button type="button" class="btn btn-primary" id="mrt-ask-tom" data-token="<%= resultToken %>">Ask Tom to review my result</button>
                <a href="/#conversation" class="btn btn-outline">Talk to us</a>
            </div>
            <p class="mrt-request-status" id="mrt-request-status" role="status" hidden></p>
        </div>
    </main>

    <script nonce="<%= nonce %>">
    (function () {
        var score = <%= report.overall_score %>;
        var rating = <%- JSON.stringify(report.rating) %>;
        var resultToken = <%- JSON.stringify(resultToken) %>;
        var shareUrl = window.location.href;
        var shareMessage = 'I scored ' + score + '/100 (' + rating + ') on Arrington Consultancy\'s Market Ready Test, a straight assessment of how ready a business is to be taken over by a new owner. Worth five minutes if you run one.';

        document.getElementById('mrt-share-x').href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareMessage) + '&url=' + encodeURIComponent(shareUrl);
        document.getElementById('mrt-share-facebook').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareUrl);
        document.getElementById('mrt-share-linkedin').href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(shareUrl);

        function copyToClipboard(text, cb) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(cb, cb);
            } else {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta);
                cb();
            }
        }

        function showShareStatus(text) {
            var el = document.getElementById('mrt-share-status');
            el.textContent = text;
            el.hidden = false;
        }

        function notifyShare(platform) {
            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            fetch('/api/market-ready-test/share-notify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ token: resultToken, platform: platform })
            }).catch(function () {});
        }

        ['mrt-share-linkedin', 'mrt-share-facebook', 'mrt-share-x'].forEach(function (id) {
            document.getElementById(id).addEventListener('click', function () {
                notifyShare(id.replace('mrt-share-', ''));
            });
        });

        document.getElementById('mrt-share-copy-text').addEventListener('click', function () {
            copyToClipboard(shareMessage + ' ' + shareUrl, function () {
                showShareStatus('Result text copied.');
                notifyShare('copy_text');
            });
        });

        document.getElementById('mrt-share-copy-link').addEventListener('click', function () {
            copyToClipboard(shareUrl, function () {
                showShareStatus('Link copied.');
                notifyShare('copy_link');
            });
        });

        var btn = document.getElementById('mrt-ask-tom');
        var status = document.getElementById('mrt-request-status');
        btn.addEventListener('click', function () {
            btn.disabled = true;
            btn.textContent = 'Sending...';
            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            fetch('/api/market-ready-test/request-review', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ token: btn.getAttribute('data-token') })
            }).then(function (res) { return res.json().catch(function () { return {}; }); })
              .then(function (data) {
                status.hidden = false;
                if (data && data.ok) {
                    btn.textContent = 'Tom will be in touch';
                    status.textContent = 'Thanks — Tom has been sent your result and will be in touch.';
                } else {
                    btn.disabled = false;
                    btn.textContent = 'Ask Tom to review my result';
                    status.textContent = (data && data.error) || 'Something went wrong. Please try again or email tom@arringtonconsultancy.com directly.';
                }
            }).catch(function () {
                btn.disabled = false;
                btn.textContent = 'Ask Tom to review my result';
                status.hidden = false;
                status.textContent = 'Something went wrong. Please try again or email tom@arringtonconsultancy.com directly.';
            });
        });
    })();
    </script>
</body>
</html>
