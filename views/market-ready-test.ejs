<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Market Ready Test | Arrington Consultancy</title>
    <meta name="description" content="A ten-question assessment of whether your business could be taken over successfully by a new owner.">
    <meta name="robots" content="noindex, nofollow">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="turnstile-site-key" content="<%= turnstileSiteKey %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }
        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: var(--black);
            color: var(--text);
            line-height: 1.6;
        }
        <%- include('partials/site-chrome-styles') %>
        main {
            max-width: 680px;
            margin: 0 auto;
            padding: calc(88px + 2.5rem) 1.5rem 6rem;
        }
        @media (max-width: 900px) {
            main { padding-top: calc(64px + 2.5rem); }
        }
        .mrt-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.9rem;
        }
        h1, h2, h3 {
            font-family: 'DM Serif Display', serif;
            font-weight: 400;
            color: var(--text-bright);
            line-height: 1.25;
            margin: 0 0 1rem;
            text-wrap: balance;
        }
        h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); }
        h2 { font-size: 1.35rem; }
        p { color: var(--text); margin: 0 0 1.2rem; }
        .mrt-meta { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 2rem; }

        .btn {
            display: inline-block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            padding: 0.85rem 1.75rem;
            border-radius: 3px;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .btn-primary { background: var(--accent); color: var(--black); border-color: var(--accent); }
        .btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }
        button.btn { font: inherit; }

        .mrt-screen { display: none; }
        .mrt-screen.active { display: block; }

        .mrt-progress { height: 3px; background: var(--border); border-radius: 2px; margin-bottom: 2rem; overflow: hidden; }
        .mrt-progress-bar { height: 100%; background: var(--accent); width: 0%; transition: width 0.3s ease; }

        .mrt-field { margin-bottom: 1.4rem; }
        .mrt-field label { display: block; font-size: 0.9rem; font-weight: 600; color: var(--text-bright); margin-bottom: 0.5rem; }
        .mrt-field .mrt-optional { font-weight: 400; color: var(--text-muted); font-size: 0.82rem; }
        .mrt-field input[type="text"], .mrt-field input[type="email"], .mrt-field input[type="tel"], .mrt-field select, .mrt-field textarea {
            width: 100%;
            font-family: 'DM Sans', sans-serif;
            font-size: 1rem;
            padding: 0.85rem 1rem;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-bright);
        }
        .mrt-field input:focus-visible, .mrt-field select:focus-visible, .mrt-field textarea:focus-visible {
            outline: none; border-color: var(--accent);
        }
        .mrt-field textarea { min-height: 160px; resize: vertical; line-height: 1.6; }
        .mrt-field-hint { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.5rem; }

        fieldset { border: none; margin: 0; padding: 0; }
        legend { font-family: 'DM Serif Display', serif; font-size: 1.35rem; color: var(--text-bright); margin-bottom: 1.25rem; padding: 0; line-height: 1.3; text-wrap: balance; }
        .mrt-options { display: flex; flex-direction: column; gap: 0.75rem; }
        .mrt-option { display: block; position: relative; }
        .mrt-option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
        .mrt-option label { display: block; padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: 4px; cursor: pointer; font-size: 0.96rem; color: var(--text); }
        .mrt-option input:checked + label { border-color: var(--accent); color: var(--text-bright); background: rgba(200,164,78,0.06); }
        .mrt-option input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
        .mrt-field-error { font-size: 0.85rem; color: var(--odr-red, #c0524a); margin-top: 0.5rem; display: none; }
        .mrt-field-error.visible { display: block; }
        .mrt-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        @media (max-width: 560px) { .mrt-row-2 { grid-template-columns: 1fr; } }

        .mrt-consent { display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 1rem; }
        .mrt-consent input[type="checkbox"] { margin-top: 0.3rem; flex-shrink: 0; width: 18px; height: 18px; }
        .mrt-consent label { font-size: 0.92rem; color: var(--text); font-weight: 400; }
        .mrt-privacy-note { font-size: 0.82rem; color: var(--text-muted); margin: 0 0 1rem; }
        .mrt-privacy-note a { color: var(--text-muted); text-underline-offset: 0.16em; }

        .mrt-turnstile { margin: 0.5rem 0 0; }
        .mrt-verify-error { font-size: 0.88rem; color: var(--odr-red, #c0524a); margin-top: 0.5rem; }

        .mrt-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 1.75rem; gap: 1rem; }
        .mrt-back { background: none; border: none; color: var(--text-muted); font-family: 'DM Sans', sans-serif; font-size: 0.9rem; cursor: pointer; padding: 0.5rem 0; }
        .mrt-back:hover, .mrt-back:focus-visible { color: var(--text-bright); }
        .mrt-back:disabled { visibility: hidden; }

        .mrt-callout {
            padding: 1.1rem 1.3rem;
            border: 1px solid var(--border);
            border-radius: 4px;
            margin-bottom: 1.75rem;
            font-size: 0.92rem;
            color: var(--text-muted);
        }
        .mrt-callout p { margin-bottom: 0.9rem; }
        .mrt-callout p:last-child { margin-bottom: 0; }
        #mrt-step-label { margin: 0; }

        /* Honeypot: must be a class rule, not an inline style="" attribute —
           the page's CSP has no 'unsafe-inline' for style-src, and a nonce
           only covers <style> elements, not the style="" HTML attribute, so
           an inline style is silently dropped and the field renders fully
           visible. Same fix as the Commercial Gaps Review honeypot. */
        .mrt-hp { position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; }

        .mrt-review-block { padding: 1rem 0; border-top: 1px solid var(--border); }
        .mrt-review-block:first-of-type { border-top: none; }
        .mrt-review-q { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.35rem; }
        .mrt-review-a { font-size: 0.95rem; color: var(--text-bright); white-space: pre-wrap; }
        .mrt-review-edit { font-size: 0.82rem; color: var(--accent); background: none; border: none; cursor: pointer; padding: 0; margin-top: 0.4rem; }

        .mrt-loading { text-align: center; padding: 3rem 0; }
        .mrt-loading-text { font-size: 1.05rem; color: var(--text-bright); min-height: 1.6em; }
        .mrt-spinner {
            width: 36px; height: 36px; margin: 0 auto 1.75rem;
            border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%;
            animation: mrt-spin 0.9s linear infinite;
        }
        @keyframes mrt-spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { .mrt-spinner { animation: none; border-top-color: var(--border); } }

        .mrt-error-box {
            padding: 1.25rem 1.4rem; border: 1px solid var(--odr-red, #c0524a);
            background: rgba(192,82,74,0.08); border-radius: 4px; margin-bottom: 1.5rem;
        }
        .mrt-error-box p { color: var(--text-bright); margin: 0; }

        @media (max-width: 480px) {
            .mrt-nav { flex-wrap: wrap; }
        }
    </style>
</head>
<body>
    <%- include('partials/site-header', { currentPage: { slug: 'market-ready-test' }, navPages, canEdit: false, content, pageContact }) %>

    <main>
        <!-- INTRO -->
        <section class="mrt-screen active" id="mrt-intro">
            <p class="mrt-label">MARKET READY TEST</p>
            <h1>How ready is your business for a new owner?</h1>
            <p>The Market Ready Test looks beyond headline profit and asks the questions a serious buyer is likely to ask.</p>
            <p>Answer ten questions honestly and receive a New Owner Ready Score, including the strengths a buyer may value, the questions they may ask and the areas worth strengthening before a sale.</p>
            <p class="mrt-meta">Around 5 minutes. Multiple choice, with space at the end for anything else.</p>

            <div class="mrt-callout">
                <p>There are no perfect businesses and there are no perfect answers. This assessment is designed to understand how the business really works, where it may be exposed and how it could look through the eyes of a serious buyer. The more open you are, the more useful the result will be.</p>
                <p>This is not a valuation and it is not legal, accounting or financial advice.</p>
            </div>

            <div class="mrt-callout">
                <p>Your answers will be used to produce your assessment and may be reviewed by Arrington Consultancy if you ask us to contact you. If you give us an email address, we will also send you a copy of your result so you can keep it and return to it later.</p>
            </div>

            <button type="button" class="btn btn-primary" id="mrt-start">Start the Market Ready Test</button>
        </section>

        <!-- BUSINESS DETAILS -->
        <section class="mrt-screen" id="mrt-business">
            <p class="mrt-label">ABOUT THE BUSINESS</p>
            <h2>A few details about the business</h2>
            <p class="mrt-meta">Nothing here is mandatory except the business name. Skip anything you'd rather not answer.</p>
            <form id="mrt-business-form">
                <div class="mrt-field">
                    <label for="mrt-businessName">Business name</label>
                    <input type="text" id="mrt-businessName" name="businessName" maxlength="255" required>
                </div>
                <div class="mrt-field">
                    <label for="mrt-location">Business location <span class="mrt-optional">(optional)</span></label>
                    <input type="text" id="mrt-location" name="location" maxlength="255">
                </div>
                <div class="mrt-field">
                    <label for="mrt-industry">Industry or type of business <span class="mrt-optional">(optional)</span></label>
                    <input type="text" id="mrt-industry" name="industry" maxlength="255">
                </div>
                <div class="mrt-row-2">
                    <div class="mrt-field">
                        <label for="mrt-employeeCount">Approximate number of people working in the business <span class="mrt-optional">(optional)</span></label>
                        <input type="text" id="mrt-employeeCount" name="employeeCount" maxlength="100">
                    </div>
                    <div class="mrt-field">
                        <label for="mrt-turnoverBand">Approximate annual turnover band <span class="mrt-optional">(optional)</span></label>
                        <input type="text" id="mrt-turnoverBand" name="turnoverBand" maxlength="100" placeholder="e.g. £250k&ndash;£500k">
                    </div>
                </div>
                <div class="mrt-field">
                    <label for="mrt-saleTimeframe">Are you currently considering a sale? <span class="mrt-optional">(optional)</span></label>
                    <select id="mrt-saleTimeframe" name="saleTimeframe">
                        <option value="">Prefer not to say for now</option>
                        <% saleTimeframeOptions.forEach(function(opt) { %>
                        <option value="<%= opt %>"><%= opt %></option>
                        <% }); %>
                    </select>
                </div>
                <p class="mrt-field-error" id="mrt-business-error">Please enter the business name.</p>
                <div class="mrt-nav">
                    <button type="button" class="mrt-back" id="mrt-business-back">&larr; Back</button>
                    <button type="submit" class="btn btn-primary">Continue</button>
                </div>
            </form>
        </section>

        <!-- QUESTIONS -->
        <section class="mrt-screen" id="mrt-questions">
            <div class="mrt-progress" role="progressbar" aria-valuemin="1" aria-valuemax="<%= questions.length %>" id="mrt-progress-track">
                <div class="mrt-progress-bar" id="mrt-progress-bar"></div>
            </div>
            <div id="mrt-question-body"></div>
            <p class="mrt-field-error" id="mrt-answer-error"></p>
            <div class="mrt-nav">
                <button type="button" class="mrt-back" id="mrt-q-back">&larr; Back</button>
                <span class="mrt-meta" id="mrt-step-label"></span>
                <button type="button" class="btn btn-primary" id="mrt-q-continue">Continue</button>
            </div>
        </section>

        <!-- CONTEXT -->
        <section class="mrt-screen" id="mrt-context">
            <p class="mrt-label">ANYTHING ELSE</p>
            <h2>Anything else worth knowing?</h2>
            <p class="mrt-meta">Optional. Use this for anything the questions did not cover. It is included in your result exactly as written.</p>
            <div class="mrt-field">
                <label for="mrt-context-input">Additional context <span class="mrt-optional">(optional)</span></label>
                <textarea id="mrt-context-input" maxlength="2000"></textarea>
            </div>
            <div class="mrt-nav">
                <button type="button" class="mrt-back" id="mrt-context-back">&larr; Back</button>
                <button type="button" class="btn btn-primary" id="mrt-context-continue">Continue</button>
            </div>
        </section>

        <!-- CONTACT DETAILS -->
        <section class="mrt-screen" id="mrt-contact">
            <p class="mrt-label">YOUR DETAILS</p>
            <h2>Where should we send your result?</h2>
            <form id="mrt-contact-form">
                <div class="mrt-row-2">
                    <div class="mrt-field">
                        <label for="mrt-firstName">First name</label>
                        <input type="text" id="mrt-firstName" name="firstName" maxlength="200" required>
                    </div>
                    <div class="mrt-field">
                        <label for="mrt-lastName">Last name <span class="mrt-optional">(optional)</span></label>
                        <input type="text" id="mrt-lastName" name="lastName" maxlength="200">
                    </div>
                </div>
                <div class="mrt-field">
                    <label for="mrt-email">Email address <span class="mrt-optional">(optional)</span></label>
                    <input type="email" id="mrt-email" name="email" maxlength="255">
                </div>
                <div class="mrt-field">
                    <label for="mrt-phone">Telephone number <span class="mrt-optional">(optional)</span></label>
                    <input type="tel" id="mrt-phone" name="phone" maxlength="50">
                </div>

                <div class="mrt-hp" aria-hidden="true">
                    <label>Leave this field blank<input type="text" name="website" id="mrt-website-hp" tabindex="-1" autocomplete="off"></label>
                </div>

                <div class="mrt-consent">
                    <input type="checkbox" id="mrt-consent-result" required>
                    <label for="mrt-consent-result">I agree to my answers being used to produce my Market Ready Test result.</label>
                </div>
                <div class="mrt-consent">
                    <input type="checkbox" id="mrt-consent-tom">
                    <label for="mrt-consent-tom">I would like Tom Arrington to review my result and contact me.</label>
                </div>
                <div class="mrt-consent">
                    <input type="checkbox" id="mrt-consent-marketing">
                    <label for="mrt-consent-marketing">I would like to receive occasional useful business thinking from Arrington Consultancy.</label>
                </div>
                <p class="mrt-privacy-note">We use your details to produce and send your result. Read our <a href="/privacy">Privacy</a> page.</p>

                <p class="mrt-field-error" id="mrt-contact-error">Please enter your first name, a valid email address if you give one, and agree to the first box above.</p>
                <div class="mrt-nav">
                    <button type="button" class="mrt-back" id="mrt-contact-back">&larr; Back</button>
                    <button type="submit" class="btn btn-primary">Review my answers</button>
                </div>
            </form>
        </section>

        <!-- REVIEW -->
        <section class="mrt-screen" id="mrt-review">
            <p class="mrt-label">REVIEW</p>
            <h2>Check your answers before submitting</h2>
            <p class="mrt-meta">You can go back and change anything before your result is generated.</p>
            <div id="mrt-review-body"></div>
            <p class="mrt-label">ONE LAST STEP</p>
            <div id="mrt-turnstile" class="mrt-turnstile"></div>
            <p class="mrt-verify-error" id="mrt-verify-error" role="alert" hidden>Verification failed. Please try again.</p>
            <div class="mrt-nav">
                <button type="button" class="mrt-back" id="mrt-review-back">&larr; Back</button>
                <button type="button" class="btn btn-primary" id="mrt-review-submit" disabled>Get my New Owner Ready Score</button>
            </div>
        </section>

        <!-- LOADING -->
        <section class="mrt-screen" id="mrt-loading">
            <div class="mrt-loading">
                <div class="mrt-spinner" aria-hidden="true"></div>
                <p class="mrt-loading-text" id="mrt-loading-text" role="status">Reading your answers</p>
            </div>
        </section>

        <!-- ERROR / RECOVERY -->
        <section class="mrt-screen" id="mrt-error">
            <p class="mrt-label">SOMETHING WENT WRONG</p>
            <div class="mrt-error-box">
                <p id="mrt-error-message">We could not complete your assessment reliably. Your answers have been saved and no score has been guessed.</p>
            </div>
            <p>Your answers are still here. You can try again, or contact us directly.</p>
            <div class="mrt-nav">
                <button type="button" class="btn btn-outline" id="mrt-error-retry">Try again</button>
                <a href="#" class="btn btn-primary" id="mrt-error-contact">Email tom@arringtonconsultancy.com</a>
            </div>
        </section>
    </main>

    <%- include('partials/site-footer', { canEdit: false, pageContact, content }) %>
    <script nonce="<%= nonce %>">
        <%- include('partials/site-chrome-script') %>
    </script>

    <script nonce="<%= nonce %>">
    (function () {
        var QUESTIONS = <%- JSON.stringify(questions) %>;
        var STORAGE_KEY = 'mrt_progress_v2';

        var state = {
            business: {},
            answers: new Array(QUESTIONS.length).fill(null),
            context: '',
            contact: {},
            consentTom: false,
            consentMarketing: false
        };

        function saveProgress() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
        }
        function loadProgress() {
            try {
                var raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                var parsed = JSON.parse(raw);
                if (parsed && Array.isArray(parsed.answers) && parsed.answers.length === QUESTIONS.length) {
                    state = Object.assign(state, parsed);
                }
            } catch (e) {}
        }
        function clearProgress() {
            try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
        }
        loadProgress();

        var screens = ['mrt-intro', 'mrt-business', 'mrt-questions', 'mrt-context', 'mrt-contact', 'mrt-review', 'mrt-loading', 'mrt-error'].reduce(function (acc, id) {
            acc[id] = document.getElementById(id);
            return acc;
        }, {});

        function showScreen(id) {
            Object.values(screens).forEach(function (s) { s.classList.remove('active'); });
            screens[id].classList.add('active');
            window.scrollTo({ top: 0, behavior: 'auto' });
        }

        document.getElementById('mrt-start').addEventListener('click', function () {
            document.getElementById('mrt-businessName').value = state.business.businessName || '';
            document.getElementById('mrt-location').value = state.business.location || '';
            document.getElementById('mrt-industry').value = state.business.industry || '';
            document.getElementById('mrt-employeeCount').value = state.business.employeeCount || '';
            document.getElementById('mrt-turnoverBand').value = state.business.turnoverBand || '';
            document.getElementById('mrt-saleTimeframe').value = state.business.saleTimeframe || '';
            showScreen('mrt-business');
        });

        document.getElementById('mrt-business-back').addEventListener('click', function () { showScreen('mrt-intro'); });

        document.getElementById('mrt-business-form').addEventListener('submit', function (e) {
            e.preventDefault();
            var businessName = document.getElementById('mrt-businessName').value.trim();
            var errEl = document.getElementById('mrt-business-error');
            if (!businessName) {
                errEl.classList.add('visible');
                return;
            }
            errEl.classList.remove('visible');
            state.business = {
                businessName: businessName,
                location: document.getElementById('mrt-location').value.trim(),
                industry: document.getElementById('mrt-industry').value.trim(),
                employeeCount: document.getElementById('mrt-employeeCount').value.trim(),
                turnoverBand: document.getElementById('mrt-turnoverBand').value.trim(),
                saleTimeframe: document.getElementById('mrt-saleTimeframe').value
            };
            saveProgress();
            currentQuestion = 0;
            renderQuestion();
            showScreen('mrt-questions');
        });

        // ---- Questions ----
        var currentQuestion = 0;
        var progressBar = document.getElementById('mrt-progress-bar');
        var progressTrack = document.getElementById('mrt-progress-track');
        var stepLabel = document.getElementById('mrt-step-label');
        var qBody = document.getElementById('mrt-question-body');
        var answerError = document.getElementById('mrt-answer-error');
        var qBack = document.getElementById('mrt-q-back');
        var qContinue = document.getElementById('mrt-q-continue');

        function renderQuestion() {
            var q = QUESTIONS[currentQuestion];
            var pct = Math.round((currentQuestion / QUESTIONS.length) * 100);
            progressBar.style.width = pct + '%';
            progressTrack.setAttribute('aria-valuenow', currentQuestion + 1);
            stepLabel.textContent = 'Question ' + (currentQuestion + 1) + ' of ' + QUESTIONS.length;
            qBack.disabled = false;
            answerError.classList.remove('visible');

            var selected = state.answers[currentQuestion];
            var html = '<fieldset><legend>' + escapeHtml(q.text) + '</legend><div class="mrt-options">';
            q.options.forEach(function (optionText, i) {
                var checked = selected === i ? ' checked' : '';
                var id = 'mrt_opt_' + currentQuestion + '_' + i;
                html += '<div class="mrt-option">' +
                    '<input type="radio" name="mrt-option" id="' + id + '" value="' + i + '"' + checked + '>' +
                    '<label for="' + id + '">' + escapeHtml(optionText) + '</label>' +
                    '</div>';
            });
            html += '</div></fieldset>';
            qBody.innerHTML = html;

            qBody.querySelectorAll('input[name="mrt-option"]').forEach(function (input) {
                input.addEventListener('change', function () {
                    state.answers[currentQuestion] = parseInt(input.value, 10);
                    saveProgress();
                    answerError.classList.remove('visible');
                });
            });
        }

        qBack.addEventListener('click', function () {
            if (currentQuestion === 0) {
                showScreen('mrt-business');
                return;
            }
            currentQuestion -= 1;
            renderQuestion();
        });

        qContinue.addEventListener('click', function () {
            if (state.answers[currentQuestion] === null || state.answers[currentQuestion] === undefined) {
                answerError.textContent = 'Please choose an answer before continuing.';
                answerError.classList.add('visible');
                return;
            }
            if (currentQuestion < QUESTIONS.length - 1) {
                currentQuestion += 1;
                renderQuestion();
            } else {
                document.getElementById('mrt-context-input').value = state.context || '';
                showScreen('mrt-context');
            }
        });

        // ---- Context ----
        document.getElementById('mrt-context-back').addEventListener('click', function () {
            currentQuestion = QUESTIONS.length - 1;
            renderQuestion();
            showScreen('mrt-questions');
        });

        document.getElementById('mrt-context-continue').addEventListener('click', function () {
            state.context = document.getElementById('mrt-context-input').value.trim();
            saveProgress();
            document.getElementById('mrt-firstName').value = state.contact.firstName || '';
            document.getElementById('mrt-lastName').value = state.contact.lastName || '';
            document.getElementById('mrt-email').value = state.contact.email || '';
            document.getElementById('mrt-phone').value = state.contact.phone || '';
            document.getElementById('mrt-consent-tom').checked = !!state.consentTom;
            document.getElementById('mrt-consent-marketing').checked = !!state.consentMarketing;
            showScreen('mrt-contact');
        });

        // ---- Contact ----
        document.getElementById('mrt-contact-back').addEventListener('click', function () {
            document.getElementById('mrt-context-input').value = state.context || '';
            showScreen('mrt-context');
        });

        function isValidEmail(s) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s); }

        document.getElementById('mrt-contact-form').addEventListener('submit', function (e) {
            e.preventDefault();
            var firstName = document.getElementById('mrt-firstName').value.trim();
            var email = document.getElementById('mrt-email').value.trim();
            var consentResult = document.getElementById('mrt-consent-result').checked;
            var errEl = document.getElementById('mrt-contact-error');
            var emailOk = !email || isValidEmail(email);
            if (!firstName || !emailOk || !consentResult) {
                errEl.classList.add('visible');
                return;
            }
            errEl.classList.remove('visible');
            state.contact = {
                firstName: firstName,
                lastName: document.getElementById('mrt-lastName').value.trim(),
                email: email,
                phone: document.getElementById('mrt-phone').value.trim()
            };
            state.consentTom = document.getElementById('mrt-consent-tom').checked;
            state.consentMarketing = document.getElementById('mrt-consent-marketing').checked;
            saveProgress();
            renderReview();
            showScreen('mrt-review');
        });

        // ---- Review ----
        function renderReview() {
            var body = document.getElementById('mrt-review-body');
            var html = '<div class="mrt-review-block"><div class="mrt-review-q">Business</div><div class="mrt-review-a">' +
                escapeHtml(state.business.businessName || '') + '</div></div>';
            QUESTIONS.forEach(function (q, i) {
                var optIndex = state.answers[i];
                var answerText = (optIndex !== null && optIndex !== undefined) ? q.options[optIndex] : '';
                html += '<div class="mrt-review-block"><div class="mrt-review-q">' + escapeHtml(q.text) + '</div>' +
                    '<div class="mrt-review-a">' + escapeHtml(answerText) + '</div>' +
                    '<button type="button" class="mrt-review-edit" data-edit-q="' + i + '">Change this answer</button></div>';
            });
            if (state.context) {
                html += '<div class="mrt-review-block"><div class="mrt-review-q">Additional context</div>' +
                    '<div class="mrt-review-a">' + escapeHtml(state.context) + '</div>' +
                    '<button type="button" class="mrt-review-edit" id="mrt-review-edit-context">Change this</button></div>';
            }
            html += '<div class="mrt-review-block"><div class="mrt-review-q">' +
                (state.contact.email ? 'Sending your result to' : 'Your result will be shown to') + '</div><div class="mrt-review-a">' +
                escapeHtml(state.contact.email ? (state.contact.firstName + ', ' + state.contact.email) : state.contact.firstName) + '</div></div>';
            body.innerHTML = html;
            body.querySelectorAll('[data-edit-q]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentQuestion = parseInt(btn.getAttribute('data-edit-q'), 10);
                    renderQuestion();
                    showScreen('mrt-questions');
                });
            });
            var editContext = document.getElementById('mrt-review-edit-context');
            if (editContext) {
                editContext.addEventListener('click', function () {
                    document.getElementById('mrt-context-input').value = state.context || '';
                    showScreen('mrt-context');
                });
            }
            renderTurnstileWidget();
        }

        // Human verification — rendered on the review screen, immediately
        // before the actual submit button, never during the question
        // screens themselves. Re-rendered (reset) every time the review
        // screen is shown, including after a failed submission retry, so a
        // token is never reused past its first submit attempt.
        var turnstileToken = null;
        var turnstileWidgetId = null;
        function renderTurnstileWidget() {
            turnstileToken = null;
            document.getElementById('mrt-review-submit').disabled = true;
            document.getElementById('mrt-verify-error').hidden = true;

            function render() {
                if (typeof turnstile === 'undefined') {
                    window.setTimeout(render, 300);
                    return;
                }
                if (turnstileWidgetId !== null) {
                    turnstile.reset(turnstileWidgetId);
                    return;
                }
                var siteKey = document.querySelector('meta[name="turnstile-site-key"]')?.content;
                turnstileWidgetId = turnstile.render('#mrt-turnstile', {
                    sitekey: siteKey,
                    callback: function (token) {
                        turnstileToken = token;
                        document.getElementById('mrt-review-submit').disabled = false;
                    },
                    'error-callback': function () {
                        document.getElementById('mrt-verify-error').hidden = false;
                        document.getElementById('mrt-review-submit').disabled = true;
                    },
                    'expired-callback': function () {
                        turnstileToken = null;
                        document.getElementById('mrt-review-submit').disabled = true;
                    }
                });
            }
            render();
        }

        function escapeHtml(s) {
            var d = document.createElement('div');
            d.textContent = s;
            return d.innerHTML;
        }

        document.getElementById('mrt-review-back').addEventListener('click', function () { showScreen('mrt-contact'); });

        // ---- Loading messages ----
        function startLoadingMessages() {
            document.getElementById('mrt-loading-text').textContent = 'Building your New Owner Ready Score';
        }
        function stopLoadingMessages() {}

        // ---- Submit ----
        document.getElementById('mrt-review-submit').addEventListener('click', function () {
            if (!turnstileToken) return;
            showScreen('mrt-loading');
            startLoadingMessages();

            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            fetch('/api/market-ready-test/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({
                    website: document.getElementById('mrt-website-hp').value,
                    firstName: state.contact.firstName,
                    lastName: state.contact.lastName,
                    email: state.contact.email,
                    phone: state.contact.phone,
                    businessName: state.business.businessName,
                    location: state.business.location,
                    industry: state.business.industry,
                    employeeCount: state.business.employeeCount,
                    turnoverBand: state.business.turnoverBand,
                    saleTimeframe: state.business.saleTimeframe,
                    answers: state.answers,
                    context: state.context,
                    consentTomReview: state.consentTom,
                    consentMarketing: state.consentMarketing,
                    turnstileToken: turnstileToken
                })
            }).then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                    return { ok: res.ok, data: data };
                });
            }).then(function (result) {
                stopLoadingMessages();
                if (result.ok && result.data && result.data.resultUrl) {
                    clearProgress();
                    window.location.href = result.data.resultUrl;
                } else {
                    document.getElementById('mrt-error-message').textContent =
                        (result.data && result.data.error) || 'We could not complete your assessment reliably. Your answers have been saved and no score has been guessed. Please try again or contact us at tom@arringtonconsultancy.com.';
                    showScreen('mrt-error');
                }
            }).catch(function () {
                stopLoadingMessages();
                document.getElementById('mrt-error-message').textContent =
                    'Something went wrong. Please try again or contact us at tom@arringtonconsultancy.com.';
                showScreen('mrt-error');
            });
        });

        document.getElementById('mrt-error-retry').addEventListener('click', function () {
            renderTurnstileWidget();
            showScreen('mrt-review');
        });
        document.getElementById('mrt-error-contact').addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = 'mailto:tom@arringtonconsultancy.com';
        });
    })();
    </script>
</body>
</html>
