<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%
      // A shared result link (?score=N) gets its own title/description so the
      // link preview on LinkedIn/Facebook/X actually shows the score and band
      // instead of the same generic card every time. The canonical URL stays
      // the clean, query-free page for SEO; only og:url follows the shared link.
      const _pageTitle = shareResult
        ? `I scored ${shareResult.score}/16 (${shareResult.bandLabel}) on the Owner Dependency Quiz | Arrington Consultancy`
        : 'Owner Dependency Quiz | Arrington Consultancy';
      const _pageDescription = shareResult
        ? `See where a real business owner's own business still depends on them, then take the same free 5 minute quiz yourself.`
        : 'A free, practical 5 minute quiz to help you see where your business still depends too heavily on you as the owner. No email required, no diagnosis - just a clear, honest look.';
      const _ogUrl = shareResult ? requestUrl : 'https://www.arringtonconsultancy.com/owner-dependency-quiz';
    %>
    <title><%= _pageTitle %></title>
    <meta name="description" content="<%= _pageDescription %>">
    <link rel="canonical" href="https://www.arringtonconsultancy.com/owner-dependency-quiz">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= _pageTitle %>">
    <meta property="og:description" content="<%= _pageDescription %>">
    <meta property="og:url" content="<%= _ogUrl %>">
    <meta property="og:image" content="https://www.arringtonconsultancy.com/img/logo">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= _pageTitle %>">
    <meta name="twitter:description" content="<%= _pageDescription %>">
    <meta name="twitter:image" content="https://www.arringtonconsultancy.com/img/logo">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
            --odr-red: #c0524a;
            --odr-red-bg: rgba(192,82,74,0.12);
            --odr-amber: #c98a3e;
            --odr-amber-bg: rgba(201,138,62,0.12);
            --odr-green: #4a8f6a;
            --odr-green-bg: rgba(74,143,106,0.12);
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }
        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: var(--black);
            color: var(--text);
            line-height: 1.6;
        }
        header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }
        header a.odr-logo-link {
            display: inline-flex;
        }
        header img { height: 32px; width: auto; }
        header .odr-back-link {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            white-space: nowrap;
        }
        header .odr-back-link:hover, header .odr-back-link:focus-visible {
            color: var(--accent);
        }
        main {
            max-width: 640px;
            margin: 0 auto;
            padding: 2.5rem 1.5rem 5rem;
        }
        .odr-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 0.9rem;
        }
        h1, h2, h3 {
            font-family: 'DM Serif Display', serif;
            font-weight: 400;
            color: var(--text-bright);
            line-height: 1.25;
            margin: 0 0 1rem;
        }
        h1 { font-size: clamp(1.7rem, 5vw, 2.2rem); }
        h2 { font-size: 1.4rem; }
        h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
        p { color: var(--text); margin: 0 0 1.2rem; }
        .odr-meta {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
        }
        .odr-meta span { color: var(--accent); font-weight: 600; }
        #odr-step-label { margin: 0; }

        .btn {
            display: inline-block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            padding: 0.85rem 1.75rem;
            border-radius: 3px;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .btn-primary {
            background: var(--accent);
            color: var(--black);
            border-color: var(--accent);
        }
        .btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-outline {
            background: transparent;
            color: var(--text-bright);
            border-color: var(--border);
        }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }
        button.btn { font: inherit; }

        .odr-screen { display: none; }
        .odr-screen.active { display: block; }

        .odr-progress {
            height: 3px;
            background: var(--border);
            border-radius: 2px;
            margin-bottom: 2rem;
            overflow: hidden;
        }
        .odr-progress-bar {
            height: 100%;
            background: var(--accent);
            width: 0%;
        }

        fieldset {
            border: none;
            margin: 0 0 2rem;
            padding: 0;
        }
        legend {
            font-family: 'DM Serif Display', serif;
            font-size: 1.3rem;
            color: var(--text-bright);
            margin-bottom: 1.25rem;
            padding: 0;
            line-height: 1.4;
        }
        .odr-options { display: flex; flex-direction: column; gap: 0.75rem; }
        .odr-option {
            display: block;
            position: relative;
        }
        .odr-option input {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px;
        }
        .odr-option label {
            display: block;
            padding: 1rem 1.15rem;
            border: 1px solid var(--border);
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.98rem;
            color: var(--text);
        }
        .odr-option input:checked + label {
            border-color: var(--accent);
            color: var(--text-bright);
            background: rgba(200,164,78,0.06);
        }
        .odr-option input:focus-visible + label {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        .odr-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; }
        .odr-back {
            background: none;
            border: none;
            color: var(--text-muted);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            padding: 0.5rem 0;
        }
        .odr-back:hover, .odr-back:focus-visible { color: var(--text-bright); }
        .odr-back:disabled { visibility: hidden; }

        /* ---- results: score + band, shown first ---- */
        .odr-score-block {
            display: flex;
            align-items: baseline;
            gap: 1rem;
            flex-wrap: wrap;
            padding: 1.5rem 1.6rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            margin-bottom: 2rem;
        }
        .odr-score-num {
            font-family: 'DM Serif Display', serif;
            font-size: 2.2rem;
            color: var(--text-bright);
            line-height: 1;
        }
        .odr-score-band {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 700;
            color: var(--accent);
        }
        .odr-score-body {
            flex-basis: 100%;
            margin: 0.5rem 0 0;
            font-size: 0.92rem;
            color: var(--text-muted);
        }

        /* ---- results: eight RAG rows ---- */
        .odr-result-item {
            padding: 1.25rem 0;
            border-top: 1px solid var(--border);
        }
        .odr-result-item:first-of-type { border-top: none; }
        .odr-rag-pill {
            flex-shrink: 0;
            width: 64px;
            text-align: center;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 700;
            padding: 0.3rem 0;
            border-radius: 20px;
            margin-top: 0.15rem;
        }
        .odr-rag-red { color: var(--odr-red); background: var(--odr-red-bg); }
        .odr-rag-amber { color: var(--odr-amber); background: var(--odr-amber-bg); }
        .odr-rag-green { color: var(--odr-green); background: var(--odr-green-bg); }
        .odr-result-head { display: flex; gap: 1rem; align-items: flex-start; }
        .odr-result-head h3 { font-size: 0.98rem; margin: 0; }
        .odr-result-text { margin: 0.3rem 0 0; font-size: 0.9rem; padding-left: calc(64px + 1rem); }

        /* ---- results: share ---- */
        .odr-share {
            margin: 1.75rem 0 2rem;
            padding: 1.1rem 1.3rem;
            border: 1px solid var(--border);
            border-radius: 6px;
        }
        .odr-share-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 700;
            color: var(--text-muted);
            margin: 0 0 0.85rem;
        }
        .odr-share-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
        .odr-share-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.55rem 1rem;
            border-radius: 3px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-bright);
            text-decoration: none;
            cursor: pointer;
        }
        .odr-share-btn:hover, .odr-share-btn:focus-visible {
            border-color: var(--accent);
            color: var(--accent);
        }
        .odr-share-icon { flex-shrink: 0; }
        .odr-share-status {
            margin: 0.75rem 0 0;
            font-size: 0.85rem;
            color: var(--accent);
        }

        /* ---- results: commercial summary ---- */
        .odr-summary {
            margin-top: 2rem;
            padding: 1.4rem 1.5rem;
            background: var(--charcoal, rgba(255,255,255,0.03));
            border-radius: 6px;
        }
        .odr-summary p { margin: 0; font-size: 0.95rem; color: var(--text-bright); }

        .odr-disclaimer {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
        }

        /* ---- results: email capture ---- */
        .odr-email-capture {
            margin-top: 2.5rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }
        .lead-hp {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
        }
        .odr-email-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.1rem; }
        .odr-email-row input[type="email"] {
            flex: 1;
            min-width: 220px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            padding: 0.75rem 1rem;
            border-radius: 3px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-bright);
        }
        .odr-email-row input[type="email"]::placeholder { color: var(--text-muted); }
        .odr-email-row input[type="email"]:focus-visible { outline: none; border-color: var(--accent); }
        .odr-email-status { margin: 0.75rem 0 0; font-size: 0.88rem; }
        .odr-email-status.is-success { color: var(--accent); }
        .odr-email-status.is-error { color: var(--odr-red); }
        .odr-privacy-note { font-size: 0.82rem; color: var(--text-muted); margin: 0.75rem 0 0; }
        .odr-privacy-note a { color: var(--text-muted); text-underline-offset: 0.16em; }

        .odr-cta {
            margin-top: 2.5rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }
        .odr-cta-actions { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem; }

        @media (max-width: 480px) {
            .odr-cta-actions { flex-direction: column; }
            .odr-cta-actions .btn { text-align: center; }
            .odr-result-item { padding: 0.85rem 0; }
            .odr-result-head { gap: 0.6rem; align-items: center; }
            .odr-result-head h3 { font-size: 0.92rem; }
            .odr-rag-pill { width: auto; display: inline-block; padding: 0.2rem 0.65rem; font-size: 0.62rem; margin-top: 0; }
            .odr-result-text { padding-left: 0; margin-top: 0.2rem; font-size: 0.86rem; }
            .odr-email-row { flex-direction: column; }
            .odr-email-row .btn { text-align: center; }
        }
    </style>
</head>
<body>
    <header>
        <a href="/" class="odr-logo-link" aria-label="Arrington Consultancy home">
            <img src="/img/logo" alt="Arrington Business Consultancy">
        </a>
        <a href="/" class="odr-back-link">&larr; Back to site</a>
    </header>

    <main>
        <!-- INTRO -->
        <section class="odr-screen active" id="odr-intro">
            <p class="odr-label">FREE COMMERCIAL TOOL</p>
            <h1>Owner Dependency Quiz</h1>
            <p class="odr-meta">Takes about <span>5 minutes</span>. No email required. Results shown immediately.</p>
            <p>A business can look healthy on the outside and still carry too much through one person. This short quiz asks eight practical questions about how your business actually runs day to day, and gives you a plain, honest look at where dependency on you might be building up.</p>
            <p>This is not a personality test and not a professional diagnosis. It is a starting point for your own judgement, based on the same patterns we see across owner run businesses.</p>
            <button type="button" class="btn btn-primary" id="odr-start">Start the quiz</button>
        </section>

        <!-- QUIZ -->
        <section class="odr-screen" id="odr-quiz">
            <div class="odr-progress" role="progressbar" aria-valuemin="1" aria-valuemax="8" aria-valuenow="1" id="odr-progress-track">
                <div class="odr-progress-bar" id="odr-progress-bar"></div>
            </div>
            <form id="odr-form">
                <div id="odr-questions"></div>
            </form>
            <div class="odr-nav">
                <button type="button" class="odr-back" id="odr-back">&larr; Back</button>
                <span id="odr-step-label" class="odr-meta"></span>
            </div>
        </section>

        <!-- RESULTS -->
        <section class="odr-screen" id="odr-results">
            <p class="odr-label">YOUR RESULT</p>

            <div class="odr-score-block">
                <div class="odr-score-num" id="odr-score-num">0 / 16</div>
                <div class="odr-score-band" id="odr-score-band">Low dependency</div>
                <p class="odr-score-body" id="odr-score-body"></p>
            </div>

            <div class="odr-share">
                <p class="odr-share-label">Share your result</p>
                <div class="odr-share-actions">
                    <a href="#" id="odr-share-linkedin" target="_blank" rel="noopener" class="odr-share-btn">
                        <svg class="odr-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        LinkedIn
                    </a>
                    <a href="#" id="odr-share-facebook" target="_blank" rel="noopener" class="odr-share-btn">
                        <svg class="odr-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.675 0h-21.35C.6 0 0 .6 0 1.326v21.348C0 23.4.6 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24h-1.918c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.4 24 24 23.4 24 22.674V1.326C24 .6 23.4 0 22.675 0"/></svg>
                        Facebook
                    </a>
                    <a href="#" id="odr-share-x" target="_blank" rel="noopener" class="odr-share-btn">
                        <svg class="odr-share-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        X
                    </a>
                    <button type="button" id="odr-share-copy-text" class="odr-share-btn">Copy result text</button>
                    <button type="button" id="odr-share-copy-link" class="odr-share-btn">Copy quiz link</button>
                </div>
                <p class="odr-share-status" id="odr-share-status" role="status" hidden></p>
            </div>

            <div id="odr-results-list"></div>

            <div class="odr-summary">
                <p id="odr-summary-text"></p>
            </div>

            <p class="odr-disclaimer">This is a general reflection tool based on common patterns in owner run businesses, not a professional assessment of your specific business. It does not replace proper financial, legal or commercial advice.</p>

            <div class="odr-email-capture">
                <h2>Send me a copy of my result</h2>
                <p>Enter your email and we'll send you your score and the areas highlighted in your quiz.</p>
                <form id="odr-email-form" class="odr-email-form">
                    <div class="lead-hp" aria-hidden="true">
                        <label>Leave this field blank<input type="text" name="website" id="odr-email-hp" tabindex="-1" autocomplete="off"></label>
                    </div>
                    <div class="odr-email-row">
                        <input type="email" id="odr-email-input" name="email" placeholder="you@business.co.uk" maxlength="255" required aria-label="Email address">
                        <button type="submit" class="btn btn-outline" id="odr-email-submit">Send my result</button>
                    </div>
                    <p class="odr-privacy-note">We use your email to send your result. Read our <a href="/privacy">Privacy</a> page.</p>
                    <p class="odr-email-status" id="odr-email-status" role="status" hidden></p>
                </form>
            </div>

            <div class="odr-cta">
                <h2>If any of this sounds familiar</h2>
                <p>A straightforward 30 minute conversation is usually enough to work out whether a proper commercial review would actually help, with no pressure either way.</p>
                <div class="odr-cta-actions">
                    <a href="/book-a-30-minute-conversation" class="btn btn-primary" id="odr-cta-book">Book a 30 minute conversation</a>
                    <button type="button" class="btn btn-outline" id="odr-restart">Start again</button>
                </div>
            </div>
        </section>
    </main>

    <script nonce="<%= nonce %>">
    (function () {
        // ============================================================
        // CONTENT CONFIGURATION - everything below this block and above
        // the "MECHANISM" comment is pure data. Edit question text,
        // options, indicator wording or result bands here without
        // touching any of the scoring/rendering logic further down.
        // Each option's "score" (2/1/0) maps directly to its category's
        // Red/Amber/Green result - no separate calculation, so the
        // indicator always traces back to the literal answer given.
        // ============================================================
        var QUESTIONS = [
            {
                id: 'freedom',
                category: 'Freedom from the business',
                text: 'Could you take a proper two-week holiday, turn your phone off and trust the business to run without you?',
                options: [
                    { text: 'No. I would expect calls, problems or things to stall without me.', score: 2 },
                    { text: 'Probably, but I would still need to check in and stay available.', score: 1 },
                    { text: 'Yes. The business would carry on properly without my involvement.', score: 0 }
                ],
                indicator: {
                    red: "You'd expect to be called, chased or needed while away.",
                    amber: "You could step back briefly, but would still need to check in.",
                    green: "The business would continue properly without you for a genuine break."
                }
            },
            {
                id: 'decisions',
                category: 'Decision dependency',
                text: 'When something needs to be decided, what is the first port of call?',
                options: [
                    { text: 'Me. Most decisions still come back to me, even when someone else should be able to make them.', score: 2 },
                    { text: 'It depends who is involved. Some people decide for themselves, others still come to me.', score: 1 },
                    { text: 'The person responsible usually makes the decision without needing me.', score: 0 }
                ],
                indicator: {
                    red: "Most decisions still route through you, even ones others should be able to make.",
                    amber: "Some people decide for themselves, others still come to you.",
                    green: "The person responsible usually decides without needing you."
                }
            },
            {
                id: 'visibility',
                category: 'Visibility',
                text: 'How do you get a clear picture of how the business is running and whether everything is working properly?',
                options: [
                    { text: 'By being there, watching what is happening and picking things up myself.', score: 2 },
                    { text: 'I get some updates and figures, but I still have to chase or join the dots.', score: 1 },
                    { text: 'I get clear, regular information I trust without needing to dig for it.', score: 0 }
                ],
                indicator: {
                    red: "You mainly know what's happening by being there and picking it up yourself.",
                    amber: "You get some information, but still have to chase it.",
                    green: "You get clear, regular information you trust without digging for it."
                }
            },
            {
                id: 'delegation',
                category: 'Delegation',
                text: 'When you outsource a task, what normally happens?',
                options: [
                    { text: 'I still end up checking it, chasing it or taking it back.', score: 2 },
                    { text: 'It depends on the person or the task.', score: 1 },
                    { text: 'It gets handled properly without coming back to me.', score: 0 }
                ],
                indicator: {
                    red: "Work you hand off tends to come back to you, one way or another.",
                    amber: "It depends on the person or the task.",
                    green: "What you delegate gets handled properly without returning to you."
                }
            },
            {
                id: 'management',
                category: 'Day-to-day management',
                text: 'Who keeps the day-to-day running of the business on track?',
                options: [
                    { text: "Me. If I'm not involved, standards quickly slip or things don't get done.", score: 2 },
                    { text: 'I have people who help, but I still need to step in regularly.', score: 1 },
                    { text: 'The business is well managed day to day without relying on me.', score: 0 }
                ],
                indicator: {
                    red: "Standards or progress slip when you're not personally involved.",
                    amber: "You have people helping, but still need to step in regularly.",
                    green: "The business runs well day to day without relying on you."
                }
            },
            {
                id: 'commercial',
                category: 'Commercial understanding',
                text: 'If I asked what makes the business the most money and what is the biggest drain on its time and money, who could give me the right answer?',
                options: [
                    { text: 'It would have to be me. Nobody else really has that understanding.', score: 2 },
                    { text: "One or two people could probably answer, but I'd still be the person everyone relies on.", score: 1 },
                    { text: 'The people responsible understand the numbers and could answer confidently without me.', score: 0 }
                ],
                indicator: {
                    red: "You're the only one who really understands what drives profit and cost.",
                    amber: "One or two people could answer, but you're still the one everyone relies on.",
                    green: "The people responsible understand the numbers and could answer confidently without you."
                }
            },
            {
                id: 'succession',
                category: 'Succession readiness',
                text: 'If you had to step away from the business permanently, what would happen?',
                options: [
                    { text: 'The business would struggle because too much still depends on me.', score: 2 },
                    { text: 'It could continue, but there would be disruption and someone would need to take over a lot of what I do.', score: 1 },
                    { text: 'The business could continue under its existing structure without relying on me.', score: 0 }
                ],
                indicator: {
                    red: "The business would struggle if you stepped away permanently.",
                    amber: "It could continue, but there'd be real disruption.",
                    green: "The business could continue under its existing structure without you."
                }
            },
            {
                id: 'cash',
                category: 'Cash control',
                text: 'How closely do you track cash in the business, not just overall profit?',
                options: [
                    { text: "I mostly find out about cash problems once they've already happened.", score: 2 },
                    { text: "I check it, but not consistently, and I'm sometimes caught out by the position.", score: 1 },
                    { text: 'I have clear, regular visibility of cash, weekly or better, and rarely find surprises.', score: 0 }
                ],
                indicator: {
                    red: "You mostly find out about cash problems once they've happened.",
                    amber: "You check cash, but not consistently, and are sometimes caught out.",
                    green: "You have clear, regular visibility of cash and rarely find surprises."
                }
            }
        ];

        // Ordered low to high; "max" is the highest total score included in
        // that band. Combined max score is 16 (8 questions x 2).
        var BANDS = [
            { max: 3, label: 'Low dependency', body: 'The business already runs largely independently of you day to day.' },
            { max: 7, label: 'Emerging dependency', body: 'Some parts of the business still rely on you more than they need to.' },
            { max: 11, label: 'Significant dependency', body: 'A meaningful share of decisions, oversight or knowledge still sits with you alone.' },
            { max: 16, label: 'High dependency', body: "Most of the business's day-to-day running, decisions and knowledge currently depend on you directly." }
        ];

        // ============================================================
        // MECHANISM - quiz flow, scoring and rendering. Shouldn't need
        // to change when only the content above is edited.
        // ============================================================
        var current = 0;
        var answers = new Array(QUESTIONS.length).fill(null);
        var lastResult = null;

        var introEl = document.getElementById('odr-intro');
        var quizEl = document.getElementById('odr-quiz');
        var resultsEl = document.getElementById('odr-results');
        var questionsEl = document.getElementById('odr-questions');
        var progressBar = document.getElementById('odr-progress-bar');
        var progressTrack = document.getElementById('odr-progress-track');
        var stepLabel = document.getElementById('odr-step-label');
        var backBtn = document.getElementById('odr-back');

        function showScreen(el) {
            [introEl, quizEl, resultsEl].forEach(function (s) { s.classList.remove('active'); });
            el.classList.add('active');
            el.scrollIntoView({ block: 'start' });
        }

        function ragClass(score) {
            return score === 2 ? 'red' : (score === 1 ? 'amber' : 'green');
        }

        function renderQuestion() {
            var q = QUESTIONS[current];
            var pct = Math.round(((current) / QUESTIONS.length) * 100);
            progressBar.style.width = pct + '%';
            progressTrack.setAttribute('aria-valuenow', current + 1);
            stepLabel.textContent = 'Question ' + (current + 1) + ' of ' + QUESTIONS.length;
            backBtn.disabled = current === 0;

            var html = '<fieldset><legend>' + q.text + '</legend><div class="odr-options">';
            q.options.forEach(function (opt, i) {
                var checked = answers[current] === i ? ' checked' : '';
                html += '<div class="odr-option">' +
                    '<input type="radio" name="q_' + q.id + '" id="q_' + q.id + '_' + i + '" value="' + i + '"' + checked + '>' +
                    '<label for="q_' + q.id + '_' + i + '">' + opt.text + '</label>' +
                    '</div>';
            });
            html += '</div></fieldset>';
            questionsEl.innerHTML = html;

            questionsEl.querySelectorAll('input[type="radio"]').forEach(function (input) {
                input.addEventListener('change', function () {
                    answers[current] = parseInt(input.value, 10);
                    if (typeof gtag === 'function') {
                        gtag('event', 'dependency_quiz_question_answered', {
                            event_category: 'tool',
                            question: q.id,
                            step: current + 1
                        });
                    }
                    window.setTimeout(function () {
                        if (current < QUESTIONS.length - 1) {
                            current += 1;
                            renderQuestion();
                        } else {
                            showResults();
                        }
                    }, 220);
                });
            });

            var legend = questionsEl.querySelector('legend');
            if (legend) { legend.setAttribute('tabindex', '-1'); legend.focus({ preventScroll: true }); }
        }

        backBtn.addEventListener('click', function () {
            if (current > 0) {
                current -= 1;
                renderQuestion();
            }
        });

        document.getElementById('odr-start').addEventListener('click', function () {
            if (typeof gtag === 'function') {
                gtag('event', 'dependency_quiz_start', { event_category: 'tool' });
            }
            current = 0;
            showScreen(quizEl);
            renderQuestion();
        });

        function showResults() {
            progressBar.style.width = '100%';

            var total = 0;
            var rows = QUESTIONS.map(function (q, i) {
                var score = QUESTIONS[i].options[answers[i]].score;
                total += score;
                return { category: q.category, score: score, cls: ragClass(score), text: q.indicator[ragClass(score)] };
            });

            var band = BANDS[BANDS.length - 1];
            for (var b = 0; b < BANDS.length; b++) {
                if (total <= BANDS[b].max) { band = BANDS[b]; break; }
            }

            document.getElementById('odr-score-num').textContent = total + ' / 16';
            document.getElementById('odr-score-band').textContent = band.label;
            document.getElementById('odr-score-body').textContent = band.body;

            document.getElementById('odr-results-list').innerHTML = rows.map(function (r) {
                return '<div class="odr-result-item">' +
                    '<div class="odr-result-head">' +
                    '<span class="odr-rag-pill odr-rag-' + r.cls + '">' + r.cls + '</span>' +
                    '<h3>' + r.category + '</h3>' +
                    '</div>' +
                    '<p class="odr-result-text">' + r.text + '</p>' +
                    '</div>';
            }).join('');

            var reds = rows.filter(function (r) { return r.cls === 'red'; }).map(function (r) { return r.category; });
            var ambers = rows.filter(function (r) { return r.cls === 'amber'; }).map(function (r) { return r.category; });
            var summary;
            if (reds.length > 0) {
                var redPhrase = reds.length === QUESTIONS.length ? 'All eight areas checked are flagged red' :
                    reds.length + ' of the eight areas checked ' + (reds.length === 1 ? 'is' : 'are') + ' flagged red';
                summary = 'Based on your answers, ' + redPhrase +
                    (ambers.length > 0 ? ' and ' + ambers.length + ' amber' : '') +
                    '. The clearest pressure points are: ' + reds.join(', ') + '.';
            } else if (ambers.length > 0) {
                summary = "Based on your answers, nothing is under serious pressure, but " + ambers.join(', ') +
                    ' ' + (ambers.length === 1 ? 'is' : 'are') + ' worth keeping an eye on as the business grows.';
            } else {
                summary = 'Based on your answers, none of the eight areas tested currently show meaningful dependency on you personally.';
            }
            document.getElementById('odr-summary-text').textContent = summary;

            // ?score=N lets the server render a personalised link-preview title
            // (see server.js) so a LinkedIn/Facebook/X share actually shows the
            // result instead of the same generic card every time.
            var shareUrl = location.origin + '/owner-dependency-quiz?score=' + total;
            var shareMessage = "I scored " + total + "/16 (" + band.label + ") on Arrington Consultancy's Owner Dependency Quiz. It highlighted a few areas I'd been overlooking. Worth five minutes if you run an owner run business.";
            var fullResultsText = 'Score: ' + total + '/16 (' + band.label + ')\n\n' +
                rows.map(function (r) { return r.cls.toUpperCase() + ' - ' + r.category + ': ' + r.text; }).join('\n') +
                '\n\n' + summary;

            lastResult = { total: total, band: band, rows: rows, summary: summary, shareUrl: shareUrl, shareMessage: shareMessage, fullResultsText: fullResultsText };

            document.getElementById('odr-share-x').href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareMessage) + '&url=' + encodeURIComponent(shareUrl);
            document.getElementById('odr-share-facebook').href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareUrl);
            document.getElementById('odr-share-linkedin').href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(shareUrl);

            if (typeof gtag === 'function') {
                gtag('event', 'dependency_quiz_complete', {
                    event_category: 'tool',
                    score: total,
                    band: band.label,
                    red_count: reds.length,
                    amber_count: ambers.length
                });
            }
            showScreen(resultsEl);
        }

        document.getElementById('odr-restart').addEventListener('click', function () {
            current = 0;
            answers = new Array(QUESTIONS.length).fill(null);
            showScreen(introEl);
        });

        document.getElementById('odr-cta-book').addEventListener('click', function () {
            if (typeof gtag === 'function') {
                gtag('event', 'dependency_quiz_cta_click', { event_category: 'tool' });
            }
        });

        function copyToClipboard(text, cb) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(cb, cb);
            } else {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); } catch (e) {}
                document.body.removeChild(ta);
                cb();
            }
        }

        function showShareStatus(text) {
            var el = document.getElementById('odr-share-status');
            el.textContent = text;
            el.hidden = false;
        }

        function trackShare(platform) {
            if (typeof gtag === 'function') {
                gtag('event', 'dependency_quiz_share', { event_category: 'tool', platform: platform });
            }
            if (lastResult) {
                var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
                fetch('/api/quiz/share-notify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                    body: JSON.stringify({
                        platform: platform,
                        score: lastResult.total,
                        band: lastResult.band.label
                    })
                }).catch(function () {});
            }
        }

        ['odr-share-linkedin', 'odr-share-facebook', 'odr-share-x'].forEach(function (id) {
            document.getElementById(id).addEventListener('click', function () {
                trackShare(id.replace('odr-share-', ''));
            });
        });

        document.getElementById('odr-share-copy-text').addEventListener('click', function () {
            if (!lastResult) return;
            copyToClipboard(lastResult.shareMessage + ' ' + lastResult.shareUrl, function () {
                showShareStatus('Result text copied.');
                trackShare('copy_text');
            });
        });

        document.getElementById('odr-share-copy-link').addEventListener('click', function () {
            if (!lastResult) return;
            copyToClipboard(lastResult.shareUrl, function () {
                showShareStatus('Link copied.');
                trackShare('copy_link');
            });
        });

        document.getElementById('odr-email-form').addEventListener('submit', function (e) {
            e.preventDefault();
            if (!lastResult) return;

            var emailForm = e.target;
            var emailInput = document.getElementById('odr-email-input');
            var statusEl = document.getElementById('odr-email-status');
            var submitBtn = document.getElementById('odr-email-submit');
            var email = emailInput.value.trim();
            var hp = document.getElementById('odr-email-hp').value;

            statusEl.hidden = true;
            statusEl.className = 'odr-email-status';
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';

            var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

            fetch('/api/quiz/email-results', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({
                    email: email,
                    website: hp,
                    score: lastResult.total,
                    band: lastResult.band.label,
                    resultsText: lastResult.fullResultsText
                })
            }).then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                    return { ok: res.ok, data: data };
                });
            }).then(function (result) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send my result';
                statusEl.hidden = false;
                if (result.ok) {
                    statusEl.textContent = 'Sent — check your inbox shortly.';
                    statusEl.className = 'odr-email-status is-success';
                    emailForm.reset();
                    if (typeof gtag === 'function') {
                        gtag('event', 'dependency_quiz_email_capture', {
                            event_category: 'tool',
                            score: lastResult.total,
                            band: lastResult.band.label
                        });
                    }
                } else {
                    statusEl.textContent = (result.data && result.data.error) || 'Something went wrong. Please try again.';
                    statusEl.className = 'odr-email-status is-error';
                }
            }).catch(function () {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send my result';
                statusEl.hidden = false;
                statusEl.textContent = 'Something went wrong. Please try again.';
                statusEl.className = 'odr-email-status is-error';
            });
        });
    })();
    </script>
</body>
</html>
