<%
// Template metadata — kept in sync with VALID_SECTIONS server-side.
const templates = [
    { id: 'hero',         label: 'Hero',                blurb: 'Headline, subtext, call-to-action and photo' },
    { id: 'credentials',  label: 'Credentials',         blurb: 'Two columns: badge and headline statistic' },
    { id: 'biography',    label: 'Biography',           blurb: 'Label, heading and two-column body text' },
    { id: 'intervention', label: 'Intervention',        blurb: 'Centred statement block' },
    { id: 'approach',     label: 'Approach',            blurb: 'Three numbered steps' },
    { id: 'insights',     label: 'Insights',            blurb: 'Three-card grid with tags' },
    { id: 'fourcards',    label: 'Four cards',          blurb: 'Four-card grid with numbers, titles and body' },
    { id: 'documents',    label: 'Documents',           blurb: 'Four downloadable PDFs with page previews' },
    { id: 'casestudy',    label: 'Case Study (timeline)', blurb: 'Three-phase horizontal timeline' },
    { id: 'casestudy2',   label: 'Case Study (editorial)', blurb: 'Pull-quote intro, body and outcome block' },
    { id: 'assessment',   label: 'Assessment',          blurb: 'Stacked question list' },
    { id: 'filter',       label: 'Filter',              blurb: 'Short statement with two paragraphs' },
    { id: 'proofstrip',   label: 'Proof strip',         blurb: 'Three text-only proof points (action + client)' },
    { id: 'websitecase',  label: 'Website case study',  blurb: 'Screenshots, headline, price statement and feature list' }
    // 'contact' is intentionally omitted — it now renders in the global footer.
];

// Section title lookup for orphan cards
const templateLabels = {};
templates.forEach(t => { templateLabels[t.id] = t.label; });
%>
<div class="cms-modal-overlay" id="cmsAddSectionModal">
    <div class="cms-modal cms-modal-wide">
        <div class="cms-modal-header">
            <span class="cms-modal-title">Add section</span>
            <button class="cms-modal-close" id="cmsAddSectionClose" title="Close">&times;</button>
        </div>
        <div class="cms-add-tabs">
            <button class="cms-add-tab active" data-tab="new">New section</button>
            <button class="cms-add-tab" data-tab="reuse">Reuse existing</button>
        </div>
        <div class="cms-add-tab-panel" id="cmsTabNew">
            <p class="cms-add-intro">Choose a template. The new section will be added to the bottom of the page. Duplicates are allowed.</p>
            <div class="cms-template-grid" id="cmsTemplateGrid">
                <% for (const t of templates) { %>
                <button class="cms-template-card" data-template-id="<%= t.id %>">
                    <img src="/img/templates/<%= t.id %>.svg" alt="" class="cms-template-thumb">
                    <div class="cms-template-label"><%= t.label %></div>
                    <div class="cms-template-blurb"><%= t.blurb %></div>
                </button>
                <% } %>
            </div>
        </div>
        <div class="cms-add-tab-panel cms-hidden" id="cmsTabReuse">
            <p class="cms-add-intro">Previously removed sections with their original content. Click to add one back to this page.</p>
            <div id="cmsOrphanGrid" class="cms-template-grid">
                <p class="cms-add-empty">Loading...</p>
            </div>
        </div>
    </div>
</div>
