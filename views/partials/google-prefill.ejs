<%
/*
  "Continue with Google" one-tap prefill for the public checks.

  This is an autofill convenience, not authentication: Google's Identity
  Services button hands the browser an ID token, this script decodes its
  payload locally and fills the form fields, and the form then submits
  through the exact same validated endpoint as a typed entry. No session
  is created, nothing is sent to our server until the visitor presses the
  existing submit button, and no new trust is claimed for the data.

  Renders nothing at all unless GOOGLE_SIGNIN_CLIENT_ID is set (exposed
  as app.locals.googleSigninClientId), so every page using this partial
  degrades to plain typed entry when the feature is unconfigured. The
  matching CSP allowances in server.js are gated on the same variable.

  Usage: include the partial with gpTargets, a map of optional selectors
  (fullName, or firstName/lastName for split fields, and email). The
  selectors are per page. Filled fields get an 'input' event dispatched
  so the page's own validation reacts.
*/
%>
<% if (typeof googleSigninClientId === 'string' && googleSigninClientId) { %>
<div class="g-prefill">
  <div id="g-prefill-btn"></div>
  <p class="g-prefill-note">One tap fills in your details. Or type them below.</p>
</div>
<script nonce="<%= nonce %>">
  (function () {
    var targets = <%- JSON.stringify(gpTargets || {}) %>;
    function fill(selector, value) {
      if (!selector || !value) return;
      var el = document.querySelector(selector);
      if (!el || el.value) return;
      el.value = value;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
    }
    window.__gPrefillCredential = function (resp) {
      try {
        var part = resp.credential.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
        var p = JSON.parse(atob(part));
        fill(targets.fullName, p.name || [p.given_name, p.family_name].filter(Boolean).join(' '));
        fill(targets.firstName, p.given_name);
        fill(targets.lastName, p.family_name);
        fill(targets.email, p.email);
      } catch (e) { /* fall back silently to typed entry */ }
    };
    // If Google cannot serve the button, the whole block removes itself
    // and the visitor simply types their details. A button that opens a
    // Google error page is worse than no button: it reads as the site
    // being broken, and the form underneath works perfectly well. This
    // covers the script being blocked, the client ID not being
    // configured for this origin (Google's "no registered origin" /
    // invalid_client), and the button never rendering.
    var wrap = document.querySelector('.g-prefill');
    function giveUpQuietly() { if (wrap) wrap.remove(); }
    var s = document.createElement('script');
    s.src = 'https://accounts.google.com/gsi/client';
    s.async = true;
    s.onerror = giveUpQuietly;
    s.onload = function () {
      if (!window.google || !google.accounts || !google.accounts.id) return giveUpQuietly();
      var slot = document.getElementById('g-prefill-btn');
      if (!slot) return giveUpQuietly();
      try {
        google.accounts.id.initialize({
          client_id: <%- JSON.stringify(googleSigninClientId) %>,
          callback: window.__gPrefillCredential
        });
        google.accounts.id.renderButton(slot, {
          theme: 'outline', size: 'large', text: 'continue_with', shape: 'pill', width: 280
        });
      } catch (e) { return giveUpQuietly(); }
      // Google renders into the slot asynchronously. If nothing appears,
      // the client ID is not usable from this origin, so remove the
      // block rather than leaving an empty space or a dead button.
      setTimeout(function () {
        if (!slot.querySelector('iframe') && !slot.querySelector('div[role=button]')) giveUpQuietly();
      }, 2500);
    };
    document.head.appendChild(s);
  })();
</script>
<style nonce="<%= nonce %>">
  /* The button's markup is rendered by Google, inside our slot, so its
     size is not fully ours to set: renderButton is asked for 280px, but
     if Google's own stylesheet is slow, blocked or changes shape, the
     logo inside it has nothing constraining it and scales to the width
     of whatever contains it. On a wide form column that produces a
     Google G the size of the page, which is what happened live on
     30/08/2026. These bounds are the backstop: a correctly rendered
     280px button is untouched by them, and a broken one can no longer
     take over the page. */
  .g-prefill { margin: 0 0 1.4rem; max-width: 320px; }
  #g-prefill-btn { width: 280px; max-width: 100%; max-height: 60px; overflow: hidden; }
  #g-prefill-btn svg, #g-prefill-btn img { max-height: 24px; width: auto; }
  #g-prefill-btn iframe { max-width: 100%; max-height: 60px; }
  .g-prefill-note { font-size: 0.85rem; color: var(--text-muted, #888); margin: 0.6rem 0 0; }
</style>
<% } %>
