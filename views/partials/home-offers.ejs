<%# HOME PAGE OFFERS. Three boxes, one per offer, each with one button to its
    own page (Tom's decision of 21/10/2026, "DECISION AND PLAN - Simplify to
    three offers"). Rendered by views/index.ejs as the first section under
    the home page hero (since 22/10/2026; until then inside the hero, which
    made it four and a half phone screens tall and hid the photo), so the
    page opens with one headline and three boxes. The copy, prices and links
    come from lib/mainNav.js (homeOffers), where every line is already
    approved on the page it leads to. Styles are in views/index.ejs
    (.home-offers), the only view that renders this. Expects: homeOffers.
    The line that the first conversation is free sits in the hero itself. %>
<div class="home-offers" data-home-offers>
    <% homeOffers.forEach(function (o, n) { %>
    <div class="home-offer <%= n === 0 ? 'home-offer--lead' : 'home-offer--side' %>" data-offer="<%= o.id %>">
        <p class="home-offer-audience"><%= o.audience %></p>
        <h2 class="home-offer-name"><%= o.name %></h2>
        <p class="home-offer-price"><%= o.price %></p>
        <p class="home-offer-line"><%= o.line %></p>
        <a href="<%= o.href %>" class="btn <%= n === 0 ? 'btn-primary' : 'btn-outline' %> home-offer-btn"><%= o.button %></a>
    </div>
    <% }); %>
</div>
