<%# PAGE-LEVEL STRUCTURED DATA for the standalone (code route) pages, added
    in the SEO sweep of 11/10/2026. The CMS pages build theirs in
    views/index.ejs and the Where to Start pages in where-to-start-schema.ejs;
    these pages had none. A breadcrumb (Home, then this page) always; a
    Service as well when schemaService names one. The business itself is
    described once, site-wide, by partials/site-schema.ejs, and the Service
    points at it by @id rather than repeating it.
    Takes: schemaName, schemaPath, and optionally schemaService and
    schemaParent ({ name, path }), which puts a middle crumb between Home and
    this page for a page that sits under another one. %>
<%
  const _pageUrl = 'https://www.arringtonconsultancy.com' + schemaPath;
  const _crumbs = [{ name: 'Home', item: 'https://www.arringtonconsultancy.com/' }];
  if (typeof schemaParent !== 'undefined' && schemaParent) {
    _crumbs.push({ name: schemaParent.name, item: 'https://www.arringtonconsultancy.com' + schemaParent.path });
  }
  _crumbs.push({ name: schemaName, item: _pageUrl });
  const _graph = [{
    '@type': 'BreadcrumbList',
    itemListElement: _crumbs.map(function (c, i) { return { '@type': 'ListItem', position: i + 1, name: c.name, item: c.item }; })
  }];
  if (typeof schemaService !== 'undefined' && schemaService) {
    _graph.push({
      '@type': 'Service',
      name: schemaService,
      provider: { '@id': 'https://www.arringtonconsultancy.com/#organization' },
      areaServed: [{ '@type': 'AdministrativeArea', name: 'Devon' }, { '@type': 'AdministrativeArea', name: 'Cornwall' }],
      url: _pageUrl
    });
  }
%>
<script type="application/ld+json" nonce="<%= nonce %>"><%- JSON.stringify({ '@context': 'https://schema.org', '@graph': _graph }).replace(/</g, '\\u003c') %></script>
