<%# SHARED SITE CHROME SCRIPT — extracted from views/index.ejs. Raw statements
    only (no <script> tag), so both index.ejs and standalone tool pages can
    each wrap this in their own nonced <script> block. %>
// Reveal obfuscated email / phone links. Runs before any generic anchor
// handling below so the mailto:/tel: hrefs are live by the time other
// listeners attach.
document.querySelectorAll('.js-email-link').forEach(a => {
    const u = a.dataset.u, d = a.dataset.d;
    if (!u || !d) return;
    const addr = u + '@' + d;
    a.href = 'mailto:' + addr + '?subject=Let%27s%20talk';
    a.textContent = addr;
});
document.querySelectorAll('.js-phone-link').forEach(a => {
    const pa = a.dataset.pa || '', pb = a.dataset.pb || '';
    const digits = pa + pb;
    if (!digits) return;
    a.href = 'tel:' + digits;
});

// Where this visit came from. Captured once per browser session on the
// first page seen (landing page, referrer, utm_* and the Google Ads click
// id) and sent with every form that writes an enquiry, so the source of a
// lead is a recorded fact. The server allowlists and caps every value
// (lib/leadAttribution.js). Session storage can be unavailable (private
// window, blocked site data), so every access is wrapped and a form still
// submits with nothing attached rather than failing.
window.__leadAttribution = (function () {
    const KEY = 'arrLeadAttribution';
    let cached = null;
    function fromPage() {
        const out = {
            landing_page: (location.pathname + location.search).slice(0, 300),
            referrer: (document.referrer || '').slice(0, 500),
            captured_at: new Date().toISOString()
        };
        const params = new URLSearchParams(location.search);
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid'].forEach(k => {
            const v = params.get(k);
            if (v) out[k] = v.slice(0, 200);
        });
        return out;
    }
    try {
        const stored = sessionStorage.getItem(KEY);
        if (stored) cached = JSON.parse(stored);
        if (!cached || typeof cached !== 'object' || Array.isArray(cached)) {
            cached = fromPage();
            sessionStorage.setItem(KEY, JSON.stringify(cached));
        }
    } catch (err) {
        cached = cached || fromPage();
    }
    return function () { return cached || {}; };
})();

// Google Ads conversion: visitor tapped a phone, email or WhatsApp link.
// Runs after the reassembly above so the href prefixes are live.
document.querySelectorAll('a[href^="tel:"], a[href^="mailto:"], a[href^="https://wa.me/"], a[href^="https://api.whatsapp.com/"]').forEach(a => {
    a.addEventListener('click', () => {
        const kind = a.href.indexOf('tel:') === 0 ? 'phone'
            : a.href.indexOf('mailto:') === 0 ? 'email'
            : 'whatsapp';
        if (typeof gtag === 'function') {
            gtag('event', 'conversion', { 'send_to': 'AW-18129914078/h_2rCJeH8aYcEN6RgsVD' });
            gtag('event', kind + '_click', { event_category: 'contact', page_path: location.pathname });
        }
    });
});

// Footer contact/booking form.
(function () {
    const form = document.getElementById('leadForm');
    if (!form) return;
    const status = document.getElementById('leadFormStatus');
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const data = Object.fromEntries(new FormData(form).entries());
        data.attribution = window.__leadAttribution ? window.__leadAttribution() : {};
        btn.disabled = true;
        status.textContent = 'Sending...';
        status.classList.remove('lead-form-error');
        try {
            const res = await fetch('/api/leads', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (!res.ok) throw new Error(result.error || 'Something went wrong.');
            form.reset();
            status.textContent = 'Thanks. I will get back to you shortly.';
            // The Ads "Contact" conversion is NOT fired here. It fires on
            // /thank-you, once, and only with the token the server issues after
            // the enquiry is stored (lib/contactConversion.js), so a refresh or a
            // direct visit to that page counts nothing. Anything unexpected in
            // thankYou falls back to the bare page, which thanks the visitor and
            // counts nothing.
            const next = (typeof result.thankYou === 'string' && /^\/thank-you\?c=[A-Za-z0-9._-]+$/.test(result.thankYou))
                ? result.thankYou : '/thank-you';
            let gone = false;
            const go = () => { if (!gone) { gone = true; location.assign(next); } };
            // GA4's own event stays on the form's page, with the redirect waiting
            // for it to be handed over (or a second at most if gtag is blocked).
            if (typeof gtag === 'function') {
                gtag('event', 'contact_form_submit', { event_category: 'contact', page_path: location.pathname, event_callback: go });
            }
            setTimeout(go, 1000);
        } catch (err) {
            status.textContent = err.message || 'Something went wrong. Please try again.';
            status.classList.add('lead-form-error');
            // Re-enabled only on failure: on success the button stays off
            // until the page changes, so a second click cannot send it twice.
            btn.disabled = false;
        }
    });
})();

// "How did you hear about us?": reveal the Other box only when Other is
// chosen, and keep the prompt muted while nothing is selected. The box is
// hidden in the markup rather than here, so it never flashes before this
// runs. Nothing else is needed to submit the answer: the handler above
// serialises the whole form, so both fields travel with the enquiry.
(function () {
    const select = document.getElementById('leadHeardAbout');
    const otherRow = document.getElementById('leadHeardAboutOtherRow');
    const otherInput = document.getElementById('leadHeardAboutOther');
    if (!select || !otherRow || !otherInput) return;

    const sync = () => {
        const isOther = select.value === 'other';
        otherRow.classList.toggle('lead-row-hidden', !isOther);
        select.classList.toggle('lead-select-empty', select.value === '');
        // A hidden box must not still carry what someone typed before
        // changing their mind, or the enquiry would arrive saying "Google
        // search" with a stray sentence attached. The server drops it too;
        // this keeps the screen and the record telling the same story.
        if (!isOther) otherInput.value = '';
    };

    select.addEventListener('change', sync);
    // A form reset (after a successful send) restores the defaults
    // asynchronously, so re-sync on the next tick rather than immediately.
    select.form.addEventListener('reset', () => setTimeout(sync, 0));
    sync();
})();

window.addEventListener('scroll', () => {
    const navEl = document.getElementById('nav');
    if (navEl) navEl.classList.toggle('scrolled', window.scrollY > 20);
});

// Hamburger menu toggle
(function () {
    const btn = document.getElementById('navHamburger');
    const menu = document.getElementById('mobileMenu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
        const open = btn.classList.toggle('open');
        menu.classList.toggle('open', open);
        btn.setAttribute('aria-expanded', open);
        document.body.style.overflow = open ? 'hidden' : '';
    });

    menu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
            btn.classList.remove('open');
            menu.classList.remove('open');
            btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        });
    });
})();

document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
        e.preventDefault();
        const target = document.querySelector(a.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});
