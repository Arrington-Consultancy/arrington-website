<%# SHARED SITE CHROME CSS — extracted from views/index.ejs. Raw rules only
    (no <style> tag), so both index.ejs and standalone tool pages can each
    wrap this in their own nonced <style> block. %>
/* ---- NAV ---- */
nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--black) 90%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s;
}

nav.scrolled {
    box-shadow: 0 1px 20px rgba(0,0,0,0.5);
}

.nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
}

.nav-logo {
    font-family: 'DM Serif Display', serif;
    font-size: 1.15rem;
    color: var(--text-bright);
    text-decoration: none;
    letter-spacing: -0.01em;
}

.nav-logo-img {
    width: 200px;
    height: auto;
    display: block;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
}

.nav-cta {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s;
}

.nav-cta:hover {
    color: var(--text-bright);
}

.nav-cta-whatsapp {
    color: #25D366;
}

.nav-cta-whatsapp:hover {
    color: #1da851;
}

/* ---- HAMBURGER ---- */
.nav-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 110;
}

.nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-bright);
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
}

.nav-hamburger span + span {
    margin-top: 5px;
}

.nav-hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}

.nav-hamburger.open span:nth-child(2) {
    opacity: 0;
}

.nav-hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}

/* ---- MOBILE MENU ---- */
.mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 105;
    background: color-mix(in srgb, var(--black) 95%, transparent);
    backdrop-filter: blur(20px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
}

.mobile-menu.open {
    display: flex;
}

.mobile-menu a {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
}

.mobile-menu a:hover,
.mobile-menu a.active {
    color: var(--accent);
}

.mobile-menu .mobile-menu-sublink {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    opacity: 0.85;
    margin-top: -1.5rem;
}

.mobile-menu .mobile-menu-sublink::before {
    content: '\203A';
    margin-right: 0.4rem;
    color: var(--accent);
}

.mobile-menu .mobile-menu-divider {
    width: 40px;
    height: 1px;
    background: var(--border);
}

.mobile-menu .mobile-menu-cta {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
}

.mobile-menu .mobile-menu-whatsapp {
    color: #25D366;
}

/* ---- PAGE MENU ---- */
.page-menu {
    position: fixed;
    top: 88px;
    left: 0;
    right: 0;
    z-index: 99;
    background: color-mix(in srgb, var(--black) 75%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
}

.page-menu-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    gap: 1.25rem;
    height: 36px;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
}

.page-menu-inner::-webkit-scrollbar {
    display: none;
}

.page-menu-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.03em;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s, border-color 0.2s;
}

.page-menu-link:hover {
    color: var(--text-bright);
}

.page-menu-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
}

.page-menu-link.page-menu-hidden {
    opacity: 0.4;
    font-style: italic;
}

.page-menu-link-child {
    font-size: 0.72rem;
    color: var(--text-muted);
    opacity: 0.85;
    margin-left: -0.5rem;
}

.page-menu-link-child::before {
    content: '\203A';
    margin-right: 0.35rem;
    color: var(--accent);
}

@media (max-width: 900px) {
    .nav-hamburger {
        display: block;
    }

    .nav-actions {
        display: none;
    }

    .page-menu {
        display: none;
    }

    .nav-logo-img {
        width: 140px;
    }

    .nav-inner {
        height: 64px;
    }
}

/* ---- FOOTER / CONTACT ---- */
footer {
    background: var(--dark-grey);
    border-top: 1px solid var(--border);
}

.footer-contact {
    text-align: center;
    max-width: 580px;
    margin: 0 auto;
    padding: 5rem 2rem;
}

.footer-contact p {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.footer-contact .contact-details {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
}

.footer-contact .contact-details a {
    color: var(--text-bright);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
}

.footer-contact .contact-details a:hover {
    color: var(--accent);
}

.btn-whatsapp {
    background: #25D366;
    color: #fff;
    border-color: #25D366;
}

.btn-whatsapp:hover {
    background: #1da851;
    border-color: #1da851;
}

.lead-form {
    text-align: left;
    margin: 0 0 2rem;
}

.lead-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
}

.lead-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
}

.lead-form input,
.lead-form textarea {
    width: 100%;
    background: var(--charcoal);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.8rem 1rem;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--text-bright);
}

.lead-form textarea {
    margin-bottom: 1.1rem;
    resize: vertical;
}

.lead-privacy-note {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0.85rem 0 1rem;
    text-align: left;
}

.lead-privacy-note a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.16em;
}

.lead-form input::placeholder,
.lead-form textarea::placeholder {
    color: var(--text-muted);
}

.lead-form input:focus,
.lead-form textarea:focus {
    outline: none;
    border-color: var(--accent);
}

.lead-form-status {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    min-height: 1.2em;
}

.lead-form-status.lead-form-error {
    color: #e07a6d;
}

.lead-form-alt {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem !important;
}

@media (max-width: 600px) {
    .lead-row {
        grid-template-columns: 1fr;
    }
}

.footer-credit {
    position: relative;
    text-align: center;
    padding: 1.5rem 2rem 2.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
}

.footer-links {
    text-align: center;
    padding: 0 2rem;
}

.footer-links a {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
}

.footer-links a:hover {
    color: var(--text-bright);
    border-bottom-color: var(--text-bright);
}
