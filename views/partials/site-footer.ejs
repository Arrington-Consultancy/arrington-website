<%# SHARED SITE FOOTER — extracted from views/index.ejs so every page renders
    the identical contact/booking footer from one place. Expects: canEdit,
    pageContact, content, currentPage. Anchors to id="conversation", matched
    by the header's "Start a conversation" / mobile-menu CTA links above.
    The /useful-thinking lead-form suppression (08/08/2026) was removed
    22/08/2026: the page should end with the same standard contact form as
    every other page, before the footer. %>
<%
  const _rawEmail = (content['contact.email'] || '').trim();
  const _atIdx = _rawEmail.indexOf('@');
  const _eU = _atIdx >= 0 ? _rawEmail.slice(0, _atIdx) : _rawEmail;
  const _eD = _atIdx >= 0 ? _rawEmail.slice(_atIdx + 1) : '';
  const _rawPhone = (content['contact.phone'] || '').trim();
  const _pMid = Math.ceil(_rawPhone.length / 2);
  const _pA = _rawPhone.slice(0, _pMid);
  const _pB = _rawPhone.slice(_pMid);
  const _pDigits = _rawPhone.replace(/[^0-9+]/g, '');
  const _pDigitsMid = Math.ceil(_pDigits.length / 2);
  const _pDigitsA = _pDigits.slice(0, _pDigitsMid);
  const _pDigitsB = _pDigits.slice(_pDigitsMid);
  const _waUrl = (content['contact.whatsapp'] || '').trim();
  const _waValid = /^https:\/\/(wa\.me|api\.whatsapp\.com)\//.test(_waUrl);
%>
<footer id="conversation">
    <div class="footer-contact cms-section" data-section="contact">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="contact" title="Edit section">&#9998;</button><% } %>
        <% if ((pageContact.label || '').replace(/<[^>]+>/g, '').trim()) { %>
        <p class="section-label"><%- pageContact.label %></p>
        <% } %>
        <h2 class="section-heading"><%- pageContact.heading %></h2>
        <p><%- pageContact.body %></p>
        <form class="lead-form" id="leadForm">
            <%# Deliberately no method or action (30/09/2026): only the script
                can submit an enquiry. A method="post" fallback added on 27/09
                was the route contact-form spam tools used to store sales
                pitches and fire the Ads conversion; see routes/leads.js. %>
            <div class="lead-hp" aria-hidden="true">
                <label>Leave this field blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <div class="lead-row">
                <input type="text" name="name" placeholder="Your name" maxlength="200" required>
                <input type="email" name="email" placeholder="Your email" maxlength="255" required>
            </div>
            <div class="lead-row">
                <input type="tel" name="phone" placeholder="Phone (optional)" maxlength="50">
                <input type="text" name="preferred_time" placeholder="Best day/time for a 30 min call (optional)" maxlength="255">
            </div>
            <textarea name="message" placeholder="<%= pageContact.messagePlaceholder %>" maxlength="2000" rows="4"></textarea>
            <%# "How did you hear about us?" (19/09/2026). The first option is
                the prompt and submits as an empty value, matching the
                placeholder-only style of the fields above, which carry no
                visible labels either. The option list comes from
                lib/heardAbout.js so the dropdown and the server's allowlist
                cannot drift apart. The Other box is hidden until Other is
                chosen (see the chrome script), and starts hidden here rather
                than in script so it never flashes on a slow load.

                IT IS OPTIONAL AND DOES NOT SAY SO (Tom's question, 19/09/2026:
                does the word invite people to skip it?). It carries no
                `required`, so a visitor can send the form without touching it,
                and the server stores '' for an unanswered question. The word is
                dropped because a dropdown resting on its own question already
                LOOKS unanswered and skippable: the marker adds no information
                and only nudges. Phone and best day/time keep theirs, because
                there the word is doing real work, answering "do I have to give
                you my number?" Nobody hesitates over admitting they found us on
                Google, so the same reassurance buys nothing here.

                DO NOT MAKE IT REQUIRED. Reasons in CLAUDE.md; the short one is
                that a forced answer is a worse answer, and `attribution`
                already records the channel automatically on every enquiry. %>
            <div class="lead-row lead-row-single">
                <select name="heard_about" id="leadHeardAbout" class="lead-select-empty" aria-label="How did you hear about us?">
                    <option value="">How did you hear about us?</option>
                    <% heardAboutOptions.forEach(function (opt) { %>
                    <option value="<%= opt.id %>"><%= opt.label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="lead-row lead-row-single lead-row-hidden" id="leadHeardAboutOtherRow">
                <input type="text" name="heard_about_other" id="leadHeardAboutOther" placeholder="Where did you hear about us?" maxlength="200">
            </div>
            <p class="lead-privacy-note">We use your details to respond to your enquiry. Read our <a href="/privacy">Privacy</a> page.</p>
            <%# Cloudflare Turnstile (01/10/2026). Implicit render: the api.js
                script below auto-renders this element and injects a hidden
                cf-turnstile-response field into the form, which the submit
                script already serialises with the rest of the form, so no
                change to that script is needed to SEND the token. For most
                visitors it clears itself in under a second; the server fails
                open when it is absent or cannot be checked. Rendered only when
                a site key is configured, so local/unconfigured builds show no
                widget. turnstileSiteKey reaches this shared partial via
                app.locals (see server.js). %>
            <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
            <div class="lead-turnstile cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark" data-action="contact"></div>
            <% } %>
            <button type="submit" class="btn btn-primary"><%= pageContact.submitText %></button>
            <p class="lead-form-status" id="leadFormStatus" aria-live="polite"></p>
        </form>
        <p class="lead-form-alt">Prefer to call, email or WhatsApp instead?</p>
        <div class="contact-details">
            <a href="#" class="js-email-link" data-u="<%= _eU %>" data-d="<%= _eD %>" rel="nofollow"><%= _eU %> <span aria-hidden="true">[at]</span> <%= _eD %></a>
            <a href="#" class="js-phone-link" data-pa="<%= _pDigitsA %>" data-pb="<%= _pDigitsB %>" rel="nofollow"><%= _pA %><span aria-hidden="true">&#8203;</span><%= _pB %></a>
            <% if (_waValid) { %>
            <a href="<%= _waUrl %>" class="btn btn-whatsapp" target="_blank" rel="noopener nofollow">WhatsApp us</a>
            <% } %>
        </div>
    </div>
    <div class="footer-links">
        <a href="/useful-thinking">For more on how we think, see Useful Thinking</a>
        <a href="/privacy">Privacy</a>
        <a href="/staff" class="footer-link-staff">Staff Login</a>
    </div>
    <div class="footer-credit cms-section" data-section="footer">
        <% if (canEdit) { %><button class="cms-edit-btn" data-section="footer" title="Edit name">&#9998;</button><% } %>
        <%= content['footer.name'] || '' %>
    </div>
</footer>
<%# Load the Turnstile script once per page, and only when the footer widget
    above is present. The standalone assessment tools already load api.js in
    their own <head>; the guard stops a second copy loading there, while CMS
    pages (which had no Turnstile before) get it from here. The already-loaded
    script auto-renders the footer .cf-turnstile either way. nonce comes from
    res.locals, like every other nonced block. %>
<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
<script nonce="<%= nonce %>">
  (function () {
    if (document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/v0/api.js"]')) return;
    var s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  })();
</script>
<% } %>
