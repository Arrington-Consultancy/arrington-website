<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Approvals | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'approvals' }) %>
    <main class="sc-main">
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Approvals</h1>
          <p>Things a worker has flagged that need a decision before they count as part of the demonstration's record.</p>
        </div>
      </div>

      <div class="sc-list" id="scApprovalsList">
        <% if (!approvals.length) { %>
          <div class="sc-card sc-empty">Nothing waiting for a decision right now.</div>
        <% } %>
        <% approvals.forEach(function (w) { %>
          <div class="sc-card" style="padding: 16px 18px;" data-approval-id="<%= w.id %>">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap: 12px; flex-wrap: wrap;">
              <div>
                <div class="sc-row-sub" style="margin-bottom:4px;">
                  Proposed by <strong><%= workers[w.proposing_worker_id] ? workers[w.proposing_worker_id].characterName : w.proposing_worker_id %></strong>
                  <% if (w.related_job_ref) { %> &middot; <a href="/scott/jobs/<%= w.related_job_ref %>"><%= w.related_job_ref %></a><% } %>
                </div>
                <div style="font-size: 14.5px;"><%= w.summary %></div>
              </div>
              <div style="display:flex; gap:8px; flex-shrink:0;">
                <button type="button" class="sc-btn sc-btn-approve" data-decision="approve" data-id="<%= w.id %>">Approve</button>
                <button type="button" class="sc-btn sc-btn-reject" data-decision="reject" data-id="<%= w.id %>">Reject</button>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </main>
  </div>
  <script nonce="<%= nonce %>">
    (function () {
      var csrfToken = <%- JSON.stringify(csrfToken) %>;
      document.getElementById('scApprovalsList').addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-decision]');
        if (!btn) return;
        btn.disabled = true;
        var card = btn.closest('[data-approval-id]');
        fetch('/api/scott/approvals/' + btn.getAttribute('data-id') + '/decide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ decision: btn.getAttribute('data-decision') })
        }).then(function (r) { return r.json(); }).then(function () {
          card.style.transition = 'opacity 200ms ease';
          card.style.opacity = '0';
          setTimeout(function () { card.remove(); }, 200);
        }).catch(function () { btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
