<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Complaints | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'complaints', navCounts: navCounts }) %>
    <main class="sc-main">
      <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="sc-impersonation-banner">Demonstration mode: viewing as <%= persona.name %>, Clearance <%= persona.code %> (<%= persona.role %>). This is exactly what they can see.</div>
      <% } %>
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Complaints</h1>
          <p>07D SCOTT'S CUSTOMER SERVICE &amp; COMPLAINTS. Viewing as <strong><%= persona.name %></strong> (<%= persona.role %>).</p>
        </div>
      </div>

      <% if (!canSee('complaints_workflow')) { %>
        <div class="sc-card sc-empty"><%= deniedNote('complaints_workflow') %></div>
      <% } else { %>
        <div class="sc-stat-grid">
          <div class="sc-card sc-stat"><div class="sc-stat-label">Logged (90d)</div><div class="sc-stat-value"><%= facts.COMPLAINT_METRICS_90D.total %></div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Currently open</div><div class="sc-stat-value <%= facts.COMPLAINT_METRICS_90D.currentlyOpen ? 'warn' : '' %>"><%= facts.COMPLAINT_METRICS_90D.currentlyOpen %></div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Closed within 5 days</div><div class="sc-stat-value"><%= facts.COMPLAINT_METRICS_90D.closedWithin5WorkingDays %></div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Led to rework</div><div class="sc-stat-value"><%= facts.COMPLAINT_METRICS_90D.resultedInRework %></div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Full refunds</div><div class="sc-stat-value"><%= facts.COMPLAINT_METRICS_90D.fullRefunds %></div></div>
        </div>

        <div class="sc-card sc-proposed-note"><strong>Watchpoint.</strong> <%= facts.COMPLAINT_METRICS_90D.watchpoint %></div>

        <h2 class="sc-section-title">Complaint records</h2>
        <div class="sc-list">
          <% facts.COMPLAINTS.forEach(function (c) { %>
            <div class="sc-card sc-row-card">
              <div>
                <div class="sc-row-title">
                  <%= c.ref %> &middot; <%= c.customer %>
                  <% if (c.jobRef && /^SAKS/.test(c.jobRef)) { %> &middot; <a href="/scott/jobs/<%= c.jobRef %>"><%= c.jobRef %></a><% } else if (c.jobRef) { %> &middot; <%= c.jobRef %><% } %>
                </div>
                <div class="sc-row-sub">
                  <%= c.category %> &middot; received <%= c.received %> via <%= c.channel %><br>
                  <%= c.detail %>
                  <% if (c.remedy) { %><br><strong>Remedy:</strong> <%= c.remedy %><% } %>
                  <% if (field(c, 'remedyRestricted')) { %> <%= field(c, 'remedyRestricted') %><% } %>
                  <% if (c.rootCause) { %><br><strong>Root cause:</strong> <%= c.rootCause %><% } %>
                  <% if (c.qualityRef) { %><br><strong>Quality record:</strong> <%= c.qualityRef %><% } %>
                </div>
              </div>
              <div class="sc-row-actions">
                <span class="sc-pill <%= c.status === 'CLOSED' ? 'sc-pill-status' : 'sc-pill-risk' %>"><%= c.status %></span>
              </div>
            </div>
          <% }); %>
        </div>

        <h2 class="sc-section-title">Remedy authority</h2>
        <div class="sc-card">
          <p class="sc-row-sub"><strong>Apology and explanation:</strong> <%= facts.REMEDY_AUTHORITY.apologyAndExplanation %></p>
          <p class="sc-row-sub"><strong>Rework in original scope:</strong> <%= facts.REMEDY_AUTHORITY.reworkInOriginalScope %></p>
          <p class="sc-row-sub"><strong>Refund or goodwill:</strong> <%= facts.REMEDY_AUTHORITY.refundOrGoodwill %></p>
          <p class="sc-row-sub"><strong>Owner approval:</strong> <%= facts.REMEDY_AUTHORITY.ownerApprovalThreshold %></p>
          <p class="sc-row-sub"><strong><%= facts.REMEDY_AUTHORITY.prohibited %></strong></p>
        </div>
      <% } %>

    </main>
  </div>
</body>
</html>
