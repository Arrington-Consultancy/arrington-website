<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customers | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'customers', navCounts: navCounts }) %>
    <main class="sc-main">
      <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="sc-impersonation-banner">Demonstration mode: viewing as <%= persona.name %>, Clearance <%= persona.code %> (<%= persona.role %>). This is exactly what they can see.</div>
      <% } %>
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Customers</h1>
          <p>07G SCOTT'S CUSTOMERS, JOB HISTORY &amp; TRADE ACCOUNTS. Viewing as <strong><%= persona.name %></strong> (<%= persona.role %>).</p>
        </div>
      </div>

      <% if (!canSee('customers_contact')) { %>
        <div class="sc-card sc-empty"><%= deniedNote('customers_contact') %></div>
      <% } else { %>
        <div class="sc-stat-grid">
          <div class="sc-card sc-stat"><div class="sc-stat-label">Detailed records</div><div class="sc-stat-value"><%= facts.CUSTOMER_MASTER_SUMMARY.namedDetailedRecords %></div><div class="sc-stat-sub">plus <%= facts.CUSTOMER_MASTER_SUMMARY.archivedAggregateHouseholdCustomers %> archived aggregate</div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Trade accounts</div><div class="sc-stat-value"><%= facts.CUSTOMER_MASTER_SUMMARY.tradeAccountDetailed %></div></div>
          <% if (canSee('kpi_trend')) { %>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Repeat / referral revenue</div><div class="sc-stat-value"><%= facts.CUSTOMER_VALUE_METRICS.repeatReferralShareOfRevenuePct %>%</div></div>
          <div class="sc-card sc-stat"><div class="sc-stat-label">Trade share</div><div class="sc-stat-value"><%= facts.CUSTOMER_VALUE_METRICS.tradeShareOfRevenuePct %>%</div></div>
          <% } %>
        </div>

        <h2 class="sc-section-title">Customer records</h2>
        <div class="sc-list">
          <% facts.CUSTOMERS.forEach(function (c) { %>
            <div class="sc-card sc-row-card">
              <div>
                <div class="sc-row-title"><%= c.name %> <span class="sc-pill sc-pill-status"><%= c.type %></span></div>
                <div class="sc-row-sub">
                  <%= c.ref %> &middot; <%= c.location %> &middot; customer since <%= c.since %>
                  <% if (canSee('trade_terms') && c.lifetimeBilledGbp) { %> &middot; lifetime billed £<%= c.lifetimeBilledGbp.toLocaleString() %><% } %>
                  <% if (c.avgPayDays) { %> &middot; average payment <%= c.avgPayDays %> days<% } %>
                  <% if (c.note) { %><br><%= c.note %><% } %>
                </div>
              </div>
              <div class="sc-row-actions">
                <% if (c.openComplaints) { %><span class="sc-pill sc-pill-risk">complaint open</span><% } %>
                <% if (canSee('debtor_flag') && c.overdueGbp) { %><span class="sc-pill sc-pill-risk">£<%= c.overdueGbp.toLocaleString() %> overdue<% if (c.overdueDays) { %> <%= c.overdueDays %>d<% } %></span><% } %>
                <% if (c.creditRisk) { %><span class="sc-pill sc-pill-status"><%= c.creditRisk %></span><% } %>
              </div>
            </div>
          <% }); %>
        </div>

        <% if (canSee('trade_terms')) { %>
          <h2 class="sc-section-title">Trade account rules</h2>
          <div class="sc-card">
            <p class="sc-row-sub">Standard terms: <%= facts.TRADE_ACCOUNT_RULES.standardTerms %>. Default credit limit £<%= facts.TRADE_ACCOUNT_RULES.defaultCreditLimitGbp.toLocaleString() %>.</p>
            <p class="sc-row-sub">Over 45 days overdue: <%= facts.TRADE_ACCOUNT_RULES.over45DaysOverdue %>.</p>
            <p class="sc-row-sub"><strong><%= facts.TRADE_ACCOUNT_RULES.principle %></strong></p>
          </div>
        <% } %>
      <% } %>

    </main>
  </div>
</body>
</html>
