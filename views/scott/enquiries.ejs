<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enquiries | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'enquiries' }) %>
    <main class="sc-main">
      <%- include('partials/progression-rail') %>
      <div class="sc-page-header">
        <div>
          <%
            // The page calls itself what the nav calls it. The registry
            // owns that name, so renaming it there renames it here too
            // rather than leaving a nav item and a heading disagreeing —
            // which is exactly what "Messages" in the sidebar above an
            // "Enquiries" heading was doing.
            var _navName = 'Enquiries';
            (((typeof caps !== 'undefined' && caps.nav) || []).forEach(function (g) {
              g.items.forEach(function (it) { if (it.activeKey === 'enquiries') _navName = it.label; });
            }));
          %>
          <h1 class="sc-h"><%= _navName %></h1>
          <p><%= enquiries.length %> shown</p>
        </div>
      </div>

      <div class="sc-filter-bar">
        <a href="/scott/enquiries" class="<%= !status ? 'active' : '' %>">All</a>
        <a href="/scott/enquiries?status=new" class="<%= status === 'new' ? 'active' : '' %>">New</a>
        <a href="/scott/enquiries?status=routed" class="<%= status === 'routed' ? 'active' : '' %>">Routed</a>
        <a href="/scott/enquiries?status=closed" class="<%= status === 'closed' ? 'active' : '' %>">Closed</a>
      </div>

      <div class="sc-list">
        <% if (!enquiries.length) { %>
          <div class="sc-card sc-empty">No enquiries match this filter.</div>
        <% } %>
        <% enquiries.forEach(function (e) { %>
          <a href="/scott/enquiries/<%= e.id %>" class="sc-card sc-card-link sc-row-card">
            <div>
              <div class="sc-row-title"><%= e.subject %></div>
              <div class="sc-row-sub"><%= e.customer_name %> &middot; via <%= e.channel %><% if (e.related_job_ref) { %> &middot; <%= e.related_job_ref %><% } %></div>
            </div>
            <div class="sc-row-actions">
              <% if (e.status === 'new') { %><span class="sc-pill sc-pill-new">New</span><% } %>
              <% if (e.assigned_worker_id && workers[e.assigned_worker_id]) { %>
                <span class="sc-pill sc-pill-status">→ <%= workers[e.assigned_worker_id].characterName %></span>
              <% } %>
            </div>
          </a>
        <% }); %>
      </div>
      <%- include('partials/deeper-dive') %>
    </main>
  </div>
</body>
</html>
