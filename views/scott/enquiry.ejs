<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= enquiry.subject %> | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'enquiries' }) %>
    <main class="sc-main">
      <div class="sc-page-header">
        <div>
          <p style="margin: 0 0 4px;"><a href="/scott/enquiries" style="color: var(--sc-text-muted); font-size: 13px;">&larr; All enquiries</a></p>
          <h1 class="sc-h"><%= enquiry.subject %></h1>
          <p><%= enquiry.customer_name %> &middot; via <%= enquiry.channel %> &middot; <%= new Date(enquiry.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        </div>
        <% if (enquiry.assigned_worker_id && workers[enquiry.assigned_worker_id]) { %>
          <span class="sc-pill sc-pill-status" style="font-size: 13px;">Routed to <%= workers[enquiry.assigned_worker_id].characterName %></span>
        <% } %>
      </div>

      <div class="sc-detail-grid">
        <div>
          <div class="sc-card sc-detail-card">
            <h2 class="sc-section-title">Message</h2>
            <p style="margin: 0; font-size: 14.5px; line-height: 1.6;"><%= enquiry.message %></p>
          </div>
          <% if (enquiry.related_job_ref) { %>
          <div class="sc-card sc-detail-card">
            <h2 class="sc-section-title">Related job</h2>
            <a href="/scott/jobs/<%= enquiry.related_job_ref %>" class="sc-btn sc-btn-outline"><%= enquiry.related_job_ref %></a>
          </div>
          <% } %>
        </div>
        <div>
          <%- include('partials/chat-widget', { workersById: workersById, csrfToken: csrfToken, aiEnabled: aiEnabled, suggestions: false }) %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
