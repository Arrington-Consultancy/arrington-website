<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Needs Human Input | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'gaps', navCounts: navCounts }) %>
    <main class="sc-main">
      <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="sc-impersonation-banner">Demonstration mode: viewing as <%= persona.name %>, Clearance <%= persona.code %> (<%= persona.role %>). This is exactly what they can see.</div>
      <% } %>
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Needs Human Input</h1>
          <p>Where a worker was stopped by evidence that is missing, out of date or contradictory. Viewing as <strong><%= persona.name %></strong> (<%= persona.role %>).</p>
        </div>
      </div>

      <div class="sc-card sc-honesty-card">
        <p class="sc-row-sub"><strong>This is not the approvals queue.</strong> An approval is a decision somebody has the authority to make. A gap here is a record that is wrong, missing or says two different things, and no approval fixes that. Somebody has to go and correct the source.</p>
        <p class="sc-row-sub">A gap closes when the underlying controlled record has actually been corrected or confirmed by a person. Nothing here is ever filled in by inference to clear the queue, and no worker can close one.</p>
      </div>

      <% if (mine.length) { %>
        <h2 class="sc-section-title">Waiting on you</h2>
        <div class="sc-list">
          <% mine.forEach(function (g) { %>
            <%- include('partials/gap-card', { g: g, canResolve: true, csrfToken: csrfToken, describeNotification: describeNotification }) %>
          <% }); %>
        </div>
      <% } %>

      <h2 class="sc-section-title">All gaps you can see</h2>
      <% if (!gaps.length) { %>
        <div class="sc-card sc-empty">No gaps recorded, or none in records you are cleared for. These two look the same here on purpose: the difference between them would itself say something about records you cannot read.</div>
      <% } else { %>
        <div class="sc-list">
          <% gaps.forEach(function (g) { %>
            <%- include('partials/gap-card', { g: g, canResolve: canSee(g.domain || 'finance_full') && ['open','notified','awaiting_source'].indexOf(g.status) !== -1, csrfToken: csrfToken, describeNotification: describeNotification }) %>
          <% }); %>
        </div>
      <% } %>

      <% if (canReviewFacts) { %>
      <h2 class="sc-section-title">What the company has learned</h2>
      <div class="sc-card sc-honesty-card">
        <p class="sc-row-sub"><strong>Nothing here waits for you.</strong> When a worker hits a gap it may work out what the missing record should say. That suggestion is checked against everything the company already holds and settled at once: admitted into the company brain, rejected with the reason shown, or dropped because the company already held it. Rejections are never quietly retried and the earlier fact always stands over a later one.</p>
        <p class="sc-row-sub">Your part is oversight. Read what it learned, and <strong>retract</strong> anything that reads wrong for the business. A retracted fact leaves the brain immediately and the workers stop using it.</p>
      </div>

      <% if (!brainChanges.length) { %>
        <div class="sc-card sc-empty">Nothing learned or rejected yet, or nothing in records you are cleared for. Same as above, these two read identically on purpose.</div>
      <% } else { %>
        <div class="sc-list">
          <% brainChanges.forEach(function (c) { %>
            <% var admitted = c.status === 'approved'; var retracted = c.status === 'rejected' && /^Retracted by /.test(c.decision_note || ''); %>
            <div class="sc-card sc-gap-card">
              <div class="sc-row-head">
                <strong><%= c.domain %> / <%= c.fact_key %></strong>
                <span class="sc-msg-tag sc-msg-tag-<%= admitted ? 'evidence' : 'certainty' %>"><%= admitted ? (c.estimated ? 'Held as an estimate' : 'Held as a record') : (retracted ? 'Retracted by a person' : (c.status === 'superseded' ? 'Already held, not added' : 'Rejected by the checks')) %></span>
              </div>
              <p class="sc-row-sub"><strong><%= admitted ? 'The company now holds:' : 'Proposed:' %></strong> <%= c.fact_value %></p>
              <% if (c.estimated && c.basis) { %><p class="sc-row-sub"><strong>Reasoned from:</strong> <%= c.basis %></p><% } %>
              <p class="sc-row-sub"><strong>Filed as:</strong> <%= c.source_label || 'no source named' %><% if (c.proposed_by_worker_id) { %>, worked out by <%= c.proposed_by_worker_id %><% } %><% if (c.decided_at) { %>, settled <%= new Date(c.decided_at).toLocaleString('en-GB', { timeZone: 'Europe/London' }) %><% } %></p>
              <% if (c.decision_note) { %><p class="sc-row-sub"><strong>Settlement:</strong> <%= c.decision_note %></p><% } %>

              <% var drift = Array.isArray(c.drift_flags) ? c.drift_flags : []; %>
              <% if (admitted && drift.length) { %>
                <p class="sc-row-sub"><strong>Noted when it went in:</strong></p>
                <ul class="sc-row-sub"><% drift.forEach(function (f) { %><li><%= f.detail %></li><% }); %></ul>
              <% } %>

              <% if (admitted && canSee(c.domain || 'finance_full')) { %>
                <form class="js-fact-retract" data-candidate="<%= c.id %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label class="sc-row-sub" for="fact-note-<%= c.id %>">Why is this wrong for the business?</label>
                  <textarea class="sc-gap-note" id="fact-note-<%= c.id %>" rows="2"></textarea>
                  <div class="sc-gap-actions">
                    <button type="submit">Retract from the brain</button>
                  </div>
                </form>
              <% } else if (admitted) { %>
                <p class="sc-row-sub">Retracting this is outside your clearance.</p>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
      <% } %>
    </main>
  </div>
  <script nonce="<%= nonce %>">
  (function () {
    // Which button was pressed decides sourceCorrected, so "the source is
    // now right" and "this was never a real gap" cannot be submitted as
    // the same thing by accident.
    var pressed = null;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.sc-gap-actions button');
      if (btn) pressed = btn.getAttribute('data-corrected') === 'true';
    });
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('.js-gap-resolve');
      if (!form) return;
      e.preventDefault();
      var note = form.querySelector('.sc-gap-note').value.trim();
      var out = form.querySelector('.sc-gap-error') || document.createElement('p');
      out.className = 'sc-gap-error';
      if (!form.contains(out)) form.appendChild(out);
      out.textContent = '';
      fetch('/api/scott/gaps/' + form.getAttribute('data-gap') + '/resolve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': form.querySelector('input[name=_csrf]').value },
        body: JSON.stringify({ sourceCorrected: pressed === true, note: note })
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (!res.ok) { out.textContent = res.d.error || 'Could not close this gap.'; return; }
          out.className = 'sc-gap-done';
          out.textContent = pressed ? 'Closed. The source is recorded as corrected.' : 'Dismissed. The source was not changed.';
          form.querySelector('.sc-gap-actions').remove();
        })
        .catch(function () { out.textContent = 'Could not reach the server.'; });
    });

    // Retracting a learned fact. Separate handler from the gap one above,
    // so closing a gap and retracting a fact can never be confused for one
    // another by a stale variable.
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('.js-fact-retract');
      if (!form) return;
      e.preventDefault();
      var note = form.querySelector('.sc-gap-note').value.trim();
      var out = form.querySelector('.sc-gap-error') || document.createElement('p');
      out.className = 'sc-gap-error';
      if (!form.contains(out)) form.appendChild(out);
      out.textContent = '';
      fetch('/api/scott/brain-candidates/' + form.getAttribute('data-candidate') + '/retract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': form.querySelector('input[name=_csrf]').value },
        body: JSON.stringify({ note: note })
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (!res.ok) { out.textContent = res.d.error || 'Could not retract that.'; return; }
          out.className = 'sc-gap-done';
          if (res.d.brainReloaded === false) {
            // Retracted in the register but the workers may still see it
            // until the next restart. Said plainly rather than reported as
            // a clean success, because those are different states.
            out.textContent = 'Retracted and recorded, but the workers may still see it until the next restart.';
          } else {
            out.textContent = 'Retracted. It is out of the company brain and the workers no longer use it.';
          }
          form.querySelector('.sc-gap-actions').remove();
        })
        .catch(function () { out.textContent = 'Could not reach the server.'; });
    });
  })();
  </script>
</body>
</html>
