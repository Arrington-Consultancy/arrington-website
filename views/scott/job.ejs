<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= job.ref %> | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'jobs' }) %>
    <main class="sc-main">
      <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="sc-impersonation-banner">Demonstration mode: viewing as <%= persona.name %>, Clearance <%= persona.code %> (<%= persona.role %>). This is exactly what they can see.</div>
      <% } %>
      <div class="sc-page-header sc-jobhead">
        <div>
          <p class="sc-back-link-wrap"><a href="/scott/jobs" class="sc-back-link">&larr; Jobs &amp; Orders</a></p>
          <h1 class="sc-h sc-jobhead-ref"><%= job.ref %> <span class="sc-status-chip sc-status-chip-<%= job.status %>"><%= job.status.replace(/_/g, ' ') %></span></h1>
          <p class="sc-jobhead-customer"><%= job.customer_name || 'Unknown customer' %><% if (job.customer_location) { %> &middot; <%= job.customer_location %><% } %> &middot; <%= job.kind %></p>
        </div>
        <%
          // The one critical action on this page, shown only to people
          // whose clearance can actually perform it; the API enforces the
          // same rule regardless.
        %>
        <% if (canSee('jobs_ops')) { %>
        <form id="scStatusForm" class="sc-jobhead-action">
          <select id="scStatusSelect" class="sc-select">
            <% jobStatuses.forEach(function (s) { %>
              <option value="<%= s %>" <%= s === job.status ? 'selected' : '' %>><%= s.replace(/_/g, ' ') %></option>
            <% }); %>
          </select>
          <button type="submit" class="sc-btn sc-btn-gold" id="scStatusSave">Update status</button>
        </form>
        <% } %>
      </div>
      <div id="scStatusNote" class="sc-inline-note" hidden>Status updated.</div>

      <div class="sc-detail-grid">
        <div>
          <% if (job.at_risk) { %>
            <div class="sc-risk-banner"><strong>At risk:</strong> <%= job.risk_note %></div>
          <% } %>

          <div class="sc-spec-strip">
            <% if (canSee('job_margin')) { %>
            <div class="sc-spec">
              <span class="sc-spec-num"><%= job.price_pence != null ? ('\u00a3' + Math.round(job.price_pence / 100).toLocaleString()) : '\u00b7' %></span>
              <span class="sc-spec-label"><%= job.price_pence != null ? 'agreed price' : 'not yet quoted' %></span>
            </div>
            <% } %>
            <div class="sc-spec">
              <span class="sc-spec-num"><%= job.promised_date ? new Date(job.promised_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : '\u00b7' %></span>
              <span class="sc-spec-label">promised</span>
            </div>
            <div class="sc-spec">
              <span class="sc-spec-num"><%= job.collection_date ? new Date(job.collection_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : '\u00b7' %></span>
              <span class="sc-spec-label">collected</span>
            </div>
          </div>

          <div class="sc-card sc-detail-card">
            <h2 class="sc-section-title">The job</h2>
            <p class="sc-detail-text-sm"><%= job.description %></p>
          </div>

          <% if (job.customer_notes) { %>
          <div class="sc-card sc-detail-card">
            <h2 class="sc-section-title">Customer notes</h2>
            <p class="sc-detail-text-sm"><%= job.customer_notes %></p>
          </div>
          <% } %>

          <div class="sc-card sc-detail-card">
            <h2 class="sc-section-title">Activity on this job</h2>
            <% if (!activity.length) { %>
              <div class="sc-empty">No recorded activity yet.</div>
            <% } else { %>
              <ul class="sc-activity-list">
                <% activity.forEach(function (a) { %>
                  <li class="sc-activity-item">
                    <span class="sc-activity-dot sc-dot-<%= workersById[a.actor] ? a.actor : (a.actor === 'user' ? 'user' : 'system') %>"></span>
                    <div>
                      <div><%= a.summary %></div>
                      <div class="sc-activity-meta"><%= (workersById[a.actor] && workersById[a.actor].characterName) || a.actor %> &middot; <%= new Date(a.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></div>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>
        <div class="sc-askcol">
          <div class="sc-ask-head">
            <div class="sc-ask-avatars">
              <span class="sc-msg-avatar sc-avatar-receptionist"><%= workersById.receptionist.initials %></span>
              <span class="sc-msg-avatar sc-avatar-operations"><%= workersById.operations.initials %></span>
            </div>
            <div>
              <strong>Ask about <%= job.ref %></strong>
              <span>Ruth routes it; Maggie Trent owns this board</span>
            </div>
          </div>
          <%- include('partials/chat-widget', { workersById: workersById, csrfToken: csrfToken, aiEnabled: aiEnabled, suggestions: false, relatedJobId: job.id, initialConversationId: initialConversationId, initialMessages: initialMessages }) %>
        </div>
      </div>
    </main>
  </div>
  <script nonce="<%= nonce %>">
    (function () {
      var csrfToken = <%- JSON.stringify(csrfToken) %>;
      var jobRef = <%- JSON.stringify(job.ref) %>;
      var statusForm = document.getElementById('scStatusForm');
      // The form only renders for clearances that can act; without this
      // guard the listener bind throws for everyone else.
      if (statusForm) statusForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var select = document.getElementById('scStatusSelect');
        var btn = document.getElementById('scStatusSave');
        var note = document.getElementById('scStatusNote');
        btn.disabled = true;
        fetch('/api/scott/jobs/' + encodeURIComponent(jobRef) + '/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ status: select.value })
        }).then(function (r) { return r.json(); }).then(function (data) {
          if (data.ok) {
            note.textContent = 'Status updated.';
            note.classList.remove('sc-inline-note-error');
            note.hidden = false;
            setTimeout(function () { note.hidden = true; }, 2500);
          } else if (data.error) {
            // The quality release gate's refusal names the exact missing
            // evidence (doc 31), so it must reach the person, not vanish.
            note.textContent = data.error;
            note.classList.add('sc-inline-note-error');
            note.hidden = false;
          }
        }).finally(function () { btn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
