<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jobs &amp; Orders | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'jobs' }) %>
    <main class="sc-main">
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Jobs &amp; Orders</h1>
          <p><%= jobs.length %> job<%= jobs.length === 1 ? '' : 's' %> shown</p>
        </div>
      </div>

      <div class="sc-filter-bar">
        <a href="/scott/jobs" class="<%= !status ? 'active' : '' %>">All</a>
        <a href="/scott/jobs?at_risk=1">At risk</a>
        <a href="/scott/jobs?status=in_progress" class="<%= status === 'in_progress' ? 'active' : '' %>">In progress</a>
        <a href="/scott/jobs?status=quoted" class="<%= status === 'quoted' ? 'active' : '' %>">Quoted</a>
        <a href="/scott/jobs?status=scheduled" class="<%= status === 'scheduled' ? 'active' : '' %>">Scheduled</a>
        <a href="/scott/jobs?status=delivered" class="<%= status === 'delivered' ? 'active' : '' %>">Delivered</a>
      </div>

      <div class="sc-list">
        <% if (!jobs.length) { %>
          <div class="sc-card sc-empty">No jobs match this filter.</div>
        <% } %>
        <% jobs.forEach(function (j) { %>
          <a href="/scott/jobs/<%= j.ref %>" class="sc-card sc-card-link sc-row-card">
            <div>
              <div class="sc-row-title"><%= j.ref %> &middot; <%= j.customer_name || 'Unknown customer' %></div>
              <div class="sc-row-sub"><%= j.description %></div>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
              <% if (j.at_risk) { %><span class="sc-pill sc-pill-risk">At risk</span><% } %>
              <span class="sc-pill sc-pill-status"><%= j.status.replace('_', ' ') %></span>
            </div>
          </a>
        <% }); %>
      </div>
    </main>
  </div>
</body>
</html>
