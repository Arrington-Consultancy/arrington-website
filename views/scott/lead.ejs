<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Get in touch | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-login-wrap sc-notfound-wrap">
    <div class="sc-login-card sc-lead-card">
      <div class="sc-login-head">
        <div class="sc-brand-mark">SA</div>
        <h1 class="sc-h">Scott's Armchair &amp; Knitting Service</h1>
        <p>Tell us what you need &mdash; the team will get back to you</p>
      </div>
      <div class="sc-login-body">
        <div id="scLeadError" class="sc-login-error" hidden></div>
        <div id="scLeadThanks" class="sc-inline-note sc-lead-thanks" hidden>Thanks &mdash; that's landed with the team. We'll be in touch.</div>
        <form id="scLeadForm">
          <div class="sc-field">
            <label for="scLeadName">Your name</label>
            <input type="text" id="scLeadName" name="name" autocomplete="name" required maxlength="200">
          </div>
          <div class="sc-field">
            <label for="scLeadEmail">Email</label>
            <input type="email" id="scLeadEmail" name="email" autocomplete="email" required maxlength="255">
          </div>
          <div class="sc-field">
            <label for="scLeadMessage">What can we help with?</label>
            <textarea id="scLeadMessage" name="message" rows="4" required maxlength="2000" class="sc-textarea"></textarea>
          </div>
          <div class="sc-honeypot" aria-hidden="true">
            <label for="scLeadWebsite">Leave this field blank</label>
            <input type="text" id="scLeadWebsite" name="website" tabindex="-1" autocomplete="off">
          </div>
          <button type="submit" class="sc-btn sc-btn-primary sc-login-submit" id="scLeadSubmit">Send</button>
        </form>
        <p class="sc-login-foot">A demonstration built on the real Arrington Consultancy website. Scott's Armchair &amp; Knitting Service is a fictional business used to show a governed AI team in action &mdash; nothing submitted here is a real business enquiry.</p>
      </div>
    </div>
  </div>
  <script nonce="<%= nonce %>">
    (function () {
      var csrfToken = <%- JSON.stringify(csrfToken) %>;
      var form = document.getElementById('scLeadForm');
      var errorEl = document.getElementById('scLeadError');
      var thanksEl = document.getElementById('scLeadThanks');
      var submitBtn = document.getElementById('scLeadSubmit');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorEl.hidden = true;
        submitBtn.disabled = true;
        fetch('/api/scott/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({
            name: document.getElementById('scLeadName').value,
            email: document.getElementById('scLeadEmail').value,
            message: document.getElementById('scLeadMessage').value,
            website: document.getElementById('scLeadWebsite').value
          })
        }).then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok) {
              errorEl.textContent = result.data.error || 'Something went wrong. Please try again.';
              errorEl.hidden = false;
              submitBtn.disabled = false;
              return;
            }
            form.hidden = true;
            thanksEl.hidden = false;
          })
          .catch(function () {
            errorEl.textContent = 'Could not reach the server. Please try again.';
            errorEl.hidden = false;
            submitBtn.disabled = false;
          });
      });
    })();
  </script>
</body>
</html>
