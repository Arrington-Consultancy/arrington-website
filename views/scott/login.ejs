<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-login-wrap">
    <div class="sc-login-card">
      <div class="sc-login-head">
        <div class="sc-brand-mark">SA</div>
        <h1 class="sc-h">Scott's Armchair &amp; Knitting Service</h1>
        <p>Company system &mdash; invited access only</p>
      </div>
      <div class="sc-login-body">
        <% if (error) { %>
          <div class="sc-login-error"><%= error %></div>
        <% } %>
        <form action="/scott/login" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="next" value="<%= nextPath %>">
          <div class="sc-field">
            <label for="scUsername">Username</label>
            <input type="text" id="scUsername" name="username" autocomplete="username" required>
          </div>
          <div class="sc-field">
            <label for="scPassword">Password</label>
            <input type="password" id="scPassword" name="password" autocomplete="current-password" required>
          </div>
          <button type="submit" class="sc-btn sc-btn-primary sc-login-submit">Sign in</button>
        </form>
        <p class="sc-login-foot">A demonstration built on the real Arrington Consultancy website. Scott's Armchair &amp; Knitting Service is a fictional business used to show a governed AI team in action.</p>
      </div>
    </div>
  </div>
</body>
</html>
