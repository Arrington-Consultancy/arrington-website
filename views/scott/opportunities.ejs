<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Where the Money Goes | Scott's Armchair &amp; Knitting Service</title>
  <meta name="robots" content="noindex, nofollow">
  <%- include('partials/styles') %>
</head>
<body class="scott-body">
  <div class="sc-shell">
    <%- include('partials/sidebar', { active: 'opportunities', navCounts: navCounts }) %>
    <main class="sc-main">
      <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="sc-impersonation-banner">Demonstration mode: viewing as <%= persona.name %>, Clearance <%= persona.code %> (<%= persona.role %>). This is exactly what they can see.</div>
      <% } %>
      <div class="sc-page-header">
        <div>
          <h1 class="sc-h">Where the Money Goes</h1>
          <p>07T SCOTT'S COMMERCIAL LEAKAGE &amp; IMPROVEMENT EVIDENCE. Viewing as <strong><%= persona.name %></strong> (<%= persona.role %>).</p>
        </div>
      </div>

      <% var visible = facts.IMPROVEMENT_REGISTER.filter(function (o) { return canSee(o.domain); }); %>

      <% if (!visible.length) { %>
        <div class="sc-card sc-empty"><%= deniedNote('finance_summary_ops') %></div>
      <% } else { %>
        <% if (canSee('finance_summary_ops')) { %>
          <div class="sc-card sc-honesty-card">
            <p class="sc-row-sub"><strong><%= facts.IMPROVEMENT_CONTROL_PRINCIPLE.rule %></strong> <%= facts.IMPROVEMENT_CONTROL_PRINCIPLE.openUntil %></p>
            <p class="sc-row-sub"><%= facts.IMPROVEMENT_CONTROL_PRINCIPLE.showYourWorking %> <%= facts.IMPROVEMENT_CONTROL_PRINCIPLE.neverCut %></p>
            <p class="sc-row-sub"><strong><%= facts.IMPROVEMENT_CONTROL_PRINCIPLE.realisedOnly %></strong></p>
          </div>

          <div class="sc-leakage-hero">
            <div class="sc-leakage-hero-label">Commercial leakage opportunity</div>
            <div>
              <span class="sc-leakage-num">£<%= facts.IMPROVEMENT_TOTALS.envelopeLowGbp.toLocaleString() %></span>
              <span class="sc-leakage-sep">to</span>
              <span class="sc-leakage-num">£<%= facts.IMPROVEMENT_TOTALS.envelopeHighGbp.toLocaleString() %></span>
              <span class="sc-leakage-unit">/year</span>
            </div>
            <div class="sc-leakage-zero">Realised so far<span class="sc-leakage-zero-dot">·</span>£0 &mdash; nothing approved and measured yet</div>
          </div>

          <div class="sc-stat-grid">
            <div class="sc-card sc-stat"><div class="sc-stat-label">Opportunities visible to you</div><div class="sc-stat-value"><%= visible.length %></div></div>
            <div class="sc-card sc-stat"><div class="sc-stat-label">Total in register</div><div class="sc-stat-value"><%= facts.IMPROVEMENT_REGISTER.length %></div></div>
            <div class="sc-card sc-stat"><div class="sc-stat-label">Clearance</div><div class="sc-stat-value sc-stat-value-sm"><%= persona.code %></div><div class="sc-stat-sub"><%= persona.role %></div></div>
          </div>

          <div class="sc-card sc-honesty-card">
            <p class="sc-row-sub"><strong><%= facts.IMPROVEMENT_TOTALS.doNotSum %></strong></p>
            <p class="sc-row-sub">The envelope excludes <%= facts.IMPROVEMENT_TOTALS.excludes %>.</p>
            <p class="sc-row-sub sc-honesty"><%= facts.IMPROVEMENT_TOTALS.warning %></p>
          </div>
        <% } %>

        <h2 class="sc-section-title">The register</h2>
        <div class="sc-list">
          <% visible.forEach(function (o) { %>
            <div class="sc-card sc-row-card">
              <div>
                <div class="sc-row-title"><%= o.ref %> &middot; <%= o.title %></div>
                <div class="sc-row-sub">
                  <strong>Evidence (<%= o.source %>):</strong> <%= o.evidence %>.<br>
                  <% if (o.recoverableRange) { %><strong>Working range:</strong> <%= o.recoverableRange %>.<br><% } %>
                  <% if (o.action) { %><strong>Likely action:</strong> <%= o.action %>.<br><% } %>
                  <% if (o.dependency) { %><strong>Depends on:</strong> <%= o.dependency %>.<br><% } %>
                  <% if (o.owner) { %><strong>Owner:</strong> <%= o.owner %>.<br><% } %>
                  <em>Confidence: <%= o.confidence %>.</em>
                  <% if (o.warning) { %><br><span class="sc-honesty"><%= o.warning %></span><% } %>
                </div>
              </div>
              <div class="sc-row-actions">
                <% if (o.annualisedGrossGbp) { %><span class="sc-pill sc-pill-status">£<%= o.annualisedGrossGbp.toLocaleString() %>/yr gross</span><% } %>
                <span class="sc-pill <%= /DO NOT|REQUIRED/.test(o.status) ? 'sc-pill-risk' : 'sc-pill-status' %>"><%= o.status %></span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
