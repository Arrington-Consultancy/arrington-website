<% var heroMode = typeof heroMode !== 'undefined' && heroMode; %>
<div class="sc-chat-panel<%= heroMode ? ' sc-chat-hero' : '' %>" id="scChatPanel">
  <% if (!heroMode) { %>
  <div class="sc-chat-head">
    <div class="sc-msg-avatar sc-avatar-receptionist"><%= workersById.receptionist.initials %></div>
    <div class="sc-chat-head-text">
      <strong>Ask Ruth</strong>
      <span>Ruth routes every question to the right person on the team</span>
    </div>
  </div>
  <% } %>
  <% var hasHistory = typeof initialMessages !== 'undefined' && initialMessages && initialMessages.length; %>
  <div class="sc-chat-messages" id="scChatMessages">
    <% if (hasHistory) { %>
      <% initialMessages.forEach(function (m) { %>
        <% if (m.sender === 'user') { %>
          <div class="sc-msg sc-msg-user"><div class="sc-msg-avatar sc-avatar-user">You</div><div class="sc-msg-body"><%= m.content %></div></div>
        <% } else { %>
          <div class="sc-msg">
            <div class="sc-msg-avatar sc-avatar-<%= workersById[m.workerId] ? m.workerId : 'system' %>"><%= m.initials %></div>
            <div class="sc-msg-body">
              <div class="sc-msg-name"><%= m.characterName %><%= m.displayRole ? ' · ' + m.displayRole : '' %></div>
              <%= m.content %>
              <% if (m.certainty === 'LIKELY' || m.certainty === 'UNPROVEN' || m.technicalFailure) { %>
              <div class="sc-msg-meta-row">
                <% if (m.certainty === 'LIKELY') { %><span class="sc-msg-tag sc-msg-tag-certainty">Likely, not certain</span><% } %>
                <% if (m.certainty === 'UNPROVEN') { %><span class="sc-msg-tag sc-msg-tag-certainty">Unproven, insufficient evidence</span><% } %>
                <% if (m.technicalFailure) { %><span class="sc-msg-tag sc-msg-tag-fail">Technical problem</span><% } %>
              </div>
              <% } %>
            </div>
          </div>
        <% } %>
      <% }); %>
    <% } else if (!heroMode) { %>
      <div class="sc-msg">
        <div class="sc-msg-avatar sc-avatar-receptionist"><%= workersById.receptionist.initials %></div>
        <div class="sc-msg-body">
          <div class="sc-msg-name">Ruth Bailey · Receptionist</div>
          <% if (typeof suggestions !== 'undefined' && suggestions === false) { %>Morning! Ask me anything about this and I'll get it to the right person.<% } else { %>Morning! Ask me anything about the workshop and I'll get it to the right person, or try one of the questions below.<% } %>
        </div>
      </div>
    <% } %>
  </div>
  <% if ((typeof suggestions === 'undefined' || suggestions !== false) && !hasHistory) { %>
  <%
    // Four curated examples, each demonstrating one property of the
    // system through use rather than explanation: ordinary use (whose
    // answer also differs by login), multi-worker routing, a
    // human-approval boundary the AI will not cross, and a clearance
    // refusal for everyone except the owner.
  %>
  <div class="sc-chat-suggestions" id="scChatSuggestions">
    <button type="button" data-q="What needs my attention today?">What needs my attention today?</button>
    <button type="button" data-q="Could we take on a six-chair trade repair next week, and what would we charge?">Could we take a six-chair trade job next week, and at what price?</button>
    <button type="button" data-q="Give Moorland Holiday Lets a 20 per cent goodwill discount on their next invoice.">Give Moorland a 20% goodwill discount</button>
    <button type="button" data-q="What is the company's current bank balance?">What is the company's bank balance?</button>
  </div>
  <% } %>
  <% if (!aiEnabled) { %>
    <div class="sc-chat-disabled-note">Live AI is not enabled in this environment yet, so the team can't reply until Tom sets it up.</div>
  <% } %>
  <form class="sc-chat-input-row" id="scChatForm">
    <input type="text" id="scChatInput" placeholder="Ask Ruth anything..." autocomplete="off" <%= aiEnabled ? '' : 'disabled' %><%- (typeof heroFocus !== 'undefined' && heroFocus && aiEnabled) ? ' autofocus' : '' %>>
    <button type="submit" class="sc-chat-send" id="scChatSend" <%= aiEnabled ? '' : 'disabled' %>>Send</button>
  </form>
</div>
<script nonce="<%= nonce %>">
(function () {
  var WORKERS = <%- JSON.stringify(workersById) %>;
  var conversationId = <%- typeof initialConversationId !== 'undefined' && initialConversationId ? initialConversationId : 'null' %>;
  var relatedJobId = <%- typeof relatedJobId !== 'undefined' && relatedJobId ? relatedJobId : 'null' %>;
  var relatedEnquiryId = <%- typeof relatedEnquiryId !== 'undefined' && relatedEnquiryId ? relatedEnquiryId : 'null' %>;
  var messagesEl = document.getElementById('scChatMessages');
  messagesEl.scrollTop = messagesEl.scrollHeight;
  var form = document.getElementById('scChatForm');
  var input = document.getElementById('scChatInput');
  var sendBtn = document.getElementById('scChatSend');
  var suggestionsEl = document.getElementById('scChatSuggestions');
  var csrfToken = <%- JSON.stringify(csrfToken) %>;
  var busy = false;

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // CSS class per worker (see views/scott/partials/styles.ejs), never an
  // inline style="" — the site's strict CSP has no 'unsafe-inline' for
  // styles and nonces don't cover the style attribute at all, so a raw hex
  // colour string can never be injected as an inline style and actually
  // render; it has to resolve to one of these fixed classes instead.
  var KNOWN_WORKER_IDS = ['receptionist', 'commercial', 'operations', 'customers_marketing', 'company_brain', 'governance'];
  function avatarClass(workerId) {
    return 'sc-avatar-' + (KNOWN_WORKER_IDS.indexOf(workerId) !== -1 ? workerId : (workerId === 'user' ? 'user' : 'system'));
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addUserMessage(text) {
    var div = document.createElement('div');
    div.className = 'sc-msg sc-msg-user';
    div.innerHTML = '<div class="sc-msg-avatar ' + avatarClass('user') + '">You</div><div class="sc-msg-body">' + escapeHtml(text) + '</div>';
    messagesEl.appendChild(div);
    scrollToBottom();
  }

  function ping(workerId, state) {
    if (window.scTeamPing) { try { window.scTeamPing(workerId, state); } catch (e) {} }
  }

  function addTypingIndicator(name, workerId, initials) {
    ping(workerId, 'thinking');
    var div = document.createElement('div');
    div.className = 'sc-msg sc-typing';
    div.innerHTML = '<div class="sc-msg-avatar ' + avatarClass(workerId) + '">' + initials + '</div><div class="sc-typing-dots"><span></span><span></span><span></span></div>';
    messagesEl.appendChild(div);
    scrollToBottom();
    return div;
  }

  function addWorkerMessage(opts) {
    var div = document.createElement('div');
    div.className = 'sc-msg';
    var tags = '';
    if (opts.certainty === 'LIKELY') tags += '<span class="sc-msg-tag sc-msg-tag-certainty">Likely, not certain</span>';
    if (opts.certainty === 'UNPROVEN') tags += '<span class="sc-msg-tag sc-msg-tag-certainty">Unproven, insufficient evidence</span>';
    if (opts.writeback) tags += '<span class="sc-msg-tag sc-msg-tag-writeback" title="' + escapeHtml(opts.writeback.summary) + '">Recorded in demo audit trail</span>';
    if (opts.escalation) tags += '<span class="sc-msg-tag sc-msg-tag-escalation" title="' + escapeHtml(opts.escalation.reason) + '">Needs ' + (opts.escalation.to === 'scott_mercer' ? 'Scott Mercer' : 'Tom Arrington') + ' approval</span>';
    if (opts.technicalFailure) tags += '<span class="sc-msg-tag sc-msg-tag-fail">Technical problem</span>';
    div.innerHTML =
      '<div class="sc-msg-avatar ' + avatarClass(opts.workerId) + '">' + opts.initials + '</div>' +
      '<div class="sc-msg-body"><div class="sc-msg-name">' + escapeHtml(opts.name) + ' &middot; ' + escapeHtml(opts.role) + '</div>' +
      escapeHtml(opts.text) +
      (tags ? '<div class="sc-msg-meta-row">' + tags + '</div>' : '') +
      '</div>';
    messagesEl.appendChild(div);
    scrollToBottom();
    ping(opts.workerId, 'answered');
  }

  function delay(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  async function revealSequentially(turn) {
    if (turn.receptionist && turn.receptionist.note) {
      var t1 = addTypingIndicator('Ruth Bailey', 'receptionist', WORKERS.receptionist.initials);
      await delay(500 + Math.random() * 300);
      t1.remove();
      addWorkerMessage({
        name: 'Ruth Bailey', role: 'Receptionist', workerId: 'receptionist', initials: WORKERS.receptionist.initials,
        text: turn.receptionist.note, technicalFailure: turn.receptionist.technicalFailure
      });
    }
    for (var i = 0; i < turn.workerReplies.length; i++) {
      var wr = turn.workerReplies[i];
      var t2 = addTypingIndicator(wr.characterName, wr.workerId, wr.initials);
      await delay(600 + Math.random() * 500);
      t2.remove();
      addWorkerMessage({
        name: wr.characterName, role: wr.displayRole, workerId: wr.workerId, initials: wr.initials,
        text: wr.reply, certainty: wr.certainty, writeback: wr.writeback, escalation: wr.escalation, technicalFailure: wr.technicalFailure
      });
    }
  }

  async function sendMessage(text) {
    if (!text || busy) return;
    busy = true;
    ping('receptionist', 'thinking');
    sendBtn.disabled = true;
    if (suggestionsEl) suggestionsEl.hidden = true;
    addUserMessage(text);
    input.value = '';

    try {
      var res = await fetch('/api/scott/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ message: text, conversationId: conversationId, relatedJobId: relatedJobId, relatedEnquiryId: relatedEnquiryId })
      });
      var data = await res.json();
      if (!res.ok) {
        addWorkerMessage({ name: 'System', role: 'Notice', workerId: 'system', initials: '!', text: data.error || 'Something went wrong.' });
        return;
      }
      conversationId = data.conversationId;
      await revealSequentially(data);
    } catch (err) {
      addWorkerMessage({ name: 'System', role: 'Notice', workerId: 'system', initials: '!', text: 'Could not reach the server. Please try again.' });
    } finally {
      busy = false;
      ping(null, 'idle');
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    sendMessage(input.value.trim());
  });

  if (suggestionsEl) {
    suggestionsEl.querySelectorAll('button').forEach(function (btn) {
      btn.addEventListener('click', function () { sendMessage(btn.getAttribute('data-q')); });
    });
  }
})();
</script>
