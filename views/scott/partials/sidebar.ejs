<aside class="sc-sidebar">
  <div class="sc-brand">
    <div class="sc-brand-mark">SA</div>
    <div class="sc-brand-text">
      <strong>Scott's</strong>
      <span>Armchair &amp; Knitting Co.</span>
    </div>
  </div>
  <div class="sc-search-wrap">
    <input type="text" id="scSearchInput" class="sc-search-input" placeholder="Search jobs, enquiries, customers..." autocomplete="off">
    <div id="scSearchResults" class="sc-search-results" hidden></div>
  </div>
  <ul class="sc-nav">
    <li><a href="/scott" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
    <li><a href="/scott/jobs" class="<%= active === 'jobs' ? 'active' : '' %>">Jobs &amp; Orders</a></li>
    <li><a href="/scott/enquiries" class="<%= active === 'enquiries' ? 'active' : '' %>">Enquiries<% if (typeof navCounts !== 'undefined' && navCounts.newEnquiries) { %><span class="sc-badge"><%= navCounts.newEnquiries %></span><% } %></a></li>
    <li><a href="/scott/approvals" class="<%= active === 'approvals' ? 'active' : '' %>">Approvals<% if (typeof navCounts !== 'undefined' && navCounts.pendingApprovals) { %><span class="sc-badge"><%= navCounts.pendingApprovals %></span><% } %></a></li>
    <li><a href="/scott/finance" class="<%= active === 'finance' ? 'active' : '' %>">Finance</a></li>
    <li><a href="/scott/quality" class="<%= active === 'quality' ? 'active' : '' %>">Quality Control</a></li>
  </ul>
  <% if (typeof personas !== 'undefined') { %>
  <div class="sc-persona-switcher">
    <label for="scPersonaSelect" class="sc-persona-label">Viewing as</label>
    <select id="scPersonaSelect">
      <% Object.keys(personas).forEach(function (id) { %>
        <option value="<%= id %>" <%= id === personaId ? 'selected' : '' %>><%= personas[id].name %> (<%= personas[id].role %>)</option>
      <% }); %>
    </select>
    <p class="sc-persona-hint">Changes what this session's clearance can see, per 07Q. Does not change your real login.</p>
  </div>
  <% } %>
  <div class="sc-sidebar-footer">
    <div class="sc-user-row">Signed in as <strong>&nbsp;<%= user.username %></strong></div>
    <form action="/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="sc-logout">Log out</button>
    </form>
  </div>
</aside>
<% if (typeof personas !== 'undefined') { %>
<script nonce="<%= nonce %>">
(function () {
  var select = document.getElementById('scPersonaSelect');
  if (!select) return;
  select.addEventListener('change', function () {
    fetch('/api/scott/persona', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': <%- JSON.stringify(csrfToken) %> },
      body: JSON.stringify({ personaId: select.value })
    }).then(function () { window.location.reload(); });
  });
})();
</script>
<% } %>
<script nonce="<%= nonce %>">
(function () {
  var input = document.getElementById('scSearchInput');
  var results = document.getElementById('scSearchResults');
  var debounceTimer = null;

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function render(data) {
    var rows = [];
    (data.jobs || []).forEach(function (j) {
      rows.push('<a href="/scott/jobs/' + encodeURIComponent(j.ref) + '">' + escapeHtml(j.ref) + ' &middot; ' + escapeHtml(j.customer_name || '') + '</a>');
    });
    (data.enquiries || []).forEach(function (e) {
      rows.push('<a href="/scott/enquiries/' + e.id + '">' + escapeHtml(e.subject) + '</a>');
    });
    (data.customers || []).forEach(function (c) {
      rows.push('<span class="sc-search-customer">' + escapeHtml(c.name) + '</span>');
    });
    if (!rows.length) {
      results.innerHTML = '<div class="sc-search-empty">No matches</div>';
    } else {
      results.innerHTML = rows.join('');
    }
    results.hidden = false;
  }

  input.addEventListener('input', function () {
    var q = input.value.trim();
    clearTimeout(debounceTimer);
    if (q.length < 2) { results.hidden = true; return; }
    debounceTimer = setTimeout(function () {
      fetch('/api/scott/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(render)
        .catch(function () { results.hidden = true; });
    }, 200);
  });

  document.addEventListener('click', function (e) {
    if (!results.contains(e.target) && e.target !== input) results.hidden = true;
  });
})();
</script>
