<%
  // Counts hang off the capability they belong to rather than off a
  // hard-coded label, so renaming Enquiries to Messages did not silently
  // drop its badge. Returns raw HTML, so the call sites interpolate it
  // unescaped; the only thing interpolated is an integer from our own
  // summary query. (Do not write an EJS open tag in this comment. The
  // parser does not know it is a comment and will hunt for its closer —
  // that mistake has now cost two debugging rounds on this branch.)
  function navBadge(id) {
    if (typeof navCounts === 'undefined' || !navCounts) return '';
    var n = id === 'messages' ? navCounts.newEnquiries
          : id === 'approvals' ? navCounts.pendingApprovals
          : id === 'gaps' ? navCounts.openGaps
          : 0;
    return n ? '<span class="sc-badge">' + parseInt(n, 10) + '</span>' : '';
  }
%>
<aside class="sc-sidebar">
  <div class="sc-brand">
    <div class="sc-brand-mark">SA</div>
    <div class="sc-brand-text">
      <strong>Scott's</strong>
      <span>Armchair &amp; Knitting Co.</span>
    </div>
  </div>
  <div class="sc-search-wrap">
    <input type="text" id="scSearchInput" class="sc-search-input" placeholder="Search jobs, enquiries, customers..." autocomplete="off">
    <div id="scSearchResults" class="sc-search-results" hidden></div>
  </div>
<%
    // THE NAV IS RENDERED FROM THE CAPABILITY REGISTRY, not from
    // conditionals written here (15/09/2026). `caps.nav` is
    // capabilityRegistry.navFor(level, canSee): the groups this level
    // reveals, already filtered to what this person's clearance allows,
    // with empty groups dropped so no level ever renders a bare heading.
    //
    // That is the whole point of the registry. Moving Calendar from My
    // Business to My Team is now a single number in one table, and this
    // file does not need to know it happened.
    //
    // HIDING IS NOT GATING. Every route stays registered,
    // access-guarded and clearance-filtered exactly as it was: a link
    // absent from this list is still reachable by typing it, and still
    // refuses anyone it refused before. A nav that silently 404'd a page
    // it is merely not showing yet would be a second access model, and a
    // second access model is how a finance figure eventually reaches the
    // driver.
    var _caps = (typeof caps !== 'undefined') ? caps : { nav: [], showPersonaSwitch: true };
    var _groups = _caps.nav || [];
  %>
  <% _groups.forEach(function (g, gi) { %>
    <% if (g.label) { %>
      <% if (g.collapsible) { %>
        <%
          // OPEN BY DEFAULT, and this was a real bug rather than a
          // preference. Closed, sixteen of Level 4's twenty-six
          // destinations sat behind two folds, so the state whose whole
          // job is to look like a complete operating environment rendered
          // a SHORTER sidebar than the state below it. The workspace has
          // to be seen to grow; the fold is there so somebody can put a
          // section away, not so the growth is hidden by default.
        %>
        <details class="sc-nav-group" open>
          <summary class="sc-nav-heading"><%= g.label %></summary>
          <ul class="sc-nav">
            <% g.items.forEach(function (it) { %>
              <li><a href="<%= it.path %>" class="<%= active === it.activeKey ? 'active' : '' %>"><%= it.label %><%- navBadge(it.id) %></a></li>
            <% }); %>
          </ul>
        </details>
      <% } else { %>
        <div class="sc-nav-heading sc-nav-heading-static"><%= g.label %></div>
        <ul class="sc-nav">
          <% g.items.forEach(function (it) { %>
            <li><a href="<%= it.path %>" class="<%= active === it.activeKey ? 'active' : '' %>"><%= it.label %><%- navBadge(it.id) %></a></li>
          <% }); %>
        </ul>
      <% } %>
    <% } else { %>
      <ul class="sc-nav">
        <% g.items.forEach(function (it) { %>
          <li><a href="<%= it.path %>" class="<%= active === it.activeKey ? 'active' : '' %>"><%= it.label %><%- navBadge(it.id) %></a></li>
        <% }); %>
      </ul>
    <% } %>
  <% }); %>
  <% if (typeof persona !== 'undefined' && _caps.showPersonaSwitch) { %>
  <div class="sc-clearance-block">
    <div class="sc-persona-label">Clearance</div>
    <div class="sc-clearance-value"><%= persona.code %> &middot; <%= persona.role %></div>
    <% if (typeof canImpersonate !== 'undefined' && canImpersonate) { %>
      <p class="sc-persona-hint">The <strong>Viewing as</strong> control sits above the chat on the <a href="/scott">dashboard</a>.</p>
    <% } %>
  </div>
  <% } %>
  <div class="sc-sidebar-footer">
    <div class="sc-user-row">
      Signed in as <strong><%= user.displayName || user.username %></strong>
      <% if (user.jobTitle) { %><span class="sc-user-jobtitle"><%= user.jobTitle %></span><% } %>
    </div>
    <form action="<%= user.kind === 'portal' ? '/scott/logout' : '/logout' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="sc-logout">Log out</button>
    </form>
  </div>
</aside>
<% if (typeof canImpersonate !== 'undefined' && canImpersonate) { %>
<script nonce="<%= nonce %>">
(function () {
  // Delegated, not bound to the element: the select now lives in the
  // page body (the dashboard hero), which is parsed AFTER this script
  // runs. A direct getElementById here would find nothing and leave the
  // switcher silently dead.
  // Persona chip switcher — delegated click handler so it works whether
  // the chips are on the dashboard or any other page that includes them.
  document.addEventListener('click', function (e) {
    var chip = e.target.closest('[data-persona-id]');
    if (!chip) return;
    var personaId = chip.dataset.personaId || null;
    fetch('/api/scott/impersonate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': <%- JSON.stringify(csrfToken) %> },
      body: JSON.stringify({ personaId: personaId })
    }).then(function () { window.location.reload(); });
  });
})();
</script>
<% } %>
<script nonce="<%= nonce %>">
(function () {
  var input = document.getElementById('scSearchInput');
  var results = document.getElementById('scSearchResults');
  var debounceTimer = null;

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function render(data) {
    var rows = [];
    (data.jobs || []).forEach(function (j) {
      rows.push('<a href="/scott/jobs/' + encodeURIComponent(j.ref) + '">' + escapeHtml(j.ref) + ' &middot; ' + escapeHtml(j.customer_name || '') + '</a>');
    });
    (data.enquiries || []).forEach(function (e) {
      rows.push('<a href="/scott/enquiries/' + e.id + '">' + escapeHtml(e.subject) + '</a>');
    });
    (data.customers || []).forEach(function (c) {
      rows.push('<span class="sc-search-customer">' + escapeHtml(c.name) + '</span>');
    });
    // Company Brain hits. The server has already filtered these to this
    // viewer's clearance and redacted the snippet, so there is nothing to
    // gate here: whatever arrives is theirs to read.
    (data.brain || []).forEach(function (b) {
      rows.push('<span class="sc-search-brain"><strong>' + escapeHtml(b.label) + '</strong>'
        + '<span class="sc-search-domain">' + escapeHtml(b.domain) + '</span>'
        + (b.snippet ? '<span class="sc-search-snippet">' + escapeHtml(b.snippet) + '</span>' : '')
        + '</span>');
    });
    if (!rows.length) {
      results.innerHTML = '<div class="sc-search-empty">No matches</div>';
    } else {
      results.innerHTML = rows.join('');
    }
    results.hidden = false;
  }

  input.addEventListener('input', function () {
    var q = input.value.trim();
    clearTimeout(debounceTimer);
    if (q.length < 2) { results.hidden = true; return; }
    debounceTimer = setTimeout(function () {
      fetch('/api/scott/search?q=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(render)
        .catch(function () { results.hidden = true; });
    }, 200);
  });

  document.addEventListener('click', function (e) {
    if (!results.contains(e.target) && e.target !== input) results.hidden = true;
  });
})();
</script>
