<%
  // Social media, at the top of the sidebar.
  //
  // Logos are inline SVG rather than image files or an icon font: the
  // site runs a strict CSP with per-request nonces and no external
  // origins, so a hosted icon set would simply not load, and a sprite
  // file would be one more asset to keep in step with the platform list.
  //
  // These are navigation, not status. Each one goes to the platform's
  // own block on the Social Media page, which is where the real state
  // lives (connected, last retrieval, last outcome). A viewer cleared
  // for marketing_performance also gets a quiet dot: filled for a
  // connected account, hollow for one that is not. A viewer who is not
  // cleared gets neither, because "no dot" and "not connected" must not
  // look the same.
  var platforms = (typeof socialPlatforms !== 'undefined' ? socialPlatforms : []);
%>
<% if (platforms.length) { %>
<%
  // The brand colours are emitted here rather than written as a style
  // attribute on each chip. The site runs a strict CSP with no
  // 'unsafe-inline' for styles, so `style="--sc-brand: ..."` is silently
  // refused and every logo renders in the inherited colour - which is
  // exactly what happened, and only showed up on a real page load. They
  // still come from the one platform list, so a colour cannot drift from
  // the platform it belongs to.
%>
<style nonce="<%= nonce %>">
<% platforms.forEach(function (p) { %>.sc-social-<%= p.id %> .sc-social-glyph { color: <%= p.colour %>; }
<% }); %>
</style>
<div class="sc-social-strip">
  <div class="sc-social-strip-head">Social media</div>
  <ul class="sc-social-links">
    <% platforms.forEach(function (p) { %>
      <li>
        <a href="/scott/social#social-<%= p.id %>"
           class="sc-social-link sc-social-<%= p.id %><%= p.connected === false ? ' sc-social-off' : '' %>"
           title="<%= p.name %><%= p.connected === null ? '' : (p.connected ? ': connected' : ': not connected') %>">
          <span class="sc-social-glyph">
            <% if (p.id === 'facebook') { %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></svg>
            <% } else if (p.id === 'instagram') { %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4z"/><circle cx="18.41" cy="5.59" r="1.44"/></svg>
            <% } else if (p.id === 'linkedin') { %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.96 6.82H1.69l7.73-8.84L1.27 2.25H8.1l4.71 6.23 5.43-6.23zm-1.16 17.52h1.83L7.09 4.13H5.12l11.96 15.64z"/></svg>
            <% } %>
          </span>
          <span class="sc-social-name"><%= p.name %></span>
          <% if (p.connected !== null) { %>
            <span class="sc-social-dot<%= p.connected ? ' sc-social-dot-on' : '' %>" aria-hidden="true"></span>
            <span class="sc-sr-only"><%= p.connected ? 'connected' : 'not connected' %></span>
          <% } %>
        </a>
      </li>
    <% }); %>
  </ul>
</div>
<% } %>
