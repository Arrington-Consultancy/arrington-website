<%- include('partials/top', { title: 'Dispatch' }) %>
<section class="to-hero">
  <p class="to-eyebrow">The booking software</p>
  <h1>Dispatch board</h1>
  <p class="to-lede">This stands in for the firm's own dispatch system. On a live build the office reads and writes the real one, such as iCabbi, Autocab or Cordic, through its booking API, with access arranged with the provider.</p>
</section>

<% days.forEach(function (d) { %>
  <section class="to-section">
    <h2><%= d.date === today ? 'Today, ' + longDate(d.date) : longDate(d.date) %></h2>
    <div class="to-table-wrap">
      <table class="to-table">
        <thead>
          <tr><th scope="col">Time</th><th scope="col">Ref</th><th scope="col">Customer</th><th scope="col">Pickup</th><th scope="col">Destination</th><th scope="col">Pax</th><th scope="col">Vehicle</th><th scope="col">Came in by</th><th scope="col">Status</th></tr>
        </thead>
        <tbody>
          <% d.jobs.forEach(function (j) { %>
            <tr class="<%= j.status === 'cancelled' ? 'is-cancelled' : '' %><%= j.changed ? ' is-changed' : '' %>">
              <td class="to-time"><%= j.time %></td>
              <td class="to-ref"><%= j.ref %></td>
              <td><%= j.name %><% if (j.notes) { %><span class="to-cell-note"><%= j.notes %></span><% } %></td>
              <td><%= j.pickup %></td>
              <td><%= j.destination %></td>
              <td class="to-num"><%= j.passengers %></td>
              <td><%= VEHICLE_LABELS[j.vehicle] || j.vehicle %></td>
              <td><%= j.source %></td>
              <td><% if (j.status === 'cancelled') { %><span class="to-pill to-pill-neutral">Cancelled</span><% } else if (j.changed === 'added') { %><span class="to-pill to-pill-ok">Added today</span><% } else if (j.changed === 'updated') { %><span class="to-pill to-pill-ok">Corrected</span><% } else { %><span class="to-pill to-pill-neutral">Booked</span><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% }) %>
<%- include('partials/bottom') %>
