<%- include('partials/top', { title: email.subject }) %>
<p class="to-back"><a href="<%= BASE %>/inbox">Inbox</a></p>

<div class="to-email-grid">
  <article class="to-email" aria-label="The email">
    <header>
      <p class="to-email-from"><%= email.from %></p>
      <p class="to-email-when">Received <%= longDate(email.receivedAt.slice(0, 10)) %> at <%= email.receivedAt.slice(11) %></p>
      <h1 class="to-email-subject"><%= email.subject %></h1>
    </header>
    <div class="to-email-body"><%= email.body %></div>
  </article>

  <div class="to-work">
    <% if (!reading || !reading.data) { %>
      <section class="to-panel to-start">
        <p class="to-worker-tag">Not read yet</p>
        <h2>Read it and pass it on</h2>
        <% if (reading && reading.note) { %><p class="to-note to-note-warn"><%= reading.note %></p><% } %>
        <p>The AI reads the email and works out what it is. Plain code then passes it to Bookings, Customer emails, Complaints or Licensing, and checks it against dispatch.</p>
        <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/read">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="to-btn to-btn-primary" data-busy="Reading the email...">Read this email</button>
        </form>
      </section>
    <% } else { var x = reading.data; var W = WORKER[worker]; %>
      <section class="to-panel">
        <div class="to-panel-head">
          <p class="to-worker-tag"><%= reading.source === 'ai' ? 'Read by the AI' : 'Prepared for the demo' %></p>
          <span><span class="to-chip"><%- include('partials/worker-icon', { id: worker }) %><%= W.name %></span> <span class="to-pill to-pill-<%= status.tone %>"><%= status.label %></span></span>
        </div>
        <% if (reading.note) { %><p class="to-note to-note-warn"><%= reading.note %></p><% } %>
        <p class="to-summary"><%= x.summary %></p>
        <dl class="to-facts">
          <div><dt>Customer</dt><dd><%= x.customer_name || 'Not given' %></dd></div>
          <div><dt>Phone</dt><dd><%= x.phone || 'Not given' %></dd></div>
          <% if (x.reference) { %><div><dt>Their reference</dt><dd><%= x.reference %></dd></div><% } %>
        </dl>
        <% if ((x.missing || []).length) { %>
          <p class="to-missing"><strong>Still needed:</strong> <%= x.missing.join(', ') %>.</p>
        <% } %>
      </section>

      <% if (checkState) { var cs = checkState; %>
        <section class="to-panel to-check to-check-<%= cs %>" id="check">
          <div class="to-panel-head">
            <p class="to-worker-tag"><%- include('partials/worker-icon', { id: 'checker' }) %>Checker, a second AI</p>
            <span class="to-pill to-pill-<%= cs === 'agrees' ? 'ok' : (cs === 'concerns' ? 'bad' : 'neutral') %>"><%= cs === 'agrees' ? 'Agrees' : (cs === 'concerns' ? 'Flagged' : 'Not checked') %></span>
          </div>
          <h2><%= cs === 'agrees' ? 'The booking matches the email' : (cs === 'concerns' ? 'The checker found something' : 'Not checked yet') %></h2>
          <p class="to-small">A second AI reads the customer's email beside the booking above, without seeing how the first one worked it out, and reports anything that doesn't match. It decides nothing: you sign it off.</p>
          <% if (reading.corrected && reading.corrected.length) { %><p class="to-note to-note-ok">Corrected from the checker's findings: <%= reading.corrected.join(', ') %>.</p><% } %>
          <% if (check && check.note) { %><p class="to-note to-note-warn"><%= check.note %></p><% } %>
          <% if (check && check.data) { %>
            <% if (check.data.summary) { %><p><%= check.data.summary %></p><% } %>
            <% if (check.data.issues.length) { var _lab = { date: 'Date', time: 'Pickup time', pickup: 'Pickup', destination: 'Destination', passengers: 'Passengers', vehicle: 'Vehicle', needs: 'For the driver', customer_name: 'Name', phone: 'Phone', journey_missing: 'Journey missed', journey_extra: 'Journey not asked for' }; var _multi = (reading.data.journeys || []).length > 1; %>
              <div class="to-table-scroll"><table class="to-diff to-check-table">
                <thead><tr><th scope="col"></th><th scope="col">The booking says</th><th scope="col">The email says</th><th scope="col">It should be</th></tr></thead>
                <tbody>
                  <% check.data.issues.forEach(function (i) { var v = function (x) { return i.field === 'date' && /^\d{4}-\d{2}-\d{2}$/.test(x) ? longDate(x) : (i.field === 'vehicle' ? (VEHICLE_LABELS[x] || x) : x); }; %>
                    <tr><th scope="row"><%= _lab[i.field] %><%= _multi && i.journey >= 0 && i.field !== 'journey_missing' ? ' (journey ' + (i.journey + 1) + ')' : '' %></th><td><%= v(i.booking) || 'Nothing' %></td><td><%= i.email ? '\u201c' + i.email + '\u201d' : '' %></td><td><%= v(i.should_be) %></td></tr>
                  <% }) %>
                </tbody>
              </table></div>
              <% if (check.data.issues.some(function (i) { return i.fixable; }) && !sent) { %>
                <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/apply-check" class="to-inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="to-btn to-btn-primary" data-busy="Correcting and checking again...">Use the checker's corrections</button>
                  <span class="to-small">Puts its values into the booking and checks it again. Or read the email and decide for yourself.</span>
                </form>
              <% } %>
            <% } %>
          <% } %>
          <% if (aiOn && (!check || check.source !== 'ai')) { %>
            <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/recheck" class="to-inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="to-btn to-btn-quiet" data-busy="Checking...">Ask the checker</button>
            </form>
          <% } %>
        </section>
      <% } %>

      <% if (worker === 'licensing') { %>
        <section class="to-panel">
          <p class="to-worker-tag">Passed to Licensing</p>
          <h2>This one is for Licensing</h2>
          <p>It's from the council's licensing team, not a customer, so it has gone to the Licensing worker<% if (regItem) { %> and been filed against <strong><%= regItem.subject %></strong><% } %>.</p>
          <a class="to-btn" href="<%= BASE %>/licensing<% if (regItem) { %>#item-<%= regItem.id %><% } %>">Open it in Licensing</a>
        </section>
      <% } else if (worker === 'complaints') { %>
        <section class="to-panel">
          <p class="to-worker-tag">Passed to Complaints</p>
          <h2>This one is a complaint</h2>
          <% if (complaint && complaint.data) { %>
            <p><%= complaint.jobRef ? 'The Complaints worker found the job in dispatch (' + complaint.jobRef + ') and drafted a reply from what the record shows.' : 'The Complaints worker could not match it to one job in dispatch, so the draft asks the customer for the details.' %><% if (complaint.data.for_licensing) { %> It has also passed it to Licensing, because it's about safety.<% } %></p>
          <% } else { %>
            <p>The Complaints worker looks up the job in dispatch and drafts the reply from the record.</p>
          <% } %>
          <a class="to-btn to-btn-primary" href="<%= BASE %>/complaints#c-<%= email.id %>">Open it in Complaints</a>
        </section>
      <% } else if (worker === 'customer') { %>
        <% if (pastJobs.length) { %>
          <section class="to-panel">
            <p class="to-worker-tag">Checked against dispatch</p>
            <h2>The journey<%= pastJobs.length > 1 ? 's it could be' : '' %></h2>
            <p class="to-small">Plain code found <%= pastJobs.length === 1 ? 'this job' : 'these jobs' %> in dispatch from what the email says<%= pastJobs.length > 1 ? ', so the office knows which drivers to ask' : '' %>.</p>
            <ul class="to-jobs">
              <% pastJobs.forEach(function (j) { %>
                <li><span class="to-ref"><%= j.ref %></span> <span><%= shortDate(j.date) %> <%= j.time %>, <%= j.pickup %> to <%= j.destination %></span><% if (j.record) { %> <span class="to-small">Driver <%= j.record.driver %>, <%= j.record.car %> <%= j.record.reg %></span><% } %></li>
              <% }) %>
            </ul>
          </section>
        <% } %>
      <% } else if (cmp && cmp.legs.length) { %>
        <section class="to-panel">
          <p class="to-worker-tag">Checked against dispatch</p>
          <h2>Does dispatch have it right?</h2>
          <p class="to-small">Plain code, not the AI, decides whether dispatch matches what the customer asked for. Changes go through the dispatch connection (<%= conn.dispatch %>), and only once someone in the office has signed them off.</p>
          <% cmp.legs.forEach(function (leg) { var j = leg.journey; var st = STATUS[leg.status]; %>
            <div class="to-leg">
              <div class="to-leg-head">
                <h3><%= cmp.legs.length > 1 ? 'Journey ' + (leg.index + 1) : 'The journey' %></h3>
                <span class="to-pill to-pill-<%= st.tone %>"><%= st.label %></span>
              </div>
              <dl class="to-facts">
                <div><dt>When</dt><dd><%= j.date ? longDate(j.date) : 'Not given' %><%= j.time ? ', ' + j.time : (j.date ? ', time not given' : '') %></dd></div>
                <div><dt>From</dt><dd><%= j.pickup || 'Not given' %></dd></div>
                <div><dt>To</dt><dd><%= j.destination || 'Not given' %></dd></div>
                <div><dt>Passengers</dt><dd><%= j.passengers %>, <%= (VEHICLE_LABELS[j.vehicle] || 'Car').toLowerCase() %></dd></div>
                <% if (j.needs) { %><div><dt>For the driver</dt><dd><%= j.needs %></dd></div><% } %>
                <% if (leg.fare) { %><div><dt>Fare table</dt><dd><%= leg.fare %></dd></div><% } %>
              </dl>
              <% if (leg.job) { %>
                <p class="to-small">In dispatch as <strong><%= leg.job.ref %></strong>, <%= leg.job.name %>, <%= longDate(leg.job.date) %> at <%= leg.job.time %>.</p>
              <% } %>
              <% if (leg.diffs.length) { %>
                <table class="to-diff">
                  <thead><tr><th scope="col"></th><th scope="col">The email says</th><th scope="col">Dispatch has</th></tr></thead>
                  <tbody>
                    <% leg.diffs.forEach(function (d) { %>
                      <tr><th scope="row"><%= d.label %></th><td><%= d.field === 'date' ? longDate(d.email) : d.email %></td><td><%= d.field === 'date' ? longDate(d.board) : d.board %></td></tr>
                    <% }) %>
                  </tbody>
                </table>
              <% } %>
              <% if (leg.status === 'missing' || leg.status === 'differs' || leg.status === 'to_cancel') { var _sid = 'signoff-' + email.id + '-' + leg.index; %>
                <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/fix" class="to-signoff">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="leg" value="<%= leg.index %>">
                  <p class="to-worker-tag">Your sign-off</p>
                  <label class="to-check-box" for="<%= _sid %>"><input type="checkbox" id="<%= _sid %>" name="signoff" value="yes" required> <span><%= checkState === 'agrees' ? 'I\'ve read the email and the checker\'s result, and I\'m signing this off.' : (checkState === 'concerns' ? 'The checker flagged this booking. I\'ve read what it found, and I\'m signing it off anyway.' : 'The checker hasn\'t checked this. I\'ve checked it against the email myself, and I\'m signing it off.') %></span></label>
                  <button type="submit" class="to-btn to-btn-primary"><%= leg.status === 'missing' ? 'Sign off and book it into dispatch' : (leg.status === 'differs' ? 'Sign off and correct it in dispatch' : 'Sign off and cancel it in dispatch') %></button>
                  <p class="to-small">Signed off as <%= user ? user.username : 'you' %>. The board records who signed it off.</p>
                </form>
              <% } else if (leg.status === 'needs_details') { %>
                <p class="to-small">Nothing goes into dispatch until the customer sends <%= (leg.gaps || []).join(', ') || 'the missing details' %>. The reply below asks for it.</p>
              <% } else if (leg.status === 'match') { %>
                <p class="to-small">Dispatch already has this right. Nothing to do but reply.</p>
              <% } %>
            </div>
          <% }) %>
        </section>
      <% } %>

      <% if (worker === 'bookings' || worker === 'customer') { %>
        <section class="to-panel" id="draft">
          <p class="to-worker-tag"><%= W.name %> worker</p>
          <h2>Draft reply</h2>
          <% if (sent) { %>
            <p class="to-note to-note-ok"><%= sent.where ? 'Saved as a draft in ' + sent.where + ' for someone to send.' : 'Marked as sent. In this demo nothing leaves the office.' %></p>
            <div class="to-reply-sent"><%= sent.text %></div>
          <% } else if (replyText) { %>
            <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/send" class="to-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="to-field"><span class="to-sr">Reply</span><textarea id="reply-<%= email.id %>" name="reply" rows="10" maxlength="3000"><%= replyText %></textarea></label>
              <% if (aiOn) { %>
                <%- include('partials/guide', {
                  fieldId: 'guide-' + email.id,
                  action: BASE + '/inbox/' + email.id + '/guide',
                  unguideAction: BASE + '/inbox/' + email.id + '/unguide',
                  placeholder: worker === 'bookings' ? 'For example: We\'re fully booked then. Offer half an hour later.' : 'For example: It was handed in. They can collect it from the office.',
                  guided: guided,
                  max: guideMax
                }) %>
              <% } %>
              <button type="submit" class="to-btn to-btn-primary"><%= email.live && conn.liveLabel ? 'Save as a draft in ' + conn.liveLabel : (conn.mailboxDemo || email.custom ? 'Mark as sent' : 'Save as a draft in ' + conn.mailbox) %></button>
              <p class="to-small">Edit it first if you like. A person always sends; here nothing is sent at all.</p>
            </form>
          <% } else { %>
            <p>No reply drafted for this one.</p>
          <% } %>
        </section>
      <% } %>

      <% if (reading.source !== 'ai' && aiOn) { %>
        <form method="post" action="<%= BASE %>/inbox/<%= email.id %>/read" class="to-inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="again" value="1">
          <button type="submit" class="to-btn to-btn-quiet" data-busy="Reading the email...">Ask the AI to read it</button>
        </form>
      <% } %>
    <% } %>
  </div>
</div>
<%- include('partials/bottom') %>
