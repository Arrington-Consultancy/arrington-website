<%- include('partials/top', { title: 'Licensing' }) %>
<section class="to-hero">
  <p class="to-eyebrow">AI worker</p>
  <h1>Licensing</h1>
  <p class="to-lede">Every driver badge, vehicle licence, MOT and insurance date in one register, and any safety report passed on by Complaints. The AI drafts what goes to the council's licensing team; a person checks it, attaches the papers and sends it. It never writes to the council itself.</p>
</section>

<% if (passed.length) { %>
  <section class="to-panel to-council" id="from-complaints">
    <p class="to-worker-tag">Passed from Complaints</p>
    <h2>Safety reports to keep on file</h2>
    <p class="to-small">The Complaints worker passes anything about safety here, so it sits with the driver's or the vehicle's record. Whether the council needs to be told is for the office to check against the council's own conditions.</p>
    <ul class="to-record">
      <% passed.forEach(function (c) { %>
        <li><strong><%= c.email.from.replace(/\s*<.*$/, '') %>, <%= shortDate(c.email.receivedAt.slice(0, 10)) %>:</strong> <%= c.complaint.data.licensing_note %> <a href="<%= BASE %>/complaints#c-<%= c.email.id %>">The complaint</a></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% councilEmails.forEach(function (e) { var item = items.find(function (i) { return i.council === e.id; }); %>
  <section class="to-panel to-council">
    <p class="to-worker-tag">From the council</p>
    <h2><%= e.subject %></h2>
    <div class="to-email-body to-email-body-small"><%= e.body %></div>
    <% if (item) { %><p class="to-small">Filed against <a href="#item-<%= item.id %>"><%= item.subject %></a>.</p><% } %>
  </section>
<% }) %>

<section class="to-section">
  <h2>The register</h2>
  <ul class="to-register">
    <% items.forEach(function (i) { var d = drafts[i.id]; var tone = i.urgency.level === 'overdue' ? 'bad' : (i.urgency.level === 'urgent' ? 'warn' : (i.urgency.level === 'soon' ? 'soon' : 'neutral')); %>
      <li id="item-<%= i.id %>" class="to-reg-item">
        <div class="to-reg-row">
          <div>
            <p class="to-reg-what"><%= i.item %><% if (i.council) { %> <span class="to-tag">Council has asked</span><% } %></p>
            <p class="to-reg-subject"><%= i.subject %></p>
            <% if (i.note) { %><p class="to-small"><%= i.note %></p><% } %>
          </div>
          <div class="to-reg-side">
            <span class="to-pill to-pill-<%= tone %>"><%= i.urgency.level === 'ok' ? 'Due ' + i.urgency.label : i.urgency.label %></span>
            <% if (!d && i.urgency.level !== 'ok') { %>
              <form method="post" action="<%= BASE %>/licensing/<%= i.id %>/draft">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="to-btn" data-busy="Drafting...">Draft for the council</button>
              </form>
            <% } %>
          </div>
        </div>
        <% if (d) { %>
          <div class="to-draft">
            <p class="to-worker-tag"><%= d.source === 'ai' ? 'Drafted by the AI' : 'Prepared for the demo' %></p>
            <% if (d.note) { %><p class="to-note to-note-warn"><%= d.note %></p><% } %>
            <dl class="to-facts">
              <div><dt>To</dt><dd><%= d.data.to %></dd></div>
              <div><dt>Subject</dt><dd><%= d.data.subject %></dd></div>
            </dl>
            <div class="to-reply-sent"><%= d.data.body %></div>
            <% if ((d.data.checklist || []).length) { %>
              <h3>Before it goes</h3>
              <ul class="to-checklist">
                <% d.data.checklist.forEach(function (c) { %><li><%= c %></li><% }) %>
              </ul>
            <% } %>
            <p class="to-small">A person sends this from the office email. In this demo it goes nowhere.</p>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>
<%- include('partials/bottom') %>
