<%- include('partials/top', { title: 'Licensing' }) %>
<section class="to-hero">
  <p class="to-eyebrow">AI worker</p>
  <h1 class="to-h1-icon"><%- include('partials/worker-icon', { id: 'licensing', tile: true }) %>Licensing</h1>
  <p class="to-lede">Every plate, MOT, interim test, driver badge and insurance date for the <%= FIRM.fleet %> cars, and any safety report passed on by Complaints. It reminds the office what is coming up and drafts what goes to the council's licensing team; a person checks it, attaches the papers and sends it. It never writes to the council itself.</p>
</section>

<%- include('partials/filter-note') %>

<% if (passed.length) { %>
  <section class="to-panel to-council" id="from-complaints">
    <p class="to-worker-tag">Passed from Complaints</p>
    <h2>Safety reports to keep on file</h2>
    <p class="to-small">The Complaints worker passes anything about safety here, so it sits with the driver's or the vehicle's record. Whether the council needs to be told is for the office to check against the council's own conditions.</p>
    <ul class="to-record">
      <% passed.forEach(function (c) { %>
        <li><strong><%= c.email.from.replace(/\s*<.*$/, '') %>, <%= shortDate(c.email.receivedAt.slice(0, 10)) %>:</strong> <%= c.complaint.data.licensing_note %> <a href="<%= BASE %>/complaints#c-<%= c.email.id %>">The complaint</a></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% councilEmails.forEach(function (e) { var item = items.find(function (i) { return i.council === e.id; }); %>
  <section class="to-panel to-council">
    <p class="to-worker-tag">From the council</p>
    <h2><%= e.subject %></h2>
    <div class="to-email-body to-email-body-small"><%= e.body %></div>
    <% if (item) { %><p class="to-small">Filed against <a href="#item-<%= item.id %>"><%= item.subject %></a>.</p><% } %>
  </section>
<% }) %>

<section class="to-section">
  <h2>Coming up</h2>
  <p class="to-small">Badges, medicals and insurance, and every MOT, plate renewal and interim test due in the next <%= counts.fleetComingUp.windowDays %> days, soonest first. The rest of the year is in the fleet below.</p>
  <ul class="to-register">
    <% items.forEach(function (i) { var d = drafts[i.id]; var tone = i.urgency.level === 'overdue' ? 'bad' : (i.urgency.level === 'urgent' ? 'warn' : (i.urgency.level === 'soon' ? 'soon' : 'neutral')); %>
      <li id="item-<%= i.id %>" class="to-reg-item">
        <div class="to-reg-row">
          <div>
            <p class="to-reg-what"><%= i.item %><% if (i.council) { %> <span class="to-tag">Council has asked</span><% } %></p>
            <p class="to-reg-subject"><%= i.subject %></p>
            <% if (i.note) { %><p class="to-small"><%= i.note %></p><% } %>
          </div>
          <div class="to-reg-side">
            <span class="to-pill to-pill-<%= tone %>"><%= i.urgency.level === 'ok' ? 'Due ' + i.urgency.label : i.urgency.label %></span>
            <% if (!d && i.urgency.level !== 'ok') { %>
              <form method="post" action="<%= BASE %>/licensing/<%= i.id %>/draft">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="to-btn" data-busy="Drafting...">Draft for the council</button>
              </form>
            <% } %>
          </div>
        </div>
        <% if (d) { %>
          <div class="to-draft">
            <p class="to-worker-tag"><%= d.source === 'ai' ? 'Drafted by the AI' : 'Prepared for the demo' %></p>
            <% if (d.note) { %><p class="to-note to-note-warn"><%= d.note %></p><% } %>
            <dl class="to-facts">
              <div><dt>To</dt><dd><%= d.data.to %></dd></div>
              <div><dt>Subject</dt><dd><%= d.data.subject %></dd></div>
            </dl>
            <div class="to-reply-sent"><%= licGuided[i.id] ? licGuided[i.id].reply : d.data.body %></div>
            <% if ((d.data.checklist || []).length) { %>
              <h3>Before it goes</h3>
              <ul class="to-checklist">
                <% d.data.checklist.forEach(function (c) { %><li><%= c %></li><% }) %>
              </ul>
            <% } %>
            <p class="to-small">A person sends this from the office email. In this demo it goes nowhere.</p>
            <% if (aiOn) { %>
              <form method="post" action="<%= BASE %>/licensing/<%= i.id %>/guide" class="to-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <%- include('partials/guide', {
                  fieldId: 'guide-l-' + i.id,
                  action: BASE + '/licensing/' + i.id + '/guide',
                  unguideAction: BASE + '/licensing/' + i.id + '/unguide',
                  placeholder: 'For example: The new certificate is attached. Ask them to confirm the file is up to date.',
                  guided: licGuided[i.id] || null,
                  max: guideMax
                }) %>
              </form>
            <% } %>
          </div>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>

<% if (!filter) { %>
<section class="to-section" id="fleet">
  <div class="to-section-head to-fleet-head">
    <h2>The fleet</h2>
    <a class="to-btn" href="<%= BASE %>/licensing/fleet.csv" download>Download as a spreadsheet</a>
  </div>
  <p class="to-small"><%= fleetMix.total %> cars: <%= fleetMix.hackney %> hackney carriage taxis and <%= fleetMix.privateHire %> private hire, including <%= fleetMix.byType.wav %> wheelchair accessible cars, <%= fleetMix.byType.mpv8 %> eight-seaters and <%= fleetMix.byType.mpv6 %> six-seaters. Each MOT falls a few days before the plate runs out, sometimes the same day, and every car has an interim test six months after its MOT. All <%= fleetMix.total %> are on one fleet insurance policy, which renews on <%= longDate(insurance.renews) %> <%= insurance.renews.slice(0, 4) %>.</p>
  <div class="to-table-wrap">
    <table class="to-table to-fleet">
      <thead><tr><th scope="col">Licence</th><th scope="col">Car</th><th scope="col">Registration</th><th scope="col">Interim test</th><th scope="col">Next MOT</th><th scope="col">Plate runs out</th></tr></thead>
      <tbody>
        <% cars.forEach(function (c) {
          var cell = function (d) {
            if (d < today) return { text: 'Done ' + shortDate(d), cls: 'to-fleet-done' };
            var n = Math.round((Date.parse(d) - Date.parse(today)) / 86400000);
            return { text: shortDate(d) + (d.slice(0, 4) !== today.slice(0, 4) ? ' ' + d.slice(0, 4) : ''), cls: n <= counts.fleetComingUp.windowDays ? 'to-fleet-soon' : '' };
          };
          var ci = cell(c.interim), cm = cell(c.nextMot), cp = cell(c.plate); %>
          <tr id="car-<%= c.id %>">
            <th scope="row"><%= c.kind === 'hackney' ? 'HC' : 'PH' %> <%= c.licence.slice(-2) %></th>
            <td><%= c.car %><span class="to-cell-note"><%= fleetTypes[c.type] %></span></td>
            <td><%= c.reg %></td>
            <td class="<%= ci.cls %>"><%= ci.text %></td>
            <td class="<%= cm.cls %>"><%= cm.text %></td>
            <td class="<%= cp.cls %>"><%= cp.text %><% if (c.gap === 0) { %><span class="to-cell-note">Same day as the MOT</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
<%- include('partials/bottom') %>
