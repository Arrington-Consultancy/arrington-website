<%- include('partials/top', { title: 'Today' }) %>
<%
  var unreadRows = emails.filter(function (r) { return !r.worker; });
  var byWorker = function (id) { return emails.filter(function (r) { return r.worker === id; }); };
  var pillTone = function (i) { return i.urgency.level === 'overdue' ? 'bad' : (i.urgency.level === 'urgent' ? 'warn' : 'neutral'); };
%>
<section class="to-hero">
  <p class="to-eyebrow">Office, <%= todayLong %></p>
  <h1>Here's what needs doing today.</h1>
  <p class="to-lede">Six AI workers read the inbox, check it against dispatch, and draft the replies, the letters to the council and the week's posts. A second AI checks every booking, and nothing goes into dispatch until someone in the office signs it off.</p>
  <% if (unreadRows.length && !readingNow) { %>
    <form method="post" action="<%= BASE %>/inbox/check-all" class="to-inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="back" value="today">
      <button type="submit" class="to-btn to-btn-primary" data-busy="Reading the inbox...">Read the inbox (<%= unreadRows.length %> new)</button>
      <span class="to-small">Each email goes to the worker it belongs to. Takes a few seconds.</span>
    </form>
  <% } %>
</section>

<p class="to-connections"><span><strong>Mailbox:</strong> <%= conn.mailbox %></span><span><strong>Dispatch:</strong> <%= conn.dispatch %></span><span class="to-small">On a live office these are the firm's own Gmail or Outlook inbox and its iCabbi, Autocab or Cordic system, connected through their APIs.</span></p>

<ul class="to-stats" aria-label="At a glance">
  <%
    // Each count opens the list it counts (routes/taxiOffice.js, FILTERS).
    var _go = '<svg class="to-stat-go" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6"/></svg>';
    var _stats = [
      [counts.jobsToday, 'jobs on the board today', '/dispatch?show=today#filtered'],
      [counts.unread + counts.needAction, 'emails to deal with', '/inbox?show=todo#filtered'],
      [counts.complaintsOpen, 'complaints waiting for a reply', '/complaints?show=open#filtered'],
      [counts.licensingDue, 'licensing items due or passed on', '/licensing?show=due#filtered']
    ];
  %>
  <% _stats.forEach(function (st) { %>
  <li><a class="to-stat" href="<%= BASE + st[2] %>"><span class="to-stat-n"><%= st[0] %></span><span class="to-stat-l"><%= st[1] %></span><%- _go %></a></li>
  <% }) %>
</ul>

<div class="to-workers">
  <% WORKERS.forEach(function (w) { %>
    <article class="to-worker" id="worker-<%= w.id %>">
      <div class="to-worker-head">
        <%- include('partials/worker-icon', { id: w.id, tile: true }) %>
        <div><p class="to-worker-tag">AI worker</p><h2><%= w.name %></h2></div>
      </div>
      <p><%= w.does %></p>
      <% if (w.id === 'bookings' || w.id === 'customer') { var list = byWorker(w.id); %>
        <% if (list.length) { %>
          <ul class="to-mini">
            <% list.slice(0, 4).forEach(function (row) { %>
              <li><a href="<%= BASE %>/inbox/<%= row.email.id %>"><%= row.email.from.replace(/\s*<.*$/, '') %></a> <span class="to-pill to-pill-<%= row.status.tone %>"><%= row.sent ? 'Replied' : row.status.label %></span></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="to-small"><%= unreadRows.length ? 'Read the inbox to see which emails are its.' : 'Nothing for it today.' %></p>
        <% } %>
        <a class="to-btn" href="<%= BASE %>/inbox">Open the inbox</a>
      <% } else if (w.id === 'checker') { var checked = emails.filter(function (r) { return r.check; }); var flagged = checked.filter(function (r) { return r.check === 'concerns'; }); %>
        <% if (checked.length) { %>
          <ul class="to-mini">
            <% checked.slice(0, 4).forEach(function (row) { %>
              <li><a href="<%= BASE %>/inbox/<%= row.email.id %>#check"><%= row.email.from.replace(/\s*<.*$/, '') %></a> <span class="to-pill to-pill-<%= row.check === 'agrees' ? 'ok' : (row.check === 'concerns' ? 'bad' : 'neutral') %>"><%= row.check === 'agrees' ? 'Agrees' : (row.check === 'concerns' ? 'Flagged' : 'Not checked') %></span></li>
            <% }) %>
          </ul>
          <p class="to-small"><%= checked.length %> booking<%= checked.length === 1 ? '' : 's' %> checked<%= flagged.length ? ', ' + flagged.length + ' flagged' : ', none flagged' %>.</p>
        <% } else { %>
          <p class="to-small"><%= unreadRows.length ? 'Read the inbox and it checks each booking.' : 'No bookings to check today.' %></p>
        <% } %>
        <a class="to-btn" href="<%= BASE %>/inbox">Open the inbox</a>
      <% } else if (w.id === 'complaints') { %>
        <% if (complaints.length) { %>
          <ul class="to-mini">
            <% complaints.forEach(function (c) { %>
              <li><a href="<%= BASE %>/complaints#c-<%= c.email.id %>"><%= c.email.from.replace(/\s*<.*$/, '') %></a> <span class="to-pill to-pill-<%= c.sent ? 'ok' : 'bad' %>"><%= c.sent ? 'Replied' : 'Open' %></span></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="to-small"><%= unreadRows.length ? 'Read the inbox to find any complaints.' : 'No complaints today.' %></p>
        <% } %>
        <a class="to-btn" href="<%= BASE %>/complaints">Open complaints</a>
      <% } else if (w.id === 'licensing') { %>
        <ul class="to-mini">
          <% passed.forEach(function (c) { %>
            <li><span>From Complaints: <%= c.email.from.replace(/\s*<.*$/, '') %></span> <span class="to-pill to-pill-bad">Safety</span></li>
          <% }) %>
          <% reg.slice(0, 3).forEach(function (i) { %>
            <li><span><%= i.subject.split(',')[0] %>: <%= i.itemLower %></span> <span class="to-pill to-pill-<%= pillTone(i) %>"><%= i.urgency.label %></span></li>
          <% }) %>
        </ul>
        <% var _cu = counts.fleetComingUp; %>
        <p class="to-small" data-fleet-coming-up>Across the <%= FIRM.fleet %> cars in the next <%= _cu.windowDays %> days: <%= _cu.renewals %> MOT and plate renewal<%= _cu.renewals === 1 ? '' : 's' %> and <%= _cu.interims %> interim test<%= _cu.interims === 1 ? '' : 's' %>.</p>
        <a class="to-btn" href="<%= BASE %>/licensing">Open licensing</a>
      <% } else { %>
        <p class="to-small"><%= social ? social.posts.length + ' drafts ready, ' + Object.keys(approved).length + ' approved.' : 'No drafts yet this week.' %></p>
        <a class="to-btn" href="<%= BASE %>/social">Open social media</a>
      <% } %>
    </article>
  <% }) %>
</div>

<section class="to-section">
  <div class="to-section-head">
    <h2>Today's board</h2>
    <a href="<%= BASE %>/dispatch">All of dispatch</a>
  </div>
  <ul class="to-board-list">
    <% todayJobs.forEach(function (j) { %>
      <li class="<%= j.status === 'cancelled' ? 'is-cancelled' : '' %>">
        <span class="to-time"><%= j.time %></span>
        <span class="to-route"><strong><%= j.name %></strong> <span><%= j.pickup %> to <%= j.destination %></span></span>
        <span class="to-ref"><%= j.ref %></span>
      </li>
    <% }) %>
  </ul>
</section>

<% if (changes.length) { %>
<section class="to-section">
  <h2>Put right this session</h2>
  <ul class="to-changes">
    <% changes.forEach(function (c) { %><li><span class="to-ref"><%= c.ref %></span> <%= c.what %></li><% }) %>
  </ul>
</section>
<% } %>
<%- include('partials/bottom') %>
