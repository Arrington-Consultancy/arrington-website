<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment confirmation | Arrington Consultancy</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--black); color: var(--text); line-height: 1.6; }
        <%- include('partials/site-chrome-styles') %>

        h1, h2 { font-family: 'DM Serif Display', serif; font-weight: 400; color: var(--text-bright); line-height: 1.22; margin: 0 0 1rem; }
        p { color: var(--text); margin: 0 0 1.2rem; }
        .btn { display: inline-block; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 600; padding: 0.9rem 1.9rem; border-radius: 3px; text-decoration: none; cursor: pointer; border: 1px solid transparent; }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }

        main { max-width: 560px; margin: 0 auto; padding: 9rem 1.5rem 6rem; text-align: center; }
        .wts-status-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; color: var(--accent); margin-bottom: 1rem; display: block; }
    </style>
</head>
<body>
    <%- include('partials/site-header', { currentPage: { slug: 'where-to-start' }, navPages, canEdit: false, content, pageContact }) %>

    <main>
        <% if (purchase && purchase.status === 'paid') { %>
            <span class="wts-status-label">Payment received</span>
            <h1>Thank you.</h1>
            <p>Your payment for <%= offer ? offer.name : 'your order' %> has gone through. A receipt has been sent to your email, and Tom has been notified.</p>
            <% if (purchase.offer_id === 'website_build') { %>
                <p>Next, Tom will email you to book the recorded planning conversation and confirm what the website needs to do.</p>
            <% } else { %>
                <p>Next, you will receive a short intake questionnaire by email. Once that comes back, work begins.</p>
            <% } %>
        <% } else if (purchase && purchase.status === 'pending') { %>
            <span class="wts-status-label">Confirming payment</span>
            <h1>Almost there.</h1>
            <p>We are still confirming your payment with Stripe. This page updates automatically once it lands — if it doesn't within a minute or two, your receipt email is the safest place to check.</p>
        <% } else { %>
            <span class="wts-status-label">Not found</span>
            <h1>We could not find that payment.</h1>
            <p>If you have just paid, check your email for a receipt from Stripe, or get in touch and we will sort it out directly.</p>
        <% } %>
        <a href="/where-to-start" class="btn btn-outline">Back to Where to Start</a>
    </main>

    <%- include('partials/site-footer', { canEdit: false, pageContact, content }) %>
    <script nonce="<%= nonce %>">
        <%- include('partials/site-chrome-script') %>
        <% if (purchase && purchase.status === 'pending') { %>
        setTimeout(function () { window.location.reload(); }, 4000);
        <% } %>
    </script>
</body>
</html>
