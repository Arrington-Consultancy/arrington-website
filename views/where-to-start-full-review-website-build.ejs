<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commercial Review and Website Build | Arrington Consultancy</title>
    <meta name="description" content="For established businesses whose external presentation no longer matches what the business has become. Commercial Review and Website Build for £3,400.">
    <link rel="canonical" href="https://www.arringtonconsultancy.com/where-to-start/full-review-website-build">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Commercial Review and Website Build | Arrington Consultancy">
    <meta property="og:description" content="Review the business internally, then rebuild the website so the outside matches what the business has become.">
    <meta property="og:url" content="https://www.arringtonconsultancy.com/where-to-start/full-review-website-build">
    <meta property="og:image" content="https://www.arringtonconsultancy.com/img/logo">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18129914078"></script>
    <script nonce="<%= nonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-18129914078');
        <% if (ga4Id) { %>
        gtag('config', '<%= ga4Id %>');
        <% } %>
    </script>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }
        body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--black); color: var(--text); line-height: 1.6; }
        <%- include('partials/site-chrome-styles') %>

        h1, h2 { font-family: 'DM Serif Display', serif; font-weight: 400; color: var(--text-bright); line-height: 1.2; margin: 0; }
        p { color: var(--text); margin: 0; }
        .wts-label { display: block; margin-bottom: 1rem; color: var(--accent); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
        .btn { display: inline-block; max-width: 100%; padding: 0.6rem 1.5rem; border: 1px solid transparent; border-radius: 3px; font-family: 'DM Sans', sans-serif; font-size: 0.92rem; font-weight: 600; text-decoration: none; cursor: pointer; }
        .btn-primary { background: var(--accent); color: var(--black); border-color: var(--accent); }
        .btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-primary:disabled { opacity: 0.6; cursor: default; }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }

        main { max-width: 660px; margin: 0 auto; padding: 8rem 1.5rem 5rem; }
        .wts-back { display: inline-block; margin-bottom: 2.5rem; color: var(--text-muted); font-size: 0.9rem; text-decoration: none; }
        .wts-back:hover { color: var(--accent); }
        .wts-hero-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 1rem 1.5rem; margin-bottom: 1.2rem; }
        .wts-hero-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.45rem); }
        .wts-price { margin-left: auto; color: var(--accent); font-family: 'DM Serif Display', serif; font-size: clamp(2.4rem, 6vw, 3rem); line-height: 1; }
        .wts-lede { max-width: 570px; margin-bottom: 1.5rem; color: var(--text-bright); font-size: 1.12rem; }
        .wts-section { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); }
        .wts-section h2 { margin-bottom: 1.2rem; color: var(--accent); font-family: 'DM Sans', sans-serif; font-size: 1.02rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
        .wts-section p { font-size: 1.02rem; margin-bottom: 1rem; }
        .wts-includes { margin: 0; padding: 0; list-style: none; }
        .wts-includes li { position: relative; margin-bottom: 0.7rem; padding-left: 1.4rem; font-size: 1.02rem; }
        .wts-includes li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
        .wts-note { display: inline-block; margin-top: 0.3rem; padding: 0.9rem 1.2rem; border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 2px; color: var(--text-bright); font-size: 0.98rem; }
        .wts-note p { margin: 0; }

        /* EVIDENCE — same real-document treatment as the £2,500 page. This
           is the biggest purchase on the page and the only one sold with no
           discovery call first, so it carries the same proof, not less. */
        .wts-evidence-note { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 1.4rem; }
        .wts-evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.75rem; }
        .wts-evidence-card { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; padding: 1.5rem 1.25rem; border: 1px solid var(--border); border-radius: 3px; }
        .wts-evidence-card:hover, .wts-evidence-card:focus-visible { border-color: var(--accent); }
        .wts-evidence-thumb { width: 100%; max-width: 190px; height: auto; border-radius: 2px; border: 1px solid var(--border); box-shadow: 0 10px 26px rgba(0,0,0,0.45); margin-bottom: 1.1rem; }
        .wts-evidence-title { font-family: 'DM Serif Display', serif; font-size: 1.1rem; color: var(--text-bright); margin-bottom: 0.4rem; }
        .wts-evidence-card p { font-size: 0.9rem; color: var(--text-muted); margin: 0; max-width: 22rem; }
        .wts-direct-proof { margin-top: 1.2rem; margin-bottom: 0; color: var(--text-muted); }
        .wts-direct-proof a { color: var(--accent); font-weight: 700; }
        .wts-direct-proof a:hover { color: var(--accent-hover); }
        @media (max-width: 640px) {
            .wts-evidence-grid { grid-template-columns: 1fr; gap: 1.5rem; }
            .wts-evidence-thumb { max-width: 220px; }
        }

        .wts-form-section { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
        .wts-form-section h2 { margin-bottom: 0.5rem; font-size: 1.42rem; }
        .wts-form-note { margin-bottom: 1.6rem; color: var(--text-muted); font-size: 0.92rem; }
        .wts-form label { display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.88rem; }
        .wts-form input[type="email"] { width: 100%; margin-bottom: 1.4rem; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: 3px; background: transparent; color: var(--text-bright); font-family: 'DM Sans', sans-serif; font-size: 1rem; }
        .wts-form input[type="email"]:focus { outline: none; border-color: var(--accent); }
        .wts-website-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
        .wts-form-status { margin-top: 1rem; font-size: 0.92rem; }
        .wts-form-status--error { color: #e07a5f; }
        .wts-form-status--ok { color: var(--accent); }
        .wts-alt-route { margin-top: 1.6rem; font-size: 0.95rem; }
        .wts-alt-route a { color: var(--text-muted); }
        .wts-alt-route a:hover { color: var(--accent); }
        @media (max-width: 520px) {
            main { padding-top: 6.5rem; }
            .wts-price { margin-left: 0; }
        }
    </style>
</head>
<body>
    <%- include('partials/site-header', { currentPage: { slug: 'where-to-start' }, navPages, canEdit: false, content, pageContact }) %>

    <main>
        <a href="/where-to-start" class="wts-back">&larr; Where to Start</a>

        <span class="wts-label">Review plus website build</span>
        <div class="wts-hero-head">
            <h1><%= offer.name %></h1>
            <p class="wts-price">£<%= (offer.pricePence / 100).toLocaleString('en-GB') %></p>
        </div>
        <p class="wts-lede">For established businesses whose website no longer matches what the business has become.</p>

        <div class="wts-section">
            <h2>What is included</h2>
            <ul class="wts-includes">
                <li>The Commercial Review and Implementation process</li>
                <li>A practical action plan</li>
                <li>A website designed around the way your business actually operates</li>
                <li>Responsive desktop and mobile build</li>
                <li>The agreed pages, forms and functionality</li>
                <li>Basic technical and on-page SEO setup</li>
                <li>One complete first website version</li>
                <li>One structured round of website changes</li>
            </ul>
        </div>

        <div class="wts-section">
            <h2>Why this package exists</h2>
            <p>Some businesses reach a point where they have outgrown what they once were. They have grown, changed direction, added services, changed systems, changed customers or become materially different.</p>
            <p>The Commercial Review addresses the business internally. The Website Build then makes sure the external presentation reflects that new direction.</p>
        </div>

        <div class="wts-section">
            <h2>How it works</h2>
            <p>The review comes first. We understand the business, agree what should be brought forward more clearly, then build the website around the business that actually exists now.</p>
            <p>Together, the work gives the business a fresh commercial platform for its next stage. It also avoids paying for the same discovery work twice, because the review has already done the commercial thinking.</p>
        </div>

        <% if (offer.creditFrom) { %>
        <div class="wts-section">
            <h2>The credit</h2>
            <div class="wts-note">
                <p>If you have already paid for a Commercial Review, that £500 is credited in full against this price.</p>
            </div>
        </div>
        <% } %>

        <div class="wts-section">
            <h2>See the standard</h2>
            <p class="wts-evidence-note">Real work, not a description of work.</p>
            <div class="wts-evidence-grid">
                <a class="wts-evidence-card" href="/evidence#documents">
                    <img class="wts-evidence-thumb" src="/img/docs/half-time-team-talk.jpg" alt="Preview of the Half-Time Team Talk document" loading="lazy">
                    <p class="wts-evidence-title">Half-Time Team Talk</p>
                    <p>The commercial assessment that comes from following the evidence.</p>
                </a>
                <a class="wts-evidence-card" href="/evidence#documents">
                    <img class="wts-evidence-thumb" src="/img/docs/90-day-action-plan.jpg" alt="Preview of the 90-Day Action Plan document" loading="lazy">
                    <p class="wts-evidence-title">90-Day Action Plan</p>
                    <p>How findings become a practical plan of action.</p>
                </a>
            </div>
            <p class="wts-direct-proof"><a href="<%= websiteBuildProofHref || '/websites-and-ai' %>">See the website work itself, built for World Student Advisors</a>.</p>
        </div>

        <div class="wts-form-section">
            <h2>Start review and website build</h2>
            <p class="wts-form-note">Payment is handled securely by Stripe. Card details are never seen by or stored on this site.</p>
            <form id="wtsCheckoutForm" class="wts-form" data-offer="full_review_website_build">
                <label for="wtsEmail">Your email</label>
                <input type="email" id="wtsEmail" name="email" required maxlength="255" autocomplete="email">
                <div class="wts-website-field" aria-hidden="true">
                    <label for="wtsWebsite">Leave this field blank</label>
                    <input type="text" id="wtsWebsite" name="website" tabindex="-1" autocomplete="off">
                </div>
                <button type="submit" class="btn btn-primary" id="wtsCheckoutSubmit">Pay £3,400 securely</button>
                <p class="wts-form-status" id="wtsCheckoutStatus" role="status"></p>
            </form>
            <p class="wts-alt-route"><a href="#conversation">Prefer to talk first? Start with a conversation &rarr;</a></p>
        </div>
    </main>

    <%- include('partials/site-footer', { canEdit: false, pageContact, content }) %>
    <script nonce="<%= nonce %>">
        <%- include('partials/site-chrome-script') %>

        (function () {
            const form = document.getElementById('wtsCheckoutForm');
            if (!form) return;
            const status = document.getElementById('wtsCheckoutStatus');
            const submitBtn = document.getElementById('wtsCheckoutSubmit');
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            const originalLabel = submitBtn.textContent;

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                status.textContent = '';
                status.className = 'wts-form-status';
                submitBtn.disabled = true;
                submitBtn.textContent = 'Starting checkout...';

                const data = {
                    email: document.getElementById('wtsEmail').value,
                    website: document.getElementById('wtsWebsite').value
                };

                try {
                    const res = await fetch('/api/checkout/' + form.dataset.offer, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    if (!res.ok || !result.ok) {
                        throw new Error(result.error || 'Something went wrong.');
                    }
                    status.textContent = 'Redirecting to secure payment...';
                    status.className = 'wts-form-status wts-form-status--ok';
                    window.location.href = result.url;
                } catch (err) {
                    status.textContent = err.message || 'Something went wrong. Please try again.';
                    status.className = 'wts-form-status wts-form-status--error';
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalLabel;
                }
            });
        })();
    </script>
</body>
</html>
