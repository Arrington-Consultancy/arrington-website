<!DOCTYPE html>
<html lang="en-GB">
<head>
    <%- include('partials/google-tag') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Website Build | Arrington Consultancy</title>
    <meta name="description" content="A fixed £999 Website Build for owner run businesses: planning, build, mobile-ready pages, agreed functionality and one structured round of changes.">
    <link rel="canonical" href="https://www.arringtonconsultancy.com/where-to-start/website-build">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Website Build | Arrington Consultancy">
    <meta property="og:description" content="A fixed £999 website build, built around the way the business actually operates.">
    <meta property="og:url" content="https://www.arringtonconsultancy.com/where-to-start/website-build">
    <meta property="og:image" content="https://www.arringtonconsultancy.com/img/logo">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Website Build | Arrington Consultancy">
    <meta name="twitter:description" content="A fixed £999 website build, built around the way the business actually operates.">
    <meta name="twitter:image" content="https://www.arringtonconsultancy.com/img/logo">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/icon-16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Poppins:wght@500;600&display=swap" rel="stylesheet">
    <%- include('partials/where-to-start-schema', {
        nonce,
        path: '/where-to-start/website-build',
        name: 'Website Build',
        description: 'Planning, build, mobile-ready pages, agreed functionality and one structured round of changes.',
        price: 999
    }) %>
    <style nonce="<%= nonce %>">
        :root {
            <% for (const [prop, val] of Object.entries(theme.vars)) { %>
            <%= prop %>: <%= val %>;
            <% } %>
        }
        * { box-sizing: border-box; }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }
        body {
            margin: 0;
            font-family: 'DM Sans', sans-serif;
            background: var(--black);
            color: var(--text);
            line-height: 1.6;
        }
        <%- include('partials/site-chrome-styles') %>

        h1, h2 {
            font-family: 'Poppins', 'DM Sans', sans-serif;
            font-weight: 400;
            color: var(--text-bright);
            line-height: 1.2;
            margin: 0;
        }
        p { color: var(--text); margin: 0; }

        .wts-label {
            display: block;
            margin-bottom: 1rem;
            color: var(--accent);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .btn {
            display: inline-block;
            max-width: 100%;
            padding: 0.6rem 1.5rem;
            border: 1px solid transparent;
            border-radius: 3px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
        }
        .btn-primary { background: var(--accent); color: var(--black); border-color: var(--accent); }
        .btn-primary:hover, .btn-primary:focus-visible { background: var(--accent-hover); border-color: var(--accent-hover); }
        .btn-primary:disabled { opacity: 0.6; cursor: default; }
        .btn-outline { background: transparent; color: var(--text-bright); border-color: var(--border); }
        .btn-outline:hover, .btn-outline:focus-visible { border-color: var(--accent); color: var(--accent); }

        main { max-width: 660px; margin: 0 auto; padding: calc(var(--site-chrome) + 2.5rem) 1.5rem 5rem; }
        .wts-back { display: inline-block; margin-bottom: 2.5rem; color: var(--text-muted); font-size: 0.9rem; text-decoration: none; }
        .wts-back:hover { color: var(--accent); }

        .wts-hero-head {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 1rem 1.5rem;
            margin-bottom: 1.2rem;
        }
        .wts-hero-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.45rem); }
        .wts-price {
            margin-left: auto;
            color: var(--accent);
            font-family: 'Poppins', 'DM Sans', sans-serif;
            font-size: clamp(2.4rem, 6vw, 3rem);
            line-height: 1;
        }
        .wts-lede {
            max-width: 570px;
            margin-bottom: 1.5rem;
            color: var(--text-bright);
            font-size: 1.12rem;
        }
        .wts-hero-action { margin: 0 0 2.2rem; }

        /* What we have built (14/11/2026, Tom: "we have plenty of website
           builds WSA, Scott's armchairs, tidewell cars and staff portals to
           show"). Four pictures in place of the two text links that sat here:
           an outside review found the page's one example was an unnamed link.
           Each card is one link. A demo is labelled a demo on the card itself,
           so nothing here can be read as a client that is not one. */
        .wts-built h2 { margin-bottom: 1.1rem; color: var(--accent); font-size: 1.05rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
        .wts-built-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
        .wts-built-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: 6px; text-decoration: none; }
        .wts-built-card:hover, .wts-built-card:focus-visible { border-color: var(--accent); }
        .wts-built-card picture { display: block; }
        .wts-built-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-bottom: 1px solid var(--border); }
        .wts-built-text { padding: 1rem 1.1rem 1.15rem; }
        .wts-built-kind { margin: 0 0 0.35rem; color: var(--text-muted); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
        .wts-built-title { margin: 0 0 0.4rem; color: var(--text-bright); font-family: 'Poppins', 'DM Sans', sans-serif; font-size: 1.05rem; line-height: 1.25; }
        .wts-built-card:hover .wts-built-title, .wts-built-card:focus-visible .wts-built-title { color: var(--accent); }
        .wts-built-caption { margin: 0; color: var(--text); font-size: 0.9rem; }
        @media (max-width: 520px) {
            .wts-built-grid { grid-template-columns: 1fr; }
            .wts-built-card img { aspect-ratio: 16 / 9; }
        }

        /* Main-site continuity fix (22/08/2026) — same device as Owner
           Check's bordered .check-card panels, replacing the plain
           top-rule dividers this page used before. See
           where-to-start-commercial-review.ejs for the fuller rationale. */
        .wts-card {
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 2rem 2.25rem;
            margin-top: 2rem;
        }
        .wts-card-item + .wts-card-item {
            margin-top: 1.75rem;
            padding-top: 1.75rem;
            border-top: 1px solid var(--border);
        }
        .wts-card h2 {
            margin-bottom: 1.2rem;
            color: var(--accent);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.02rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .wts-card p { font-size: 1.02rem; margin-bottom: 1rem; }
        .wts-card p:last-child { margin-bottom: 0; }
        .wts-card.surface-paper { background: var(--surface-paper); }
        .wts-includes { margin: 0; padding: 0; list-style: none; }
        .wts-includes li {
            position: relative;
            margin-bottom: 0.7rem;
            padding-left: 1.4rem;
            font-size: 1.02rem;
        }
        .wts-includes li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.65em;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent);
        }
        .wts-form-section { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
        .wts-form-section h2 { margin-bottom: 0.5rem; font-size: 1.42rem; }
        .wts-form-note { margin-bottom: 1.6rem; color: var(--text-muted); font-size: 0.92rem; }
        .wts-form label { display: block; margin-bottom: 0.4rem; color: var(--text-muted); font-size: 0.88rem; }
        .wts-form input[type="email"] {
            width: 100%;
            margin-bottom: 1.4rem;
            padding: 0.9rem 1rem;
            border: 1px solid var(--border);
            border-radius: 3px;
            background: transparent;
            color: var(--text-bright);
            font-family: 'DM Sans', sans-serif;
            font-size: 1rem;
        }
        .wts-form input[type="email"]:focus { outline: none; border-color: var(--accent); }
        .wts-website-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
        .wts-form-status { margin-top: 1rem; font-size: 0.92rem; }
        .wts-form-status--error { color: #e07a5f; }
        .wts-form-status--ok { color: var(--accent); }
        .wts-alt-route { margin-top: 1.6rem; font-size: 0.95rem; }
        .wts-alt-route a { color: var(--text-muted); }
        .wts-alt-route a:hover { color: var(--accent); }

        @media (max-width: 520px) {
            main { padding-top: 6.5rem; }
            .wts-price { margin-left: 0; }
            .wts-card { padding: 1.75rem 1.5rem; }
        }
    </style>
</head>
<body>
    <%- include('partials/site-header', { currentPage: { slug: 'where-to-start/website-build' }, navPages, canEdit: false, content, pageContact }) %>

    <main>
        <%# No "Where to Start" back link since 21/10/2026 (see the Commercial
            Review page). %>
        <%# No "Pay upfront" label since 28/10/2026 (Tom's "Yes fix all of the
            above" on the critical sweep): the page's main action is the enquiry
            button and payment follows our agreeing to take the project on, so
            the label contradicted both. %>
        <div class="wts-hero-head">
            <h1><%= offer.name %></h1>
            <p class="wts-price">£<%= (offer.pricePence / 100).toLocaleString('en-GB') %></p>
        </div>
        <p class="wts-lede">A fixed-price website build shaped around what your business needs to do. Built from scratch, not from a template, and completely customisable.</p>
        <%# The enquiry button at the top (Tom, 19/10/2026, for the website design
            ads): on a phone the first screen had nothing to tap, and Google Ads
            counts an enquiry from this page but cannot see a £999 payment. The
            pay section below is unchanged, so anyone arriving ready to buy
            loses nothing. %>
        <p class="wts-hero-action" data-hero-enquiry><a href="#conversation" class="btn btn-primary">Tell us what you want to build</a></p>
        <%# What we have built (14/11/2026). Replaces the two text links that
            sat here. Wording: the WSA caption is the Evidence page's own line
            plus the price that page states; the Tidewell caption is the line
            Tom approved on 19/10/2026, word for word; Scott's is the Evidence
            page's own description. The staff office goes to the PUBLIC staff
            portal page, never the login (test/websiteBuildProof.test.js), and
            says it is not part of the £999 website. %>
        <section class="wts-built" data-built-work aria-labelledby="wtsBuiltHeading">
            <h2 id="wtsBuiltHeading">What we have built</h2>
            <div class="wts-built-grid">
                <a class="wts-built-card" data-built="wsa" href="<%= websiteBuildProofHref || '/websites-and-ai' %>">
                    <picture><source srcset="/img/built/wsa.webp" type="image/webp"><img src="/img/built/wsa.jpg" alt="The World Student Advisors home page" width="720" height="450"></picture>
                    <div class="wts-built-text">
                        <p class="wts-built-kind">Live website</p>
                        <p class="wts-built-title">World Student Advisors</p>
                        <p class="wts-built-caption">A site built around the enquiry rather than around the brochure. Built for £999.</p>
                    </div>
                </a>
                <a class="wts-built-card" data-built="tidewell" data-taxi-demo-proof href="/taxi-demo/">
                    <picture><source srcset="/img/built/tidewell.webp" type="image/webp"><img src="/img/built/tidewell.jpg" alt="The Tidewell Cars demo website on a phone, with a booking on its way" width="720" height="450" loading="lazy"></picture>
                    <div class="wts-built-text">
                        <p class="wts-built-kind">Demo website</p>
                        <p class="wts-built-title">Tidewell Cars</p>
                        <p class="wts-built-caption">A taxi firm website we built as a demo, where bookings go straight into dispatch. The firm is made up.</p>
                    </div>
                </a>
                <a class="wts-built-card" data-built="office" href="/taxi-demo/staff-portal">
                    <picture><source srcset="/img/built/office.webp" type="image/webp"><img src="/img/built/office.jpg" alt="The Tidewell Cars staff office, showing today's emails, complaints and licensing items" width="720" height="450" loading="lazy"></picture>
                    <div class="wts-built-text">
                        <p class="wts-built-kind">Demo staff portal</p>
                        <p class="wts-built-title">The office behind the website</p>
                        <p class="wts-built-caption">The staff office for the same made up firm. AI workers read the inbox and draft the replies, and someone in the office signs off before anything goes. Not part of the £999 website.</p>
                    </div>
                </a>
                <a class="wts-built-card" data-built="scott" href="<%= (typeof builtProofHref !== 'undefined' && builtProofHref) || '/evidence' %>">
                    <picture><source srcset="/img/built/scott.webp" type="image/webp"><img src="/img/built/scott.jpg" alt="A screen from the Scott's Armchair and Knitting Service demonstration" width="720" height="450" loading="lazy"></picture>
                    <div class="wts-built-text">
                        <p class="wts-built-kind">Demonstration</p>
                        <p class="wts-built-title">Scott&rsquo;s Armchair and Knitting Service</p>
                        <p class="wts-built-caption">A fictional company we built to show how controlled AI works in a business. It is not a real client.</p>
                    </div>
                </a>
            </div>
        </section>

        <div class="wts-card">
            <div class="wts-card-item">
                <h2>What you get</h2>
                <ul class="wts-includes">
                    <li>A website designed for the way your customers and team actually use it</li>
                    <li>Responsive desktop and mobile build</li>
                    <li>The agreed pages, forms and functionality</li>
                    <li>Basic SEO setup, technical and on each page</li>
                    <li>A recorded planning conversation</li>
                    <li>One complete first version</li>
                    <li>One structured round of changes</li>
                    <li>CMS access where appropriate</li>
                </ul>
            </div>
            <div class="wts-card-item">
                <h2>How it works</h2>
                <p>Once we have agreed to take the project on, you pay the £<%= (offer.pricePence / 100).toLocaleString('en-GB') %> and Tom books the recorded planning conversation. That conversation is used to agree what the website needs to do, what pages are required, and what must happen before launch.</p>
                <p>Then we build the first version, take one structured round of changes, and prepare it for launch.</p>
            </div>
        </div>

        <div class="wts-card surface-paper">
            <h2>Price and scope</h2>
            <p>£<%= (offer.pricePence / 100).toLocaleString('en-GB') %> is the fixed price for the build described above. Further changes after the agreed build and included revision are charged at £300 per day, based on approximately six working hours.</p>
        </div>

        <div class="wts-form-section">
            <h2>Start your Website Build</h2>
            <p class="wts-form-note">Payment is handled securely by Stripe. Card details are never seen by or stored on this site.</p>
            <form id="wtsCheckoutForm" class="wts-form" data-offer="website_build">
                <label for="wtsEmail">Your email</label>
                <input type="email" id="wtsEmail" name="email" required maxlength="255" autocomplete="email">
                <div class="wts-website-field" aria-hidden="true">
                    <label for="wtsWebsite">Leave this field blank</label>
                    <input type="text" id="wtsWebsite" name="website" tabindex="-1" autocomplete="off">
                </div>
                <%# Secondary since 21/10/2026: the page's one main action is the
                    enquiry form (Tom's three offer decision). Paying still
                    works exactly as before for anyone ready to buy. %>
                <button type="submit" class="btn btn-outline" id="wtsCheckoutSubmit">Pay £999 securely</button>
                <p class="wts-form-status" id="wtsCheckoutStatus" role="status"></p>
            </form>
            <p class="wts-alt-route"><a href="#conversation">Not ready to pay? Tell us what you want to build instead &rarr;</a></p>
        </div>
    </main>

    <%- include('partials/site-footer', { canEdit: false, pageContact, content }) %>
    <script nonce="<%= nonce %>">
        <%- include('partials/site-chrome-script') %>

        (function () {
            const form = document.getElementById('wtsCheckoutForm');
            if (!form) return;
            const status = document.getElementById('wtsCheckoutStatus');
            const submitBtn = document.getElementById('wtsCheckoutSubmit');
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            const originalLabel = submitBtn.textContent;

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                status.textContent = '';
                status.className = 'wts-form-status';
                submitBtn.disabled = true;
                submitBtn.textContent = 'Starting checkout...';

                const data = {
                    email: document.getElementById('wtsEmail').value,
                    website: document.getElementById('wtsWebsite').value,
                    attribution: window.__leadAttribution ? window.__leadAttribution() : {}
                };

                try {
                    const res = await fetch('/api/checkout/' + form.dataset.offer, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify(data)
                    });
                    const result = await res.json();
                    if (!res.ok || !result.ok) {
                        throw new Error(result.error || 'Something went wrong.');
                    }
                    status.textContent = 'Redirecting to secure payment...';
                    status.className = 'wts-form-status wts-form-status--ok';
                    window.location.href = result.url;
                } catch (err) {
                    status.textContent = err.message || 'Something went wrong. Please try again.';
                    status.className = 'wts-form-status wts-form-status--error';
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalLabel;
                }
            });
        })();
    </script>
</body>
</html>
