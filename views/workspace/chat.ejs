<%- include('partials/shell-top', { pageTitle: 'Ask Ruth', active: 'chat' }) %>

<h1 class="ws-h">Ask <%= receptionist.RUTH.name %></h1>
<p class="ws-sub">Answers come only from records you are cleared to see, routed to the relevant specialist lane. Every answer names the records it rests on. The workspace performs no actions.</p>

<!-- Ruth is the way in, not an extra worker. She holds no clearance and
     reads no record: she takes the question, says who it went to, and
     shows you their answer. See lib/workspace/receptionist.js. -->
<div class="ws-card ws-reception">
  <div class="ws-reception-mark"><%= receptionist.RUTH.name.slice(0, 2).toUpperCase() %></div>
  <div>
    <strong><%= receptionist.RUTH.name %></strong>
    <span class="ws-reception-role"><%= receptionist.RUTH.role %></span>
    <p class="ws-reception-line"><%= receptionist.RUTH.line %></p>
    <p class="ws-note">She routes to <%= receptionist.directory().length %> specialists. She holds no clearance of her own, so she can never show you more than they would.</p>
  </div>
</div>

<% if (!aiEnabled) { %>
  <div class="ws-card"><p class="ws-empty">Workspace AI is not enabled in this environment, so questions will be refused rather than answered from memory. Everything else on this page still works.</p></div>
<% } %>

<div class="ws-card">
  <div class="ws-chat-thread" id="wsThread">
    <% messages.forEach(function (m) { %>
      <div class="ws-msg ws-msg-<%= m.role %>">
        <div><%= m.content %></div>
        <% if (m.role === 'assistant') { %>
          <div class="ws-prov">
            <%= m.lane_id ? 'Lane: ' + m.lane_id.replace(/_/g, ' ') + ' · ' : '' %>
            <% const prov = Array.isArray(m.provenance) ? m.provenance : []; %>
            <%= prov.length ? 'Records supplied: ' + prov.join(', ') : 'No records were available for this answer.' %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <form id="wsAskForm">
    <input type="hidden" name="conversationId" value="<%= active ? active.id : '' %>">
    <div class="ws-form-row">
      <select class="ws-input" name="laneId">
        <option value="">Route automatically</option>
        <% lanes.forEach(function (l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
      </select>
    </div>
    <div class="ws-form-row">
      <textarea class="ws-input" name="question" placeholder="Ask about the brain, the register, an opportunity, the website state" maxlength="4000" required></textarea>
    </div>
    <button class="ws-btn" type="submit" id="wsAskBtn">Ask</button>
    <p class="ws-note-error" id="wsAskError" hidden></p>
  </form>
</div>

<div class="ws-card">
  <h2>Your conversations</h2>
  <% if (conversations.length === 0) { %><p class="ws-empty">None yet.</p><% } %>
  <% conversations.forEach(function (c) { %>
    <div class="ws-item">
      <a href="/workspace/chat?c=<%= c.id %>"><%= c.title || ('Conversation ' + c.id) %></a>
      <div class="ws-meta"><%= new Date(c.updated_at).toUTCString() %><%= c.lane_id ? ' · ' + c.lane_id.replace(/_/g, ' ') : '' %></div>
    </div>
  <% }) %>
</div>

<script nonce="<%= nonce %>">
  (function () {
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    const form = document.getElementById('wsAskForm');
    const thread = document.getElementById('wsThread');
    const errEl = document.getElementById('wsAskError');
    const btn = document.getElementById('wsAskBtn');

    function bubble(role, text, meta) {
      const d = document.createElement('div');
      d.className = 'ws-msg ws-msg-' + role;
      const body = document.createElement('div');
      body.textContent = text;
      d.appendChild(body);
      if (meta) {
        const m = document.createElement('div');
        m.className = 'ws-prov';
        m.textContent = meta;
        d.appendChild(m);
      }
      thread.appendChild(d);
      d.scrollIntoView({ block: 'nearest' });
    }

    // A Zoho invoice draft from the sentence just typed. Approving here is
    // the human decision (recorded in Decisions & approvals); the second
    // call carries it out. Two calls on purpose: the execute route only
    // acts on an approval a named person has granted.
    function draftCard(draft) {
      const card = document.createElement('div');
      card.className = 'ws-msg ws-msg-assistant ws-draft-card';
      const title = document.createElement('div');
      title.textContent = 'Invoice draft #' + draft.approvalId + ': ' + draft.summary;
      card.appendChild(title);
      const row = document.createElement('div');
      row.className = 'ws-form-row';
      const go = document.createElement('button');
      go.className = 'ws-btn'; go.type = 'button'; go.textContent = 'Approve and send';
      const drop = document.createElement('button');
      drop.className = 'ws-btn ws-btn-quiet'; drop.type = 'button'; drop.textContent = 'Discard';
      const out = document.createElement('div');
      out.className = 'ws-prov';
      row.appendChild(go); row.appendChild(drop); card.appendChild(row); card.appendChild(out);
      thread.appendChild(card);
      card.scrollIntoView({ block: 'nearest' });
      async function post(url, body) {
        const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf }, body: JSON.stringify(body) });
        const data = await r.json();
        if (!r.ok) throw new Error(data.error || 'That did not work.');
        return data;
      }
      go.addEventListener('click', async function () {
        if (!window.confirm('Create this invoice in Zoho and email it to ' + draft.draft.customerEmail + ' now?')) return;
        go.disabled = true; drop.disabled = true;
        out.textContent = 'Approving...';
        try {
          await post('/api/workspace/approvals/' + draft.approvalId + '/decide', { decision: 'approved', note: 'Approved from Ask Ruth' });
          out.textContent = 'Approved. Creating and sending...';
          const res = await post('/api/workspace/finance/zoho/invoice/execute', { approvalId: draft.approvalId });
          out.textContent = 'Invoice ' + res.invoiceNumber + ' created' + (res.createdCustomer ? ' (new customer added)' : '') + (res.sent ? ' and emailed to ' + draft.draft.customerEmail + '.' : ', but the email failed: ' + (res.sendError || 'unknown error') + '. It is saved as a draft in Zoho.');
        } catch (ex) {
          out.textContent = 'Not sent: ' + ex.message;
          go.disabled = false; drop.disabled = false;
        }
      });
      drop.addEventListener('click', async function () {
        go.disabled = true; drop.disabled = true;
        try {
          await post('/api/workspace/approvals/' + draft.approvalId + '/decide', { decision: 'declined', note: 'Discarded from Ask Ruth' });
          out.textContent = 'Discarded. Nothing was created or sent.';
        } catch (ex) {
          out.textContent = ex.message;
          go.disabled = false; drop.disabled = false;
        }
      });
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const question = form.question.value.trim();
      if (!question) return;
      errEl.hidden = true;
      btn.disabled = true;
      bubble('user', question);
      form.question.value = '';
      try {
        const r = await fetch('/api/workspace/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
          body: JSON.stringify({
            question: question,
            laneId: form.laneId.value || null,
            conversationId: form.conversationId.value || null
          })
        });
        const data = await r.json();
        if (!r.ok) { errEl.textContent = data.error || 'That did not work.'; errEl.hidden = false; return; }
        form.conversationId.value = data.conversationId;
        const bits = [];
        if (data.receptionist) bits.push(data.receptionist);
        if (data.laneName) bits.push('Lane: ' + data.laneName);
        bits.push(data.provenance.length ? 'Records supplied: ' + data.provenance.join(', ') : 'No records were available for this answer.');
        if (data.gap) bits.push('Gap raised: ' + data.gap.gap_type);
        if (data.escalation) bits.push('For a human decision: ' + data.escalation);
        bubble('assistant', data.answer, bits.join(' · '));
        if (data.invoiceDraft) draftCard(data.invoiceDraft);
      } catch (ex) {
        errEl.textContent = 'Network problem: ' + ex.message;
        errEl.hidden = false;
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<%- include('partials/shell-bottom') %>
