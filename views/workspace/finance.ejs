<%- include('partials/shell-top', { pageTitle: 'Finance', active: 'finance' }) %>

<h1 class="ws-h">Finance</h1>
<p class="ws-sub">Read-only business banking and accounting. Primary source: <strong>ANNA Money</strong>, the real account Arrington uses today. Investigated first (1 September 2026): ANNA has no public developer API, and its own account is not evidenced as directly retrievable through TrueLayer or another regulated Open Banking provider. What ANNA does offer directly to the account holder, no third party needed: a CSV or PDF statement for any period, including full history. That is what this page reads. Xero is available separately as an entirely optional, future accounting-system connector - Tom does not currently use Xero and nothing here requires it.</p>

<% if (!permitted) { %>
  <div class="ws-card"><p class="ws-empty">This area holds real business banking data, which your clearance does not cover.</p></div>
<% } else { %>

<% if (connectError) { %>
  <div class="ws-card ws-danger-card"><p class="ws-note-error"><%= connectError %></p></div>
<% } %>
<% if (importResult) { %>
  <div class="ws-card"><p class="ws-meta"><%= importResult %></p></div>
<% } %>

<div class="ws-card">
  <h2>Upload an ANNA statement</h2>
  <p class="ws-body-text">In the ANNA app, type <strong>"Get an account statement"</strong>, choose a period (a single month, or your full history since the account opened), and choose <strong>CSV</strong>. Upload that file below. Re-uploading a period you have already imported is safe: matching transactions are recognised and not duplicated.</p>
  <p class="ws-meta">The statement export lives in the ANNA app rather than on this page, because ANNA publishes no developer API for a third party to pull it: <a href="https://anna.money/" target="_blank" rel="noopener noreferrer">open ANNA</a> and sign in there. Nothing on this page ever holds your ANNA login.</p>
  <p class="ws-meta">Until a statement is imported, the Company Brain holds no banking data at all, so asking the Workspace about costs will honestly tell you it has nothing on file rather than estimating.</p>
  <form id="wsAnnaImportForm" class="ws-form-row">
    <input class="ws-input" type="file" id="wsAnnaCsvFile" accept=".csv,text/csv">
    <button class="ws-btn" type="submit">Import statement</button>
  </form>
  <p class="ws-note-error" id="wsAnnaImportError" hidden></p>
</div>

<div class="ws-card">
  <h2>Balance</h2>
  <% if (!headlineBalance) { %>
    <p class="ws-empty">No statement uploaded yet.</p>
  <% } else { %>
    <p class="ws-h ws-h-tight"><%= formatPence(headlineBalance.currentBalancePence) %></p>
    <p class="ws-meta">
      From <%= headlineBalance.name %><% if (headlineBalance.balanceAsOf) { %>, as of <%= new Date(headlineBalance.balanceAsOf).toUTCString() %><% } %>.
      <% if (headlineBalance.provider === 'anna_statement_csv') { %>This is the balance as of the last imported statement, not a live balance.<% } %>
    </p>
  <% } %>
</div>

<div class="ws-card">
  <h2>Accounting summary (built in, free)</h2>
  <p class="ws-meta">A read-only summary of the transactions already imported here: categorised income and expenses over a period, built into the Workspace at no extra cost. It is not bookkeeping, VAT calculation or a tax return, and does not replace an accountant.</p>

  <form class="ws-form-row" method="get" action="/workspace/finance">
    <% periodPresets.forEach(function (p) { %>
      <button class="ws-btn <%= period.preset === p ? '' : 'ws-btn-quiet' %>" type="submit" name="period" value="<%= p %>"><%= p.replace(/_/g, ' ') %></button>
    <% }) %>
  </form>
  <form class="ws-form-row" method="get" action="/workspace/finance">
    <input type="hidden" name="period" value="custom">
    <input class="ws-input ws-input-narrow" type="date" name="from" value="<%= period.preset === 'custom' ? period.from : '' %>">
    <input class="ws-input ws-input-narrow" type="date" name="to" value="<%= period.preset === 'custom' ? period.to : '' %>">
    <button class="ws-btn ws-btn-quiet" type="submit">Custom range</button>
  </form>

  <p class="ws-meta">Showing: <strong><%= period.label %></strong></p>

  <% if (summary.count === 0) { %>
    <p class="ws-empty">No transactions in this period.</p>
  <% } else { %>
    <div class="ws-form-row">
      <div><span class="ws-meta">Income</span><br><span class="ws-amount-in ws-stat"><%= formatPence(summary.incomePence) %></span></div>
      <div><span class="ws-meta">Expenses</span><br><span class="ws-amount-out ws-stat"><%= formatPence(summary.expensesPence) %></span></div>
      <div><span class="ws-meta">Net</span><br><span class="ws-stat"><%= formatPence(summary.netPence) %></span></div>
    </div>
    <div class="ws-table-wrap">
    <table class="ws-table">
      <tr><th>Category</th><th>Income</th><th>Expenses</th><th>Net</th><th>Transactions</th></tr>
      <% summary.categories.forEach(function (c) { %>
        <tr>
          <td><%= c.category %></td>
          <td class="ws-amount-in"><%= c.incomePence ? formatPence(c.incomePence) : '' %></td>
          <td class="ws-amount-out"><%= c.expensesPence ? formatPence(c.expensesPence) : '' %></td>
          <td><%= formatPence(c.netPence) %></td>
          <td class="ws-meta"><%= c.count %></td>
        </tr>
      <% }) %>
    </table>
    </div>
  <% } %>
</div>

<div class="ws-card">
  <h2>Cashflow, last 12 months</h2>
  <% if (trend.every(function (m) { return m.count === 0; })) { %>
    <p class="ws-empty">No transactions imported yet.</p>
  <% } else { %>
  <div class="ws-table-wrap">
  <table class="ws-table">
    <tr><th>Month</th><th>Income</th><th>Expenses</th><th>Net</th></tr>
    <% trend.forEach(function (m) { %>
      <tr>
        <td class="ws-meta"><%= m.month %></td>
        <td class="ws-amount-in"><%= m.incomePence ? formatPence(m.incomePence) : '' %></td>
        <td class="ws-amount-out"><%= m.expensesPence ? formatPence(m.expensesPence) : '' %></td>
        <td><%= formatPence(m.netPence) %></td>
      </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<div class="ws-card">
  <h2>Estimated recurring costs</h2>
  <p class="ws-meta">Not a bank-confirmed flag: neither ANNA's statement export nor Xero's API marks a transaction as recurring. This is an estimate, detected from the same payee repeating at a similar amount roughly monthly, quarterly or annually, at least three times.</p>
  <% if (recurringGroups.length === 0) { %>
    <p class="ws-empty">No repeating pattern detected yet. This needs at least three occurrences of the same payee and amount to show up.</p>
  <% } else { %>
  <div class="ws-table-wrap">
  <table class="ws-table">
    <tr><th>Payee</th><th>Cadence</th><th>Est. amount</th><th>Occurrences</th><th>Last seen</th><th>Next expected (est.)</th></tr>
    <% recurringGroups.forEach(function (g) { %>
      <tr>
        <td><%= g.payee %></td>
        <td class="ws-meta"><%= g.cadence %></td>
        <td class="ws-amount-out"><%= formatPence(g.averageAmountPence) %></td>
        <td class="ws-meta"><%= g.occurrences %></td>
        <td class="ws-meta"><%= g.lastDate %></td>
        <td class="ws-meta"><%= g.estimatedNextDate %></td>
      </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<div class="ws-card">
  <h2>Transactions (<%= transactions.length %>)</h2>
  <% if (transactions.length === 0) { %>
    <p class="ws-empty">No transactions imported or synced yet.</p>
  <% } else { %>
  <div class="ws-table-wrap">
  <table class="ws-table">
    <tr><th>Date</th><th>Amount</th><th>Payee</th><th>Reference</th><th>Category</th><th>Recurring (est.)</th><th>Source</th></tr>
    <% transactions.forEach(function (t) { %>
      <tr>
        <td class="ws-meta"><%= new Date(t.txn_date).toISOString().slice(0, 10) %></td>
        <td class="<%= t.direction === 'in' ? 'ws-amount-in' : 'ws-amount-out' %>"><%= t.direction === 'in' ? '+' : '-' %><%= formatPence(t.amount_pence) %></td>
        <td><%= t.payee || '(no payee recorded)' %></td>
        <td class="ws-meta"><%= t.reference %></td>
        <td class="ws-meta"><%= t.category %></td>
        <td class="ws-meta"><%= t.is_recurring ? 'yes' : '' %></td>
        <td class="ws-meta"><%= t.provider === 'anna_statement_csv' ? 'ANNA' : (t.provider === 'zoho_invoice' ? 'Zoho Invoice' : 'Xero') %></td>
      </tr>
    <% }) %>
  </table>
  </div>
  <% } %>
</div>

<div class="ws-card">
  <h2>Invoices and payments (Zoho Invoice)</h2>
  <p class="ws-meta">Read-only, from Arrington's Zoho Invoice account (EU data centre, organisation 20119226503). Invoices and customer payments only: Zoho Invoice is an invoicing tool, not a bank account, so it contributes nothing to the balance, cashflow or recurring-cost figures above.</p>
  <% if (!zoho.configured) { %>
    <p class="ws-empty">Not connected. Set <code>ZOHO_INVOICE_CLIENT_ID</code> and <code>ZOHO_INVOICE_CLIENT_SECRET</code> in Railway, then use the connection controls at the bottom of this page.</p>
  <% } else if (zoho.error) { %>
    <p class="ws-note-error">Zoho Invoice could not be read: <%= zoho.error %></p>
  <% } else { %>
    <h3 class="ws-h-inline">Invoices (<%= zoho.invoices.length %>)</h3>
    <% if (zoho.invoicesError) { %>
      <p class="ws-note-error">Invoices could not be read: <%= zoho.invoicesError %></p>
    <% } else if (zoho.invoices.length === 0) { %>
      <p class="ws-empty">No invoices returned.</p>
    <% } else { %>
    <div class="ws-table-wrap">
    <table class="ws-table">
      <tr><th>Number</th><th>Customer</th><th>Date</th><th>Due</th><th>Status</th><th>Total</th><th>Balance</th></tr>
      <% zoho.invoices.forEach(function (inv) { %>
        <tr>
          <td><%= inv.invoice_number %></td>
          <td><%= inv.customer_name %></td>
          <td class="ws-meta"><%= inv.date %></td>
          <td class="ws-meta"><%= inv.due_date %></td>
          <td class="ws-meta"><%= inv.status %></td>
          <td><%= inv.currency_symbol || '' %><%= Number(inv.total || 0).toFixed(2) %></td>
          <td class="<%= Number(inv.balance) > 0 ? 'ws-amount-out' : 'ws-meta' %>"><%= inv.currency_symbol || '' %><%= Number(inv.balance || 0).toFixed(2) %></td>
        </tr>
      <% }) %>
    </table>
    </div>
    <% } %>
    <h3 class="ws-h-inline">Customer payments (<%= zoho.payments.length %>)</h3>
    <% if (zoho.paymentsError) { %>
      <p class="ws-note-error">Payments could not be read: <%= zoho.paymentsError %><% if (/401/.test(zoho.paymentsError)) { %> This usually means the stored token was issued without the customer payments scope: reconnect Zoho below to issue a new one.<% } %></p>
    <% } else if (zoho.payments.length === 0) { %>
      <p class="ws-empty">No payments returned.</p>
    <% } else { %>
    <div class="ws-table-wrap">
    <table class="ws-table">
      <tr><th>Date</th><th>Customer</th><th>Invoice(s)</th><th>Mode</th><th>Amount</th></tr>
      <% zoho.payments.forEach(function (p) { %>
        <tr>
          <td class="ws-meta"><%= p.date %></td>
          <td><%= p.customer_name %></td>
          <td class="ws-meta"><%= p.invoice_numbers || '' %></td>
          <td class="ws-meta"><%= p.payment_mode || '' %></td>
          <td class="ws-amount-in"><%= p.currency_symbol || '' %><%= Number(p.amount || 0).toFixed(2) %></td>
        </tr>
      <% }) %>
    </table>
    </div>
    <% } %>
  <% } %>
</div>

<% if (zoho.configured && zoho.writesEnabled) { %>
<div class="ws-card" id="wsZohoCreateCard">
  <h2>Create and send an invoice</h2>
  <p class="ws-meta">Creates the invoice in Zoho Invoice under organisation 20119226503. "Save as draft" keeps it private in Zoho; "Save and send" emails it to the customer from your Zoho account using your default invoice email. Every action is recorded in the Activity log. Nothing here can move money.</p>
  <% if (zoho.contactsError) { %><p class="ws-note-error">Existing customers could not be loaded: <%= zoho.contactsError %>. You can still create a new customer below.</p><% } %>
  <form id="wsZohoInvoiceForm">
    <div class="ws-form-row">
      <label class="ws-meta" for="wsZohoCustomer">Customer</label>
      <select class="ws-input" id="wsZohoCustomer" name="customerId">
        <option value="">New customer (enter details below)</option>
        <% zoho.contacts.forEach(function (c) { %>
          <option value="<%= c.contact_id %>"><%= c.contact_name %><% if (c.email) { %> (<%= c.email %>)<% } %></option>
        <% }) %>
      </select>
    </div>
    <div class="ws-form-row" id="wsZohoNewCustomerFields">
      <input class="ws-input" type="text" name="customerName" id="wsZohoCustomerName" placeholder="Customer or company name" maxlength="200" autocomplete="organization">
      <input class="ws-input" type="email" name="customerEmail" id="wsZohoCustomerEmail" placeholder="Customer email (where the invoice is sent)" maxlength="200" autocomplete="email">
    </div>
    <div class="ws-form-row">
      <input class="ws-input" type="text" name="description" id="wsZohoDescription" placeholder="The job, as it should read on the invoice" maxlength="500" required>
    </div>
    <div class="ws-form-row">
      <input class="ws-input ws-input-narrow" type="number" name="amount" id="wsZohoAmount" placeholder="Amount (£)" min="0.01" step="0.01" max="1000000" inputmode="decimal" required>
      <input class="ws-input ws-input-narrow" type="date" name="dueDate" id="wsZohoDueDate" title="Due date (optional)">
    </div>
    <div class="ws-form-row">
      <input class="ws-input" type="text" name="notes" id="wsZohoNotes" placeholder="Notes to the customer (optional)" maxlength="1000">
    </div>
    <div class="ws-form-row">
      <button class="ws-btn ws-btn-quiet" type="submit" data-send="false">Save as draft</button>
      <button class="ws-btn" type="submit" data-send="true">Save and send</button>
    </div>
  </form>
  <p class="ws-note-error" id="wsZohoInvoiceError" hidden></p>
  <p class="ws-meta" id="wsZohoInvoiceResult" hidden></p>
</div>
<% } else if (zoho.configured) { %>
<div class="ws-card">
  <h2>Create and send an invoice</h2>
  <p class="ws-empty">Switched off. Set <code>ENABLE_ZOHO_INVOICE_WRITES=true</code> in Railway, redeploy, then reconnect Zoho below so the token carries the create scopes. Until then this area is read-only.</p>
</div>
<% } %>

<details class="ws-card">
  <summary class="ws-summary"><h2 class="ws-h-inline">Zoho Invoice connection</h2></summary>
  <p class="ws-meta">One-time setup. The refresh token is held in Railway as <code>ZOHO_INVOICE_REFRESH_TOKEN</code>, never in this database. Read-only scopes: invoices, payments, contacts.</p>
  <% if (zoho.configured) { %>
    <p class="ws-body-text">Connected. All three Railway variables are set.</p>
    <p class="ws-meta">To reconnect (for example after revoking the token in Zoho), run the consent step again and replace the Railway variable with the new token.</p>
    <a class="ws-btn ws-btn-quiet" href="/workspace/finance/zoho/connect">Reconnect Zoho Invoice</a>
  <% } else { %>
    <p class="ws-body-text">Not connected.</p>
    <ol class="ws-meta">
      <li>Set <code>ZOHO_INVOICE_CLIENT_ID</code> and <code>ZOHO_INVOICE_CLIENT_SECRET</code> in Railway and redeploy.</li>
      <li>Click Connect below and authorise in Zoho.</li>
      <li>Copy the refresh token shown once, set it as <code>ZOHO_INVOICE_REFRESH_TOKEN</code> in Railway, and redeploy.</li>
    </ol>
    <a class="ws-btn ws-btn-quiet" href="/workspace/finance/zoho/connect">Connect Zoho Invoice</a>
  <% } %>
</details>

<details class="ws-card">
  <summary class="ws-summary"><h2 class="ws-h-inline">Optional: Xero (not required, not connected by default)</h2></summary>
  <p class="ws-meta">Tom does not currently use Xero. Nothing on this page requires it. This exists only for later, if Arrington ever adopts Xero for its own accounting independent of this Workspace.</p>
  <% accounts.filter(function (a) { return a.provider === 'xero'; }).forEach(function (account) { %>
    <span class="ws-badge ws-badge-<%= account.freshness.state === 'fresh' ? 'fresh' : (account.freshness.state === 'sync_failed' ? 'failed' : (account.freshness.state === 'not_connected' || account.freshness.state === 'never_retrieved' ? 'unverified' : 'stale')) %>"><%= account.freshness.state.replace(/_/g, ' ') %></span>
    <% if (!account.configured) { %>
      <p class="ws-body-text">Not configured in this environment. <code>XERO_CLIENT_ID</code> and <code>XERO_CLIENT_SECRET</code> are not both set.</p>
    <% } else if (!tokenCryptoReady) { %>
      <p class="ws-empty"><code>WORKSPACE_FINANCE_TOKEN_KEY</code> is not set, so tokens cannot be stored encrypted. Set it before connecting.</p>
    <% } else if (account.status === 'configured') { %>
      <p class="ws-body-text">Connected to <strong><%= account.tenantName || 'a Xero organisation' %></strong><% if (account.bankAccountName) { %>, bank account <strong><%= account.bankAccountName %></strong><% } %>.</p>
      <p class="ws-meta">
        <% if (account.lastSyncAt) { %>Last sync: <%= new Date(account.lastSyncAt).toUTCString() %> (<%= account.lastSyncOutcome %>)<% } else { %>No sync has run yet.<% } %>
        <% if (account.lastError) { %><div class="ws-note-error"><%= account.lastError %></div><% } %>
      </p>
      <form id="wsFinanceSync" class="ws-form-row">
        <button class="ws-btn ws-btn-quiet" type="submit">Sync now</button>
      </form>
      <form id="wsFinanceDisconnect" class="ws-form-row">
        <button class="ws-btn ws-btn-quiet" type="submit">Disconnect</button>
      </form>
    <% } else { %>
      <p class="ws-body-text">Not connected.</p>
      <a class="ws-btn ws-btn-quiet" href="/workspace/finance/xero/connect">Connect Xero</a>
    <% } %>
  <% }) %>
</details>

<div class="ws-card ws-danger-card">
  <h2>What this area will never do</h2>
  <p class="ws-meta">Not a permission this connector declines to use. No code path anywhere in this system constructs a payment, transfer, beneficiary or card-control instruction, or changes an account setting.</p>
  <ul>
    <% moneyActionsNeverBuilt.forEach(function (a) { %>
      <li><%= a.replace(/_/g, ' ') %></li>
    <% }) %>
  </ul>
</div>

<script nonce="<%= nonce %>">
  (function () {
    var csrf = document.querySelector('meta[name="csrf-token"]').content;

    var importForm = document.getElementById('wsAnnaImportForm');
    var importErr = document.getElementById('wsAnnaImportError');
    if (importForm) {
      importForm.addEventListener('submit', function (e) {
        e.preventDefault();
        importErr.hidden = true;
        var fileInput = document.getElementById('wsAnnaCsvFile');
        var file = fileInput.files && fileInput.files[0];
        if (!file) { importErr.textContent = 'Choose a CSV file first.'; importErr.hidden = false; return; }
        var btn = importForm.querySelector('button');
        btn.disabled = true;
        var reader = new FileReader();
        reader.onload = async function () {
          try {
            var r = await fetch('/api/workspace/finance/anna/import', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
              body: JSON.stringify({ csv: reader.result })
            });
            var data = await r.json();
            if (!r.ok) {
              importErr.textContent = (data.error || 'That did not work.') + (data.warnings && data.warnings.length ? ' ' + data.warnings.join(' ') : '');
              importErr.hidden = false;
              btn.disabled = false;
              return;
            }
            var msg = data.itemsWritten + ' transaction(s) imported.' + (data.warnings && data.warnings.length ? ' ' + data.warnings.length + ' warning(s): ' + data.warnings.slice(0, 3).join(' ') : '');
            window.location.href = '/workspace/finance?importResult=' + encodeURIComponent(msg);
          } catch (ex) {
            importErr.textContent = 'Network problem: ' + ex.message;
            importErr.hidden = false;
            btn.disabled = false;
          }
        };
        reader.onerror = function () { importErr.textContent = 'Could not read that file.'; importErr.hidden = false; btn.disabled = false; };
        reader.readAsText(file);
      });
    }

    function wire(formId, url, confirmMsg, body) {
      var form = document.getElementById(formId);
      if (!form) return;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (confirmMsg && !window.confirm(confirmMsg)) return;
        var btn = form.querySelector('button');
        btn.disabled = true;
        try {
          var r = await fetch(url, {
            method: 'POST',
            headers: Object.assign({ 'x-csrf-token': csrf }, body ? { 'Content-Type': 'application/json' } : {}),
            body: body ? JSON.stringify(body) : undefined
          });
          var data = await r.json();
          if (!r.ok) { window.alert(data.error || 'That did not work.'); btn.disabled = false; return; }
          window.location.reload();
        } catch (ex) {
          window.alert('Network problem: ' + ex.message);
          btn.disabled = false;
        }
      });
    }
    // Create (and optionally send) a Zoho invoice. Sending reaches a real
    // customer, so it is confirmed in the browser as a separate step.
    var zohoForm = document.getElementById('wsZohoInvoiceForm');
    if (zohoForm) {
      var zohoErr = document.getElementById('wsZohoInvoiceError');
      var zohoOut = document.getElementById('wsZohoInvoiceResult');
      var customerSel = document.getElementById('wsZohoCustomer');
      var newFields = document.getElementById('wsZohoNewCustomerFields');
      function syncCustomerFields() { newFields.hidden = !!customerSel.value; }
      customerSel.addEventListener('change', syncCustomerFields);
      syncCustomerFields();
      var sendMode = false;
      zohoForm.querySelectorAll('button[type="submit"]').forEach(function (b) {
        b.addEventListener('click', function () { sendMode = b.getAttribute('data-send') === 'true'; });
      });
      zohoForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        zohoErr.hidden = true; zohoOut.hidden = true;
        var payload = {
          customerId: customerSel.value,
          customerName: document.getElementById('wsZohoCustomerName').value,
          customerEmail: document.getElementById('wsZohoCustomerEmail').value,
          description: document.getElementById('wsZohoDescription').value,
          amount: document.getElementById('wsZohoAmount').value,
          dueDate: document.getElementById('wsZohoDueDate').value,
          notes: document.getElementById('wsZohoNotes').value,
          send: sendMode
        };
        if (!payload.customerId && (!payload.customerName.trim() || !payload.customerEmail.trim())) {
          zohoErr.textContent = 'Choose an existing customer or enter a name and email for a new one.'; zohoErr.hidden = false; return;
        }
        if (sendMode) {
          var who = payload.customerId ? customerSel.options[customerSel.selectedIndex].text : payload.customerEmail;
          if (!window.confirm('Send this invoice for £' + Number(payload.amount || 0).toFixed(2) + ' to ' + who + ' now? This emails the customer from your Zoho account.')) return;
        }
        var btns = zohoForm.querySelectorAll('button');
        btns.forEach(function (b) { b.disabled = true; });
        try {
          var r = await fetch('/api/workspace/finance/zoho/invoice', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
            body: JSON.stringify(payload)
          });
          var data = await r.json();
          if (!r.ok) { zohoErr.textContent = data.error || 'That did not work.'; zohoErr.hidden = false; btns.forEach(function (b) { b.disabled = false; }); return; }
          var msg = 'Invoice ' + data.invoiceNumber + ' created' + (data.createdCustomer ? ' (new customer added)' : '') + (data.sent ? ' and sent.' : (sendMode ? ', but the email failed: ' + (data.sendError || 'unknown error') + '. It is saved as a draft in Zoho.' : ' as a draft.'));
          zohoOut.textContent = msg + ' Reloading...';
          zohoOut.hidden = false;
          setTimeout(function () { window.location.reload(); }, 1500);
        } catch (ex) {
          zohoErr.textContent = 'Network problem: ' + ex.message; zohoErr.hidden = false;
          btns.forEach(function (b) { b.disabled = false; });
        }
      });
    }

    wire('wsFinanceSync', '/api/workspace/finance/sync', null);
    wire('wsFinanceDisconnect', '/api/workspace/finance/disconnect', 'Disconnect Xero? Synced transaction history is kept; the credential is removed.', { provider: 'xero' });
  })();
</script>

<% } %>

