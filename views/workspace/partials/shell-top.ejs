<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Arrington AI Workspace</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <%- include('styles') %>
</head>
<body class="ws-body">
  <div class="ws-shell">
    <aside class="ws-side">
      <a class="ws-brand" href="/workspace">
        <img src="/img/logo-nav.webp?v=20260817" alt="Arrington Consultancy" class="ws-brand-logo" width="400" height="145">
        <span class="ws-brand-line">AI Workspace</span>
        <small>internal, v0.1</small>
      </a>
      <nav class="ws-nav">
        <a href="/workspace" class="<%= active === 'today' ? 'ws-active' : '' %>">Today</a>
        <a href="/workspace/chat" class="<%= active === 'chat' ? 'ws-active' : '' %>">Ask Ruth</a>
        <a href="/workspace/brain" class="<%= active === 'brain' ? 'ws-active' : '' %>">Company Brain</a>
        <a href="/workspace/opportunities" class="<%= active === 'opportunities' ? 'ws-active' : '' %>">Opportunities</a>
        <a href="/workspace/projects" class="<%= active === 'projects' ? 'ws-active' : '' %>">Clients &amp; projects</a>
        <a href="/workspace/contacts" class="<%= active === 'contacts' ? 'ws-active' : '' %>">Contacts</a>
        <a href="/workspace/social" class="<%= active === 'social' ? 'ws-active' : '' %>">Social media</a>
        <a href="/workspace/finance" class="<%= active === 'finance' ? 'ws-active' : '' %>">Finance</a>
        <a href="/workspace/workforce" class="<%= active === 'workforce' ? 'ws-active' : '' %>">AI workforce</a>
        <a href="/workspace/approvals" class="<%= active === 'approvals' ? 'ws-active' : '' %>">Decisions &amp; approvals
          <% if (counts.openApprovals > 0) { %><span class="ws-count"><%= counts.openApprovals %></span><% } %></a>
        <a href="/workspace/gaps" class="<%= active === 'gaps' ? 'ws-active' : '' %>">Brain gaps
          <% if (counts.openGaps > 0) { %><span class="ws-count"><%= counts.openGaps %></span><% } %></a>
        <a href="/workspace/activity" class="<%= active === 'activity' ? 'ws-active' : '' %>">Activity</a>
      </nav>
      <div class="ws-me">
        <strong><%= username %></strong>
        <%= clearanceLabel %>
        <div><a href="/">Back to the website</a></div>
      </div>
    </aside>
    <main class="ws-main">
