<%- include('partials/shell-top', { pageTitle: 'Social media', active: 'social' }) %>

<h1 class="ws-h">Social media</h1>
<p class="ws-sub">Facebook, Instagram, LinkedIn and X in one place: connector state, recent posts, performance, engagement and planned content. The workspace reads, analyses and drafts. Publishing, deleting, replying publicly, changing account settings and spending money stay with a person.</p>

<div class="ws-card">
  <h2>Ask the social lane</h2>
  <p class="ws-body-text"><strong>ARRINGTON SOCIAL CONTENT BUILDER</strong> is the lane that holds this: what was posted, what it cost, which listings renew and what any of it produced. Ask it here and the question is routed to that lane only, with nothing from outside its remit.</p>
  <% if (!aiEnabled) { %>
    <p class="ws-empty">Workspace AI is not enabled in this environment, so a question would be refused rather than answered from memory. Everything below still works.</p>
  <% } %>
  <div class="ws-chat-thread" id="wsSocialThread"></div>
  <form id="wsSocialAsk">
    <div class="ws-form-row">
      <input class="ws-input" type="text" name="question" maxlength="1000" placeholder="What did we spend on directories last year, and what did it bring?">
      <button class="ws-btn" type="submit">Ask</button>
    </div>
    <p class="ws-note-error" id="wsSocialError" hidden></p>
  </form>
</div>

<div class="ws-card">
  <h2>Connectors</h2>
  <div class="ws-table-wrap">
  <table class="ws-table">
    <tr><th>Platform</th><th>State</th><th>Last retrieval</th><th>Followers</th></tr>
    <% accounts.forEach(function (a) { %>
      <tr>
        <td>
          <span class="ws-item-title"><%= a.name %></span>
          <div class="ws-meta"><%= a.api %></div>
        </td>
        <td>
          <span class="ws-badge ws-badge-<%= a.freshness.state === 'fresh' ? 'fresh' : (a.freshness.state === 'sync_failed' ? 'failed' : (a.freshness.state === 'not_connected' ? 'unverified' : 'stale')) %>"><%= a.freshness.state.replace(/_/g, ' ') %></span>
          <% if (!a.configured) { %>
            <div class="ws-meta">No credential in this environment. Nothing is retrieved and nothing is shown.</div>
          <% } %>
        </td>
        <td class="ws-meta">
          <% if (a.freshness.state === 'never_retrieved') { %>
            Connected, but no retrieval has ever succeeded.
          <% } else if (a.lastSyncAt) { %>
            <%= new Date(a.lastSyncAt).toUTCString() %> (<%= a.lastSyncOutcome %>)
            <% if (a.lastError) { %><div class="ws-note-error"><%= a.lastError %></div><% } %>
          <% } else { %>
            Never
          <% } %>
        </td>
        <td class="ws-meta"><%= a.followers === null ? 'unknown' : a.followers %><% if (a.followersChange) { %> (<%= a.followersChange > 0 ? '+' : '' %><%= a.followersChange %>)<% } %></td>
      </tr>
    <% }) %>
  </table>
  </div>
  <% if (accounts.every(function (a) { return !a.configured; })) { %>
    <p class="ws-meta">No connector is configured yet, so every figure on this page would be invented. The page deliberately shows nothing rather than a plausible empty timeline. Setup requirements are listed under each platform below.</p>
  <% } %>
</div>

<% if (accounts.some(function (a) { return !a.configured; })) { %>
<div class="ws-card">
  <h2>What each connector needs before it can read anything</h2>
  <% accounts.filter(function (a) { return !a.configured; }).forEach(function (a) { %>
    <div class="ws-item">
      <span class="ws-item-title"><%= a.name %></span>
      <div class="ws-body-text"><%= a.setupNote %></div>
      <div class="ws-meta">Least-privilege read scopes: <%= a.readScopes.join(', ') %></div>
    </div>
  <% }) %>
</div>
<% } %>

<div class="ws-card">
  <h2>Outstanding replies (<%= outstanding.length %>)</h2>
  <% if (outstanding.length === 0) { %>
    <p class="ws-empty">Nothing waiting. This list fills from comments, mentions and messages the connectors retrieve.</p>
  <% } %>
  <% outstanding.forEach(function (e) { %>
    <div class="ws-item">
      <span class="ws-badge ws-badge-plain"><%= e.platform %></span> <%= e.kind %> from <%= e.author %>
      <div class="ws-body-text"><%= e.body %></div>
      <% if (e.suggested_reply) { %>
        <div class="ws-meta">Suggested reply, for a person to send or ignore: <%= e.suggested_reply %></div>
      <% } %>
    </div>
  <% }) %>
</div>

<div class="ws-card">
  <h2>Recent and planned content</h2>
  <% if (posts.length === 0) { %>
    <p class="ws-empty">No content retrieved or drafted yet.</p>
  <% } %>
  <% posts.forEach(function (p) { %>
    <div class="ws-item">
      <span class="ws-badge ws-badge-plain"><%= p.platform %></span>
      <span class="ws-badge <%= p.kind === 'published' ? 'ws-badge-fresh' : 'ws-badge-stale' %>"><%= p.kind %></span>
      <div class="ws-body-text"><%= p.body %></div>
      <div class="ws-meta">
        <% if (p.posted_at) { %><%= new Date(p.posted_at).toUTCString() %><% } %>
        <% if (p.impressions !== null && p.impressions !== undefined) { %> · <%= p.impressions %> impressions<% } %>
        <% if (p.engagements !== null && p.engagements !== undefined) { %> · <%= p.engagements %> engagements<% } %>
        <% if (p.kind === 'proposed') { %> · proposed content, not published and not scheduled<% } %>
      </div>
    </div>
  <% }) %>
</div>

<div class="ws-card">
  <h2>Social memory</h2>
  <p class="ws-body-text">The record a business normally never gets back from an agency: every post, every penny, every directory renewal, how each performed, and which of it is worth doing again. The structure is here and the lane can answer from it. The history itself has not been supplied yet.</p>
  <div class="ws-item">
    <span class="ws-item-title">Post history</span>
    <div class="ws-meta">Not supplied. Needs an export from each platform, or the dates and subjects of what was posted.</div>
  </div>
  <div class="ws-item">
    <span class="ws-item-title">Spend ledger</span>
    <div class="ws-meta">Not supplied. Boosted posts, photography and content costs, by year.</div>
  </div>
  <div class="ws-item">
    <span class="ws-item-title">Directory and listing entries</span>
    <div class="ws-meta">Not supplied. Yell, Google Business Profile, trade directories, local print: cost, renewal date and what each produced. These renew quietly and are the spend least often reviewed.</div>
  </div>
  <div class="ws-item">
    <span class="ws-item-title">Repeat recommendations</span>
    <div class="ws-meta">Cannot be produced until the history above exists. A recommendation to repeat a post is only worth having when the evidence for it is real.</div>
  </div>
  <p class="ws-meta">Stated as missing rather than shown as empty: an empty table here would read as "nothing was ever posted", which is a different claim entirely.</p>
</div>

<script nonce="<%= nonce %>">
  (function () {
    var form = document.getElementById('wsSocialAsk');
    if (!form) return;
    var thread = document.getElementById('wsSocialThread');
    var err = document.getElementById('wsSocialError');
    var csrf = document.querySelector('meta[name="csrf-token"]').content;
    var conversationId = null;
    function bubble(role, text, meta) {
      var d = document.createElement('div');
      d.className = 'ws-msg ws-msg-' + role;
      var body = document.createElement('div');
      body.textContent = text;
      d.appendChild(body);
      if (meta) {
        var m = document.createElement('div');
        m.className = 'ws-prov';
        m.textContent = meta;
        d.appendChild(m);
      }
      thread.appendChild(d);
    }
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var q = form.question.value.trim();
      if (!q) return;
      err.hidden = true;
      bubble('user', q);
      form.question.value = '';
      try {
        var r = await fetch('/api/workspace/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
          // Pinned to the social lane: this page asks social questions,
          // so the answer must come from that remit rather than from
          // whatever the router would have guessed.
          body: JSON.stringify({ question: q, laneId: 'social_content_builder', conversationId: conversationId })
        });
        var data = await r.json();
        if (!r.ok) { err.textContent = data.error || 'That did not work.'; err.hidden = false; return; }
        conversationId = data.conversationId;
        bubble('assistant', data.answer, data.provenance.length
          ? 'Records supplied: ' + data.provenance.join(', ')
          : 'No records were available for this question.');
      } catch (ex) {
        err.textContent = 'Network problem: ' + ex.message;
        err.hidden = false;
      }
    });
  })();
</script>

<%- include('partials/shell-bottom') %>
